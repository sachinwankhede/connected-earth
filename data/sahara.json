is", "xh": 0.35, "name": "Acacia trees", "ic": "willow"}, {"id": "datepalm", "sp": "phoenix dactylifera", "xh": 0.85}, {"id": "locust", "sp": "schistocerca gregaria", "xh": 0.06}, {"id": "jerboa", "sp": "jaculus and relatives", "xh": 0.18}, {"id": "sandgrouse", "sp": "pterocles coronatus", "xh": 0.3}, {"id": "dorcas", "sp": "gazella dorcas", "xh": 0.42}, {"id": "addax", "sp": "addax nasomaculatus", "xh": 0.54}, {"id": "barbary", "sp": "ammotragus lervia", "xh": 0.68, "desc": "A hardy wild sheep of Saharan mountains that eats grasses and shrubs."}, {"id": "silverant", "sp": "cataglyphis bombycina", "xh": 0.08}, {"id": "viper", "sp": "cerastes cerastes", "xh": 0.2}, {"id": "monitor", "sp": "varanus griseus", "xh": 0.32, "tl": 3, "wiki": "Varanus griseus", "ic": "snake"}, {"id": "fennec", "sp": "vulpes zerda", "xh": 0.46}, {"id": "lanner", "sp": "falco biarmicus", "xh": 0.6}, {"id": "cheetah", "sp": "acinonyx jubatus hecki", "xh": 0.38}, {"id": "owl", "sp": "bubo ascalaphus", "xh": 0.74}], "raw": [["sun", "grass", "r"], ["sun", "datepalm", "r"], ["rain", "grass", "r"], ["rain", "acacia", "r"], ["water", "acacia", "r"], ["water", "datepalm", "r"], ["soil", "grass", "r"], ["soil", "acacia", "r"], ["soil", "datepalm", "r"], ["soil", "decomp", "r"], ["grass", "locust"], ["grass", "jerboa"], ["grass", "sandgrouse"], ["grass", "dorcas"], ["grass", "addax"], ["grass", "barbary"], ["acacia", "locust"], ["acacia", "dorcas"], ["acacia", "addax"], ["acacia", "barbary"], ["datepalm", "locust"], ["datepalm", "fennec"], ["locust", "monitor"], ["locust", "fennec"], ["jerboa", "viper"], ["jerboa", "monitor"], ["jerboa", "fennec"], ["jerboa", "owl"], ["sandgrouse", "lanner"], ["dorcas", "cheetah"], ["addax", "cheetah"], ["fennec", "owl"], ["locust", "silverant", "s"], ["grass", "decomp", "d"], ["acacia", "decomp", "d"], ["datepalm", "decomp", "d"], ["dorcas", "decomp", "d"], ["addax", "decomp", "d"], ["jerboa", "decomp", "d"]], "link_ideas": [{"kind": "flow", "with": "Amazon rainforest