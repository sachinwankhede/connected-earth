{"id": "nphotsprings", "name": "Hot Springs National Park", "short": "Hot Springs", "place": "Arkansas, USA", "lat": 34.514, "lon": -93.054, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Arkansas"], "kind": "Forest", "park": true, "blurb": "Pine-oak-hickory ridges above thermal springs, from acorns to black bears.", "tip": {"id": "fire", "title": "Take away fire", "text": "Fire thins competing trees and prepares soil for shortleaf pine. Set Wildland fire to -100% and watch the pine, then the animals that rely on it."}, "sources": [{"title": "Wikipedia: Hot Springs National Park", "url": "https://en.wikipedia.org/wiki/Hot_Springs_National_Park"}, {"title": "NPS: Nature & Science, Hot Springs National Park", "url": "https://www.nps.gov/hosp/learn/nature/index.htm"}, {"title": "Wikipedia: Ouachita Mountains", "url": "https://en.wikipedia.org/wiki/Ouachita_Mountains"}, {"title": "Wikipedia: Shortleaf pine", "url": "https://en.wikipedia.org/wiki/Shortleaf_pine"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Hot Springs National Park", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "pine", "sp": "pinus echinata", "xh": 0.08, "name": "Shortleaf pine", "wiki": "Shortleaf pine", "desc": "Pine dominates the south-facing slopes of the park. It tolerates fire and grows well on dry, nutrient-poor upland soils.", "ic": "whitebark", "badge": "Foundation species"}, {"id": "oak", "sp": "quercus marilandica", "xh": 0.27, "desc": "An oak of dry ridges and slopes. Oaks and hickories dominate the cooler north-facing slopes, and their acorns feed many animals.", "ic": "willow"}, {"id": "sweetgum", "sp": "liquidambar styraciflua", "xh": 0.46, "desc": "A common hardwood in the area whose leaves feed caterpillars and whose seeds are eaten by squirrels and birds."}, {"id": "beauty", "sp": "callicarpa americana", "xh": 0.65, "ic": "sage"}, {"id": "creeper", "sp": "parthenocissus quinquefolia", "xh": 0.84, "desc": "A woody vine of the forest floor and tree trunks. Deer, rabbits and birds eat its leaves and berries.", "ic": "willow"}, {"id": "luna", "sp": "actias luna", "xh": 0.06, "desc": "A large moth whose caterpillars feed on the leaves of trees such as sweetgum. It is often recorded around the park."}, {"id": "squirrel", "sp": "sciurus carolinensis", "xh": 0.2, "wiki": "Eastern gray squirrel", "desc": "Eats acorns, nuts and seeds, and buries many of them, which helps spread oaks and hickories."}, {"id": "chipmunk", "sp": "tamias striatus", "xh": 0.34, "wiki": "Eastern chipmunk", "desc": "A ground-dwelling rodent that gathers nuts and seeds. It is one of the most recorded mammals near the park.", "ic": "rsquirrel"}, {"id": "rabbit", "sp": "sylvilagus floridanus", "xh": 0.48, "wiki": "Eastern cottontail", "desc": "Eats green plants and woody stems and is a staple prey of foxes, coyotes and hawks."}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.64, "wiki": "White-tailed deer", "desc": "The park's best recorded large mammal. It browses shrubs, vines and young growth and eats acorns."}, {"id": "robin", "sp": "turdus migratorius", "xh": 0.82, "tl": 2, "wiki": "American robin", "desc": "Eats insects and worms and, in autumn and winter, many wild berries."}, {"id": "crow", "sp": "corvus brachyrhynchos", "xh": 0.1, "wiki": "American crow", "desc": "A very common omnivorous bird that eats eggs, small animals, carrion and fruit."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.28, "wiki": "Turkey vulture", "desc": "A scavenger that finds carrion by smell and soars over the ridges of the park."}, {"id": "opossum", "sp": "didelphis virginiana", "xh": 0.46, "wiki": "Virginia opossum", "desc": "An omnivore and scavenger that eats fruit, insects, small animals and carrion."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.64, "wiki": "Raccoon", "desc": "An omnivore that eats fruit, nuts, small vertebrates and eggs. GloBI records many prey species."}, {"id": "grayfox", "sp": "urocyon cinereoargenteus", "xh": 0.84, "wiki": "Gray fox", "desc": "A woodland fox that eats small mammals, birds and fruit, and can climb trees."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "Wikipedia lists the coyote among the park's mammals. It preys on deer, rabbits and rodents and also scavenges."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.7, "name": "American black bear", "wiki": "American black bear", "desc": "Hundreds of black bears live in the Ouachita Mountains. They eat mostly plant foods but also take deer and carrion."}, {"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Light on the forest canopy drives growth. Pine and oak dominate sunny ridges, shrubs and vines use the gaps."}, {"id": "rain", "sp": "rain & spring recharge", "xh": 0.3}, {"id": "fire", "sp": "wildland fire", "xh": 0.52}, {"id": "soil", "sp": "thin rocky soil", "xh": 0.72, "desc": "Dry, nutrient-poor upland soils suit shortleaf pine and post oak better than most other trees."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & decomposers", "desc": "Break down leaf litter, wood and carrion and return nutrients to the thin forest soil."}], "raw": [["sun", "pine", "r"], ["sun", "oak", "r"], ["sun", "sweetgum", "r"], ["sun", "beauty", "r"], ["sun", "creeper", "r"], ["rain", "pine", "r"], ["rain", "oak", "r"], ["rain", "sweetgum", "r"], ["rain", "creeper", "r"], ["fire", "pine", "r"], ["soil", "pine", "r"], ["soil", "oak", "r"], ["soil", "beauty", "r"], ["decomp", "soil", "r"], ["sweetgum", "luna"], ["oak", "squirrel"], ["sweetgum", "squirrel"], ["oak", "chipmunk"], ["oak", "deer"], ["beauty", "deer"], ["creeper", "deer"], ["creeper", "rabbit"], ["beauty", "robin"], ["creeper", "robin"], ["squirrel", "coyote"], ["rabbit", "coyote"], ["deer", "coyote"], ["chipmunk", "coyote"], ["raccoon", "coyote"], ["opossum", "coyote"], ["squirrel", "grayfox"], ["chipmunk", "grayfox"], ["rabbit", "grayfox"], ["beauty", "grayfox"], ["squirrel", "raccoon"], ["chipmunk", "raccoon"], ["rabbit", "raccoon"], ["robin", "raccoon"], ["beauty", "raccoon"], ["oak", "raccoon"], ["squirrel", "opossum"], ["rabbit", "opossum"], ["beauty", "opossum"], ["squirrel", "crow"], ["chipmunk", "crow"], ["robin", "crow"], ["deer", "bear"], ["oak", "bear"], ["beauty", "bear"], ["deer", "vulture", "s"], ["rabbit", "vulture", "s"], ["squirrel", "vulture", "s"], ["raccoon", "vulture", "s"], ["opossum", "vulture", "s"], ["pine", "decomp", "d"], ["oak", "decomp", "d"], ["sweetgum", "decomp", "d"], ["deer", "decomp", "d"], ["creeper", "decomp", "d"], ["beauty", "squirrel"], ["sweetgum", "crow"], ["rabbit", "crow"], ["deer", "crow"], ["chipmunk", "vulture"], ["deer", "opossum"], ["deer", "raccoon"], ["deer", "grayfox"], ["crow", "coyote"], ["grayfox", "coyote"]], "ev": {"sweetgum>luna": ["g", "Actias luna", "Liquidambar styraciflua"], "oak>squirrel": ["gg", "Sciurus carolinensis", "Quercus marilandica"], "sweetgum>squirrel": ["g", "Sciurus carolinensis", "Liquidambar styraciflua"], "oak>chipmunk": ["gg", "Tamias striatus", "Quercus marilandica"], "oak>deer": ["gg", "Odocoileus virginianus", "Quercus marilandica"], "beauty>deer": ["a"], "creeper>deer": ["g", "Odocoileus virginianus", "Parthenocissus quinquefolia"], "creeper>rabbit": ["g", "Sylvilagus floridanus", "Parthenocissus quinquefolia"], "beauty>robin": ["g", "Turdus migratorius", "Callicarpa americana"], "creeper>robin": ["g", "Turdus migratorius", "Parthenocissus quinquefolia"], "squirrel>coyote": ["g", "Canis latrans", "Sciurus carolinensis"], "rabbit>coyote": ["g", "Canis latrans", "Sylvilagus floridanus"], "deer>coyote": ["g", "Canis latrans", "Odocoileus virginianus"], "chipmunk>coyote": ["g", "Canis latrans", "Tamias striatus"], "raccoon>coyote": ["g", "Canis latrans", "Procyon lotor"], "opossum>coyote": ["g", "Canis latrans", "Didelphis virginiana"], "squirrel>grayfox": ["g", "Urocyon cinereoargenteus", "Sciurus carolinensis"], "chipmunk>grayfox": ["g", "Urocyon cinereoargenteus", "Tamias striatus"], "rabbit>grayfox": ["g", "Urocyon cinereoargenteus", "Sylvilagus floridanus"], "beauty>grayfox": ["g", "Urocyon cinereoargenteus", "Callicarpa americana"], "squirrel>raccoon": ["g", "Procyon lotor", "Sciurus carolinensis"], "chipmunk>raccoon": ["g", "Procyon lotor", "Tamias striatus"], "rabbit>raccoon": ["g", "Procyon lotor", "Sylvilagus floridanus"], "robin>raccoon": ["g", "Procyon lotor", "Turdus migratorius"], "beauty>raccoon": ["g", "Procyon lotor", "Callicarpa americana"], "oak>raccoon": ["gg", "Procyon lotor", "Quercus marilandica"], "squirrel>opossum": ["g", "Didelphis virginiana", "Sciurus carolinensis"], "rabbit>opossum": ["g", "Didelphis virginiana", "Sylvilagus floridanus"], "beauty>opossum": ["g", "Didelphis virginiana", "Callicarpa americana"], "squirrel>crow": ["g", "Corvus brachyrhynchos", "Sciurus carolinensis"], "chipmunk>crow": ["g", "Corvus brachyrhynchos", "Tamias striatus"], "robin>crow": ["g", "Corvus brachyrhynchos", "Turdus migratorius"], "deer>bear": ["g", "Ursus americanus", "Odocoileus virginianus"], "oak>bear": ["gg", "Ursus americanus", "Quercus marilandica"], "beauty>bear": ["a"], "deer>vulture": ["g", "Cathartes aura", "Odocoileus virginianus"], "rabbit>vulture": ["g", "Cathartes aura", "Sylvilagus floridanus"], "squirrel>vulture": ["g", "Cathartes aura", "Sciurus carolinensis"], "raccoon>vulture": ["g", "Cathartes aura", "Procyon lotor"], "opossum>vulture": ["g", "Cathartes aura", "Didelphis virginiana"], "beauty>squirrel": ["ga", "Sciurus carolinensis", "Callicarpa americana"], "sweetgum>crow": ["ga", "Corvus brachyrhynchos", "Liquidambar styraciflua"], "rabbit>crow": ["ga", "Corvus brachyrhynchos", "Sylvilagus floridanus"], "deer>crow": ["ga", "Corvus brachyrhynchos", "Odocoileus virginianus"], 