{"id": "xburkina", "name": "W National Park and Arly (Burkina Faso)", "short": "W & Arly", "place": "Burkina Faso and Benin", "lat": 11.9, "lon": 2.0, "side": "r", "cont": "Africa", "country": "Burkina Faso", "countries": ["Burkina Faso", "Benin"], "kind": "Grassland", "park": true, "blurb": "Gamba grass, buffalo and lions in the W-Arly-Pendjari savanna.", "tip": {"id": "fire", "title": "Stop the dry-season fires", "text": "Savanna fires renew the grass and keep woodland open. Set Dry-season fire to -100% and watch the grass, then the grazers that depend on it."}, "sources": [{"title": "Wikipedia: W National Park", "url": "https://en.wikipedia.org/wiki/W_National_Park"}, {"title": "Wikipedia: Arly National Park", "url": "https://en.wikipedia.org/wiki/Arly_National_Park"}, {"title": "Wikipedia: Pendjari National Park", "url": "https://en.wikipedia.org/wiki/Pendjari_National_Park"}, {"title": "Wikipedia: West African lion", "url": "https://en.wikipedia.org/wiki/Panthera_leo_leo"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "W National Park", "icon": "grass", "tier": "overview", "nodes": [{"id": "gamba", "sp": "andropogon gayanus", "xh": 0.12, "desc": "A tall bunchgrass of the Sudanian savanna. It forms much of the dry-season fuel that carries fires and feeds the grazers."}, {"id": "shea", "sp": "vitellaria paradoxa", "xh": 0.37}, {"id": "jackal", "sp": "diospyros mespiliformis", "xh": 0.62, "name": "Jackalberry", "desc": "A large tree of riverside and savanna woodland. Its fruit is recorded as food for elephants, baboons, bats, warthogs and kob."}, {"id": "tamarind", "sp": "tamarindus indica", "xh": 0.87, "wiki": "Tamarindus indica", "desc": "A savanna tree with pod fruit that elephants, baboons, warthogs and fruit bats are recorded eating."}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.05, "name": "African bush elephant", "desc": "The park complex holds some of the last wild elephants in West Africa. They eat grass, bark and tree fruits, and shape woodland."}, {"id": "hippo", "sp": "hippopotamus amphibius", "xh": 0.18, "desc": "Spends the day in river pools and grazes on land. Arly has pools visited by up to twenty hippos."}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.31, "desc": "A large grazing bovid and a main prey of lions in the Pendjari area. One of the most commonly recorded large herbivores here."}, {"id": "roan", "sp": "hippotragus equinus", "xh": 0.44}, {"id": "kob", "sp": "kobus kob", "xh": 0.57, "desc": "A grazing antelope of floodplains and savanna. A frequent prey of lions and spotted hyenas."}, {"id": "warthog", "sp": "phacochoerus africanus", "xh": 0.7, "desc": "An omnivorous pig that grazes grass and eats fallen fruit. Lions and hyenas hunt it."}, {"id": "baboon", "sp": "papio anubis", "xh": 0.83, "desc": "An omnivore that eats fruit, seeds and grass. Lions are recorded preying on it."}, {"id": "bat", "sp": "eidolon helvum", "xh": 0.95, "desc": "A migratory fruit bat that feeds on savanna tree fruit and so helps spread seeds."}, {"id": "cheetah", "sp": "acinonyx jubatus", "xh": 0.15, "name": "Northwest African cheetah", "desc": "One of the last strongholds of this rare cheetah is the W-Arly-Pendjari complex, with only a few tens of individuals."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.4, "desc": "Hunts antelope and buffalo and also scavenges kills. Present across the complex."}, {"id": "wbvulture", "sp": "gyps africanus", "xh": 0.65, "desc": "A carrion-eating vulture recorded feeding on large carcasses from buffalo to elephant."}, {"id": "hvulture", "sp": "necrosyrtes monachus", "xh": 0.88, "desc": "A small resident vulture that scavenges carcasses of large herbivores."}, {"id": "lion", "sp": "panthera leo", "xh": 0.5, "name": "West African lion", "wiki": "Panthera leo leo", "desc": "The apex predator. An estimated several hundred lions live in the W-Arly-Pendjari complex, hunting buffalo, antelope and warthog."}, {"id": "rain", "sp": "rain", "xh": 0.12, "latin": "Rain", "name": "Rainy season", "wiki": "Wet season", "desc": "The summer rains drive the growth of grass and trees; annual rainfall at nearby Pendjari is about 1,100 mm."}, {"id": "fire", "sp": "fire", "xh": 0.37, "latin": "Fire", "name": "Dry-season fire", "desc": "Savanna fires burn dry grass each dry season and keep woodland open."}, {"id": "river", "sp": "water", "xh": 0.62}, {"id": "soil", "sp": "soil", "xh": 0.87, "name": "Savanna soil", "desc": "Soil nutrients returned by decay support grass and tree growth."}, {"id": "decomp", "sp": "decomposers", "xh": 0.5, "latin": "Decomposers", "desc": "Fungi, termites and bacteria break down dead grass, leaves and carcasses and return nutrients to the soil."}], "raw": [["gamba", "elephant"], ["gamba", "buffalo"], ["gamba", "roan"], ["gamba", "kob"], ["gamba", "warthog"], ["gamba", "hippo"], ["shea", "bat"], ["shea", "baboon"], ["jackal", "bat"], ["jackal", "baboon"], ["jackal", "elephant"], ["jackal", "warthog"], ["jackal", "kob"], ["tamarind", "bat"], ["tamarind", "baboon"], ["tamarind", "elephant"], ["tamarind", "warthog"], ["buffalo", "lion"], ["roan", "lion"], ["kob", "lion"], ["warthog", "lion"], ["hippo", "lion"], ["baboon", "lion"], ["elephant", "lion"], ["buffalo", "hyena"], ["roan", "hyena"], ["kob", "hyena"], ["warthog", "hyena"], ["kob", "cheetah"], ["elephant", "wbvulture", "s"], ["buffalo", "wbvulture", "s"], ["kob", "wbvulture", "s"], ["warthog", "wbvulture", "s"], ["elephant", "hvulture", "s"], ["buffalo", "hvulture", "s"], ["hippo", "hvulture", "s"], ["gamba", "decomp", "d"], ["shea", "decomp", "d"], ["jackal", "decomp", "d"], ["tamarind", "decomp", "d"], ["elephant", "decomp", "d"], ["buffalo", "decomp", "d"], ["lion", "decomp", "d"], ["hyena", "decomp", "d"], ["decomp", "soil", "r"], ["rain",