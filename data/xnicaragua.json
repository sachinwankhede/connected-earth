{"id": "xnicaragua", "name": "Indio Maiz Biological Reserve", "short": "Indio Maiz", "place": "Nicaragua", "lat": 11.08, "lon": -84.1, "side": "r", "cont": "North America", "country": "Nicaragua", "kind": "Forest", "park": true, "blurb": "Wet lowland rainforest where jaguars, tapirs and great green macaws live.", "tip": {"id": "almendro", "title": "Lose the almendro", "text": "Great green macaws depend on almendro nuts and nest in the trees. Lower the almendro and watch macaws, agoutis and monkeys that eat the seeds feel it."}, "sources": [{"title": "Wikipedia: Indio Maiz Biological Reserve", "url": "https://en.wikipedia.org/wiki/Indio_Maíz_Biological_Reserve"}, {"title": "Wikipedia: Jaguar", "url": "https://en.wikipedia.org/wiki/Jaguar"}, {"title": "Wikipedia: Great green macaw", "url": "https://en.wikipedia.org/wiki/Great_green_macaw"}, {"title": "Wikipedia: Baird's tapir", "url": "https://en.wikipedia.org/wiki/Baird's_tapir"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Indio Maíz Biological Reserve", "icon": "grizzly", "tier": "overview", "nodes": [{"id": "almendro", "sp": "dipteryx oleifera", "xh": 0.2}, {"id": "needle", "sp": "posoqueria latifolia", "xh": 0.5}, {"id": "miconia", "sp": "miconia", "xh": 0.8, "desc": "A large group of understory shrubs and small trees with berries, common in wet Neotropical forests.", "ic": "willow"}, {"id": "tapir", "sp": "tapirella bairdii", "xh": 0.06, "desc": "The largest land mammal of Central America. It browses leaves and fallen fruit along well-worn forest paths."}, {"id": "howler", "sp": "alouatta palliata", "xh": 0.2, "desc": "A big-voiced monkey that lives in the canopy and eats mostly leaves and fruit."}, {"id": "spider", "sp": "ateles geoffroyi", "xh": 0.34, "name": "Black-handed spider monkey", "desc": "A long-limbed canopy monkey that feeds mostly on ripe fruit."}, {"id": "sloth", "sp": "bradypus variegatus", "xh": 0.47, "desc": "A slow-moving leaf eater of the canopy that comes to the ground rarely."}, {"id": "agouti", "sp": "dasyprocta punctata", "xh": 0.6, "desc": "A forest rodent that eats fruit and seeds and buries some of them, which can help trees spread."}, {"id": "macaw", "sp": "ara ambiguus", "xh": 0.74}, {"id": "bat", "sp": "artibeus lituratus", "xh": 0.87, "desc": "A fruit bat recorded eating needle flower fruit. It moves seeds through the forest as it feeds."}, {"id": "iguana", "sp": "iguana iguana", "xh": 0.96, "desc": "A large tree-dwelling lizard that eats leaves, flowers and fruit."}, {"id": "coati", "sp": "nasua narica", "xh": 0.12, "desc": "A sociable forager that eats fruit and small animals on the forest floor."}, {"id": "vulture", "sp": "coragyps atratus", "xh": 0.38, "desc": "A common scavenger that cleans up carcasses; GloBI has it feeding on agouti, iguana and egret remains."}, {"id": "egret", "sp": "ardea alba", "xh": 0.62, "name": "Great egret", "wiki": "Great egret", "desc": "A wading bird of rivers and swamps that hunts fish and reptiles, including lizards.", "ic": "hawk"}, {"id": "terciopelo", "sp": "bothrops asper", "xh": 0.88, "desc": "A large venomous pit viper of lowland forest. It is recorded eating agoutis."}, {"id": "jaguar", "sp": "panthera onca", "xh": 0.3, "desc": "The top cat of the reserve. It takes a wide range of prey, from sloths and monkeys to large animals like tapirs.", "ic": "grizzly"}, {"id": "harpy", "sp": "harpia harpyja", "xh": 0.72, "desc": "A huge forest eagle that hunts monkeys and sloths in the canopy, listed among the reserve birds.", "ic": "goldeneagle"}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Warm tropical light all year, with the dense canopy shading the forest floor."}, {"id": "rain", "sp": "heavy rain", "xh": 0.35, "desc": "More than 4,000 mm of rain falls each year, with a 