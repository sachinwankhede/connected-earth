{"id": "nppetrifiedforest", "name": "Petrified Forest National Park", "short": "Petrified Forest", "place": "Arizona, USA", "lat": 35.09, "lon": -109.81, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Arizona"], "kind": "Desert", "park": true, "blurb": "Desert grassland where prairie dogs, pronghorn and rabbits feed coyotes and eagles.", "tip": {"id": "pdog", "title": "Thin the prairie dogs", "text": "Gunnison's prairie dogs are hunted by hawks, eagles, coyotes and bobcats. Set Gunnison's prairie dog to -80% and watch the predators that rely on it."}, "sources": [{"title": "Wikipedia: Petrified Forest National Park", "url": "https://en.wikipedia.org/wiki/Petrified_Forest_National_Park"}, {"title": "NPS: Petrified Forest animals", "url": "https://www.nps.gov/pefo/learn/nature/animals.htm"}, {"title": "Wikipedia: Gunnison's prairie dog", "url": "https://en.wikipedia.org/wiki/Gunnison%27s_prairie_dog"}, {"title": "Wikipedia: Pronghorn", "url": "https://en.wikipedia.org/wiki/Pronghorn"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Petrified Forest National Park, Gunnison's prairie dog, Pronghorn). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Petrified Forest National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Strong high-desert sun drives plant growth, but it also dries the soil in a park that gets only about 10 inches of rain a year."}, {"id": "rain", "sp": "summer monsoon rain", "xh": 0.3, "wiki": "North American monsoon"}, {"id": "soil", "sp": "badland and clay soils", "xh": 0.55}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Soil microbes and fungi", "desc": "Break down dead plants, droppings and carcasses, returning nutrients to thin desert soil."}, {"id": "grama", "sp": "bouteloua gracilis", "xh": 0.2, "desc": "A short bunchgrass that dominates the desert grassland. Wikipedia lists blue grama among the common grasses of the park.", "badge": "Foundation species"}, {"id": "saltbush", "sp": "atriplex canescens", "xh": 0.5, "ic": "sage"}, {"id": "pricklypear", "sp": "opuntia polyacantha", "xh": 0.8, "desc": "A low, spiny cactus of the park's shrub steppe. Pronghorn diet studies list cacti as a notable food.", "ic": "sage"}, {"id": "ant", "sp": "pogonomyrmex rugosus", "xh": 0.08}, {"id": "kangrat", "sp": "dipodomys ordii", "xh": 0.24, "wiki": "Ord's kangaroo rat", "desc": "A nocturnal desert rodent that feeds mainly on seeds and can live without drinking water.", "ic": "vole"}, {"id": "pdog", "sp": "cynomys gunnisoni", "xh": 0.4, "wiki": "Gunnison's prairie dog", "badge": "Keystone grazer"}, {"id": "jackrabbit", "sp": "lepus californicus", "xh": 0.56, "desc": "A long-eared hare of open desert grassland that eats grasses and shrubs. Prey for nearly every predator here."}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.72, "wiki": "Pronghorn", "desc": "The fastest land mammal in North America. It eats forbs, shrubs, cacti and grasses, and is hunted by coyotes, bobcats and golden eagles.", "ic": "pronghorn"}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.88, "wiki": "Mule deer", "desc": "Browses shrubs and herbs. Wikipedia notes it visits the park's Painted Desert rim."}, {"id": "collared", "sp": "crotaphytus collaris", "xh": 0.1, "wiki": "Crotaphytus collaris", "desc": "The most common large lizard in the park. It hunts insects and smaller lizards from rocks."}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.28, "wiki": "Pituophis catenifer sayi", "desc": "A large constrictor common in the park. It eats rodents, rabbits and birds.", "ic": "snake"}, {"id": "raven", "sp": "corvus corax", "xh": 0.46, "desc": "The most-recorded bird near the park. An omnivore that scavenges carrion and takes small prey."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.64, "wiki": "Turkey vulture", "desc": "A soaring scavenger that locates carcasses by sight and smell and cleans up dead animals across the grassland."}, {"id": "redtail", "sp": "buteo jamaicensis", "xh": 0.82, "tl": 3, "wiki": "Red-tailed hawk", "desc": "A hawk that hunts rabbits, prairie dogs, rodents, reptiles and birds from perches over open ground.", "ic": "hawk"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.2, "wiki": "Coyote", "desc": "The park's top mammal predator. It hunts rabbits, rodents and pronghorn, and also scavenges carcasses."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.5, "wiki": "Bobcat", "desc": "A stealthy cat that hunts rabbits, rodents and birds, and sometimes larger prey such as pronghorn.", "ic": "lion"}, {"id": "goldeneagle", "sp": "aquila chrysaetos", "xh": 0.8, "desc": "The park's largest bird, with a wingspan up to about 7 feet. It hunts rabbits, prairie dogs and sometimes pronghorn."}], "raw": [["grama", "ant"], ["grama", "kangrat"], ["grama", "pdog"], ["grama", "jackrabbit"], ["grama", "pronghorn"], ["saltbush", "jackrabbit"], ["saltbush", "pronghorn"], ["saltbush", "muledeer"], ["saltbush", "kangrat"], ["pricklypear", "pronghorn"], ["ant", "collared"], ["kangrat", "bullsnake"], ["pdog", "redtail"], ["pdog", "coyote"], ["pdog", "bobcat"], ["pdog", "goldeneagle"], ["jackrabbit", "bullsnake"], ["jackrabbit", "redtail"], ["jackrabbit", "coyote"], ["jackrabbit", "bobcat"], ["jackrabbit", "goldeneagle"], ["pronghorn", "coyote"], ["pronghorn", "bobcat"], ["pronghorn", "goldeneagle"], ["muledeer", "coyote"], ["muledeer", "bobcat"], ["pronghorn", "vulture", "s"], ["jackrabbit", "vulture"], ["muledeer", "vulture", "s"], ["pronghorn", "raven", "s"], ["muledeer", "raven", "s"], ["collared", "redtail"], ["bullsnake", "redtail"], ["bullsnake", "raven"], ["bullsnake", "coyote"], ["sun", "grama", "r"], ["sun", "saltbush", "r"], ["sun", "pricklypear", "r"], ["rain", "grama", "r"], ["rain", "saltbush", "r"], ["rain", "pricklypear", "r"], ["soil", "grama", "r"], ["soil", "saltbush", "r"], ["soil", "pricklypear", "r"], ["decomp", "soil", "r"], ["grama", "decomp", "d"], ["saltbush", "decomp", "d"], ["pricklypear", "decomp", "d"], ["pdog", "decomp", "d"], ["pronghorn", "decomp", "d"], ["muledeer", "decomp", "d"], ["coyote", "decomp", "d"], ["bobcat", "decomp", "d"], ["goldeneagle", "decomp", "d"], ["jackrabbit", "decomp", "d"], ["vulture", "decomp", "d"], ["raven", "decomp", "d"], ["muledeer", "redtail"], ["raven", "coyote"], ["bullsnake", "bobcat"], ["kangrat", "goldeneagle"], ["muledeer", "goldeneagle"], ["bullsnake", "goldeneagle"], ["raven", "goldeneagle"], ["vulture", "goldeneagle"], ["redtail", "goldeneagle"]], "ev": {"grama>ant": ["a"], "grama>kangrat": ["a"], "grama>pdog": ["a"], "grama>jackrabbit": ["a"], "grama>pronghorn": ["a"], "saltbush>jackrabbit": ["a"], "saltbush>pronghorn": ["a"], "saltbush>muledeer": ["a"], "saltbush>kangrat": ["a"], "pricklypear>pronghorn": ["a"], "ant>collared": ["a"], "kangrat>bullsnake": ["g", "Pituophis catenifer", "Dipodomys ordii"], "pdog>redtail": ["g", "Buteo jamaicensis", "Cynomys gunnisoni"], "pdog>coyote": ["gg", "Canis latrans", "Cynomys gunnisoni"], "pdog>bobcat": ["gg", "Lynx rufus", "Cynomys gunnisoni"], "pdog>goldeneagle": ["g", "Aquila chrysaetos", "Cynomys gunnisoni"], "jackrabbit>bullsnake": ["g", "Pituophis catenifer", "Lepus californicus"], "jackrabbit>redtail": ["g", "Buteo jamaicensis", "Lepus californicus"], "jackrabbit>coyote": ["g", "Canis latrans", "Lepus californicus"], "jackrabbit>bobcat": ["g", "Lynx rufus", "Lepus californicus"], "jackrabbit>goldeneagle": ["g", "Aquila chrysaetos", "Lepus californicus"], "pronghorn>coyote": ["g", "Canis latrans", "Antilocapra americana"], "pronghorn>bobcat": ["g", "Lynx rufus", "Antilocapra americana"], "pronghorn>goldeneagle": ["g", "Aquila chrysaetos", "Antilocapra americana"], "muledeer>coyote": ["g", "Canis latrans", "Odocoileus hemionus"], "muledeer>bobcat": ["g", "Lynx rufus", "Odocoileus hemionus"], "pronghorn>vulture": ["a"], "jackrabbit>vulture": ["g", "Cathartes aura", "Lepus californicus"], "muledeer>vulture": ["g", "Cathartes aura", "Odocoileus hemionus"], "pronghorn>raven": ["a"], "muledeer>raven": ["gg", "Corvus corax", "Odocoileus hemionus"], "collared>redtail": ["g", "Buteo jamaicensis", "Crotaphytus collaris"], "bullsnake>redtail": ["g", "Buteo jamaicensis", "Pituophis catenifer"], "bullsnake>raven": ["g", "Corvus corax", "Pituophis catenifer"], "bullsnake>coyote": ["g", "Canis latrans", "Pituophis catenifer"], "muledeer>redtail": ["ga", "Buteo jamaicensis", "Odocoileus hemionus"], "raven>coyote": ["ga", "Canis latrans", "Corvus corax"], "bullsnake>bobcat": ["ga", "Lynx rufus", "Pituophis catenifer"], "kangrat>goldeneagle": ["ga", "Aquila chrysaetos", "Dipodomys ordii"], "muledeer>goldeneagle": ["ga", "Aquila chrysaetos", "Odocoileus hemionus"], "bullsnake>goldeneagle": ["ga", "Aquila chrysaetos", "Pituophis catenifer"], "raven>goldeneagle": ["ga", "Aquila chrysaetos", "Corvus corax"], "vulture>goldeneagle": ["ga", "Aquila chrysaetos", "Cathartes aura"], "redtail>goldeneagle": ["ga", "Aquila chrysaetos", "Buteo jamaicensis"]}, "story": "Petrified Forest National Park in northeastern Arizona covers about 346 square miles and is named for its petrified wood. Fallen trees from the Late Triassic, about 225 million years ago, lie in the colorful Chinle Formation. The north of the park reaches into the Painted Desert.", "matters": "More than 400 plant species, over 200 bird species, pronghorn, coyotes, bobcats and seven kinds of amphibians live here. It became a national monument in 1906 and a national park in 1962."}