{"id": "whgorongosa", "name": "Gorongosa National Park", "short": "Gorongosa", "place": "Mozambique", "lat": -18.8, "lon": 34.5, "side": "l", "cont": "Africa", "country": "Mozambique", "kind": "Grassland", "park": true, "blurb": "Floodplain savanna, lions and Lake Urema, recovering after civil war.", "tip": {"id": "lake", "title": "Shrink the floods", "text": "Lake Urema spreads over the floodplain each wet season. Lower the floods and watch the grasses, then hippos, waterbuck and the lions that hunt them."}, "sources": [{"title": "Wikipedia: Gorongosa National Park", "url": "https://en.wikipedia.org/wiki/Gorongosa_National_Park"}, {"title": "Wikipedia: Waterbuck", "url": "https://en.wikipedia.org/wiki/Waterbuck"}, {"title": "Wikipedia: Common hippopotamus", "url": "https://en.wikipedia.org/wiki/Common_hippopotamus"}, {"title": "Wikipedia: Blue wildebeest", "url": "https://en.wikipedia.org/wiki/Blue_wildebeest"}, {"title": "Wikipedia: Lion", "url": "https://en.wikipedia.org/wiki/Lion"}, {"title": "Wikipedia: Nile crocodile", "url": "https://en.wikipedia.org/wiki/Nile_crocodile"}, {"title": "Wikipedia: Hippopotamus", "url": "https://en.wikipedia.org/wiki/Hippopotamus"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Gorongosa National Park, Waterbuck, Hippopotamus). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Gorongosa National Park", "icon": "lion", "tier": "overview", "nodes": [{"id": "grass", "sp": "poaceae", "xh": 0.1, "desc": "Grasses of the valley floor and the Lake Urema floodplain, the main food of the park's grazers.", "badge": "Foundation species"}, {"id": "fever", "sp": "vachellia xanthophloea", "xh": 0.3}, {"id": "baobab", "sp": "adansonia digitata", "xh": 0.5}, {"id": "thorn", "sp": "ziziphus mucronata", "xh": 0.7}, {"id": "palm", "sp": "hyphaene coriacea", "xh": 0.9}, {"id": "waterbuck", "sp": "kobus ellipsiprymnus", "xh": 0.05}, {"id": "impala", "sp": "aepyceros melampus", "xh": 0.18, "desc": "A common antelope of savanna and woodland edges, and frequent prey for lions and wild dogs."}, {"id": "wildebeest", "sp": "connochaetes taurinus", "xh": 0.31, "desc": "A short-grass grazer that needs reliable water and is major prey for lions and crocodiles."}, {"id": "hippo", "sp": "hippopotamus amphibius", "xh": 0.44, "wiki": "Common hippopotamus", "desc": "Rests in water by day and grazes grass on land at night. Lions occasionally kill adults at Gorongosa.", "ic": "bison"}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.57, "wiki": "African elephant", "desc": "A huge browser and grazer. Records show it eating fruit of palms and baobab."}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.7, "desc": "A big grazing herd animal, taken by lions."}, {"id": "kudu", "sp": "tragelaphus strepsiceros", "xh": 0.82, "desc": "A browsing antelope that uses termite mounds for shade, according to the park article."}, {"id": "baboon", "sp": "papio ursinus", "xh": 0.94, "desc": "An omnivorous monkey that eats fruit and other foods."}, {"id": "wilddog", "sp": "lycaon pictus", "xh": 0.15, "desc": "A pack hunter lost during the war and brought back to the park in 2018 and 2019."}, {"id": "vulture", "sp": "gyps africanus", "xh": 0.4, "desc": "A scavenger that feeds on the carcasses of many large mammals."}, {"id": "marabou", "sp": "leptoptilos crumenifer", "xh": 0.65}, {"id": "lion", "sp": "panthera leo", "xh": 0.3, "name": "African lion", "desc": "The top predator, one of the few large mammals that survived the war. Hunts wildebeest, buffalo, waterbuck and more."}, {"id": "croc", "sp": "crocodylus niloticus", "xh": 0.7, "desc": "An ambush predator of animals drinking at the water, and a heavy scavenger of carcasses."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Warm, bright conditions all year let grass and trees grow quickly once water arrives."}, {"id": "rain", "sp": "seasonal rains", "xh": 0.3, "desc": "Wet-season rain feeds the floodplain and the rivers that fill Lake Urema."}, {"id": "lake", "sp": "lake urema floods", "xh": 0.5}, {"id": "soil", "sp": "floodplain soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Dung beetles & fungi", "wiki": "Dung beetle", "desc": "Dung beetles are recorded in the park. With fungi they break down dung and carcasses and return nutrients to the soil."}], "raw": [["sun", "grass", "r"], ["sun", "fever", "r"], ["sun", "baobab", "r"], ["sun", "thorn", "r"], ["sun", "palm", "r"], ["rain", "grass", "r"], ["rain", "fever", "r"], ["rain", "baobab", "r"], ["rain", "thorn", "r"], ["rain", "palm", "r"], ["lake", "grass", "r"], ["lake", "fever", "r"], ["lake", "thorn", "r"], ["lake", "palm", "r"], ["soil", "grass", "r"], ["soil", "fever", "r"], ["soil", "baobab", "r"], ["soil", "thorn", "r"], ["soil", "palm", "r"], ["decomp", "soil", "r"], ["grass", "waterbuck"], ["grass", "impala"], ["grass", "wildebeest"], ["grass", "hippo"], ["grass", "buffalo"], ["grass", "elephant"], ["grass", "baboon"], ["thorn", "impala"], ["thorn", "kudu"], ["thorn", "baboon"], ["fever", "kudu"], ["palm", "elephant"], ["baobab", "elephant"], ["thorn", "waterbuck"], ["waterbuck", "lion"], ["impala", "lion"], ["wildebeest", "lion"], ["buffalo", "lion"], ["kudu", "lion"], ["baboon", "lion"], ["hippo", "lion"], ["impala", "wilddog"], ["waterbuck", "wilddog"], ["wildebeest", "wilddog"], ["kudu", "wilddog"], ["waterbuck", "croc"], ["wildebeest", "croc"], ["hippo", "croc"], ["wildebeest", "vulture"], ["wildebeest", "marabou"], ["impala", "vulture"], ["impala", "marabou"], ["waterbuck", "vulture"], ["waterbuck", "marabou"], ["hippo", "vulture"], ["hippo", "marabou"], ["elephant", "vulture"], ["elephant", "marabou"], ["kudu", "vulture"], ["kudu", "marabou"], ["grass", "decomp", "d"], ["fever", "decomp", "d"], ["baobab"