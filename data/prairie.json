{"id": "prairie", "name": "Missouri Tallgrass Prairie", "short": "Missouri Prairie", "place": "Missouri, USA", "lat": 37.5, "lon": -94.6, "side": "l", "blurb": "Bluestem, prairie-chickens and the fire that keeps the grassland open.", "tip": {"id": "fire", "title": "Take away fire", "text": "Fire clears dead growth and stops trees taking over. Set Fire to -100% and watch the grasses, then the animals that depend on them."}, "sources": [{"title": "Missouri Dept. of Conservation field guide: big bluestem", "url": "https://mdc.mo.gov/discover-nature/field-guide/big-bluestem"}, {"title": "Wikipedia: Tallgrass prairie", "url": "https://en.wikipedia.org/wiki/Tallgrass_prairie"}, {"title": "Wikipedia: Greater prairie chicken", "url": "https://en.wikipedia.org/wiki/Greater_prairie_chicken"}, {"title": "Wikipedia: American badger", "url": "https://en.wikipedia.org/wiki/American_badger"}], "notes": "Feeding links were checked against the sources listed where they state them. Where the sources are silent, links come from general ecological knowledge and are illustrative. The sources are thin on predator and prey details for the prairie, so the links for predators lean most on general knowledge. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "nodes": [{"id": "bluestem", "sp": "andropogon gerardi", "xh": 0.1}, {"id": "indian", "sp": "sorghastrum nutans, panicum virgatum", "xh": 0.26}, {"id": "little", "sp": "schizachyrium scoparium", "xh": 0.42}, {"id": "forbs", "sp": "echinacea, silphium and others", "xh": 0.6}, {"id": "milkweed", "sp": "asclepias spp.", "xh": 0.78}, {"id": "bison", "sp": "bison bison", "xh": 0.05, "desc": "The MDC says historically vast herds disturbed the prairie in ways that helped maintain it. Today only small managed herds remain."}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.17, "wiki": "White-tailed deer", "desc": "Browses wildflowers and young plants. Wikipedia notes its droppings spread nutrients that support plant diversity."}, {"id": "hopper", "sp": "acrididae", "xh": 0.28, "desc": "Chew grasses and wildflowers all summer and feed birds, badgers and many other predators."}, {"id": "regal", "sp": "speyeria idalia", "xh": 0.38}, {"id": "cottontail", "sp": "sylvilagus floridanus", "xh": 0.48, "wiki": "Eastern cottontail", "desc": "Eats grasses and wildflowers and is prey for hawks, coyotes and bobcats.", "ic": "vole"}, {"id": "vole", "sp": "microtus ochrogaster", "xh": 0.58, "wiki": "Prairie vole", "desc": "A small grass-eating rodent and a staple for hawks, harriers, coyotes and badgers.", "ic": "vole"}, {"id": "gsq", "sp": "ictidomys tridecemlineatus", "xh": 0.69, "wiki": "Thirteen-lined ground squirrel"}, {"id": "chicken", "sp": "tympanuchus cupido", "xh": 0.8}, {"id": "dickcissel", "sp": "spiza americana", "xh": 0.14}, {"id": "henslow", "sp": "centronyx henslowii", "xh": 0.27}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.45, "tl": 3, "wiki": "Red-tailed hawk", "desc": "Hunts voles, ground squirrels, rabbits and birds from perches over open ground.", "ic": "hawk"}, {"id": "harrier", "sp": "circus hudsonius", "xh": 0.6}, {"id": "badger", "sp": "taxidea taxus", "xh": 0.75, "wiki": "American badger", "desc": "Digs out ground squirrels, pocket gophers and other rodents. Wikipedia lists snakes, ground-nesting birds and insects as other prey.", "ic": "fox"}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.89, "tl": 3, "wiki": "Bobcat", "desc": "Ambushes rabbits, rodents, birds and young deer along woodland edges.", "ic": "lion"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.5, "wiki": "Coyote", "desc": "Today's top predator of the prairie. Eats rabbits, rodents, birds and fawns."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Warm-season grasses grow fastest in summer heat."}, {"id": "rain", "sp": "rainfall", "xh": 0.3, "desc": "Rain falls mostly in spring and early summer and sets how tall the grass grows."}, {"id": "fire", "sp": "fire", "xh": 0.5, "wiki": "Controlled burn", "desc": "Fire clears dead growth and keeps trees from taking over. Wikipedia and the MDC both describe prairies as fire-adapted."}, {"id": "soil", "sp": "deep prairie soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, earthworms & bacteria", "desc": "Break down dead grass and dung and return nutrients to the soil."}], "raw": [["sun", "bluestem", "r"], ["sun", "indian", "r"], ["sun", "little", "r"], ["sun", "forbs", "r"], ["sun", "milkweed", "r"], ["rain", "bluestem", "r"], ["rain", "indian", "r"], ["rain", "little", "r"], ["rain", "forbs", "r"], ["rain", "milkweed", "r"], ["fire", "bluestem", "r"], ["fire", "indian", "r"], ["fire", "little", "r"], ["fire", "forbs", "r"], ["fire", "milkweed", "r"], ["soil", "bluestem", "r"], ["soil", "indian", "r"], ["soil", "little", "r"], ["soil", "forbs", "r"], ["soil", "milkweed", "r"], ["decomp", "soil", "r"], ["bluestem", "bison"], ["bluestem", "deer"], ["bluestem", "hopper"], ["bluestem", "cottontail"], ["bluestem", "vole"], ["bluestem", "chicken"], ["indian", "bison"], ["indian", "hopper"], ["indian", "cottontail"], ["indian", "vole"], ["indian", "chicken"], ["little", "bison"], ["little", "hopper"], ["little", "vole"], ["little", "cottontail"], ["forbs", "deer"], ["forbs", "regal"], ["forbs", "cottontail"], ["forbs", "hopper"], ["forbs", "chicken"], ["forbs", "gsq"], ["milkweed", "regal"], ["hopper", "dickcissel"], ["hopper", "henslow"], ["hopper", "chicken"], ["hopper", "gsq"], ["cottontail", "hawk"], ["cottontail", "coyote"], ["cottontail", "bobcat"], ["vole", "hawk"], ["vole", "harrier"], ["vole", "coyote"], ["vole", "bobcat"], ["vole", "badger"], ["gsq", "hawk"], ["gsq", "badger"], ["gsq", "coyote"], ["chicken", "hawk"], ["chicken", "harrier"], ["chicken", "coyote"], ["chicken", "bobcat"], ["dickcissel", "harrier"], ["henslow", "harrier"], ["deer", "coyote"], ["deer", "bo