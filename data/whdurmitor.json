 "nodes": [
  {
   "id": "sun",
   "name": "Sun and altitude",
   "latin": "",
   "tl": 0,
   "xh": 0.08,
   "wiki": "Sun",
   "desc": "Short alpine summers and cold winters set the growing season, from about 450 m in the canyons to over 2,500 m on the peaks.",
   "ic": "sun",
   "cat": "abiotic"
  },
  {
   "id": "rain",
   "name": "Rain and snowmelt",
   "latin": "",
   "tl": 0,
   "xh": 0.24,
   "wiki": "Karst",
   "desc": "Water sinks quickly into the limestone, and underground rivers drain some of the glacial lakes, so streams and lakes matter more than the dry slopes suggest.",
   "ic": "rain",
   "cat": "abiotic"
  },
  {
   "id": "snow",
   "name": "Winter snow and ice",
   "latin": "",
   "tl": 0,
   "xh": 0.42,
   "wiki": "Durmitor",
   "desc": "Snow lies long on the high massif and pushes chamois and other animals down to forest in winter. A relict ice cave records past glaciation.",
   "ic": "ice",
   "cat": "abiotic"
  },
  {
   "id": "soil",
   "name": "Limestone soil and nutrients",
   "latin": "",
   "tl": 0,
   "xh": 0.6,
   "wiki": "Karst",
   "desc": "Thin soils over Dinaric limestone hold the nutrients that alpine meadows, bogs and forests draw on.",
   "ic": "soil",
   "cat": "abiotic"
  },
  {
   "id": "decomp",
   "name": "Decomposers",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.84,
   "wiki": "Decomposer",
   "desc": "Fungi, bacteria and soil invertebrates break down needles, leaves and carcasses and return nutrients to the thin karst soil.",
   "ic": "decomp",
   "cat": "decomp"
  },
  {
   "id": "blackpine",
   "name": "European black pine",
   "latin": "Pinus nigra",
   "tl": 1,
   "xh": 0.12,
   "wiki": "Pinus nigra",
   "desc": "Dense forests cover much of the park, including old stands with trees about 400 years old and over 50 m tall. Chamois eat conifers in winter.",
   "ic": "whitebark",
   "badge": "Foundation species"
  },
  {
   "id": "beech",
   "name": "European beech",
   "latin": "Fagus sylvatica",
   "tl": 1,
   "xh": 0.36,
   "wiki": "Fagus sylvatica",
   "desc": "Broadleaf forest tree of the lower slopes. Its leaves, nuts and litter feed deer, bears and the wider forest floor.",
   "ic": "aspen"
  },
  {
   "id": "bilberry",
   "name": "Bilberry",
   "latin": "Vaccinium myrtillus",
   "tl": 1,
   "xh": 0.6,
   "wiki": "Bilberry",
   "desc": "A low forest and subalpine shrub whose berries and shoots are eaten by roe deer, birds, foxes and bears.",
   "ic": "sage"
  },
  {
   "id": "herbs",
   "name": "Gentians and meadow herbs",
   "latin": "Gentiana",
   "tl": 1,
   "xh": 0.84,
   "wiki": "Gentiana",
   "desc": "Alpine and karst grasslands hold some 700 vascular plants in the park, including many gentians, with rare and endemic species. They are summer forage for chamois.",
   "ic": "sage"
  },
  {
   "id": "snowvole",
   "name": "Balkan snow vole",
   "latin": "Dinaromys bogdanovi",
   "tl": 2,
   "xh": 0.08,
   "wiki": "Balkan snow vole",
   "desc": "A rock-dwelling rodent of the Dinaric mountains that eats plants. Small mammals like this feed foxes, eagles and bears.",
   "ic": "vole"
  },
  {
   "id": "grasshopper",
   "name": "Bow-winged grasshopper",
   "latin": "Chorthippus biguttulus",
   "tl": 2,
   "xh": 0.24,
   "wiki": "Chorthippus biguttulus",
   "desc": "A very common grassland grasshopper, a main summer food for choughs and other insect eaters.",
   "ic": "hopper"
  },
  {
   "id": "chamois",
   "name": "Chamois",
   "latin": "Rupicapra rupicapra",
   "tl": 2,
   "xh": 0.42,
   "wiki": "Chamois",
   "desc": "Eats alpine grasses and herbs in summer and conifers in winter, moving down to pine forest. A main prey of wolves and a regular carrion source.",
   "ic": "quad",
   "badge": "Keystone grazer"
  },
  {
   "id": "roe",
   "name": "Roe deer",
   "latin": "Capreolus capreolus",
   "tl": 2,
   "xh": 0.6,
   "wiki": "Roe deer",
   "desc": "A forest and edge browser that eats beech and bilberry. Prey for wolves and bears.",
   "ic": "muledeer"
  },
  {
   "id": "chough",
   "name": "Alpine chough",
   "latin": "Pyrrhocorax graculus",
   "tl": 2,
   "xh": 0.78,
   "wiki": "Alpine chough",
   "desc": "Cliff-nesting crow that eats insects in summer and berries in colder months. Golden eagles and ravens take choughs or their young.",
   "ic": "raven"
  },
  {
   "id": "mayfly",
   "name": "Stream insect larvae",
   "latin": "Ephemeroptera",
   "tl": 2,
   "xh": 0.93,
   "wiki": "Mayfly",
   "desc": "Mayfly and other insect larvae live in the cold, fast Tara and mountain streams. They feed fish and other stream animals.",
   "ic": "mayfly"
  },
  {
   "id": "trout",
   "name": "Brown trout",
   "latin": "Salmo trutta",
   "tl": 3,
   "xh": 0.1,
   "wiki": "Brown trout",
   "desc": "A fish of cold, clear mountain rivers and lakes that eats aquatic insects and smaller fish. Prey for otters.",
   "ic": "trout"
  },
  {
   "id": "otter",
   "name": "Eurasian otter",
   "latin": "Lutra lutra",
   "tl": 3,
   "xh": 0.28,
   "wiki": "Eurasian otter",
   "desc": "Lives along unpolluted rivers and lakes. Fish are its main food, with amphibians and invertebrates added. Its presence signals a healthy river.",
   "ic": "otter"
  },
  {
   "id": "fox",
   "name": "Red fox",
   "latin": "Vulpes vulpes",
   "tl": 3,
   "xh": 0.48,
   "wiki": "Red fox",
   "desc": "A flexible hunter and scavenger that takes small mammals, birds, insects and berries, and feeds on carrion.",
   "ic": "fox"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.68,
   "wiki": "Common raven",
   "desc": "A scavenger at carcasses that also robs chough nests of nestlings.",
   "ic": "raven"
  },
  {
   "id": "griffon",
   "name": "Griffon vulture",
   "latin": "Gyps fulvus",
   "tl": 3,
   "xh": 0.88,
   "wiki": "Griffon vulture",
   "desc": "A large scavenger of mountain carcasses, recorded often around the massif.",
   "ic": "hawk"
  },
  {
   "id": "bear",
   "name": "Brown bear",
   "latin": "Ursus arctos",
   "tl": 4,
   "xh": 0.2,
   "wiki": "Brown bear",
   "desc": "Mostly a plant eater, taking berries, nuts, roots and insects, but also hunting young or weak ungulates and using carrion. Wolves and bears contest kills.",
   "ic": "grizzly"
  },
  {
   "id": "wolf",
   "name": "Grey wolf",
   "latin": "Canis lupus",
   "tl": 4,
   "xh": 0.5,
   "wiki": "Wolf",
   "desc": "A top predator that hunts chamois and deer. The presence of large predators such as wolf and bear is read as a sign of ecological integrity here.",
   "ic": "wolf",
   "badge": "Keystone predator"
  },
  {
   "id": "eagle",
   "name": "Golden eagle",
   "latin": "Aquila chrysaetos",
   "tl": 4,
   "xh": 0.8,
   "wiki": "Golden eagle",
   "desc": "A cliff-nesting raptor of the high massif that hunts birds and small mammals, including choughs.",
   "ic": "goldeneagle"
  }
 ],
