{"id": "xpalestine", "name": "Judean Desert and Wadi Qelt", "short": "Judean Desert", "place": "Palestine", "lat": 31.8, "lon": 35.4, "side": "r", "cont": "Asia", "country": "Palestine", "kind": "Desert", "park": true, "blurb": "Cliffs, springs and rain shadow: gazelles, ibex, hyrax and their wolves and vultures.", "tip": {"id": "oat", "title": "Fail the winter rains", "text": "The annual plants sprout only after winter rain. Set Winter rain and rain shadow to -100% and watch wild oat, then gazelle, ibex and hare, and the wolf that hunts them."}, "sources": [{"title": "Wikipedia: Judaean Desert", "url": "https://en.wikipedia.org/wiki/Judaean_Desert"}, {"title": "Wikipedia: Wadi Qelt", "url": "https://en.wikipedia.org/wiki/Wadi_Qelt"}, {"title": "Wikipedia: Nubian ibex", "url": "https://en.wikipedia.org/wiki/Nubian_ibex"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Wadi Qelt", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight and heat", "xh": 0.1, "desc": "Strong sun and high temperatures drive the desert, drying the ground and limiting growth to winter and spring."}, {"id": "rain", "sp": "winter rain and rain shadow", "xh": 0.35}, {"id": "springs", "sp": "perennial springs", "xh": 0.6}, {"id": "soil", "sp": "desert soil and nutrients", "xh": 0.8}, {"id": "decomp", "sp": "decomposer community", "xh": 0.93, "name": "Soil microbes and fungi", "desc": "Break down dead plants and carcasses, returning nutrients to the thin desert soil."}, {"id": "oat", "sp": "avena sterilis", "xh": 0.15}, {"id": "orache", "sp": "atriplex halimus", "xh": 0.5}, {"id": "fig", "sp": "ficus carica", "xh": 0.85}, {"id": "gazelle", "sp": "gazella gazella", "xh": 0.1, "wiki": "Gazella gazella", "desc": "A graceful gazelle of hills and wadis in the Levant that grazes and browses on grasses, herbs and shrubs; it is the most recorded large mammal near the site.", "ic": "quad"}, {"id": "ibex", "sp": "capra nubiana", "xh": 0.28, "desc": "A wild goat of the cliffs that feeds mainly on grasses and leaves; it is common along the Dead Sea cliffs and in the Judean Desert."}, {"id": "hyrax", "sp": "procavia capensis", "xh": 0.46, "desc": "A rock-dwelling herbivore of the cliffs and wadi walls that lives in colonies and eats plant matter."}, {"id": "hare", "sp": "lepus capensis", "xh": 0.64}, {"id": "mouse", "sp": "acomys dimidiatus", "xh": 0.8}, {"id": "chukar", "sp": "alectoris chukar", "xh": 0.94, "desc": "A ground-dwelling partridge of rocky slopes that eats seeds and shoots; it is a staple prey of eagles and foxes."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.15, "wiki": "Red fox", "desc": "An adaptable small predator and scavenger that eats hares, birds, rodents, reptiles and fruit such as figs."}, {"id": "jackal", "sp": "canis aureus", "xh": 0.4, "desc": "An omnivorous canid that takes small prey and fruit and scavenges carrion around wadis and settlements."}, {"id": "hyena", "sp": "hyaena hyaena", "xh": 0.65, "desc": "A nocturnal scavenger of desert and rocky hills that feeds mostly on carrion, with some small prey."}, {"id": "vulture", "sp": "gyps fulvus", "xh": 0.88, "desc": "A large scavenging bird that breeds on cliffs and feeds on carcasses; it is noted as a breeding species of Wadi Qelt."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "name": "Arabian wolf", "wiki": "Arabian wolf", "desc": "A small desert wolf that hunts gazelles, ibex and hares and scavenges; it is among the region top predators now that leopards have gone."}, {"id": "eagle", "sp": "aquila fasciata", "xh": 0.7, "desc": "A cliff-nesting eagle recorded at Wadi Qelt that hunts partridges, hares and other medium-sized prey."}], "raw": [["sun", "oat", "r"], ["soil", "oat", "r"], ["sun", "orache", "r"], ["soil", "orache", "r"], ["sun",