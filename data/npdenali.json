es caribou, moose and ground squirrels, and scavenges carcasses."}, {"id": "sun", "sp": "summer sunlight", "xh": 0.1}, {"id": "snow", "sp": "snowpack and meltwater", "xh": 0.3}, {"id": "perma", "sp": "permafrost", "xh": 0.5}, {"id": "soil", "sp": "thin tundra soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & bacteria", "desc": "Break down dead plants, dung and carcasses slowly in the cold, returning nutrients to the soil."}], "raw": [["sun", "lichen", "r"], ["sun", "crowberry", "r"], ["sun", "bilberry", "r"], ["sun", "willow", "r"], ["sun", "fireweed", "r"], ["snow", "willow", "r"], ["perma", "willow", "r"], ["snow", "crowberry", "r"], ["perma", "crowberry", "r"], ["snow", "bilberry", "r"], ["perma", "bilberry", "r"], ["soil", "crowberry", "r"], ["soil", "bilberry", "r"], ["soil", "willow", "r"], ["soil", "fireweed", "r"], ["decomp", "soil", "r"], ["lichen", "caribou"], ["crowberry", "caribou"], ["bilberry", "caribou"], ["willow", "moose"], ["willow", "sheep"], ["lichen", "sheep"], ["willow", "squirrel"], ["bilberry", "squirrel"], ["willow", "hare"], ["willow", "ptarmigan"], ["crowberry", "ptarmigan"], ["bilberry", "ptarmigan"], ["fireweed", "bee"], ["bilberry", "grizzly"], ["willow", "grizzly"], ["bilberry", "raven"], ["bilberry", "fox"], ["caribou", "wolf"], ["moose", "wolf"], ["sheep", "wolf"], ["hare", "wolf"], ["ptarmigan", "wolf"], ["caribou", "grizzly"], ["moose", "grizzly"], ["squirrel", "grizzly"], ["ptarmigan", "grizzly"], ["squirrel", "fox"], ["hare", "fox"], ["ptarmigan", "fox"], ["hare", "lynx"], ["ptarmigan", "lynx"], ["squirrel", "eagle"], ["hare", "eagle"], ["ptarmigan", "eagle"], ["sheep", "eagle"], ["caribou", "raven", "s"], ["moose", "raven", "s"], ["caribou", "eagle", "s"], ["moose", "grizzly", "s"], ["caribou", "grizzly", "s"], ["lichen", "decomp", "d"], ["crowberry", "decomp", "d"], ["bilberry", "decomp", "d"], ["willow", "decomp", "d"], ["fireweed", "decomp", "d"], ["caribou", "decomp", "d"], ["moose