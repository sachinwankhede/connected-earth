{"id": "xbulgaria", "name": "Pirin National Park", "short": "Pirin", "place": "Bulgaria", "lat": 41.7, "lon": 23.4, "side": "r", "cont": "Europe", "country": "Bulgaria", "blurb": "Ancient pines, glacial lakes and chamois on the rock above southwest Bulgaria.", "tip": {"id": "meadow", "title": "Fade the alpine meadows", "text": "The high meadows feed chamois and snow voles. Remove them and watch the grazers, then the wolf, bear and golden eagle that depend on them."}, "sources": [{"title": "Wikipedia: Pirin National Park", "url": "https://en.wikipedia.org/wiki/Pirin_National_Park"}, {"title": "Wikipedia: Balkan chamois", "url": "https://en.wikipedia.org/wiki/Balkan_chamois"}, {"title": "Wikipedia: Pinus heldreichii", "url": "https://en.wikipedia.org/wiki/Pinus_heldreichii"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}, {"title": "Wikipedia: Wolf", "url": "https://en.wikipedia.org/wiki/Wolf"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Pirin National Park", "icon": "ice", "tier": "overview", "kind": "Polar & mountain", "park": true, "nodes": [{"id": "bosnian", "sp": "pinus heldreichii", "xh": 0.12}, {"id": "macedonian", "sp": "pinus peuce", "xh": 0.34}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.56, "desc": "A low berry shrub of mountain forest floors and clearings, whose fruit is eaten by birds and mammals."}, {"id": "meadow", "sp": "festuca", "xh": 0.8, "name": "Alpine grasses and herbs", "desc": "The high meadows above the tree line, where the park's 1,315 plant species include many endemics. Chamois graze them in summer."}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.08, "name": "Balkan chamois", "wiki": "Balkan chamois", "desc": "A sure-footed goat-antelope of steep rock. It grazes alpine herbs in summer and shifts to conifers in winter, and is among the park's most valued mammals.", "badge": "Keystone grazer"}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.24, "name": "Roe deer", "wiki": "Roe deer", "desc": "A small woodland deer that browses leaves, shoots and berries in the park's forests."}, {"id": "reddeer", "sp": "cervus elaphus", "xh": 0.4, "name": "Red deer", "wiki": "Red deer", "desc": "A large grazer and browser of forest and meadow, listed among the park's mammals of highest conservation value.", "ic": "elk"}, {"id": "snowvole", "sp": "chionomys nivalis", "xh": 0.56, "desc": "A small rodent of rocky alpine slopes that feeds on plants. It is common prey for birds of prey and small carnivores."}, {"id": "squirrel", "sp": "sciurus vulgaris", "xh": 0.72, "desc": "A tree-living rodent that feeds largely on conifer seeds and cones, and is recorded in the park area."}, {"id": "nutcracker", "sp": "nucifraga caryocatactes", "xh": 0.88, "desc": "A mountain-forest crow that feeds on pine seeds and hoards them, helping spread conifers."}, {"id": "marten", "sp": "martes foina", "xh": 0.22, "wiki": "Stone marten"}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.5, "desc": "A widespread raptor that hunts small mammals such as voles, and also takes birds and reptiles."}, {"id": "raven", "sp": "corvus corax", "xh": 0.78, "desc": "A clever scavenger that feeds on carcasses left by larger predators, as well as on small prey."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.16, "wiki": "Wolf", "desc": "A pack hunter that across Eurasia takes mainly red deer, roe deer and wild boar, and is on the park's species list."}, {"id": "bear", "sp": "ursus arctos", "xh": 0.5, "desc": "An omnivore that gets most of its energy from plants such as berries and pine cones, and also eats carrion and some prey. Bulgaria holds several hundred."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.84, "desc": "A powerful raptor with only a few breeding pairs in the park; chamois are among its possible prey."}, {"id": "snow", "sp": "snow", "xh": 0.15, "name": "Snow cover", "desc": "Snow lies about 120 to 160 days a year at high elevation, feeding the meadows and lakes with meltwater."}, {"id": "sun", "sp": "sunlight", "xh": 0.4, "latin": "Sunlight", "wiki": "Sunlight", "desc": "Energy for all plant growth, strongest on the open alpine slopes."}, {"id": "water", "sp": "glacial lake", "xh": 0.65}, {"id": "soil", "sp": "soil", "xh": 0.88, "name": "Mountain soil", "desc": "Thin soils and decayed matter supply nutrients to forests and meadows."}, {"id": "decomp", "sp": "fungi and bacteria", "xh": 0.6, "desc": "Fungi, bacteria and soil invertebrates break down dead wood, needles and carcasses and return nutrients to the soil."}], "raw": [["sun", "bosnian", "r"], ["sun", "macedonian", "r"], ["sun", "bilberry", "r"], ["sun", "meadow", "r"], ["snow", "meadow", "r"], ["snow", "bilberry", "r"], ["water", "meadow", "r"], ["soil", "bosnian", "r"], ["soil", "macedonian", "r"], ["decomp", "soil", "r"], ["bosnian", "decomp", "d"], ["macedonian", "decomp", "d"], ["bilberry", "decomp", "d"], ["meadow", "decomp", "d"], ["chamois", "decomp", "d"], ["reddeer", "decomp", "d"], ["meadow", "chamois"], ["bosnian", "chamois"], ["macedonian", "chamois"], ["meadow", "reddeer"], ["meadow", "roe"], ["bilberry", "roe"], ["meadow", "snowvole"], ["bosnian", "squirrel"], ["macedonian", "squirrel"], ["bosnian", "nutcracker"], ["macedonian", "nutcracker"], ["squirrel", "marten"], ["snowvole", "buzzard"], ["squirrel", "buzzard"], ["nutcracker", "buzzard"], ["chamois", "wolf"], ["roe", "wolf"], ["reddeer", "wolf"], ["bilberry", "bear"], ["macedonian", "bear"], ["meadow", "bear"], ["chamois", "raven", "s"], ["reddeer", "raven", "s"], ["chamois", "bear", "s"], ["reddeer", "bear", "s"], ["chamois", "eagle"], ["snowvole", "eagle"], ["snowvole", "raven"], ["bilberry", "reddeer"], ["reddeer", "marten"], ["roe", "buzzard"], ["bilberry", "raven"], ["roe", "raven"