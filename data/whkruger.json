{"id": "whkruger", "name": "Kruger National Park", "short": "Kruger", "place": "South Africa", "lat": -23.9, "lon": 31.6, "side": "r", "cont": "Africa", "country": "South Africa", "kind": "Grassland", "park": true, "blurb": "Elephants, lions and the grass and mopane that feed the lowveld.", "tip": {"id": "elephant", "title": "Thin the elephants", "text": "Select African bush elephants and lower their numbers. Watch the mopane, knobthorn and marula trees, then the browsers and predators that share them."}, "sources": [{"title": "Wikipedia: Kruger National Park", "url": "https://en.wikipedia.org/wiki/Kruger_National_Park"}, {"title": "Wikipedia: African bush elephant", "url": "https://en.wikipedia.org/wiki/African_bush_elephant"}, {"title": "Wikipedia: Impala", "url": "https://en.wikipedia.org/wiki/Impala"}, {"title": "Wikipedia: Colophospermum mopane", "url": "https://en.wikipedia.org/wiki/Colophospermum_mopane"}, {"title": "Wikipedia: White-backed vulture", "url": "https://en.wikipedia.org/wiki/White-backed_vulture"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Kruger National Park", "icon": "elephant", "tier": "overview", "nodes": [{"id": "redgrass", "sp": "themeda triandra", "xh": 0.2, "desc": "A tall grass of the open grazing lands that zebra, wildebeest, buffalo and impala all feed on.", "badge": "Foundation species"}, {"id": "mopane", "sp": "colophospermum mopane", "xh": 0.42, "desc": "The dominant tree across the northern park. Elephants, giraffes and antelope browse its leaves, and the mopane worm caterpillar feeds on it."}, {"id": "knobthorn", "sp": "senegalia nigrescens", "xh": 0.64}, {"id": "marula", "sp": "sclerocarya birrea", "xh": 0.84}, {"id": "impala", "sp": "aepyceros melampus", "xh": 0.08, "desc": "The most numerous large mammal in the park. It grazes after the rains and browses woody plants in the dry season, and is prey for most large carnivores.", "ic": "muledeer"}, {"id": "zebra", "sp": "equus quagga", "xh": 0.2, "desc": "Grazes grasses on the open plains and is common prey for lions, hyenas and wild dogs."}, {"id": "wildebeest", "sp": "connochaetes taurinus", "xh": 0.32, "desc": "A grazing antelope of the open grasslands, hunted by lions, hyenas, leopards and wild dogs.", "ic": "quad"}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.44, "desc": "Forms large herds on the grazing lands and is a main prey of lions."}, {"id": "giraffe", "sp": "giraffa giraffa", "xh": 0.56, "name": "Giraffe", "wiki": "Giraffe", "desc": "Browses the leaves of tall trees such as knobthorn and mopane, reaching food other herbivores cannot."}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.72, "name": "African bush elephant", "desc": "A mixed feeder on grass, leaves, bark and fruit. Its feeding opens up thickets and riverside forest, and calves are sometimes taken by lions."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.15, "desc": "Hunts in clans and also scavenges. It eats a wide range of prey, from impala to buffalo, and often feeds on lion kills."}, {"id": "wilddog", "sp": "lycaon pictus", "xh": 0.4, "desc": "A pack-hunting predator of antelope and zebra. Its packs are endangered in South Africa.", "ic": "wolf"}, {"id": "vulture", "sp": "gyps africanus", "xh": 0.65, "desc": "A scavenger that feeds on the soft tissue of carcasses and is among the first vultures to reach one. It is critically endangered, in part from poisoned carcasses."}, {"id": "bateleur", "sp": "terathopius ecaudatus", "xh": 0.88, "desc": "A soaring eagle that takes live prey and also feeds on carrion."}, {"id": "lion", "sp": "panthera leo", "xh": 0.3, "desc": "The top predator of the park, hunting zebra, wildebeest, buffalo, giraffe and impala. Its kills feed hyenas and vultures."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.7, "desc": "A solitary ambush predator that takes impala, wildebeest, zebra and other medium prey."}, {"id": "rain", "sp": "summer rains", "xh": 0.12, "desc": "Falls mostly from September to May and sets the pace of grass and leaf growth."}, {"id": "rivers", "sp": "rivers", "xh": 0.34}, {"id": "fire", "sp": "fire", "xh": 0.56, "desc": "Savanna fires clear dead grass and let fresh growth sprout for grazers."}, {"id": "soil", "sp": "soils and geology", "xh": 0.76}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Termites, dung beetles & fungi", "wiki": "Dung beetle", "desc": "Break down dung, carcasses and dead plants and return nutrients to the soil."}], "raw": [["rain", "redgrass", "r"], ["rain", "mopane", "r"], ["rain", "knobthorn", "r"], ["rain", "marula", "r"], ["rivers", "knobthorn", "r"], ["rivers", "marula", "r"], ["soil", "redgrass", "r"], ["soil", "mopane", "r"], ["soil", "knobthorn", "r"], ["fire", "redgrass", "r"], ["decomp", "soil", "r"], ["redgrass", "impala"], ["redgrass", "zebra"], ["redgrass", "wildebeest"], ["redgrass", "buffalo"], ["redgrass", "elephant"], ["mopane", "impala"], ["mopane", "giraffe"], ["mopane", "elephant"], ["knobthorn", "impala"], ["knobthorn", "giraffe"], ["knobthorn", "elephant"], ["marula", "giraffe"], ["marula", "elephant"], ["impala", "lion"], ["impala", "leopard"], ["impala", "hyena"], ["impala", "wilddog"], ["zebra", "lion"], ["zebra", "leopard"], ["zebra", "hyena"], ["zebra", "wilddog"], ["wildebeest", "lion"], ["wildebeest", "leopard"], ["wildebeest", "hyena"], ["wildebeest", "wilddog"], ["buffalo", "lion"], ["buffalo", "hyena"], ["giraffe", "lion"], ["giraffe", "hyena"], ["elephant", "lion"], ["elephant", "hyena"], ["impala", "bateleur", "s"], ["wildebeest", "bateleur", "s"], ["impala", "vulture", "s"], ["zebra", "vulture", "s"], ["wildebeest", "vulture", "s"], ["buffalo", "vulture", "s"], ["giraffe", "vulture", "s"], ["elephant", "vulture", "s"], ["lion", "hyena", "s"], ["lion", "vu