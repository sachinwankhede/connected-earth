{"id": "whranthambore", "name": "Ranthambore National Park", "short": "Ranthambore", "place": "Rajasthan, India", "lat": 26.0, "lon": 76.5, "side": "r", "cont": "Asia", "country": "India", "kind": "Forest", "park": true, "blurb": "Dry-forest tigers, sambar and chital around ancient lakes and a hilltop fort.", "tip": {"id": "chital", "title": "Lose the chital", "text": "Chital are a staple of tigers and leopards and scavenger meals. Set Chital to -100% and watch the tiger, leopard, crocodile and hyena respond."}, "sources": [{"title": "Wikipedia: Ranthambore National Park", "url": "https://en.wikipedia.org/wiki/Ranthambore_National_Park"}, {"title": "Wikipedia: Bengal tiger", "url": "https://en.wikipedia.org/wiki/Bengal_tiger"}, {"title": "Wikipedia: Mugger crocodile", "url": "https://en.wikipedia.org/wiki/Mugger_crocodile"}, {"title": "Wikipedia: Sloth bear", "url": "https://en.wikipedia.org/wiki/Sloth_bear"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Ranthambore National Park", "icon": "lion", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Strong sun and long dry months drive the park's dry deciduous forest, which looks brown in summer."}, {"id": "monsoon", "sp": "monsoon rain", "xh": 0.26, "wiki": "Monsoon of India", "desc": "Wikipedia says the characteristic dhonk tree turns green after even a few drops of rain, so the rains set the rhythm of food in this dry forest."}, {"id": "lakes", "sp": "lakes & waterholes", "xh": 0.44}, {"id": "soil", "sp": "rocky soil", "xh": 0.62}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Fungi, bacteria & insects", "desc": "Break down dead leaves, wood and carcasses and return nutrients to the soil."}, {"id": "dhok", "sp": "anogeissus pendula", "xh": 0.1}, {"id": "banyan", "sp": "ficus benghalensis", "xh": 0.3}, {"id": "jamun", "sp": "syzygium cumini", "xh": 0.5, "name": "Jamun", "desc": "A fruiting tree whose fruit appears in records of wild boar, golden jackals and many birds feeding on it."}, {"id": "babul", "sp": "vachellia nilotica", "xh": 0.7}, {"id": "grass", "sp": "poaceae", "xh": 0.9, "name": "Grasses & herbs", "desc": "Open meadows and grassy patches among the trees feed the grazing deer and antelope."}, {"id": "sambar", "sp": "rusa unicolor", "xh": 0.06, "desc": "A large deer and one of the most-recorded mammals here. Wikipedia lists sambar as a preferred tiger prey."}, {"id": "chital", "sp": "axis axis", "xh": 0.22, "desc": "The spotted deer of the open meadows and forest edge, and the usual prey of tigers, leopards and the park's crocodiles."}, {"id": "nilgai", "sp": "boselaphus tragocamelus", "xh": 0.38}, {"id": "boar", "sp": "sus scrofa", "xh": 0.54, "desc": "An omnivore that digs for roots and eats fruit, and a medium-sized prey of tigers and leopards."}, {"id": "langur", "sp": "semnopithecus entellus", "xh": 0.7}, {"id": "termite", "sp": "odontotermes", "xh": 0.88}, {"id": "sloth", "sp": "melursus ursinus", "xh": 0.08, "desc": "Eats mainly termites, ants and bees, plus fruit; fruit dominates winter diets in Rajasthan's Aravalli hills. Tigers sometimes kill it."}, {"id": "hyena", "sp": "hyaena hyaena", "xh": 0.28}, {"id": "jackal", "sp": "canis aureus", "xh": 0.48, "desc": "Opportunist that eats fruit, small animals and carrion, including the remains of big-cat kills."}, {"id": "mugger", "sp": "crocodylus palustris", "xh": 0.68, "desc": "Lives in the park's lakes. It eats fish, birds and monkeys, and deer up to chital size, and scavenges."}, {"id": "monitor", "sp": "varanus bengalensis", "xh": 0.88}, {"id": "tiger", "sp": "panthera tigris", "xh": 0.35, "name": "Bengal tiger", "wiki": "Bengal tiger", "desc": "Ranthambore's star animal. Numbers fell to about 15 in the early 2000s and reached 69 by 2022. It hunts sambar, chital, nilgai and boar."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.65, "wiki": "Indian leopard", "desc": "Smaller than the tiger and more of a generalist, taking chital, sambar, boar, langurs and jackals, though tigers sometimes kill leopards."}], "raw": [["sun", "dhok", "r"], ["monsoon", "dhok", "r"], ["sun", "banyan", "r"], ["monsoon", "banyan", "r"], ["sun", "jamun", "r"], ["monsoon", "jamun", "r"], ["sun", "babul", "r"], ["monsoon", "babul", "r"], ["sun", "grass", "r"], ["monsoon", "grass", "r"], ["soil", "dhok", "r"], ["soil", "banyan", "r"], ["soil", "jamun", "r"], ["soil", "babul", "r"], ["lakes", "grass", "r"], ["grass", "chital"], ["grass", "sambar"], ["grass", "nilgai"], ["grass", "boar"], ["grass", "termite"], ["dhok", "sambar"], ["babul", "nilgai"], ["jamun", "boar"], ["jamun", "langur"], ["banyan", "langur"], ["jamun", "jackal"], ["banyan", "jackal"], ["termite", "sloth"], ["chital", "tiger"], ["sambar", "tiger"], ["nilgai", "tiger"], ["boar", "tiger"], ["langur", "tiger"], ["sloth", "tiger"], ["leopard", "tiger"], ["mugger", "tiger"], ["chital", "leopard"], ["sambar", "leopard"], ["boar", "leopard"], ["langur", "leopard"], ["jackal", "leopard"], ["chital", "mugger"], ["langur", "mugger"], ["jackal", "hyena"], ["termite", "monitor"], ["chital", "hyena", "s"], ["sambar", "hyena", "s"], ["nilgai", "hyena", "s"], ["boar", "hyena", "s"], ["chital", "jackal", "s"], ["sambar", "jackal", "s"], ["chital", "monitor", "s"], ["sambar", "monitor", "s"], ["dhok", "decomp", "d"], ["banyan", "decomp", "d"], ["jamun", "decomp", "d"], ["babul", "decomp", "d"], ["grass", "decomp", "d"], ["chital", "decomp", "d"], ["sambar", "decomp", "d"], ["tiger", "decomp", "d"], ["leopard", "decomp", "d"], ["mugger", "decomp", "d"], ["decomp", "soil", "r"], ["langur", "hyena"], ["nilgai", "jackal"], ["boar", "jackal"], ["langur", "jackal"], ["nilgai", "leopard"], ["sloth", "leopard"]], "ev": {"grass>chital": ["g", "Axis axis", "Poaceae"], "grass>