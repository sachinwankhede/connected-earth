{"id": "xusnj", "name": "New Jersey Pine Barrens (Pinelands National Reserve)", "short": "NJ Pine Barrens", "place": "New Jersey, USA", "lat": 39.8, "lon": -74.5, "side": "r", "cont": "North America", "country": "United States of America", "states": ["New Jersey"], "kind": "Forest", "park": true, "blurb": "Fire-loving pitch pine, acid bogs and a hidden aquifer on sugar sand.", "tip": {"id": "fire", "title": "Take away fire", "text": "Fire keeps pine forest from turning to oak. Set Fire to -100% and watch pitch pine, then the seed eaters and the predators that depend on them."}, "sources": [{"title": "Wikipedia: Pine Barrens (New Jersey)", "url": "https://en.wikipedia.org/wiki/New_Jersey_Pine_Barrens"}, {"title": "Wikipedia: Pitch pine", "url": "https://en.wikipedia.org/wiki/Pitch_pine"}, {"title": "Wikipedia: Northern pine snake", "url": "https://en.wikipedia.org/wiki/Northern_pine_snake"}, {"title": "Wikipedia: Pine Barrens tree frog", "url": "https://en.wikipedia.org/wiki/Pine_Barrens_tree_frog"}, {"title": "Wikipedia: Sarracenia purpurea", "url": "https://en.wikipedia.org/wiki/Sarracenia_purpurea"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "New Jersey Pine Barrens", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "pitchpine", "sp": "pinus rigida", "xh": 0.12, "desc": "The dominant tree of the Pine Barrens, growing on dry acidic sands and in swamps. It can resprout from epicormic shoots after fire, and its seeds feed small mammals and birds.", "badge": "Foundation species"}, {"id": "oak", "sp": "quercus marilandica", "xh": 0.32, "desc": "A scrubby oak of dry sandy soils that grows with pitch pine. Its acorns and leaves feed many animals; without fire, oaks tend to replace pines."}, {"id": "cranberry", "sp": "vaccinium macrocarpon", "xh": 0.52}, {"id": "pitcher", "sp": "sarracenia purpurea", "xh": 0.72, "name": "Purple pitcher plant", "desc": "A carnivorous plant of nutrient-poor acidic bogs. It drowns insects in rainwater held in its leaves and gets nutrients from the community that breaks them down.", "ic": "sage"}, {"id": "lepid", "sp": "lepidoptera", "xh": 0.06, "name": "Moths and caterpillars", "wiki": "Lepidoptera", "desc": "Caterpillars chew oak and pine foliage. They are an important protein source for birds, lizards and frogs."}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.2, "wiki": "White-tailed deer", "desc": "The commonest large mammal of the region. It browses shrubs and young trees, including pine seedlings and sprouts."}, {"id": "gsquirrel", "sp": "sciurus carolinensis", "xh": 0.34, "wiki": "Eastern gray squirrel", "desc": "Eats acorns and tree seeds, and buries nuts for later. A frequent prey of foxes, coyotes and snakes.", "ic": "gsquirrel"}, {"id": "cottontail", "sp": "sylvilagus floridanus", "xh": 0.48, "wiki": "Eastern cottontail", "desc": "A rabbit that feeds on herbs and, in winter, twigs and bark. It is prey for many predators from snakes to coyotes."}, {"id": "wfmouse", "sp": "peromyscus leucopus", "xh": 0.62, "wiki": "White-footed mouse", "desc": "Eats seeds, nuts and berries. A key small-mammal prey for snakes, foxes and coyotes.", "ic": "vole"}, {"id": "bluejay", "sp": "cyanocitta cristata", "xh": 0.78, "tl": 2, "wiki": "Blue jay", "desc": "An omnivore that eats acorns and seeds as well as insects such as caterpillars.", "ic": "meadowlark"}, {"id": "treefrog", "sp": "dryophytes andersonii", "xh": 0.1}, {"id": "fencelizard", "sp": "sceloporus undulatus", "xh": 0.24}, {"id": "pinesnake", "sp": "pituophis melanoleucus", "xh": 0.38}, {"id": "redfox", "sp": "vulpes vulpes", "xh": 0.52, "desc": "An omnivore that eats small mammals, birds, fruit and berries. It is known to raid pine snake nests and hibernation burrows."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.66, "wiki": "Raccoon", "desc": "An adaptable omnivore. GloBI records show it eating squirrels, rabbits and birds such as the blue jay."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.82, "wiki": "Turkey vulture", "desc": "A soaring scavenger that feeds on carrion such as dead deer and small mammals."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "The top mammalian predator in the region. It eats deer, rabbits, squirrels, mice and smaller carnivores.", "badge": "Keystone predator"}, {"id": "rattler", "sp": "crotalus horridus", "xh": 0.64, "tl": 4, "wiki": "Timber rattlesnake", "desc": "A threatened ambush predator in New Jersey that eats mice, squirrels and rabbits.", "ic": "snake"}, {"id": "fire", "sp": "fire", "xh": 0.15, "desc": "Frequent fire shapes the region, from dwarf pine forest to oak forest, and pitch pine is adapted to resprout after it. Most fires are of human origin."}, {"id": "aquifer", "sp": "aquifer water", "xh": 0.4}, {"id": "soil", "sp": "sandy acidic soil", "xh": 0.62}, {"id": "sun", "sp": "sunlight", "xh": 0.85, "desc": "Energy for all the plants of the open pine forest."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.95, "name": "Decomposers", "desc": "Fungi and bacteria break down dead wood, needles and animals, returning nutrients to the soil."}], "raw": [["sun", "pitchpine", "r"], ["sun", "oak", "r"], ["sun", "cranberry", "r"], ["sun", "pitcher", "r"], ["fire", "pitchpine", "r"], ["aquifer", "cranberry", "r"], ["aquifer", "pitcher", "r"], ["aquifer", "pitchpine", "r"], ["soil", "pitchpine", "r"], ["soil", "oak", "r"], ["decomp", "soil", "r"], ["oak", "lepid"], ["pitchpine", "lepid"], ["oak", "deer"], ["pitchpine", "deer"], ["oak", "gsquirrel"], ["pitchpine", "gsquirrel"], ["oak", "cottontail"], ["oak", "wfmouse"], ["pitchpine", "wfmouse"], ["oak", "bluejay"], ["lepid", "bluejay"], ["lepid", "treefrog"], ["lepid", "fencelizard"], ["wfmouse", "pinesnake"], ["cranberry", "redfox"], [