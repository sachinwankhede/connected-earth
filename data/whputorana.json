{"id": "whputorana", "name": "Putorana Plateau", "short": "Putorana", "place": "Krasnoyarsk Krai, Russia", "lat": 69.0, "lon": 93.5, "side": "r", "cont": "Asia", "country": "Russia", "kind": "Polar & mountain", "park": true, "blurb": "Reindeer, snow sheep and larch taiga on a lake-filled Arctic plateau.", "tip": {"id": "reindeer", "title": "Remove the wild reindeer", "text": "The Taimyr herd crosses the plateau. Set Wild reindeer to -100% and watch the wolf, brown bear and carrion eaters lose a major food, while lichen and willow go ungrazed."}, "sources": [{"title": "Wikipedia: Putorana Plateau", "url": "https://en.wikipedia.org/wiki/Putorana_Plateau"}, {"title": "Wikipedia: Putorana Nature Reserve", "url": "https://en.wikipedia.org/wiki/Putorana_Nature_Reserve"}, {"title": "Wikipedia: Reindeer", "url": "https://en.wikipedia.org/wiki/Reindeer"}, {"title": "Wikipedia: Arctic char", "url": "https://en.wikipedia.org/wiki/Arctic_char"}, {"title": "Wikipedia: Wolverine", "url": "https://en.wikipedia.org/wiki/Wolverine"}, {"title": "Wikipedia: Dahurian larch", "url": "https://en.wikipedia.org/wiki/Dahurian_larch"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Putorana Plateau", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "sun", "sp": "summer sun and long days", "xh": 0.1}, {"id": "melt", "sp": "snowmelt and summer rain", "xh": 0.3, "wiki": "Snow", "desc": "Most of the 500 to 800 mm of yearly precipitation falls as summer rain, and spring snowmelt feeds the shrubs and streams."}, {"id": "lakes", "sp": "deep cold lakes", "xh": 0.5}, {"id": "perma", "sp": "permafrost soil", "xh": 0.7, "desc": "Thin soils over frozen ground limit how deeply roots can grow and how quickly nutrients cycle."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi and soil microbes", "desc": "Slowly break down needles, leaf litter, droppings and carcasses in cold soil, returning nutrients."}, {"id": "larch", "sp": "larix gmelinii", "xh": 0.12, "desc": "A deciduous conifer that forms the taiga forests of eastern Siberia and grows on shallow soils above permafrost.", "ic": "whitebark", "badge": "Foundation species"}, {"id": "willow", "sp": "salix polaris", "xh": 0.3}, {"id": "bilberry", "sp": "vaccinium uliginosum", "xh": 0.48, "desc": "A low berry shrub of tundra and boggy ground whose leaves and berries are eaten by many animals."}, {"id": "lichen", "sp": "cladonia rangiferina", "xh": 0.66, "desc": "A pale ground lichen and the favourite winter food of reindeer, which dig through snow to reach it."}, {"id": "phyto", "sp": "bacillariophyta", "xh": 0.86, "name": "Lake phytoplankton", "wiki": "Phytoplankton", "desc": "Microscopic algae in the lakes that capture sunlight and feed zooplankton."}, {"id": "reindeer", "sp": "rangifer tarandus", "xh": 0.1, "name": "Wild reindeer", "desc": "The Taimyr herd is the largest wild reindeer population in the world, and its migration routes cross the plateau.", "badge": "Keystone grazer"}, {"id": "sheep", "sp": "ovis nivicola", "xh": 0.3, "name": "Putorana snow sheep", "desc": "A wild sheep of rocky mountains. The Putorana form is isolated from other snow sheep populations."}, {"id": "ptarmigan", "sp": "lagopus lagopus", "xh": 0.5, "desc": "A ground bird of tundra and scrub that eats buds, leaves and berries, and is itself prey for many predators."}, {"id": "vole", "sp": "myodes rufocanus", "xh": 0.7, "desc": "A small rodent that feeds on shrubs and berries and supports stoats, eagles and bears."}, {"id": "daphnia", "sp": "daphnia", "xh": 0.9, "name": "Water fleas", "desc": "Tiny zooplankton that graze algae in lakes and feed fish."}, {"id": "char", "sp": "salvelinus alpinus", "xh": 0.14}, {"id": "stoat", "sp": "mustela erminea", "xh": 0.34, "desc": "A small hunter of voles, lemmings and birds, recorded in the area.", "ic": "fox"}, {"id": "raven", "sp": "corvus corax", "xh": 0.54, "desc": "An omnivorous bird that scavenges carcasses and eats berries."}, {"id": "wolverine", "sp": "gulo gulo", "xh": 0.74, "desc": "A largely carrion-eating mustelid that follows wolves to scavenge their kills but can also take large prey."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.2, "name": "Grey wolf", "wiki": "Wolf", "desc": "A pack hunter of large hoofed animals such as wild reindeer and wild sheep."}, {"id": "bear", "sp": "ursus arctos", "xh": 0.5, "desc": "An omnivore that eats berries, small mammals, birds and reindeer."}, {"id": "eagle", "sp": "haliaeetus albicilla", "xh": 0.8, "desc": "A big eagle recorded eating birds, small mammals and carrion, including reindeer."}], "raw": [["sun", "larch", "r"], ["sun", "willow", "r"], ["sun", "bilberry", "r"], ["sun", "phyto", "r"], ["melt", "willow", "r"], ["melt", "bilberry", "r"], ["sun", "lichen", "r"], ["lakes", "phyto", "r"], ["perma", "larch", "r"], ["perma", "willow", "r"], ["decomp", "perma", "r"], ["larch", "decomp", "d"], ["willow", "decomp", "d"], ["bilberry", "decomp", "d"], ["lichen", "decomp", "d"], ["phyto", "decomp", "d"], ["reindeer", "decomp", "d"], ["sheep", "decomp", "d"], ["wolf", "decomp", "d"], ["bear", "decomp", "d"], ["eagle", "decomp", "d"], ["raven", "decomp", "d"], ["wolverine", "decomp", "d"], ["char", "decomp", "d"], ["vole", "decomp", "d"], ["ptarmigan", "decomp", "d"], ["stoat", "decomp", "d"], ["daphnia", "decomp", "d"], ["lichen", "reindeer"], ["willow", "reindeer"], ["bilberry", "reindeer"], ["willow", "sheep"], ["bilberry", "sheep"], ["willow", "ptarmigan"], ["bilberry", "ptarmigan"], ["bilberry", "vole"], ["phyto", "daphnia"], ["daphnia", "char"], ["vole", "stoat"], ["ptarmigan", "stoat"], ["bilberry", "raven"], ["bilberry", "bear"], ["reindeer", "wolf"], ["sheep", "wolf"], ["reindeer", "bear"], ["vole", "bear"], ["ptarmigan", "bear"], ["vole", "eagle"], ["