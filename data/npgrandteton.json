{"id": "npgrandteton", "name": "Grand Teton National Park", "short": "Grand Teton", "place": "Wyoming, USA", "lat": 43.73, "lon": -110.8, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Wyoming"], "kind": "Polar & mountain", "park": true, "blurb": "Sagebrush flats, willow wetlands and the elk, moose and wolves of Jackson Hole.", "tip": {"id": "wolf", "title": "Remove the wolves", "text": "Wolves came back to the park from Yellowstone. Set Gray wolf to -100% and watch elk and moose, then the willow and aspen they browse."}, "sources": [{"title": "Wikipedia: Grand Teton National Park", "url": "https://en.wikipedia.org/wiki/Grand_Teton_National_Park"}, {"title": "NPS: Mammals of Grand Teton", "url": "https://www.nps.gov/grte/learn/nature/mammals.htm"}, {"title": "Wikipedia: Elk", "url": "https://en.wikipedia.org/wiki/Elk"}, {"title": "Wikipedia: Moose", "url": "https://en.wikipedia.org/wiki/Moose"}, {"title": "Wikipedia: Pronghorn", "url": "https://en.wikipedia.org/wiki/Pronghorn"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Grand Teton National Park, Elk, Moose). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Grand Teton National Park", "icon": "ice", "tier": "overview", "nodes": [{"id": "snow", "sp": "winter snowpack", "xh": 0.1, "desc": "Deep winter snow drives elk, moose and pronghorn down from the high country to the valley floor, and its spring melt feeds the Snake River."}, {"id": "river", "sp": "snake river and wetlands", "xh": 0.35}, {"id": "fire", "sp": "wildfire", "xh": 0.6, "desc": "Burns renew conifer forest and aspen stands. Park agencies now use fire management plans after earlier suppression reduced plant diversity."}, {"id": "soil", "sp": "soil nutrients", "xh": 0.85, "wiki": "Soil fertility", "desc": "Nutrients in valley and sagebrush soils that plants draw on, replenished by decomposers."}, {"id": "sage", "sp": "artemisia tridentata", "xh": 0.1, "desc": "The shrub of the sagebrush flats, the most widespread habitat in the park and home to about 100 grass and wildflower species.", "badge": "Foundation species"}, {"id": "grass", "sp": "pseudoroegneria", "xh": 0.3}, {"id": "willow", "sp": "salix", "xh": 0.5, "desc": "Shrubs along the river and wetlands such as Willow Flats, and a main winter and summer browse for moose."}, {"id": "aspen", "sp": "populus tremuloides", "xh": 0.72, "name": "Quaking aspen", "desc": "A leafy tree of the valley slopes and river terraces, eaten by elk, moose and beaver."}, {"id": "elk", "sp": "cervus elaphus", "xh": 0.04, "wiki": "Elk", "desc": "Migrates between summer range in Yellowstone and the surrounding forests and winter range on the National Elk Refuge, passing through the park. Eats mostly sedges, forbs and tree sprouts in summer.", "ic": "elk", "badge": "Keystone grazer"}, {"id": "moose", "sp": "alces alces", "xh": 0.15, "desc": "Browses willow and eats aquatic plants, and stays near waterways and wetlands in the park."}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.26, "wiki": "Pronghorn", "desc": "Eats a wide mix of forbs, shrubs and grasses on the open sagebrush flats. Prey for coyotes, wolves and bears.", "ic": "pronghorn"}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.37, "wiki": "Mule deer", "desc": "A browser of shrubs and wildflowers, recorded eating fireweed and thimbleberry."}, {"id": "bison", "sp": "bison bison", "xh": 0.49, "desc": "A large grazer of the valley meadows and sagebrush flats.", "no": ["badge"]}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.61, "wiki": "North American beaver", "desc": "Cuts aspen and willow along the river and builds dams that create ponds and wetlands.", "badge": "Ecosystem engineer"}, {"id": "uinta", "sp": "urocitellus armatus", "xh": 0.74}, {"id": "cricket", "sp": "anabrus simplex", "xh": 0.87}, {"id": "coyote", "sp": "canis latrans", "xh": 0.15, "tl": 3, "wiki": "Coyote", "desc": "Hunts ground squirrels and young hoofed animals and scavenges carcasses."}, {"id": "raven", "sp": "corvus corax", "xh": 0.4, "wiki": "Common raven", "desc": "Scavenges carcasses, including wolf kills, and eats insects and small prey."}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.62, "name": "Bald eagle", "tl": 3, "desc": "Takes waterbirds and small mammals and scavenges carrion along the river."}, {"id": "blackbear", "sp": "ursus americanus", "xh": 0.85, "name": "American black bear", "tl": 3, "wiki": "American black bear", "desc": "Omnivore that eats plants, insects and young animals, and scavenges carcasses."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "desc": "Returned to the park from Yellowstone after being wiped out in the early 1900s. Preys on elk and moose, with moose calves and weak animals most at risk."}, {"id": "grizzly", "sp": "ursus arctos", "xh": 0.7, "name": "Grizzly bear", "wiki": "Grizzly bear", "desc": "Eats army cutworm moths, roots, berries, pine seeds and carcasses, and takes elk calves."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.97, "desc": "Break down dead plants, animals and dung, returning nutrients to the soil."}], "raw": [["snow", "sage", "r"], ["snow", "grass", "r"], ["river", "willow", "r"], ["river", "aspen", "r"], ["soil", "sage", "r"], ["soil", "grass", "r"], ["fire", "aspen", "r"], ["snow", "river", "r"], ["grass", "elk"], ["aspen", "elk"], ["willow", "elk"], ["willow", "moose"], ["aspen", "moose"], ["sage", "pronghorn"], ["grass", "pronghorn"], ["sage", "muledeer"], ["willow", "muledeer"], ["grass", "bison"], ["aspen", "beaver"], ["willow", "beaver"], ["grass", "uinta"], ["sage", "cricket"], ["grass", "cricket"], ["uinta", "coyote"], ["pronghorn", "coyote"], ["uinta", "eagle"], ["cricket", "blackbear"], ["aspen", "blackbear"], ["grass"