{"id": "xuspa", "name": "Allegheny National Forest", "short": "Allegheny Forest", "place": "Pennsylvania, USA", "lat": 41.6, "lon": -79.0, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Pennsylvania"], "kind": "Forest", "park": true, "blurb": "Beech, hemlock, too many deer and the few predators left to thin them.", "tip": {"id": "deer", "title": "Remove the deer", "text": "Deer browse seedlings and shrubs far faster than predators can thin them. Set White-tailed deer to -100% and watch the trees and berries, then the fisher, coyote and bear that rely on them."}, "sources": [{"title": "Wikipedia: Allegheny National Forest", "url": "https://en.wikipedia.org/wiki/Allegheny_National_Forest"}, {"title": "Wikipedia: White-tailed deer", "url": "https://en.wikipedia.org/wiki/White-tailed_deer"}, {"title": "Wikipedia: American black bear", "url": "https://en.wikipedia.org/wiki/American_black_bear"}, {"title": "Wikipedia: Fisher (animal)", "url": "https://en.wikipedia.org/wiki/Fisher_(animal)"}, {"title": "Wikipedia: Black cherry", "url": "https://en.wikipedia.org/wiki/Black_cherry"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Allegheny National Forest", "icon": "aspen", "tier": "overview", "nodes": [{"id": "beech", "sp": "fagus grandifolia", "xh": 0.12, "desc": "Historically one of the forest's dominant trees alongside hemlock. Its nuts feed bear and other wildlife, and many insects feed on its leaves.", "ic": "willow", "badge": "Foundation species"}, {"id": "hemlock", "sp": "tsuga canadensis", "xh": 0.34, "wiki": "Eastern hemlock", "desc": "A shade-casting conifer that, with beech, made up most of the original forest. Wikipedia notes that taller trees shade streams and keep the water cool.", "ic": "willow"}, {"id": "pine", "sp": "pinus strobus", "xh": 0.58, "name": "Eastern white pine", "wiki": "Eastern white pine", "desc": "A tall conifer of the plateau forest, browsed and chewed by deer, hares, porcupines and many other animals.", "ic": "willow"}, {"id": "berry", "sp": "mitchella repens", "xh": 0.8, "desc": "A creeping evergreen vine of the forest floor whose red berries are eaten by deer, birds and small mammals.", "ic": "sage"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.05, "wiki": "White-tailed deer", "desc": "The forest's main browser. Wikipedia says the forest has often held more deer than it can support, thinning seedlings and shrubs.", "badge": "Keystone grazer"}, {"id": "porcupine", "sp": "erethizon dorsatus", "xh": 0.19, "wiki": "North American porcupine"}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.33, "wiki": "North American beaver", "desc": "Gnaws trees along streams and dams them to make ponds, changing the water and wetlands around it.", "badge": "Ecosystem engineer"}, {"id": "hare", "sp": "lepus americanus", "xh": 0.47, "desc": "A browser of woody shoots and bark. It is the main prey of the fisher."}, {"id": "redsq", "sp": "tamiasciurus hudsonicus", "xh": 0.61, "wiki": "American red squirrel", "desc": "A small tree squirrel that feeds on conifer seeds and is itself prey for foxes, coyotes and snakes.", "ic": "rsquirrel"}, {"id": "mouse", "sp": "peromyscus leucopus", "xh": 0.75, "wiki": "White-footed mouse", "desc": "A common small rodent that eats seeds and berries, including beechnuts, and feeds many predators.", "ic": "vole"}, {"id": "moth", "sp": "lymantria dispar", "xh": 0.89, "name": "Spongy moth", "desc": "An introduced caterpillar that feeds on the leaves of beech, hemlock, pine and many other trees."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.1, "wiki": "Raccoon", "desc": "An omnivore. GloBI records show it eating spongy moths and many small animals."}, {"id": "fisher", "sp": "pekania pennanti", "xh": 0.3, "desc": "A forest weasel relative whose main prey is the snowshoe hare. It is one of few predators that regularly kill porcupines, and it scavenges deer carrion."}, {"id": "rattler", "sp": "crotalus horridus", "xh": 0.5, "wiki": "Timber rattlesnake", "desc": "A sit-and-wait snake of rocky forest slopes. GloBI records show it eating mice, chipmunks and squirrels.", "ic": "snake"}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.7, "wiki": "Turkey vulture", "desc": "A soaring scavenger that cleans up carcasses of deer and other animals."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.9, "desc": "A small predator of mice, hares and squirrels that also eats berries and nuts."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "Wikipedia says coyotes are now among the main non-human predators of deer in the east, mostly taking fawns, since wolves and cougars are gone."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.7, "wiki": "American black bear", "desc": "An omnivore that mostly eats plants and nuts, but also takes fawns in spring and scavenges carrion."}, {"id": "sun", "sp": "sunlight", "xh": 0.06, "desc": "Light reaching the forest floor limits growth beneath a closed canopy; storm gaps let seedlings grow."}, {"id": "rain", "sp": "rain and snowmelt", "xh": 0.24, "wiki": "Precipitation", "desc": "Keeps the plateau forested and fills the streams, which are managed for clean water and trout."}, {"id": "snow", "sp": "winter snow", "xh": 0.42, "desc": "Deep snow and harsh winters stress deer, and fishers tend to avoid areas with deep snow."}, {"id": "soil", "sp": "soil nutrients", "xh": 0.62, "wiki": "Nutrient cycle", "desc": "Nutrients released from dead leaves, wood and carcasses feed the trees and forest-floor plants."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.85, "name": "Fungi and soil microbes", "desc": "Break down fallen leaves, wood and carcasses and return nutrients to the soil."}], "raw": [["beech", "deer"], ["hemlock", "deer"], ["pine", "deer"], ["berry", "deer"], ["beech", "porcupine"], ["hemlock", "porcupine"], ["pine", "porcupine"], ["beech", "beaver"], ["pine", "beaver"], ["beech", "hare"], ["hemlock", "hare"], ["pine", "hare"], ["pine", "redsq"], ["beech", "mouse"], ["berry", "mouse"], ["beech", "moth"], ["hemlock", "moth"], ["pine", "moth"], ["beech", "bear"], ["moth", "raccoon"], ["porcupine", "fisher"], ["hare", "fisher"], ["deer", "fisher", "s"], ["mouse", "rattler"], ["redsq", "rattler"], ["deer", "vulture", "s"], ["redsq", "vulture", "s"], ["mouse", "fox"], ["hare", "fox"], ["redsq", "fox"], ["deer", "coyote"], ["hare", "coyote"], ["beaver", "coyote"], ["mouse", "coyote"], ["redsq", "coyote"], ["porcupine", "coyote"], ["raccoon", "coyote"], ["fox", "coyote"], ["deer", "bear"], ["hare", "bear"], ["raccoon", "fisher"], ["snow", "deer", "r"], ["snow", "hare", "r"], ["sun", "beech", "r"], ["rain", "beech", "r"], ["soil", "beech", "r"], ["beech", "decomp", "d"], ["sun", "hemlock", "r"], ["rain", "hemlock", "r"], ["soil", "hemlock", "r"], ["hemlock", "decomp", "d"], ["sun", "pine", "r"], ["rain", "pine", "r"], ["soil", "pine", "r"], ["pine", "decomp", "d"], ["sun", "berry", "r"], ["rain", "berry", "r"], ["soil", "berry", "r"], ["berry", "decomp", "d"], ["deer", "decomp", "d"], ["decomp", "soil", "r"], ["hemlock", "beaver"], ["pine", "raccoon"], ["deer", "raccoon"], ["beaver", "vulture"], ["beech", "fox"], ["berry", "fox"], ["deer", "fox"], ["porcupine", "fox"], ["beaver", "fox"], ["beaver", "bear"]], "ev": {"beech>deer": ["g", "Odocoileus virginianus", "Fagus grandifolia"], "hemlock>deer": ["g", "Odocoileus virginianus", "Tsuga canadensis"], "pine>deer": ["g", "Odocoileus virginianus", "Pinus strobus"], "berry>deer": ["g", "Odocoileus virginianus", "Mitchella repens"], "beech>porcupine": ["g", "Erethizon dorsatus", "Fagus grandifolia"], "hemlock>porcupine": ["g", "Erethizon dorsatus", "Tsuga canadensis"], "pine>porcupine": ["g", "Erethizon dorsatus", "Pinus strobus"], "beec