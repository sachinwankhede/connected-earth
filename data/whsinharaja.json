": "caryota urens", "xh": 0.88}, {"id": "langur", "sp": "semnopithecus vetulus", "xh": 0.06}, {"id": "macaque", "sp": "macaca sinica", "xh": 0.2}, {"id": "giantsq", "sp": "ratufa macroura", "xh": 0.34}, {"id": "pigeon", "sp": "ducula aenea", "xh": 0.48}, {"id": "bulbul", "sp": "pycnonotus cafer", "xh": 0.62, "name": "Red-vented bulbul", "tl": 2, "wiki": "Red-vented bulbul"}, {"id": "insects", "sp": "insecta", "xh": 0.78, "desc": "Leaf-eating insects, beetles, crickets and other small invertebrates that feed on leaves and litter and are prey for lizards, frogs and birds."}, {"id": "drongo", "sp": "dicrurus lophorinus", "xh": 0.06}, {"id": "magpie", "sp": "urocissa ornata", "xh": 0.22}, {"id": "lizard", "sp": "calotes calotes", "xh": 0.38}, {"id": "frog", "sp": "polypedates cruciger", "xh": 0.54}, {"id": "vinesnake", "sp": "ahaetulla nasuta", "xh": 0.7}, {"id": "monitor", "sp": "varanus salvator", "xh": 0.88, "name": "Common water monitor", "wiki": "Common water monitor", "desc": "A large lizard that eats frogs and other small animals, and also scavenges carrion."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.5, "name": "Sri Lankan leopard", "wiki": "Sri Lankan leopard", "desc": "The island apex predator, living in forests across Sri Lanka. It hunts monkeys and other mammals, and no larger carnivore competes with it.", "badge": "Keystone predator"}, {"id": "sun", "sp": "tropical sunlight", "xh": 0.15}, {"id": "rain", "sp": "monsoon rain", "xh": 0.4, "wiki": "Rain", "desc": "Roughly 3,600 to 5,000 mm of rain per year falls in two monsoons, keeping the forest wet all year."}, {"id": "soil", "sp": "rainforest soil", "xh": 0.65}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Fungi, termites & litter fauna", "desc": "Break down fallen leaves, wood and carcasses and return nutrients to the soil."}], "raw": [["sun", "dipter", "r"], ["rain", "dipter", "r"], ["soil", "dipter", "r"], ["sun", "ficus", "r"], ["rain", "ficus", "r"], ["soil", "ficus", "