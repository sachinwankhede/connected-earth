{"id": "npwindcave", "name": "Wind Cave National Park", "short": "Wind Cave", "place": "South Dakota, USA", "lat": 43.57, "lon": -103.48, "side": "r", "cont": "North America", "country": "United States of America", "states": ["South Dakota"], "kind": "Grassland", "park": true, "blurb": "Mixed-grass prairie where bison, prairie dogs and ferrets share the grass.", "tip": {"id": "prairiedog", "title": "Lose the prairie dogs", "text": "Prairie dogs feed ferrets, badgers and coyotes. Set Black-tailed prairie dog to -100% and watch the ferret first, then the other predators."}, "sources": [{"title": "Wikipedia: Wind Cave National Park", "url": "https://en.wikipedia.org/wiki/Wind_Cave_National_Park"}, {"title": "NPS: Wind Cave nature and science", "url": "https://www.nps.gov/wica/learn/nature/index.htm"}, {"title": "Wikipedia: Black-tailed prairie dog", "url": "https://en.wikipedia.org/wiki/Black-tailed_prairie_dog"}, {"title": "Wikipedia: Black-footed ferret", "url": "https://en.wikipedia.org/wiki/Black-footed_ferret"}, {"title": "Wikipedia: American bison", "url": "https://en.wikipedia.org/wiki/American_bison"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Wind Cave National Park", "icon": "grass", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Sunshine powers the grasses and wildflowers that feed everything else on the prairie."}, {"id": "rain", "sp": "rain & snow", "xh": 0.4, "desc": "The park gets roughly 21 inches of precipitation a year, plus heavy winter snow, which is modest water for grassland growth."}, {"id": "fire", "sp": "fire", "xh": 0.65, "desc": "Grassland fire clears dead growth and holds back woody plants, one of the forces that keeps prairie open."}, {"id": "soil", "sp": "prairie soil", "xh": 0.88}, {"id": "grama", "sp": "bouteloua", "xh": 0.1, "name": "Blue grama & buffalo grass", "desc": "Short grasses that prairie dogs favour and that bison graze in mixed-grass prairie.", "badge": "Foundation species"}, {"id": "wheat", "sp": "pascopyrum smithii", "xh": 0.28, "desc": "A cool-season grass of the northern Great Plains, a staple for grazers and a main food of prairie dogs.", "no": ["badge"]}, {"id": "forbs", "sp": "echinacea angustifolia", "xh": 0.46}, {"id": "chokecherry", "sp": "prunus virginiana", "xh": 0.64}, {"id": "pine", "sp": "pinus ponderosa", "xh": 0.84, "name": "Ponderosa pine", "desc": "The dominant tree of the hills, forming the forest that meets the prairie at the park edge."}, {"id": "bison", "sp": "bison bison", "xh": 0.08, "desc": "The park herd is one of four free-roaming, genetically pure bison herds on public land. They graze mainly grasses and sedges."}, {"id": "prairiedog", "sp": "cynomys ludovicianus", "xh": 0.24, "wiki": "Black-tailed prairie dog", "desc": "A burrowing grazer that lives in large colonies; its digging and clipping reshape vegetation and its colonies support many other species.", "badge": "Ecosystem engineer"}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.4, "wiki": "Pronghorn", "desc": "A fast grassland ungulate that lives in the park alongside bison and elk.", "ic": "pronghorn"}, {"id": "elk", "sp": "cervus canadensis", "xh": 0.56, "desc": "Elk graze and browse in the park, and are among the larger prey of mountain lions."}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.72, "wiki": "Mule deer", "desc": "A browsing deer of slopes and pine edges, taken by cougars and coyotes."}, {"id": "deermouse", "sp": "peromyscus maniculatus", "xh": 0.9, "desc": "A small seed- and insect-eating rodent that is prey for badgers, coyotes, snakes and ferrets.", "ic": "vole"}, {"id": "ferret", "sp": "mustela nigripes", "xh": 0.08, "d