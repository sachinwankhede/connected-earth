{"id": "npglacierbay", "name": "Glacier Bay National Park and Preserve", "short": "Glacier Bay", "place": "Alaska, USA", "lat": 58.5, "lon": -137.0, "side": "l", "cont": "North America", "country": "United States of America", "states": ["Alaska"], "kind": "Coast & ocean", "park": true, "blurb": "Tidewater glaciers, humpbacks, sea otters and salmon-fed bears in Alaska.", "tip": {"id": "salmon", "title": "Remove the salmon", "text": "Salmon feed bears, eagles, seals and wolves. Set Pacific salmon to -100% and watch the predators and scavengers that depend on them."}, "sources": [{"title": "Wikipedia: Glacier Bay National Park and Preserve", "url": "https://en.wikipedia.org/wiki/Glacier_Bay_National_Park_and_Preserve"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Glacier Bay National Park and Preserve", "icon": "ice", "tier": "overview", "nodes": [{"id": "phyto", "sp": "bacillariophyceae", "xh": 0.12}, {"id": "alder", "sp": "alnus alnobetula", "xh": 0.38}, {"id": "willow", "sp": "salix", "xh": 0.62, "desc": "Several willow species grow on new ground and river flats near the bay. Moose and voles use them for food."}, {"id": "spruce", "sp": "picea sitchensis", "xh": 0.86, "wiki": "Sitka spruce", "ic": "willow"}, {"id": "krill", "sp": "euphausiacea", "xh": 0.08}, {"id": "herring", "sp": "clupea pallasii", "xh": 0.27}, {"id": "mussel", "sp": "mytilus", "xh": 0.46}, {"id": "moose", "sp": "alces alces", "xh": 0.68, "desc": "A large browser of willows and other shrubs on river flats and young forest. Wolves and brown bears can take them."}, {"id": "vole", "sp": "microtus longicaudus", "xh": 0.88, "wiki": "Long-tailed vole", "ic": "vole"}, {"id": "salmon", "sp": "oncorhynchus", "xh": 0.08}, {"id": "humpback", "sp": "megaptera novaeangliae", "xh": 0.24, "wiki": "Humpback whale", "desc": "The most recorded mammal near the park. It feeds on krill and small schooling fish in the bay in summer.", "ic": "whale"}, {"id": "otter", "sp": "enhydra lutris", "xh": 0.4}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.56, "desc": "Eats fish such as herring and salmon, and rests on ice and shore. Orcas hunt them."}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.72, "tl": 3, "wiki": "Bald eagle", "desc": "One of the most recorded birds here. It takes fish such as salmon and herring and scavenges carcasses."}, {"id": "raven", "sp": "corvus corax", "xh": 0.9, "desc": "An opportunistic bird that scavenges carcasses of salmon and large animals."}, {"id": "orca", "sp": "orcinus orca", "xh": 0.2, "desc": "A top marine predator. Mammal-eating orcas hunt seals, porpoises, sea otters and sometimes whales.", "badge": "Keystone predator"}, {"id": "brownbear", "sp": "ursus arctos", "xh": 0.55, "desc": "An omnivore that eats salmon, small mammals, moose and plants. Salmon carried inland add marine nutrients to the land."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.85, "desc": "A pack hunter of the park's forests. It hunts moose and also eats salmon.", "no": ["badge"]}, {"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Long summer days power plankton blooms in the bay and plant growth on the land."}, {"id": "glacier", "sp": "retreating glaciers", "xh": 0.28}, {"id": "meltwater", "sp": "glacial meltwater", "xh": 0.48}, {"id": "soil", "sp": "young soils", "xh": 0.68}, {"id": "decomp", "sp": "decomposers", "xh": 0.9, "desc": "Fungi, bacteria and invertebrates that break down dead plants, fish and carcasses and return nutrients to the soil."}], "raw": [["sun", "phyto", "r"], ["sun", "alder", "r"], ["sun", "willow", "r"], ["sun", "spruce", "r"], ["glacier", "alder", "r"], ["glacier", "willow", "r"], ["meltwater", "phyto", "r"], ["soil", "spruce", "r"], ["soil", "willow", "r"], ["soil", "alder", "r"], ["decomp", "soil", "r"], ["p