{"id": "xusne", "name": "Platte River sandhill crane migration (central Platte valley)", "short": "Platte River", "place": "Nebraska, USA", "lat": 40.7, "lon": -98.5, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Nebraska"], "kind": "Lakes & wetlands", "park": true, "blurb": "Sandhill cranes, waste corn and the shallow braided river they roost on.", "tip": {"id": "river", "title": "Dry up the river", "text": "Set Platte River flow to -100% and watch the channels, cattail and cottonwood suffer, then the roosting sandbars the cranes depend on."}, "sources": [{"title": "Wikipedia: Sandhill crane", "url": "https://en.wikipedia.org/wiki/Sandhill_crane"}, {"title": "Wikipedia: Platte River", "url": "https://en.wikipedia.org/wiki/Platte_River"}, {"title": "Wikipedia: Whooping crane", "url": "https://en.wikipedia.org/wiki/Whooping_crane"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Platte River", "icon": "hawk", "tier": "overview", "nodes": [{"id": "bluestem", "sp": "andropogon gerardi", "xh": 0.1, "desc": "A tall native grass of the wet-meadow and prairie grasslands beside the river, and one of the plants Wikipedia lists along the Platte.", "no": ["badge"]}, {"id": "cottonwood", "sp": "populus deltoides", "xh": 0.28, "name": "Plains cottonwood", "desc": "Cottonwood trees line the riverbanks and form part of the green oasis the Platte makes across semi-arid Nebraska.", "badge": "Foundation species"}, {"id": "corn", "sp": "zea mays", "xh": 0.46, "name": "Waste corn", "desc": "Leftover grain in harvested fields. Wikipedia notes it helps sandhill cranes build body reserves before they continue north."}, {"id": "milkweed", "sp": "asclepias syriaca", "xh": 0.64, "desc": "A common prairie wildflower of ditches and meadows here, and the plant monarch caterpillars feed on.", "ic": "sage"}, {"id": "cattail", "sp": "typha", "xh": 0.84, "name": "Cattail", "desc": "Tall marsh plants of shallow backwaters and wet meadows, eaten and used for lodges by muskrats."}, {"id": "crane", "sp": "grus canadensis", "xh": 0.06, "tl": 2, "wiki": "Sandhill crane", "desc": "Up to 450,000 lesser sandhill cranes stop in the central Platte valley each year. They feed on waste grain, seeds and invertebrates in fields and wet meadows.", "ic": "hawk", "badge": "Keystone grazer"}, {"id": "snow", "sp": "anser caerulescens", "xh": 0.18, "desc": "Large flocks of migrating geese feed in the same harvested fields as the cranes and roost on the river.", "ic": "hawk"}, {"id": "goose", "sp": "branta canadensis", "xh": 0.3, "wiki": "Canada goose", "desc": "Wikipedia notes Canada geese have adapted to farm fields along the Platte, where they graze on grass and grain.", "ic": "hawk"}, {"id": "mallard", "sp": "anas platyrhynchos", "xh": 0.42, "wiki": "Mallard", "desc": "An omnivorous dabbling duck of shallow channels and backwaters, taking seeds, plants and small invertebrates.", "ic": "hawk"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.54, "wiki": "White-tailed deer", "desc": "Wikipedia lists it among the Platte valley wildlife. It browses riverside trees and shrubs and eats grain and grasses."}, {"id": "monarch", "sp": "danaus plexippus", "xh": 0.66, "wiki": "Monarch butterfly", "desc": "The most-recorded insect in the area. Its caterpillars feed only on milkweed, and the adults pass through on migration."}, {"id": "vole", "sp": "microtus pennsylvanicus", "xh": 0.78, "wiki": "Meadow vole", "desc": "A small grassland rodent that eats grasses and seeds and is prey for hawks, coyotes and snakes.", "ic": "vole"}, {"id": "muskrat", "sp": "ondatra zibethicus", "xh": 0.9, "wiki": "Muskrat", "desc": "A wetland rodent that eats cattails and other marsh plants and is hunted by many predators.", "ic": "beaver"}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.2, "wiki": "Raccoon", "desc": "An omnivore of the river corridor. It takes eggs, birds and small mammals, and is a recognised nest predator of cranes."}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.5, "wiki": "Bullsnake", "desc": "A large grassland snake that eats rodents and other small animals.", "ic": "snake"}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.8, "tl": 3, "wiki": "Red-tailed hawk", "desc": "A common raptor of open country that hunts small mammals, birds and snakes.", "ic": "hawk"}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.35, "name": "Bald eagle", "desc": "Wikipedia lists it among the Platte valley wildlife. It hunts waterfowl and can take adult cranes, and also scavenges carcasses."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.65, "wiki": "Coyote", "desc": "A widespread predator that eats rodents, birds, fawns and carrion; it can take crane eggs and chicks."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Drives growth of the grasses, crops and marsh plants in the valley."}, {"id": "river", "sp": "platte river flow", "xh": 0.3}, {"id": "sandbar", "sp": "braided channels & sandbars", "xh": 0.5}, {"id": "soil", "sp": "river-valley soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, insects & bacteria", "desc": "Break down dead grass, leaves, grain, and carcasses and return nutrients to the soil."}], "raw": [["sun", "bluestem", "r"], ["sun", "corn", "r"], ["sun", "milkweed", "r"], ["sun", "cottonwood", "r"], ["sun", "cattail", "r"], ["river", "cottonwood", "r"], ["river", "cattail", "r"], ["river", "corn", "r"], ["river", "bluestem", "r"], ["soil", "bluestem", "r"], ["soil", "corn", "r"], ["soil", "milkweed", "r"], ["soil", "cottonwood", "r"], ["river", "sandbar", "r"], ["sandbar", "crane"], ["sandbar", "snow"], ["sandbar", "goose"], ["cottonwood", "decomp", "d"], ["bluestem", "decomp", "d"], ["corn", "decomp", "d"]