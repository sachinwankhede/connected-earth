{"id": "xusvt", "name": "Green Mountain National Forest", "short": "Green Mountains", "place": "Vermont, USA", "lat": 43.9, "lon": -72.9, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Vermont"], "kind": "Forest", "park": true, "blurb": "Northern hardwoods, beech mast, moose and the bears and coyotes that follow them.", "tip": {"id": "beech", "title": "Take away the beech", "text": "Beechnuts feed bears, deer and chipmunks in autumn. Set American beech to -100% and watch those animals, then the predators that hunt them."}, "sources": [{"title": "Wikipedia: Green Mountain National Forest", "url": "https://en.wikipedia.org/wiki/Green_Mountain_National_Forest"}, {"title": "Wikipedia: Moose", "url": "https://en.wikipedia.org/wiki/Moose"}, {"title": "Wikipedia: American black bear", "url": "https://en.wikipedia.org/wiki/American_black_bear"}, {"title": "Wikipedia: American beaver", "url": "https://en.wikipedia.org/wiki/American_beaver"}, {"title": "Wikipedia: Northern hardwood forest", "url": "https://en.wikipedia.org/wiki/Northern_hardwood_forest"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Green Mountain National Forest", "icon": "aspen", "tier": "overview", "nodes": [{"id": "beech", "sp": "fagus grandifolia", "xh": 0.12, "name": "American beech", "desc": "A common hardwood of the northern forest on the lower slopes. Its nuts are an autumn food for bears, deer and small mammals.", "badge": "Foundation species"}, {"id": "birch", "sp": "betula alleghaniensis", "xh": 0.32}, {"id": "fir", "sp": "abies balsamea", "xh": 0.52, "wiki": "Balsam fir", "desc": "A conifer of the cooler, higher slopes. Beavers, deer and red squirrels are recorded feeding on it.", "ic": "willow"}, {"id": "stripedmaple", "sp": "acer pensylvanicum", "xh": 0.72, "name": "Striped maple", "desc": "A small understory tree whose twigs and leaves are browsed by moose and deer.", "ic": "willow"}, {"id": "clintonia", "sp": "clintonia borealis", "xh": 0.9, "desc": "A woodland wildflower of the forest floor in cool northern woods. Deer are recorded eating it.", "ic": "sage"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.06, "wiki": "White-tailed deer", "desc": "The most recorded large herbivore near the forest. It browses twigs, buds and herbs and eats beechnuts."}, {"id": "moose", "sp": "alces alces", "xh": 0.2, "wiki": "Moose", "desc": "A large browser of young hardwood growth. Winter ticks have caused many moose deaths in Vermont in recent years.", "ic": "moose"}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.34, "wiki": "American beaver", "desc": "Cuts trees to build dams, and the ponds it makes create wetland habitat for many other species.", "badge": "Ecosystem engineer"}, {"id": "porcupine", "sp": "erethizon dorsatus", "xh": 0.48, "wiki": "North American porcupine", "desc": "A slow tree-climbing herbivore that eats bark and leaves of hardwoods and conifers."}, {"id": "redsq", "sp": "tamiasciurus hudsonicus", "xh": 0.62, "wiki": "American red squirrel", "desc": "A small forest squirrel that feeds on conifer seeds, buds and bark, and is prey for many carnivores.", "ic": "rsquirrel"}, {"id": "chipmunk", "sp": "tamias striatus", "xh": 0.76, "wiki": "Eastern chipmunk", "desc": "A ground-dwelling omnivore eating nuts, seeds and some invertebrates, and is prey for foxes, bobcats and coyotes."}, {"id": "vole", "sp": "microtus pennsylvanicus", "xh": 0.9, "wiki": "Meadow vole", "desc": "A small grazer of clearings and wet meadows that feeds many predators.", "ic": "vole"}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.2, "desc": "A small canid hunting voles and squirrels, and scavenging carrion in winter."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.45, "wiki": "Raccoon", "desc": "A flexible omnivore that takes small mammals and carrion in the forest edge and near streams."}, {"id": "raven", "sp": "corvus corax", "xh": 0.7, "desc": "A large scavenging bird that feeds on carcasses of deer and moose through winter."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.2, "wiki": "Coyote", "desc": "The main wild canid predator of the region. It takes small mammals and deer and also scavenges carrion."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.5, "wiki": "Bobcat", "desc": "A secretive cat that hunts squirrels, voles and hares and sometimes deer in the forest.", "ic": "lion"}, {"id": "bear", "sp": "ursus americanus", "xh": 0.8, "name": "American black bear", "wiki": "American black bear", "desc": "An omnivore feeding on beechnuts, berries, insects and carrion, and occasionally on calves or fawns."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Drives growth of the canopy and understory plants in the short northern summer."}, {"id": "snow", "sp": "snow and cold winters", "xh": 0.3}, {"id": "rain", "sp": "rain and streams", "xh": 0.5}, {"id": "soil", "sp": "forest soil", "xh": 0.7, "desc": "Leaf litter and rich soils on the slopes hold the nutrients that trees and wildflowers draw on."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "desc": "Break down leaf litter, dead wood and carcasses and return nutrients to the soil."}], "raw": [["sun", "beech", "r"], ["rain", "beech", "r"], ["soil", "beech", "r"], ["sun", "birch", "r"], ["rain", "birch", "r"], ["soil", "birch", "r"], ["sun", "fir", "r"], ["rain", "fir", "r"], ["soil", "fir", "r"], ["sun", "stripedmaple", "r"], ["rain", "stripedmaple", "r"], ["soil", "stripedmaple", "r"], ["sun", "clintonia", "r"], ["soil", "clintonia", "r"], ["beech", "deer"], ["birch", "deer"], ["fir", "deer"], ["clintonia", "deer"], ["stripedmaple", "moose"], ["stripedmaple", "deer"], ["fir", "beaver"], ["birch", "beaver"], ["beech", "beaver"], ["birch", "porcupine"], ["beech", "porcupine"], ["fir", "redsq