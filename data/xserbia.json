{"id": "xserbia", "name": "Đerdap National Park", "short": "Đerdap", "place": "Serbia", "lat": 44.6, "lon": 22.0, "side": "r", "cont": "Europe", "country": "Serbia", "blurb": "Danube gorge forests, relict trees, roe deer, griffons and a few lynx.", "tip": {"id": "roedeer", "title": "Remove the roe deer", "text": "Roe deer are the lynx's preferred prey and leave carcasses for scavengers. Set European roe deer to -100% and watch the lynx, then the griffon vulture and raven."}, "sources": [{"title": "Wikipedia: Đerdap National Park", "url": "https://en.wikipedia.org/wiki/%C4%90erdap_National_Park"}, {"title": "Wikipedia: Iron Gates", "url": "https://en.wikipedia.org/wiki/Iron_Gates"}, {"title": "Wikipedia: Eurasian lynx", "url": "https://en.wikipedia.org/wiki/Eurasian_lynx"}, {"title": "Wikipedia: Roe deer", "url": "https://en.wikipedia.org/wiki/Roe_deer"}, {"title": "Wikipedia: Griffon vulture", "url": "https://en.wikipedia.org/wiki/Griffon_vulture"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Đerdap National Park", "icon": "aspen", "kind": "Forest", "park": true, "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Sun drives growth in the gorge forests, where steep rock slopes create warm and cool pockets side by side."}, {"id": "rain", "sp": "rainfall", "xh": 0.26, "desc": "Rain feeds the forests and the karst springs and streams that run down into the gorge."}, {"id": "danube", "sp": "danube river", "xh": 0.44}, {"id": "soil", "sp": "soil & leaf litter", "xh": 0.62}, {"id": "decomp", "sp": "decomposer community", "xh": 0.84, "name": "Fungi & soil decomposers", "desc": "Break down fallen leaves, wood and carcasses and return nutrients to the soil."}, {"id": "quercus", "sp": "quercus", "xh": 0.1, "name": "Downy oak & other oaks", "wiki": "Quercus pubescens", "desc": "Wikipedia lists downy oak among the relict tree species of the park. Acorns feed many forest animals.", "badge": "Foundation species"}, {"id": "fagus", "sp": "fagus sylvatica", "xh": 0.34, "wiki": "Fagus sylvatica", "desc": "A common broadleaf forest tree of the Balkan hills, producing beechnuts that forest animals eat.", "no": ["badge"]}, {"id": "corylus", "sp": "corylus colurna", "xh": 0.58}, {"id": "robinia", "sp": "robinia pseudoacacia", "xh": 0.82, "name": "False acacia", "desc": "An introduced tree that is the most recorded plant near the park in GBIF. It grows thickly on disturbed ground.", "ic": "willow"}, {"id": "roedeer", "sp": "capreolus capreolus", "xh": 0.06, "wiki": "Roe deer", "desc": "Feeds on grass, leaves, berries and young shoots. Where it is common it is the preferred prey of the Eurasian lynx."}, {"id": "boar", "sp": "sus scrofa", "xh": 0.22, "desc": "An omnivore that roots through forest floors for nuts, plants and small animals. Wikipedia says deer and boar are common around the park."}, {"id": "flavicollis", "sp": "apodemus flavicollis", "xh": 0.38, "desc": "A seed-eating forest rodent and a staple prey of martens, hedgehogs and birds of prey."}, {"id": "dormouse", "sp": "glis glis", "xh": 0.54, "desc": "A tree-living rodent that eats nuts, seeds and fruit in broadleaf forest.", "ic": "rsquirrel"}, {"id": "jay", "sp": "garrulus glandarius", "xh": 0.7, "desc": "A woodland crow that eats acorns and other seeds along with insects, and is among the most recorded forest birds nearby."}, {"id": "pigeon", "sp": "columba palumbus", "xh": 0.88, "desc": "Eats seeds, buds, leaves and acorns in woodland and fields."}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.1, "desc": "A bird of prey that hunts small mammals and birds from perches over forest edges and clearings."}, {"id": "marten", "sp": "martes foina", "xh": 0.3, "desc": "An omnivorous mustelid that hunts rodents and birds and also eats fruit.", "ic": "fox"}, {"id": "hedgehog", "sp": "erinaceus concolor", "xh": 0.5, "desc": "A ground-foraging insect and small-animal eater of woodland edges and scrub."}, {"id": "griffon", "sp": "gyps fulvus", "xh": 0.7, "desc": "A large scavenger that feeds on carrion and nests on cliffs. It is the most recorded bird near the park in GBIF."}, {"id": "raven", "sp": "corvus corax", "xh": 0.9, "desc": "A clever omnivore that scavenges carcasses and also takes small animals."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.5, "desc": "The park's top predator, with a small population reported in the 2020s. It prefers roe deer where they are common."}], "raw": [["sun", "quercus", "r"], ["sun", "fagus", "r"], ["sun", "corylus", "r"], ["sun", "robinia", "r"], ["rain", "quercus", "r"], ["rain", "fagus", "r"], ["rain", "corylus", "r"], ["rain", "robinia", "r"], ["danube", "quercus", "r"], ["danube", "fagus", "r"], ["danube", "corylus", "r"], ["danube", "robinia", "r"], ["soil", "quercus", "r"], ["soil", "fagus", "r"], ["soil", "corylus", "r"], ["soil", "robinia", "r"], ["decomp", "soil", "r"], ["quercus", "decomp", "d"], ["fagus", "decomp", "d"], ["corylus", "decomp", "d"], ["robinia", "decomp", "d"], ["quercus", "roedeer"], ["quercus", "boar"], ["quercus", "dormouse"], ["quercus", "flavicollis"], ["quercus", "jay"], ["quercus", "pigeon"], ["fagus", "boar"], ["fagus", "dormouse"], ["fagus", "flavicollis"], ["fagus", "roedeer"], ["corylus", "dormouse"], ["corylus", "jay"], ["corylus", "flavicollis"], ["robinia", "boar"], ["roedeer", "lynx"], ["flavicollis", "boar"], ["dormouse", "boar"], ["flavicollis", "hedgehog"], ["flavicollis", "marten"], ["dormouse", "marten"], ["pigeon", "marten"], ["hedgehog", "marten"], ["flavicollis", "buzzard"], ["jay", "buzzard"], ["pigeon", "buzzard"], ["flavicollis", "raven"], ["roedeer", "griffon", "s"], ["roedeer", "raven", "s"], ["boar", "griffon", "s"], ["boar", "raven", "s"], ["roedeer", "decomp", "d"], ["boar", "decomp", "d"], ["fagus", "jay"],