{"id": "nppinnacles", "name": "Pinnacles National Park", "short": "Pinnacles", "place": "California, USA", "lat": 36.49, "lon": -121.18, "side": "l", "cont": "North America", "country": "United States of America", "states": ["California"], "kind": "Desert", "park": true, "blurb": "Chaparral, cliff-nesting falcons, cave bats and reintroduced condors.", "tip": {"id": "rain", "title": "Cut the winter rain", "text": "Chaparral shrubs and wildflowers depend on winter rain. Set Winter rain to -80% and watch the shrubs, then the bees, moths and the animals that eat them."}, "sources": [{"title": "Wikipedia: Pinnacles National Park", "url": "https://en.wikipedia.org/wiki/Pinnacles_National_Park"}, {"title": "NPS: Pinnacles animals", "url": "https://www.nps.gov/pinn/learn/nature/animals.htm"}, {"title": "Wikipedia: California condor", "url": "https://en.wikipedia.org/wiki/California_condor"}, {"title": "Wikipedia: Prairie falcon", "url": "https://en.wikipedia.org/wiki/Prairie_falcon"}, {"title": "Wikipedia: Townsend's big-eared bat", "url": "https://en.wikipedia.org/wiki/Townsend%27s_big-eared_bat"}, {"title": "Wikipedia: California ground squirrel", "url": "https://en.wikipedia.org/wiki/California_ground_squirrel"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Pinnacles National Park, California condor, Prairie falcon). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Pinnacles National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Chaparral shrubs grow in open, sunny, dry slopes; sunlight drives all plant growth in the park."}, {"id": "rain", "sp": "winter rain", "xh": 0.3, "desc": "Rain falls mostly in the cooler months. Creeks in the park do not flow all year, so water is scarce for much of it."}, {"id": "fire", "sp": "fire", "xh": 0.5, "desc": "Fire has long shaped the park, from lightning and from Native American burning, and keeps chaparral renewing."}, {"id": "soil", "sp": "soil & nutrients", "xh": 0.7}, {"id": "decomp", "sp": "fungi, bacteria and invertebrates", "xh": 0.9}, {"id": "chamise", "sp": "adenostoma fasciculatum", "xh": 0.2}, {"id": "manzanita", "sp": "arctostaphylos glauca", "xh": 0.5}, {"id": "buckwheat", "sp": "eriogonum fasciculatum", "xh": 0.8}, {"id": "bees", "sp": "apis mellifera", "xh": 0.1, "wiki": "Western honey bee", "desc": "The best-recorded bee here. A 1990s census counted about 450 bee species in the park, most of them solitary, a very high density.", "ic": "hopper"}, {"id": "lepid", "sp": "lepidoptera", "xh": 0.26, "name": "Moths & butterflies", "wiki": "Lepidoptera", "desc": "Caterpillars eat shrub leaves and adults take nectar from flowers. Moths are the main prey of Townsend's big-eared bats."}, {"id": "kratrat", "sp": "dipodomys venustus", "xh": 0.42}, {"id": "squirrel", "sp": "otospermophilus beecheyi", "xh": 0.58, "wiki": "California ground squirrel"}, {"id": "jackrabbit", "sp": "lepus californicus", "xh": 0.74, "desc": "A large hare that browses shrubs and grasses in open country and is eaten by coyotes and bobcats."}, {"id": "quail", "sp": "callipepla californica", "xh": 0.9, "wiki": "California quail"}, {"id": "lizard", "sp": "sceloporus occidentalis", "xh": 0.08, "wiki": "Western fence lizard", "ic": "snake"}, {"id": "bat", "sp": "corynorhinus townsendii", "xh": 0.24}, {"id": "rattler", "sp": "crotalus oreganus", "xh": 0.4, "name": "Northern Pacific rattlesnake", "wiki": "Western rattlesnake", "desc": "An ambush predator of rodents. Ground squirrels are among its most frequent prey."}, {"id": "raven", "sp": "corvus corax", "xh": 0.56, "desc": "An omnivore and scavenger that eats carrion, insects, eggs and small animals."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.72, "wiki": "Turkey vulture", "desc": "A carrion eater that soars over the park and cleans up dead animals."}, {"id": "condor", "sp": "gymnogyps californianus", "xh": 0.88, "desc": "A scavenger released at Pinnacles from 2003. Lead from ammunition in carcasses is the main cause of death for wild adults."}, {"id": "falcon", "sp": "falco mexicanus", "xh": 0.2}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.5, "wiki": "Bobcat", "desc": "A solitary cat that hunts rabbits, rodents and birds across chaparral and woodland.", "ic": "lion"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.8, "wiki": "Coyote", "desc": "A flexible predator of rabbits, rodents and other small animals; it also scavenges."}], "raw": [["sun", "chamise", "r"], ["rain", "chamise", "r"], ["soil", "chamise", "r"], ["sun", "manzanita", "r"], ["rain", "manzanita", "r"], ["soil", "manzanita", "r"], ["sun", "buckwheat", "r"], ["rain", "buckwheat", "r"], ["soil", "buckwheat", "r"], ["fire", "chamise", "r"], ["fire", "manzanita", "r"], ["decomp", "soil", "r"], ["chamise", "decomp", "d"], ["manzanita", "decomp", "d"], ["buckwheat", "decomp", "d"], ["squirrel", "decomp", "d"], ["jackrabbit", "decomp", "d"], ["kratrat", "decomp", "d"], ["coyote", "decomp", "d"], ["bobcat", "decomp", "d"], ["condor", "decomp", "d"], ["vulture", "decomp", "d"], ["chamise", "lepid"], ["chamise", "bees"], ["manzanita", "lepid"], ["manzanita", "bees"], ["buckwheat", "lepid"], ["buckwheat", "bees"], ["buckwheat", "squirrel"], ["manzanita", "squirrel"], ["buckwheat", "jackrabbit"], ["chamise", "jackrabbit"], ["chamise", "kratrat"], ["buckwheat", "kratrat"], ["buckwheat", "quail"], ["manzanita", "quail"], ["lepid", "lizard"], ["bees", "lizard"], ["lepid", "bat"], ["squirrel", "rattler"], ["kratrat", "rattler"], ["lepid", "raven"], ["lizard", "raven"], ["squirrel", "coyote"], ["jackrabbit", "coyote"], ["kratrat", "coyote"], ["squirrel", "bobcat"], ["jackrabbit", "bobcat"], ["kratrat", "bobcat"], ["rattler", "bobcat"], ["quail", "bobcat"], ["squirrel", "falcon"], ["quail", "falcon"], ["lizard", "falcon"], ["squirrel", "raven", "s"], ["jackrabbit", "raven", "s"], ["squirrel", "vulture", "s"], ["jackrabbit", "vulture", "s"], ["coyote", "vulture", "s"], ["bobcat", "vulture", "s"], ["jackrabbit", "condor", "s"], ["squirrel", "condor", "s"], ["jackrabbit", "falcon"], ["lepid", "coyote"], ["raven", "coyote"]], "ev": {"chamise>lepid": ["a"], "chamise>bees": ["g", "Apis mellifera", "Adenostoma fasciculatum"], "manzanita>lepid": ["a"], "manzanita>bees": ["g", "Apis mellifera", "Arctostaphylos glauca"], "buckwheat>lepid": ["a"], "buckwheat>bees": ["g", "Apis mellifera", "Eriogonum fasciculatum"], "buckwheat>squirrel": ["gg", "Otospermophilus beecheyi", "Eriogonum fasciculatum"], "manzanita>squirrel": ["a"], "buckwheat>jackrabbit": ["a"], "chamise>jackrabbit": ["a"], "chamise>kratrat": ["a"], "buckwheat>kratrat": ["a"], "buckwheat>quail": ["a"], "manzanita>quail": ["gg", "Callipepla californica", "Arctostaphylos glauca"], "lepid>lizard": ["g", "Sceloporus occidentalis", "Lepidoptera"], "bees>lizard": ["g", "Sceloporus occidentalis", "Apis mellifera"], "lepid>bat": ["a"], "squirrel>rattler": ["g", "Crotalus oreganus", "Otospermophilus beecheyi"], "kratrat>rattler": ["gg", "Crotalus oreganus", "Dipodomys venustus"], "lepid>raven": ["a"], "lizard>raven": ["a"], "squirrel>coyote": ["g", "Canis latrans", "Otospermophilus beecheyi"], "jackrabbit>coyote": ["g", "Canis latrans", "Lepus californicus"], "kratrat>coyote": ["g", "Canis latrans", "Dipodomys venustus"], "squirrel>bobcat": ["g", "Lynx rufus", "Otospermophilus beecheyi"], "jackrabbit>bobcat": ["g", "Lynx rufus", "Lepus californicus"], "kratrat>bobcat": ["g", "Lynx rufus", "Dipodomys venustus"], "rattler>bobcat": ["g", "Lynx rufus", "Crotalus oreganus"], "quail>bobcat": ["gg", "Lynx rufus", "Callipepla californica"], "squirrel>falcon": ["g", "Falco mexicanus", "Otospermophilus beecheyi"], "quail>falcon": ["gg", "Falco mexicanus", "Callipepla californica"], "lizard>falcon": ["gg", "Falco mexicanus", "Sceloporus occidentalis"], "squirrel>raven": ["gg", "Corvus corax", "Otospermophilus beecheyi"], "jackrabbit>raven": ["gg", "Corvus corax", "Lepus californicus"], "squirrel>vulture": ["g", "Cathartes aura", "Otospermophilus beecheyi"], "jackrabbit>vulture": ["g", "Cathartes aura", "Lepus californicus"], "coyote>vulture": ["g", "Cathartes aura", "Canis latrans"], "bobcat>vulture": ["g", "Cathartes aura", "Lynx rufus"], "jackrabbit>condor": ["a"], "squirrel>condor": ["a"], "jackrabbit>falcon": ["ga", "Falco mexicanus", "Lepus californicus"], "lepid>coyote": ["ga", "Canis latrans", "Lepidoptera"], "raven>coyote": ["ga", "Canis latrans", "Corvus corax"]}, "story": "Pinnacles National Park in central California protects the eroded remains of half of an extinct volcano, which has moved 200 miles along the San Andreas Fault. Its talus caves house at least 13 bat species. It became a national monument in 1908 and a national park in 2013.", "matters": "Prairie falcons find prime habitat here, and captive-hatched California condors are released here. Condors were extinct in the wild in 1987 and have since been reintroduced."}