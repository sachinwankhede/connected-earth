{"id": "nparches", "name": "Arches National Park", "short": "Arches", "place": "Utah, USA", "lat": 38.73, "lon": -109.59, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Utah"], "kind": "Desert", "park": true, "blurb": "Soil crust, kangaroo rats and cougars in Utah's red-rock desert.", "tip": {"id": "rain", "title": "Dry out the desert", "text": "Rain is scarce already. Set Rain & snowmelt to -100% and watch the crust and shrubs, then the deer, rabbits and rodents that depend on them."}, "sources": [{"title": "Wikipedia: Arches National Park", "url": "https://en.wikipedia.org/wiki/Arches_National_Park"}, {"title": "NPS: Arches animals", "url": "https://www.nps.gov/arch/learn/nature/animals.htm"}, {"title": "Wikipedia: Biological soil crust", "url": "https://en.wikipedia.org/wiki/Biological_soil_crust"}, {"title": "Wikipedia: Ord's kangaroo rat", "url": "https://en.wikipedia.org/wiki/Ord%27s_kangaroo_rat"}, {"title": "Wikipedia: Mule deer", "url": "https://en.wikipedia.org/wiki/Mule_deer"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Arches National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "crust", "sp": "microcoleus", "xh": 0.1}, {"id": "ricegrass", "sp": "achnatherum hymenoides", "xh": 0.3}, {"id": "blackbrush", "sp": "coleogyne ramosissima", "xh": 0.5}, {"id": "pricklypear", "sp": "opuntia polyacantha", "xh": 0.7, "name": "Prickly pear", "desc": "A spiny cactus, one of the park's most frequently recorded plants. Its pads store water in a land that gets under 10 inches of rain a year.", "ic": "sage"}, {"id": "juniper", "sp": "juniperus osteosperma", "xh": 0.9, "wiki": "Utah juniper"}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.06, "wiki": "Mule deer", "desc": "The park's most recorded large mammal. It mostly browses shrubs and trees, adds forbs in summer, and is a main prey of cougars."}, {"id": "bighorn", "sp": "ovis canadensis", "xh": 0.23, "name": "Desert bighorn sheep"}, {"id": "jackrabbit", "sp": "lepus californicus", "xh": 0.4, "wiki": "Black-tailed jackrabbit", "desc": "A big-eared hare of open desert shrubland that eats plants and carries juniper seeds. It is prey for snakes, bobcats and other predators."}, {"id": "cottontail", "sp": "sylvilagus audubonii", "xh": 0.57, "wiki": "Desert cottontail", "desc": "A small rabbit that is active at dawn and dusk and eats plants. Rattlesnakes, bullsnakes and bobcats take it."}, {"id": "kangrat", "sp": "dipodomys ordii", "xh": 0.74, "wiki": "Ord's kangaroo rat", "ic": "vole"}, {"id": "squirrel", "sp": "ammospermophilus leucurus", "xh": 0.91}, {"id": "raven", "sp": "corvus corax", "xh": 0.12, "desc": "By far the most recorded species near Arches. An opportunistic omnivore and scavenger that will eat carrion and take snakes and small birds."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.37, "name": "Turkey vulture", "wiki": "Turkey vulture", "desc": "A soaring scavenger that feeds on carrion, from small rodents to deer, helping recycle dead animals back into the web."}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.62, "wiki": "Gopher snake", "desc": "A large day-active constrictor that eats rodents, rabbits, lizards and birds. It is itself prey for ravens and bobcats.", "ic": "snake"}, {"id": "rattler", "sp": "crotalus oreganus", "xh": 0.87, "wiki": "Western rattlesnake"}, {"id": "cougar", "sp": "puma concolor", "xh": 0.3, "name": "Cougar", "desc": "A nocturnal big cat that lives in desert and mountains and prefers large prey such as mule deer and bighorn sheep."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.7, "wiki": "Bobcat", "desc": "A nocturnal small cat that hunts rabbits, rodents,