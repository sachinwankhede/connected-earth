{"id": "xlatvia", "name": "Gauja National Park", "short": "Gauja", "place": "Latvia", "lat": 57.42, "lon": 25.42, "side": "r", "cont": "Europe", "country": "Latvia", "blurb": "Sandstone river valley forest where wolves, lynx and beavers shape the woods.", "tip": {"id": "wolf", "title": "Take away the wolves", "text": "Wolves take moose, roe deer and boar. Set Gray wolf to -100% and watch those herbivores, then the aspen, pine and bilberry they browse."}, "sources": [{"title": "Wikipedia: Gauja National Park", "url": "https://en.wikipedia.org/wiki/Gauja_National_Park"}, {"title": "Wikipedia: Eurasian beaver", "url": "https://en.wikipedia.org/wiki/Eurasian_beaver"}, {"title": "Wikipedia: Eurasian lynx", "url": "https://en.wikipedia.org/wiki/Eurasian_lynx"}, {"title": "Wikipedia: Gray wolf", "url": "https://en.wikipedia.org/wiki/Gray_wolf"}, {"title": "Wikipedia: European roe deer", "url": "https://en.wikipedia.org/wiki/European_roe_deer"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Gauja National Park", "icon": "aspen", "tier": "overview", "kind": "Forest", "park": true, "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light reaching the forest floor and canopy drives plant growth through the short northern summer."}, {"id": "water", "sp": "gauja river and springs", "xh": 0.4}, {"id": "soil", "sp": "soil nutrients", "xh": 0.7, "desc": "Nutrients released from dead wood, leaves and carcasses are taken up again by forest plants."}, {"id": "decomp", "sp": "decomposers", "xh": 0.9, "desc": "Fungi, bacteria and invertebrates break down dead wood, leaf litter and carcasses and return nutrients to the soil."}, {"id": "pine", "sp": "pinus sylvestris", "xh": 0.1, "desc": "A common conifer of sandy and sandstone soils in northern Europe. Its seeds feed red squirrels and its shoots are browsed by moose in winter.", "no": ["badge"]}, {"id": "aspen", "sp": "populus tremula", "xh": 0.35}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.6, "desc": "A low berry shrub of the forest floor, recorded in the park. Its leaves and berries are eaten by deer, hares and foraging omnivores."}, {"id": "birdcherry", "sp": "prunus padus", "xh": 0.85}, {"id": "beaver", "sp": "castor fiber", "xh": 0.08, "desc": "Eats bark, shoots and water plants, and fells trees such as aspen and willow. Its dams make wetlands used by otters, voles and bats; it is also prey for wolves and sometimes lynx."}, {"id": "moose", "sp": "alces alces", "xh": 0.24, "desc": "The largest deer in the region; browses twigs, bark and shoots of pine, aspen and other trees and shrubs. A main prey of wolves."}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.4, "desc": "Small deer that feeds on grass, leaves, berries and young shoots. It is the preferred prey of lynx where common, and is also taken by wolves."}, {"id": "boar", "sp": "sus scrofa", "xh": 0.56, "desc": "An omnivore that roots in the forest floor for plant matter, berries and invertebrates. One of the main wolf prey animals across Eurasia."}, {"id": "squirrel", "sp": "sciurus vulgaris", "xh": 0.72, "name": "Eurasian red squirrel", "desc": "Feeds largely on conifer seeds such as pine. Recorded in the park and preyed on by pine martens."}, {"id": "hare", "sp": "lepus europaeus", "xh": 0.88, "desc": "Grazes grasses and herbs and browses twigs in winter. Prey of foxes, lynx and wolves."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.12, "wiki": "Red fox", "desc": "Hunts hares and young deer and scavenges carcasses. Also eaten by lynx where it is common."}, {"id": "marten", "sp": "martes martes", "xh": 0.34, "desc": "A forest-dwelling mustelid that hunts squirrels and small animals and also eats berries."}, {"id": "raccoondog", "sp": "nyctereutes procyonoides", "xh": 0.56, "desc": "An introduced omnivorous canid recorded in the park. Eats berries, small animals and carrion, and is taken by lynx.", "ic": "coyote"}, {"id": "raven", "sp": "corvus corax", "xh": 0.82, "wiki": "Common raven", "desc": "A widespread scavenger of the northern forest that feeds on carrion, including the remains of wolf and lynx kills."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.3, "desc": "Ambush hunter that prefers roe deer where they are common. When roe deer are scarce it turns to hares, beavers, foxes and raccoon dogs."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.7, "desc": "Preys mainly on moose, roe deer and wild boar across Eurasia, and also takes beavers and hares. Competes with lynx for prey."}], "raw": [["sun", "pine", "r"], ["sun", "aspen", "r"], ["sun", "bilberry", "r"], ["sun", "birdcherry", "r"], ["water", "aspen", "r"], ["water", "birdcherry", "r"], ["soil", "pine", "r"], ["soil", "bilberry", "r"], ["decomp", "soil", "r"], ["pine", "squirrel"], ["pine", "moose"], ["aspen", "beaver"], ["aspen", "moose"], ["aspen", "roe"], ["aspen", "hare"], ["bilberry", "moose"], ["bilberry", "roe"], ["bilberry", "boar"], ["bilberry", "hare"], ["bilberry", "marten"], ["bilberry", "raccoondog"], ["birdcherry", "moose"], ["birdcherry", "roe"], ["birdcherry", "boar"], ["beaver", "wolf"], ["beaver", "lynx"], ["moose", "wolf"], ["roe", "wolf"], ["roe", "lynx"], ["roe", "fox"], ["boar", "wolf"], ["squirrel", "marten"], ["hare", "fox"], ["hare", "lynx"], ["hare", "wolf"], ["fox", "lynx"], ["raccoondog", "lynx"], ["moose", "raven", "s"], ["moose", "fox", "s"], ["roe", "raven", "s"], ["roe", "raccoondog", "s"], ["boar", "raven", "s"], ["wolf", "raven", "s"], ["lynx", "raven", "s"], ["pine", "decomp", "d"], ["aspen", "decomp", "d"], ["bilberry", "decomp", "d"], ["birdcherry", "decomp", "d"], ["moose", "decomp", "d"], ["roe", "decomp", "d"], ["pine", "roe"], ["bilberry", "fox"], ["birdcherry", "fox"], ["beaver", "fox"], ["boar", "fox"], ["squirrel", "fox"], ["birdcherry", "marten"],