   "name": "Alpine chough",
   "latin": "Pyrrhocorax graculus",
   "tl": 2,
   "xh": 0.18,
   "wiki": "Alpine chough",
   "desc": "Picks insects from alpine pasture in summer and fruit in winter. Flocks gather around huts and ski areas for scraps.",
   "ic": "meadowlark"
  },
  {
