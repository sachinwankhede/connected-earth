  },
  {
   "id": "stonepine",
   "name": "Swiss stone pine",
   "latin": "Pinus cembra",
   "tl": 1,
   "xh": 0.12,
   "wiki": "Swiss pine",
   "desc": "A conifer of the uppermost forest belt in the Alps. On the Aletsch side it forms forest on moraine laid down after the glacier maximum around 1850.",
   "ic": "whitebark",
   "badge": "Foundation species"
  },
  {
   "id": "spruce",
