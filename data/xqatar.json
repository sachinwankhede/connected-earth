{"id": "xqatar", "name": "Al Reem Biosphere Reserve", "short": "Al Reem", "place": "Qatar", "lat": 25.75, "lon": 51.0, "side": "r", "cont": "Asia", "country": "Qatar", "kind": "Desert", "park": true, "blurb": "Rain-fed gravel desert where oryx, gazelles and sand cats share thin pickings.", "tip": {"id": "stip", "title": "Skip the rains", "text": "Rain wakes the desert grasses and shrubs. Cut Desert bunch grasses by 100% and watch the oryx, the beetles and desert larks, then the shrikes, monitors and cats that feed on them."}, "sources": [{"title": "Wikipedia: Al Reem Biosphere Reserve", "url": "https://en.wikipedia.org/wiki/Al_Reem_Biosphere_Reserve"}, {"title": "Wikipedia: Wildlife of Qatar", "url": "https://en.wikipedia.org/wiki/Wildlife_of_Qatar"}, {"title": "Wikipedia: Arabian oryx", "url": "https://en.wikipedia.org/wiki/Arabian_oryx"}, {"title": "Wikipedia: Arabian gazelle", "url": "https://en.wikipedia.org/wiki/Arabian_gazelle"}, {"title": "Wikipedia: Sand cat", "url": "https://en.wikipedia.org/wiki/Sand_cat"}, {"title": "Wikipedia: Desert monitor", "url": "https://en.wikipedia.org/wiki/Desert_monitor"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Al Reem Biosphere Reserve", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight and heat", "xh": 0.1, "desc": "Intense sun powers sparse plant growth, and daytime heat sends many animals into burrows or shade."}, {"id": "rain", "sp": "rare winter rain", "xh": 0.32}, {"id": "rawdat", "sp": "rainwater depressions (rawdat)", "xh": 0.54}, {"id": "soil", "sp": "thin desert soil", "xh": 0.74, "desc": "Weathered, nutrient-poor gravel and sand soil that limits how much vegetation the desert can carry."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Bacteria and fungi", "desc": "Break down dead plants and animals, returning scarce nutrients to the soil."}, {"id": "stip", "sp": "stipagrostis", "xh": 0.2}, {"id": "samr", "sp": "vachellia tortilis", "xh": 0.5, "name": "Samr acacia", "desc": "A drought-tolerant thorny tree, among the most common plants in Qatar. Its pods and foliage are used as desert fodder and it fixes nitrogen in the soil.", "badge": "Foundation species"}, {"id": "arfaj", "sp": "rhanterium epapposum", "xh": 0.8}, {"id": "oryx", "sp": "oryx leucoryx", "xh": 0.1}, {"id": "gazelle", "sp": "gazella marica", "xh": 0.3}, {"id": "mastigure", "sp": "uromastyx aegyptia", "xh": 0.5}, {"id": "beetle", "sp": "adesmia cancellata", "xh": 0.7}, {"id": "deslark", "sp": "ammomanes deserti", "xh": 0.9}, {"id": "mesalina", "sp": "mesalina brevirostris", "xh": 0.12}, {"id": "wheatear", "sp": "oenanthe deserti", "xh": 0.37}, {"id": "shrike", "sp": "lanius excubitor", "xh": 0.62, "desc": "A perch-and-pounce predator of rodents, songbirds, lizards and large insects, which it impales on thorns.", "ic": "hawk"}, {"id": "viper", "sp": "cerastes gasperettii", "xh": 0.87}, {"id": "monitor", "sp": "varanus griseus", "xh": 0.2, "desc": "A burrowing carnivore that eats small mammals, reptiles, birds, eggs and insects, and also scavenges carrion."}, {"id": "sandcat", "sp": "felis margarita", "xh": 0.5}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.8, "tl": 4, "wiki": "Red fox", "desc": "An omnivore that takes small animals, birds, reptiles and insects, and eats carrion. Qatar has two fox species."}], "raw": [["sun", "stip", "r"], ["sun", "samr", "r"], ["sun", "arfaj", "r"], ["rain", "stip", "r"], ["rain", "arfaj", "r"], ["rain", "samr", "r"], ["rawdat", "samr", "r"], ["rawdat", "arfaj", "r"], ["rawdat", "stip", "r"], ["soil", "samr", "r"], ["decomp", "soil", "r"], ["stip", "oryx"], ["stip", "mastigure"], ["arfaj", "mastigure"], ["arfaj", "gazelle"], ["samr", "gazelle"], ["stip", "deslark"], ["stip", "beetle"], ["beetle", "mesalin