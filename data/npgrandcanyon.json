 "nodes": [
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.2,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Strong desert sun drives plant growth on the rims and canyon slopes, though water is usually the limit.",
   "ic": "sun"
  },
  {
   "id": "rain",
   "name": "Rain & snowmelt",
   "latin": "",
   "tl": 0,
   "xh": 0.5,
   "cat": "abiotic",
   "wiki": "Precipitation",
   "desc": "Rain and snow vary a lot with elevation: the North Rim gets far more precipitation and snow than the South Rim, and water limits plant life across the canyon.",
   "ic": "rain"
  },
  {
   "id": "fire",
   "name": "Low-intensity fire",
   "latin": "",
   "tl": 0,
   "xh": 0.8,
   "cat": "abiotic",
   "wiki": "Wildfire",
   "desc": "Frequent, low fires are part of the natural cycle in ponderosa pine forest, clearing litter and keeping the forest open.",
   "ic": "fire"
  },
  {
   "id": "decomp",
   "name": "Fungi & soil microbes",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.95,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Break down dead wood, needles, grasses and carcasses and return nutrients to thin canyon-country soils.",
   "ic": "decomp"
  },
  {
   "id": "ponderosa",
   "name": "Ponderosa pine",
   "latin": "Pinus ponderosa",
   "tl": 1,
   "xh": 0.08,
   "badge": "Foundation species",
   "wiki": "Pinus ponderosa",
   "desc": "Dominant tree of the cooler rim forests. Its seeds feed squirrels and chipmunks, and its seedlings are browsed by mule deer.",
   "ic": "whitebark"
  },
  {
   "id": "pinyon",
   "name": "Pinyon pine",
   "latin": "Pinus edulis",
   "tl": 1,
   "xh": 0.24,
   "wiki": "Pinus edulis",
   "desc": "A small pine of the drier woodland below the pine forest. Rock squirrels are recorded eating its seeds.",
   "ic": "whitebark"
  },
  {
   "id": "oak",
   "name": "Gambel oak",
   "latin": "Quercus gambelii",
   "tl": 1,
   "xh": 0.4,
   "wiki": "Quercus gambelii",
   "desc": "A shrubby oak whose acorns and leaves feed squirrels, mice and browsing deer on the rims.",
   "ic": "willow"
  },
  {
   "id": "cliffrose",
   "name": "Stansbury cliffrose",
   "latin": "Purshia stansburiana",
   "tl": 1,
   "xh": 0.56,
   "wiki": "Purshia stansburiana",
   "desc": "A tough desert shrub that deer browse on dry slopes.",
   "ic": "sage"
  },
  {
   "id": "pricklypear",
   "name": "Prickly pear cactus",
   "latin": "Opuntia",
   "tl": 1,
   "xh": 0.72,
   "wiki": "Opuntia",
   "desc": "Cacti like prickly pear store water in dry ground. GloBI records bighorn sheep eating cacti.",
   "ic": "sage"
  },
  {
   "id": "grass",
   "name": "Grasses",
   "latin": "Poaceae",
   "tl": 1,
   "xh": 0.9,
   "wiki": "Poaceae",
   "desc": "Bunchgrasses and other grasses grow in open forest and on dry ground and feed elk, deer and bighorn.",
   "ic": "grass"
  },
  {
   "id": "elk",
   "name": "Elk",
   "latin": "Cervus canadensis",
   "tl": 2,
   "xh": 0.06,
   "wiki": "Elk",
   "desc": "A large grazer of rim meadows and open forest. Cougars and coyotes take elk, and their carcasses feed scavengers.",
   "ic": "elk"
  },
  {
   "id": "muledeer",
   "name": "Mule deer",
   "latin": "Odocoileus hemionus",
   "tl": 2,
   "xh": 0.2,
   "wiki": "Mule deer",
   "desc": "Browses shrubs and young pines on the rims and is a main prey of cougars and a main carcass for scavengers.",
   "ic": "muledeer"
  },
  {
   "id": "bighorn",
   "name": "Bighorn sheep",
   "latin": "Ovis canadensis",
   "tl": 2,
   "xh": 0.34,
   "wiki": "Bighorn sheep",
   "desc": "A climber of canyon cliffs that grazes and browses. Cougars take bighorn sheep, among other large prey.",
   "ic": "quad"
  },
  {
   "id": "rocksq",
   "name": "Rock squirrel",
   "latin": "Otospermophilus variegatus",
   "tl": 2,
   "xh": 0.5,
   "wiki": "Rock squirrel",
   "desc": "A common ground squirrel of rocky slopes. GloBI records it eating juniper and pinyon seeds, and hawks and coyotes prey on it.",
   "ic": "gsquirrel"
  },
  {
   "id": "abert",
   "name": "Abert's squirrel",
   "latin": "Sciurus aberti",
   "tl": 2,
   "xh": 0.66,
   "wiki": "Abert's squirrel",
   "desc": "Lives in ponderosa pine forest and eats pine seeds. Its Kaibab race lives only on the Kaibab Plateau, including the North Rim.",
   "ic": "rsquirrel"
  },
  {
   "id": "deermouse",
   "name": "Deer mouse",
   "latin": "Peromyscus maniculatus",
   "tl": 2,
   "xh": 0.82,
   "wiki": "Deer mouse",
   "desc": "A small, widespread omnivore that eats seeds and insects and is food for hawks and coyotes.",
   "ic": "vole"
  },
  {
   "id": "coyote",
   "name": "Coyote",
   "latin": "Canis latrans",
   "tl": 3,
   "xh": 0.12,
   "wiki": "Coyote",
   "desc": "Hunts small mammals and also eats carrion. GloBI records it eating rock squirrels, mice and deer.",
   "ic": "coyote"
  },
  {
   "id": "hawk",
   "name": "Red-tailed hawk",
   "latin": "Buteo jamaicensis",
   "tl": 3,
   "xh": 0.3,
   "wiki": "Red-tailed hawk",
   "desc": "A soaring hawk that hunts squirrels and mice from the rim and canyon updrafts.",
   "ic": "hawk"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.48,
   "wiki": "Common raven",
   "desc": "A clever scavenger and the most recorded bird near the park. It feeds on carrion and scraps.",
   "ic": "raven"
  },
  {
   "id": "vulture",
   "name": "Turkey vulture",
   "latin": "Cathartes aura",
   "tl": 3,
   "xh": 0.66,
   "wiki": "Turkey vulture",
   "desc": "Finds carcasses by smell and feeds on carrion. GloBI records it eating mule deer and rock squirrels.",
   "ic": "hawk"
  },
  {
   "id": "condor",
   "name": "California condor",
   "latin": "Gymnogyps californianus",
   "tl": 3,
   "xh": 0.84,
   "wiki": "California condor",
   "desc": "A large scavenger released near the canyon in 1996. It eats carrion of large mammals such as deer, and lead from ammunition in carcasses is a main threat.",
   "ic": "baldeagle"
  },
  {
   "id": "cougar",
   "name": "Mountain lion",
   "latin": "Puma concolor",
   "tl": 4,
   "xh": 0.4,
   "wiki": "Cougar",
   "desc": "Deer and elk are its main prey, and it also takes bighorn sheep. It lives in forests and rugged canyon country.",
   "ic": "lion"
  }
 ],
