ning nutrients to the water."}, {"id": "giantkelp", "sp": "macrocystis pyrifera", "xh": 0.14}, {"id": "bullkelp", "sp": "nereocystis luetkeana", "xh": 0.34}, {"id": "phyto", "sp": "microscopic algae", "xh": 0.78}, {"id": "urchin", "sp": "strongylocentrotus purpuratus", "xh": 0.06}, {"id": "abalone", "sp": "haliotis cracherodii", "xh": 0.18}, {"id": "kelpcrab", "sp": "pugettia producta", "xh": 0.3}, {"id": "amph", "sp": "amphipoda", "xh": 0.42}, {"id": "mussel", "sp": "mytilus californianus", "xh": 0.82}, {"id": "star", "sp": "pycnopodia helianthoides", "xh": 0.08}, {"id": "otter", "sp": "enhydra lutris nereis", "xh": 0.24}, {"id": "rockfish", "sp": "sebastes spp.", "xh": 0.42}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.62}, {"id": "sealion", "sp": "zalophus californianus", "xh": 0.78}, {"id": "shark", "sp": "carcharodon carcharias", "xh": 0.36}, {"id": "orca", "sp": "orcinus orca", "xh": 0.7, "wiki": "Killer whale", "desc": "The main mammalian predator of sea otters, and has killed great white sharks off California. Also eats seals and sea lions.", "badge": "Apex predator"}], "raw": [["giantkelp", "urchin"], ["giantkelp", "abalone"], ["giantkelp", "kelpcrab"], ["bullkelp", "urchin"], ["bullkelp", "abalone"], ["bullkelp", "kelpcrab"], ["giantkelp", "amph"], ["phyto", "mussel"], ["urchin", "otter"], ["urchin", "star"], ["abalone", "otter"], ["abalone", "star"], ["kelpcrab", "otter"], ["kelpcrab", "star"], ["mussel", "otter"], ["mussel", "star"], ["amph", "rockfish"], ["rockfish", "seal"], ["rockfish", "sealion"], ["seal", "shark"], ["sealion", "shark"], ["otter", "shark"], ["seal", "orca"], ["sealion", "orca"], ["otter", "orca"], ["shark", "orca"], ["sun", "giantkelp", "r"], ["sun", "bullkelp", "r"], ["sun", "phyto", "r"], ["upwell", "giantkelp", "r"], ["upwell", "bullkelp", "r"], ["upwell", "phyto", "r"], ["cool", "giantkelp", "r"], ["cool", "bullkelp", "r"], ["giantkelp", "decomp", "d"], ["bullkelp", "decomp", "d"], ["phyto", "decomp", "d"], ["otter", "decomp",