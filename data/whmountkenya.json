{"id": "whmountkenya", "name": "Mount Kenya National Park/Natural Forest", "short": "Mount Kenya", "place": "Kenya", "lat": -0.15, "lon": 37.3, "side": "r", "cont": "Africa", "country": "Kenya", "kind": "Polar & mountain", "park": true, "blurb": "Equatorial glaciers, giant groundsel and the forest-to-moorland belts of Kenya's water tower.", "tip": {"id": "rockhyrax", "title": "Thin out the hyraxes", "text": "Rock hyraxes are the main prey of Verreaux's eagle and also feed leopards. Set them to -100% and watch the eagle, leopard and lobelia respond."}, "sources": [{"title": "Wikipedia: Mount Kenya National Park", "url": "https://en.wikipedia.org/wiki/Mount_Kenya_National_Park"}, {"title": "Wikipedia: Mount Kenya", "url": "https://en.wikipedia.org/wiki/Mount_Kenya"}, {"title": "UNESCO World Heritage: Mount Kenya National Park/Natural Forest", "url": "https://whc.unesco.org/en/list/800/"}, {"title": "Wikipedia: Rock hyrax", "url": "https://en.wikipedia.org/wiki/Rock_hyrax"}, {"title": "Wikipedia: Verreaux's eagle", "url": "https://en.wikipedia.org/wiki/Verreaux%27s_eagle"}, {"title": "Wikipedia: Dendrosenecio keniodendron", "url": "https://en.wikipedia.org/wiki/Dendrosenecio_keniodendron"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Mount Kenya", "icon": "ice", "tier": "overview", "nodes": [{"id": "groundsel", "sp": "dendrosenecio keniodendron", "xh": 0.1}, {"id": "lobelia", "sp": "lobelia telekii", "xh": 0.28}, {"id": "bamboo", "sp": "yushania alpina", "xh": 0.46}, {"id": "tussock", "sp": "festuca", "xh": 0.64, "name": "Tussock grasses", "desc": "Grasses and sedges that cover the moorland glades above the tree line and feed the mountain's grazers."}, {"id": "forest", "sp": "podocarpus", "xh": 0.82}, {"id": "rockhyrax", "sp": "procavia capensis", "xh": 0.05, "desc": "Lives in rocky crevices up to the moorlands and eats plants including lobelia. It is the main prey of Verreaux's eagle."}, {"id": "treehyrax", "sp": "dendrohyrax arboreus", "xh": 0.19}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.33, "wiki": "African elephant", "desc": "Moves through forest and bamboo on the lower slopes and has been recorded feeding on giant groundsel. Fences keep it out of nearby farms."}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.47, "desc": "Common in the lower forest and glades, grazing grass in herds."}, {"id": "colobus", "sp": "colobus guereza", "xh": 0.61, "desc": "A black-and-white colobus monkey that lives in the forest canopy and eats mainly leaves."}, {"id": "bushbuck", "sp": "tragelaphus scriptus", "xh": 0.75}, {"id": "duiker", "sp": "sylvicapra grimmia", "xh": 0.89, "desc": "A small antelope found from the forest up into the moorlands, browsing leaves, shoots and fruit."}, {"id": "buzzard", "sp": "buteo augur", "xh": 0.2, "desc": "A common raptor of the mountain slopes and moorland that hunts small mammals and reptiles from the air."}, {"id": "vulture", "sp": "gypaetus barbatus", "xh": 0.5, "desc": "A mountain scavenger that lives on carrion, especially bones, and nests on cliffs."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.8, "desc": "Hunts and scavenges in the forest belt and drives off or scavenges from other predators' kills.", "ic": "coyote"}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.3, "desc": "A solitary hunter that lives at every altitude of the mountain, even the alpine zone, preying on hyraxes, antelope and monkeys.", "badge": "Keystone predator"}, {"id": "eagle", "sp": "aquila verreauxii", "xh": 0.7}, {"id": "glacier", "sp": "glaciers and snowmelt", "xh": 0.12}, {"id": "rain", "sp": "mountain rain and cloud", "xh": 0.38}, {"id": "soil", "sp": "volcanic soil", "xh": 0.64, "desc": "Fertile volcanic soils on the lower slopes support the dense vegetation and surrounding farmland."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Decomposers", "desc": "Fungi, bacteria and soil invertebrates that break down dead plants, dung and carcasses."}], "raw": [["glacier", "groundsel", "r"], ["glacier", "lobelia", "r"], ["rain", "groundsel", "r"], ["rain", "lobelia", "r"], ["rain", "bamboo", "r"], ["rain", "tussock", "r"], ["rain", "forest", "r"], ["soil", "bamboo", "r"], ["soil", "forest", "r"], ["soil", "tussock", "r"], ["groundsel", "elephant"], ["bamboo", "elephant"], ["forest", "elephant"], ["lobelia", "rockhyrax"], ["tussock", "rockhyrax"], ["forest", "treehyrax"], ["tussock", "buffalo"], ["forest", "buffalo"], ["forest", "colobus"], ["forest", "bushbuck"], ["forest", "duiker"], ["tussock", "duiker"], ["rockhyrax", "leopard"], ["treehyrax", "leopard"], ["bushbuck", "leopard"], ["duiker", "leopard"], ["colobus", "leopard"], ["rockhyrax", "eagle"], ["duiker", "buzzard"], ["buffalo", "hyena"], ["bushbuck", "hyena"], ["elephant", "hyena", "s"], ["elephant", "vulture"], ["buffalo", "vulture"], ["leopard", "vulture", "s"], ["leopard", "hyena", "s"], ["groundsel", "decomp", "d"], ["bamboo", "decomp", "d"], ["forest", "decomp", "d"], ["elephant", "decomp", "d"], ["buffalo", "decomp", "d"], ["decomp", "soil", "r"], ["colobus", "hyena"], ["duiker", "hyena"], ["buffalo", "leopard"], ["hyena", "leopard"]], "ev": {"groundsel>elephant": ["a"], "bamboo>elephant": ["a"], "forest>elephant": ["a"], "lobelia>rockhyrax": ["a"], "tussock>rockhyrax": ["a"], "forest>treehyrax": ["a"], "tussock>buffalo": ["a"], "forest>buffalo": ["a"], "forest>colobus": ["a"], "forest>bushbuck": ["a"], "forest>duiker": ["a"], "tussock>duiker": ["a"], "rockhyrax>leopard": ["g", "Panthera pardus", "Procavia capensis"], "treehyrax>leopard": ["g", "Panthera pardus", "Dendrohyrax arboreus"], "bushbuck>leopard": ["g", "Panthera pardus", "Tragelaphus scriptus"], "duiker>leopard": ["g", "Panthera pardus", "Sylvicapra grimmia"], "colobus>leopard": ["gg", "Pant