{"id": "serengeti", "name": "Serengeti", "short": "Serengeti", "place": "Tanzania and Kenya", "lat": -2.4, "lon": 34.9, "side": "r", "blurb": "The great migration, big cats, and the grass that feeds it all.", "story": "Over 1.5 million wildebeest, along with zebras and gazelles, make the largest annual animal migration in the world across the Serengeti of northern Tanzania and southwestern Kenya. Lions, hyenas, leopards and crocodiles live off those herds, and the herds live off the grass.", "matters": "The Serengeti National Park has the largest lion population in Africa, and the wider Serengeti is counted among the Seven Natural Wonders of Africa. The park is under threat from deforestation, population growth, poaching and ranching.", "tip": {"id": "wildebeest", "title": "Follow the migration", "text": "More than a million wildebeest move through this web each year. Select them, lower their numbers, and watch the lions, hyenas and grass respond."}, "nodes": [{"id": "redoat", "sp": "themeda triandra", "xh": 0.2, "name": "Red oat grass"}, {"id": "star", "sp": "cynodon and digitaria spp.", "xh": 0.45}, {"id": "acacia", "sp": "vachellia tortilis", "xh": 0.72, "desc": "Flat-topped trees that feed giraffes and elephants and shade the ground beneath."}, {"id": "rivalg", "sp": "periphyton", "xh": 0.93}, {"id": "wildebeest", "sp": "connochaetes taurinus", "xh": 0.08}, {"id": "zebra", "sp": "equus quagga", "xh": 0.2}, {"id": "gazelle", "sp": "eudorcas thomsonii", "xh": 0.31}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.43}, {"id": "giraffe", "sp": "giraffa camelopardalis", "xh": 0.54}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.65, "wiki": "African elephant", "desc": "Pushes over trees and digs for water, opening woodland into grassland."}, {"id": "hippo", "sp": "hippopotamus amphibius", "xh": 0.76, "desc": "Grazes grass on land at night and fertilizes rivers with its dung by day.", "ic": "bison"}, {"id": "termites", "sp": "macrotermes spp.", "xh": 0.87}, {"id": "tilapia", "sp": "oreochromis spp.", "xh": 0.96}, {"id": "cheetah", "sp": "acinonyx jubatus", "xh": 0.18}, {"id": "wilddog", "sp": "lycaon pictus", "xh": 0.3}, {"id": "jackal", "sp": "lupulella mesomelas", "xh": 0.42, "desc": "Takes gazelle fawns and rodents and cleans up scraps at kills."}, {"id": "aardwolf", "sp": "proteles cristata", "xh": 0.6, "desc": "A small hyena relative that laps up thousands of termites a night.", "ic": "fox"}, {"id": "vulture", "sp": "gyps rueppelli", "xh": 0.78}, {"id": "lion", "sp": "panthera leo", "xh": 0.25, "desc": "Hunts wildebeest, zebra and buffalo in prides, and its kills feed hyenas, jackals and vultures."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.5, "desc": "A solitary ambush hunter that hauls kills into trees, out of reach of lions and hyenas."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.72, "tl": 4, "ic": "coyote"}, {"id": "croc", "sp": "crocodylus niloticus", "xh": 0.93, "desc": "Ambushes wildebeest and zebra at river crossings and eats fish between migrations."}, {"id": "sun", "sp": "sunlight", "xh": 0.12, "desc": "Drives grass growth. Heat and light are plentiful, so water, not sun, limits the plains."}, {"id": "rain", "sp": "seasonal rains", "xh": 0.38}, {"id": "soil", "sp": "volcanic soil", "xh": 0.64, "desc": "Ash from old volcanoes makes the southern plains rich in minerals but shallow."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Dung beetles & fungi", "wiki": "Dung beetle", "desc": "Break down dung, carcasses and dead grass and return nutrients to the soil."}], "raw": [["sun", "redoat", "r"], ["sun", "star", "r"], ["sun", "acacia", "r"], ["sun", "rivalg", "r"], ["rain", "redoat", "r"], ["rain", "star", "r"], ["rain", "acacia", "r"], ["rain", "rivalg", "r"], ["soil", "redoat", "r"], ["soil", "star", "r"], ["soil", "acacia", "r"], ["decomp", "soil", "r"], ["redoat", "wildebeest"], ["redoat", "zebra"], ["redoat", "buffalo"], ["redoat", "elephant"], ["redoat", "termites