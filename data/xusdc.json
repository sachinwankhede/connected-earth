{"id": "xusdc", "name": "Rock Creek Park", "short": "Rock Creek Park", "place": "Washington, D.C., USA", "lat": 38.97, "lon": -77.05, "side": "r", "cont": "North America", "country": "United States of America", "states": ["District of Columbia"], "kind": "Forest", "park": true, "blurb": "Beech forest, deer and coyotes in an urban valley along Rock Creek.", "tip": {"id": "coyote", "title": "Remove the coyotes", "text": "Coyotes mostly take deer fawns, rabbits and rodents. Set Coyote to -100% and watch deer, then the browsed forest floor."}, "sources": [{"title": "Wikipedia: Rock Creek Park", "url": "https://en.wikipedia.org/wiki/Rock_Creek_Park"}, {"title": "NPS: Nature at Rock Creek Park", "url": "https://www.nps.gov/rocr/learn/nature/index.htm"}, {"title": "Wikipedia: White-tailed deer", "url": "https://en.wikipedia.org/wiki/White-tailed_deer"}, {"title": "Wikipedia: American beech", "url": "https://en.wikipedia.org/wiki/American_beech"}, {"title": "Wikipedia: Eastern gray squirrel", "url": "https://en.wikipedia.org/wiki/Eastern_gray_squirrel"}, {"title": "Wikipedia: Red fox", "url": "https://en.wikipedia.org/wiki/Red_fox"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Rock Creek Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "beech", "sp": "fagus grandifolia", "xh": 0.1, "desc": "A shade-tolerant forest tree whose nut crop feeds raccoons, foxes, deer, rabbits, squirrels and opossums. Old trunks often rot into cavities that wildlife use as shelter.", "ic": "willow", "badge": "Foundation species"}, {"id": "tulip", "sp": "liriodendron tulipifera", "xh": 0.3, "desc": "A tall native hardwood of the valley forest whose young shoots can be browsed by deer."}, {"id": "pawpaw", "sp": "asimina triloba", "xh": 0.5, "desc": "A small understory tree of moist woods whose large fruit is eaten by mammals such as raccoons, opossums and foxes.", "ic": "willow"}, {"id": "pokeweed", "sp": "phytolacca americana", "xh": 0.7, "desc": "A tall herb of forest edges and clearings whose dark purple berries are eaten by birds and several mammals.", "ic": "sage"}, {"id": "creeper", "sp": "parthenocissus quinquefolia", "xh": 0.9, "desc": "A native woody vine that climbs trees and walls. Its leaves and berries feed rabbits and birds.", "ic": "willow"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.06, "wiki": "White-tailed deer", "desc": "The park service says deer numbers need management to keep the ecosystem in balance. Heavy browsing reduces tree seedlings and wildflowers on the forest floor.", "badge": "Keystone grazer"}, {"id": "squirrel", "sp": "sciurus carolinensis", "xh": 0.22, "wiki": "Eastern gray squirrel", "desc": "An omnivore that eats nuts, buds and berries and buries thousands of caches each season. Forgotten caches can grow into new trees."}, {"id": "cottontail", "sp": "sylvilagus floridanus", "xh": 0.38, "wiki": "Eastern cottontail", "desc": "A small rabbit that eats herbs and vines at wooded edges and is prey for foxes and coyotes."}, {"id": "mouse", "sp": "peromyscus leucopus", "xh": 0.54, "wiki": "White-footed mouse", "desc": "A small woodland rodent that eats seeds and nuts, including beechnuts, and is food for many predators.", "ic": "vole"}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.7, "wiki": "North American beaver", "desc": "A semi-aquatic rodent that gnaws trees and shrubs along streams and cuts and dams them to build lodges.", "badge": "Ecosystem engineer"}, {"id": "robin", "sp": "turdus migratorius", "xh": 0.88, "tl": 2, "wiki": "American robin", "desc": "A very commonly recorded bird here that eats earthworms, insects and wild fruit such as berries."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.1, "wiki": "Raccoon", "desc": "An adaptable omnivore that eats fruit, nuts, eggs, small animals and food scraps. It is common in this urban park."}, {"id": "opossum", "sp": "didelphis virginiana", "xh": 0.35, "wiki": "Virginia opossum", "desc": "A nocturnal omnivore that eats fruit, small animals, insects and carrion."}, {"id": "crow", "sp": "corvus brachyrhynchos", "xh": 0.6, "wiki": "American crow", "desc": "A clever omnivorous bird that scavenges carcasses and eats eggs, insects and seeds."}, {"id": "garter", "sp": "thamnophis sirtalis", "xh": 0.85, "desc": "A small snake that hunts frogs, small rodents and birds near water and in damp woods."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.3, "tl": 4, "desc": "An omnivore centred on small rodents, rabbits and birds, with fruit in season. It has settled well in towns and cities."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.7, "wiki": "Coyote", "desc": "Often the main wild predator of deer in the eastern US, mostly taking fawns. It also eats rabbits, rodents and carrion.", "badge": "Keystone predator"}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light reaching the forest floor drives growth, and the leafy canopy shades the layers below."}, {"id": "rain", "sp": "rain & rock creek", "xh": 0.35}, {"id": "soil", "sp": "forest soil", "xh": 0.6, "desc": "Leaf litter and dead wood return nutrients to the forest soil."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, insects & bacteria", "desc": "Break down fallen leaves, dead wood and carcasses and return nutrients to the soil."}], "raw": [["sun", "beech", "r"], ["sun", "tulip", "r"], ["sun", "pawpaw", "r"], ["sun", "pokeweed", "r"], ["sun", "creeper", "r"], ["rain", "beech", "r"], ["rain", "tulip", "r"], ["rain", "pawpaw", "r"], ["rain", "pokeweed", "r"], ["rain", "creeper", "r"], ["soil", "beech", "r"], ["soil", "tulip", "r"], ["soil", "pawpaw", "r"], ["soil", "pokeweed", "r"], ["soil", "creeper", "r"], ["decomp", "soil", "r"], ["beech", "deer"], ["tulip", "deer"], ["beech", "squirrel"], ["beech"