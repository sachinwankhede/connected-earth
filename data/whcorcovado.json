{"id": "whcorcovado", "name": "Corcovado National Park", "short": "Corcovado", "place": "Costa Rica", "lat": 8.55, "lon": -83.58, "side": "l", "cont": "North America", "country": "Costa Rica", "kind": "Forest", "park": true, "blurb": "Osa lowland rainforest where jaguars, tapirs, macaws and monkeys share the fruit.", "tip": {"id": "jaguar", "title": "Remove the jaguars", "text": "Jaguars hunt peccaries, agoutis, pacas and tapirs. Set Jaguar to -100% and watch those prey animals, then the fruit and seeds they eat and bury."}, "sources": [{"title": "Wikipedia: Corcovado National Park", "url": "https://en.wikipedia.org/wiki/Corcovado_National_Park"}, {"title": "Wikipedia: Osa Peninsula", "url": "https://en.wikipedia.org/wiki/Osa_Peninsula"}, {"title": "Wikipedia: Jaguar", "url": "https://en.wikipedia.org/wiki/Jaguar"}, {"title": "Wikipedia: Baird's tapir", "url": "https://en.wikipedia.org/wiki/Baird%27s_tapir"}, {"title": "Wikipedia: Scarlet macaw", "url": "https://en.wikipedia.org/wiki/Scarlet_macaw"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Corcovado National Park", "icon": "aspen", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Strong tropical sun drives growth, but little of it reaches the forest floor under the tall, dense canopy."}, {"id": "rain", "sp": "heavy rainfall", "xh": 0.45, "desc": "Very wet conditions on the Osa Peninsula keep the lowland forest green and swell the rivers and lagoons."}, {"id": "soil", "sp": "forest soil and leaf litter", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Fungi, bacteria and litter insects", "desc": "Break down fallen leaves, fruit, dung and carcasses, returning nutrients to the soil."}, {"id": "ficus", "sp": "ficus", "xh": 0.15, "desc": "Figs fruit through much of the year in tropical forests and are eaten by many monkeys, birds and other animals.", "ic": "aspen"}, {"id": "palm", "sp": "astrocaryum standleyanum", "xh": 0.4}, {"id": "heliconia", "sp": "heliconia", "xh": 0.65}, {"id": "cissus", "sp": "cissus verticillata", "xh": 0.88}, {"id": "agouti", "sp": "dasyprocta punctata", "xh": 0.1, "desc": "The most recorded mammal here; this rodent eats fruit and seeds and buries some, helping to spread trees."}, {"id": "paca", "sp": "cuniculus paca", "xh": 0.25}, {"id": "tapir", "sp": "tapirella bairdii", "xh": 0.4, "desc": "Endangered browser that eats leaves, twigs and fruit and sometimes passes seeds intact. Only jaguars and large crocodiles can kill adults."}, {"id": "peccary", "sp": "pecari tajacu", "xh": 0.55, "desc": "Pig-like forest herbivore that eats fruit, seeds, roots and vines, and is a staple prey of cats."}, {"id": "spider", "sp": "ateles geoffroyi", "xh": 0.7, "desc": "Canopy fruit specialist that moves widely to find ripe fruit, spreading seeds as it goes."}, {"id": "macaw", "sp": "ara macao", "xh": 0.84, "desc": "Eats fruit, nuts, seeds and flowers high in the canopy; the park holds Costa Rica's largest population."}, {"id": "iguana", "sp": "iguana iguana", "xh": 0.96, "desc": "A tree-climbing lizard that eats leaves, flowers and fruit and is eaten by snakes, birds and cats."}, {"id": "terciopelo", "sp": "bothrops asper", "xh": 0.2}, {"id": "ocelot", "sp": "leopardus pardalis", "xh": 0.45, "desc": "A medium-sized cat that hunts agoutis, pacas, small peccaries and other mammals, mostly at night."}, {"id": "blackvulture", "sp": "coragyps atratus", "xh": 0.7, "wiki": "Black vulture", "desc": "Common scavenger that feeds on carcasses and also takes small animals."}, {"id": "turkeyvulture", "sp": "cathartes aura", "xh": 0.88, "wiki": "Turkey vulture", "desc": "Soaring scavenger that finds carrion, including dead peccaries and reptiles."}, {"id": "jaguar", "sp": "panthera onca", "