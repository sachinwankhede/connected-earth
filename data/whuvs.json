eer."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "name": "Wolf", "wiki": "Wolf", "desc": "The main predator of argali, also taking roe deer and hares, especially in harsh winters.", "no": ["badge"]}, {"id": "eagle", "sp": "aquila nipalensis", "xh": 0.8, "tl": 4, "desc": "A large raptor of open steppe that hunts jerboas, hares and small foxes, with GloBI records of these meals.", "ic": "goldeneagle"}], "raw": [["sun", "stipa", "r"], ["sun", "phyto", "r"], ["rivers", "stipa", "r"], ["rivers", "pinus", "r"], ["saltlake", "phyto", "r"], ["soil", "stipa", "r"], ["soil", "pinus", "r"], ["decomp", "soil", "r"], ["stipa", "argali"], ["stipa", "ibex"], ["stipa", "roe"], ["pinus", "roe"], ["stipa", "hare"], ["stipa", "jerboa"], ["stipa", "crane"], ["phyto", "zoo"], ["zoo", "fish"], ["fish", "cormorant"], ["jerboa", "saker"], ["hare", "saker"], ["jerboa", "corsac"], ["hare", "corsac"], ["crane", "corsac"], ["cormorant", "corsac"], ["argali", "snowleo"], ["ibex", "snowleo"], ["roe", "snowleo"], ["argali", "wolf"], ["roe", "wolf"], ["hare", "wolf"], ["jerboa", "eagle"], ["hare", "eagle"], ["corsac", "eagle"], ["hare", "raven"], ["argali", "raven", "s"], ["roe", "raven", "s"], ["stipa", "decomp", "d"], ["pinus", "decomp", "d"], ["phyto", "decomp", "d"], ["argali", "decomp", "d"], ["wolf", "decomp", "d"], ["fish", "decomp", "d"], ["jerboa", "raven"], ["crane", "raven"], ["hare", "snowleo"], ["ibex", "wolf"], ["jerboa", "wolf"], ["crane", "wolf"], ["cormorant", "wolf"], ["corsac", "wolf"], ["raven", "wolf"]], "countries": ["Mongolia", "Russia"], "ev": {"stipa>argali": ["a"], "stipa>ibex": ["a"], "stipa>roe": ["a"], "pinus>roe": ["a"], "stipa>hare": ["a"], "stipa>jerboa": ["a"], "stipa>crane": ["a"], "phyto>zoo": ["a"], "zoo>fish": ["a"], "fish>cormorant": ["a"], "jerboa>saker": ["g", "Falco cherrug", "Allactaga sibirica"], "hare>saker": ["g", "Falco cherrug", "Lepus tolai"], "jerboa>corsac": ["g", "Vulpes corsac", "Allactaga sibirica"], "hare>corsac": ["g", "Vulpes corsac", "