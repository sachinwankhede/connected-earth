{"id": "whgrosmorne", "name": "Gros Morne National Park", "short": "Gros Morne", "place": "Newfoundland and Labrador, Canada", "lat": 49.6, "lon": -57.8, "side": "l", "cont": "North America", "country": "Canada", "blurb": "Moose, lynx and bears in a Newfoundland forest of fir, bog and coast.", "tip": {"id": "moose", "title": "Remove the moose", "text": "Moose were brought to Newfoundland around 1900 and now browse heavily. Set Moose to -100% and watch balsam fir and tamarack recover, while bears and ravens lose a big food source."}, "sources": [{"title": "Wikipedia: Gros Morne National Park", "url": "https://en.wikipedia.org/wiki/Gros_Morne_National_Park"}, {"title": "Wikipedia: Moose", "url": "https://en.wikipedia.org/wiki/Moose"}, {"title": "Wikipedia: American marten", "url": "https://en.wikipedia.org/wiki/American_marten"}, {"title": "Wikipedia: Canada lynx", "url": "https://en.wikipedia.org/wiki/Canada_lynx"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Gros Morne National Park", "icon": "moose", "kind": "Forest", "park": true, "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Short northern summers set the growing season for the forest, bogs and alpine heath."}, {"id": "precip", "sp": "rain, fog and snow", "xh": 0.32}, {"id": "soil", "sp": "peat and poor soils", "xh": 0.54}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "desc": "Break down fallen trees, leaf litter and carcasses, returning nutrients to the soil."}, {"id": "fir", "sp": "abies balsamea", "xh": 0.15, "wiki": "Balsam fir", "desc": "The common conifer of Newfoundland forests, and a winter browse for moose, hares and caribou. Its seeds and buds feed squirrels and others."}, {"id": "larch", "sp": "larix laricina", "xh": 0.38, "desc": "A deciduous conifer of bogs and wet ground. Moose, hares and voles eat its shoots and bark."}, {"id": "bunchberry", "sp": "cornus canadensis", "xh": 0.62, "name": "Bunchberry", "desc": "A low forest-floor plant with red berries, eaten by hares, voles, caribou and bears.", "ic": "sage"}, {"id": "labrador", "sp": "rhododendron groenlandicum", "xh": 0.85, "name": "Labrador tea", "ic": "sage"}, {"id": "vole", "sp": "microtus pennsylvanicus", "xh": 0.1, "wiki": "Meadow vole", "desc": "A small grassland and bog rodent that eats plant shoots and seeds. It is a staple prey for foxes and martens.", "ic": "vole"}, {"id": "squirrel", "sp": "tamiasciurus hudsonicus", "xh": 0.26, "wiki": "American red squirrel", "desc": "Feeds on conifer seeds and buds and is taken by lynx, fox and marten.", "ic": "rsquirrel"}, {"id": "hare", "sp": "lepus americanus", "xh": 0.42, "desc": "A browser of twigs, buds and low shrubs, and the main prey of the lynx."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.58, "wiki": "American beaver", "desc": "Cuts trees for food and dams, creating ponds that other wildlife use.", "badge": "Ecosystem engineer"}, {"id": "caribou", "sp": "rangifer tarandus", "xh": 0.74, "name": "Newfoundland caribou", "desc": "An ecotype of caribou found in the park. It grazes lichens and low plants, and calves can be taken by bears."}, {"id": "moose", "sp": "alces alces", "xh": 0.9, "desc": "Introduced to Newfoundland around 1900, it now reaches densities five to 20 times those in comparable areas. It browses fir, tamarack and other plants."}, {"id": "marten", "sp": "martes americana", "xh": 0.2, "desc": "The Newfoundland form is threatened. A forest hunter of voles, hares and squirrels, and itself prey of the red fox."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.5, "desc": "An opportunist that hunts hares, voles, squirrels and martens and scavenges carcasses."}, {"id": "raven", "sp": "corvus corax", "xh": 0.8, "wiki": "Common raven", "desc": "A scavenger that feeds on carcasses of moose and other animals."}, {"id": "lynx", "sp": "lynx canadensis", "xh": 0.3, "tl": 4, "desc": "A cat that hunts mainly snowshoe hares, and also takes squirrels and foxes. It is a top predator of the park."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.7, "wiki": "American black bear", "desc": "The Newfoundland form is a large omnivore that eats berries and also takes moose and caribou calves."}], "raw": [["sun", "fir", "r"], ["precip", "fir", "r"], ["soil", "fir", "r"], ["sun", "larch", "r"], ["precip", "larch", "r"], ["soil", "larch", "r"], ["sun", "bunchberry", "r"], ["precip", "bunchberry", "r"], ["soil", "bunchberry", "r"], ["sun", "labrador", "r"], ["precip", "labrador", "r"], ["soil", "labrador", "r"], ["decomp", "soil", "r"], ["fir", "moose"], ["fir", "hare"], ["fir", "squirrel"], ["fir", "caribou"], ["fir", "beaver"], ["fir", "vole"], ["larch", "moose"], ["larch", "hare"], ["larch", "caribou"], ["larch", "vole"], ["larch", "beaver"], ["bunchberry", "hare"], ["bunchberry", "caribou"], ["bunchberry", "vole"], ["bunchberry", "bear"], ["labrador", "hare"], ["labrador", "caribou"], ["labrador", "vole"], ["hare", "lynx"], ["squirrel", "lynx"], ["fox", "lynx"], ["beaver", "lynx"], ["hare", "fox"], ["squirrel", "fox"], ["vole", "fox"], ["beaver", "fox"], ["hare", "marten"], ["squirrel", "marten"], ["vole", "marten"], ["marten", "fox"], ["hare", "bear"], ["beaver", "bear"], ["moose", "bear"], ["caribou", "bear"], ["moose", "fox", "s"], ["moose", "raven", "s"], ["caribou", "raven", "s"], ["fir", "decomp", "d"], ["larch", "decomp", "d"], ["moose", "decomp", "d"], ["caribou", "decomp", "d"], ["hare", "decomp", "d"], ["beaver", "decomp", "d"], ["bear", "decomp", "d"], ["lynx", "decomp", "d"], ["bunchberry", "raven"], ["beaver", "marten"], ["caribou", "marten"], ["moose", "marten"], ["caribou", "fox"], ["squirrel", "raven"], ["hare", "raven"], ["beaver", "raven"], ["vole", "bear"], ["marten", "bear"]], "ev": {"fir>moose": ["a"], "fir>hare": ["g