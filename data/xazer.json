{"id": "xazer", "name": "Hirkan National Park", "short": "Hirkan", "place": "Azerbaijan", "lat": 38.63, "lon": 48.71, "side": "r", "cont": "Asia", "country": "Azerbaijan", "kind": "Forest", "park": true, "blurb": "Ancient Hyrcanian beech forest, wild boar, and the leopard that still roams it.", "tip": {"id": "leopard", "title": "Remove the leopard", "text": "Take out the Caucasian leopard and see boar, roe deer and porcupine lose a predator, and the jackal lose a source of carrion."}, "sources": [{"title": "Wikipedia: Hirkan National Park", "url": "https://en.wikipedia.org/wiki/Hirkan_National_Park"}, {"title": "Wikipedia: Hyrcanian forests", "url": "https://en.wikipedia.org/wiki/Hyrcanian_forests"}, {"title": "Wikipedia: Caucasian leopard", "url": "https://en.wikipedia.org/wiki/Caucasian_leopard"}, {"title": "Wikipedia: Wild boar", "url": "https://en.wikipedia.org/wiki/Wild_boar"}, {"title": "Wikipedia: Golden jackal", "url": "https://en.wikipedia.org/wiki/Golden_jackal"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Hirkan National Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.2, "desc": "Light for the forest canopy; the humid subtropical lowlands and cooler mountain slopes share the same energy source."}, {"id": "rain", "sp": "heavy rainfall", "xh": 0.5, "desc": "Annual rainfall of roughly 1,400 to 1,800 mm, the highest in Azerbaijan, keeps the forest lush."}, {"id": "nutr", "sp": "forest soil nutrients", "xh": 0.8, "desc": "Leaf litter and dead wood return nutrients to the soil, feeding the trees again."}, {"id": "decomp", "sp": "decomposers", "xh": 0.95, "desc": "Fungi, bacteria and soil invertebrates break down leaf litter, dead wood and carcasses."}, {"id": "beech", "sp": "fagus orientalis", "xh": 0.1, "desc": "The dominant tree at mid elevations of the Hyrcanian forest. Its nuts feed boar and other animals.", "ic": "willow"}, {"id": "oak", "sp": "quercus castaneifolia", "xh": 0.3}, {"id": "hornbeam", "sp": "carpinus betulus", "xh": 0.5, "name": "European hornbeam", "desc": "A broadleaf tree of the Hyrcanian forest; GloBI records several birds eating it."}, {"id": "dateplum", "sp": "diospyros lotus", "xh": 0.7}, {"id": "boar", "sp": "sus scrofa", "xh": 0.08, "name": "Wild boar", "desc": "An omnivore that eats acorns and beechnuts, roots and carrion, and is hunted by wolves and leopards."}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.26, "name": "Roe deer", "wiki": "Roe deer", "desc": "A small deer of the forest that browses leaves and buds. Wolves and leopards take it."}, {"id": "porc", "sp": "hystrix indica", "xh": 0.44}, {"id": "chaff", "sp": "fringilla coelebs", "xh": 0.62}, {"id": "tit", "sp": "parus major", "xh": 0.8}, {"id": "jackal", "sp": "canis aureus", "xh": 0.08, "desc": "An opportunist that eats small animals and fruit and scavenges the kills of wolves and leopards."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.28, "desc": "A small predator of birds and other animals, found in the park."}, {"id": "hawk", "sp": "accipiter nisus", "xh": 0.48}, {"id": "wood", "sp": "dendrocopos major", "xh": 0.68}, {"id": "bear", "sp": "ursus arctos", "xh": 0.9, "tl": 3, "desc": "A large omnivore of the Hyrcanian forest. It eats nuts, fruit and other foods."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.3, "name": "Caucasian leopard", "wiki": "Caucasian leopard", "desc": "Camera traps have photographed it in Hirkan. Elsewhere in its range it preys on boar, roe deer and porcupine.", "badge": "Keystone predator"}, {"id": "wolf", "sp": "canis lupus", "xh": 0.7, "desc": "A top predator of the Hyrcanian forest, and the main predator of wild boar across much of its range.", "no": ["badge"]}], "raw": [["sun", "beech", "r"], ["rain", "beech", "r"