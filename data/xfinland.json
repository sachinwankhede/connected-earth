{"id": "xfinland", "name": "Oulanka National Park", "short": "Oulanka", "place": "Finland", "lat": 66.4, "lon": 29.3, "side": "r", "cont": "Europe", "country": "Finland", "kind": "Forest", "park": true, "blurb": "Pine forest, bilberry and the bears, wolves and wolverines of the far north.", "tip": {"id": "bilberry", "title": "Lose the bilberry", "text": "Bilberry feeds voles, hares and bears. Set Bilberry to -100% and watch the voles, then the stoats and jays that eat them."}, "sources": [{"title": "Wikipedia: Oulanka National Park", "url": "https://en.wikipedia.org/wiki/Oulanka_National_Park"}, {"title": "Wikipedia: Wolverine", "url": "https://en.wikipedia.org/wiki/Wolverine"}, {"title": "Wikipedia: Eurasian brown bear", "url": "https://en.wikipedia.org/wiki/Eurasian_brown_bear"}, {"title": "Wikipedia: Western capercaillie", "url": "https://en.wikipedia.org/wiki/Western_capercaillie"}, {"title": "Wikipedia: Bilberry", "url": "https://en.wikipedia.org/wiki/Vaccinium_myrtillus"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Oulanka National Park", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "sun", "sp": "summer sunlight", "xh": 0.06, "desc": "Light drives the short boreal growing season near the Arctic Circle, when plants must grow and set fruit quickly."}, {"id": "snow", "sp": "winter snow cover", "xh": 0.24}, {"id": "river", "sp": "oulanka river & its floods", "xh": 0.42}, {"id": "soil", "sp": "boreal forest soil", "xh": 0.6}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & soil microbes", "desc": "Break down needles, leaves, wood and carcasses and return nutrients to the forest soil."}, {"id": "pine", "sp": "pinus sylvestris", "xh": 0.05, "wiki": "Pinus sylvestris", "desc": "Pine dominates the park's old, unlogged boreal forest; its seeds feed red squirrels and the trees shelter much forest life."}, {"id": "spruce", "sp": "picea abies", "xh": 0.2, "wiki": "Picea abies", "desc": "A widespread conifer of the northern forest whose seeds are eaten by red squirrels."}, {"id": "birch", "sp": "betula pubescens", "xh": 0.36, "name": "Downy birch", "desc": "A common northern broadleaf tree; hares and moose browse its twigs and birds eat its seeds."}, {"id": "willow", "sp": "salix caprea", "xh": 0.52}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.68, "desc": "A dwarf shrub of acidic open pine and spruce forest. Its leaves and berries feed voles, hares and bears.", "badge": "Foundation species"}, {"id": "cowberry", "sp": "vaccinium vitis-idaea", "xh": 0.84, "desc": "An evergreen berry shrub of pine forest floors, eaten by voles, lemmings, hares and reindeer."}, {"id": "bankvole", "sp": "myodes glareolus", "xh": 0.04, "desc": "The most recorded mammal around the park. It eats berries and shoots and is prey for many predators."}, {"id": "lemming", "sp": "myopus schisticolor", "xh": 0.16}, {"id": "squirrel", "sp": "sciurus vulgaris", "xh": 0.28, "desc": "Feeds on conifer seeds, and is hunted by predators such as wolves."}, {"id": "siskin", "sp": "spinus spinus", "xh": 0.4}, {"id": "hare", "sp": "lepus timidus", "xh": 0.54, "desc": "Browses twigs and bark of birch and willow and eats dwarf shrubs. Prey for wolves, stoats and wolverines.", "ic": "vole"}, {"id": "reindeer", "sp": "rangifer tarandus", "xh": 0.7, "name": "Reindeer", "desc": "Grazes lichens, dwarf shrubs and other plants of forest and mire, and is prey for wolves and bears."}, {"id": "moose", "sp": "alces alces", "xh": 0.88, "desc": "The largest browser of the forest: eats twigs of birch, willow and pine. Its carcasses feed scavengers.", "badge": "Keystone grazer"}, {"id": "jay", "sp": "perisoreus infaustus", "xh": 0.2}, {"id": "stoat", "sp": "mustela erminea", "xh": 0.5, "desc": "A small hunter of voles, lemmings and shrews that can also take hares and birds.", "ic": "fox"}, {"id": "wolverine", "sp": "gulo gulo", "xh": 0.8, "desc": "Mostly a scavenger, especially in winter, often feeding on carcasses of other predators' kills but also hunting."}, {"id": "bear", "sp": "ursus arctos", "xh": 0.3, "desc": "An omnivore that eats berries and plants and also hunts small mammals and young deer."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.7, "desc": "Hunts moose, reindeer and hares across the forest; its kills feed scavengers such as wolverines."}], "raw": [["sun", "pine", "r"], ["soil", "pine", "r"], ["sun", "spruce", "r"], ["soil", "spruce", "r"], ["sun", "birch", "r"], ["soil", "birch", "r"], ["sun", "willow", "r"], ["soil", "willow", "r"], ["sun", "bilberry", "r"], ["soil", "bilberry", "r"], ["sun", "cowberry", "r"], ["soil", "cowberry", "r"], ["river", "willow", "r"], ["river", "birch", "r"], ["decomp", "soil", "r"], ["bilberry", "bankvole"], ["cowberry", "bankvole"], ["cowberry", "lemming"], ["bilberry", "hare"], ["cowberry", "hare"], ["birch", "hare"], ["willow", "hare"], ["cowberry", "reindeer"], ["birch", "moose"], ["willow", "moose"], ["pine", "moose"], ["pine", "squirrel"], ["spruce", "squirrel"], ["birch", "siskin"], ["bankvole", "jay"], ["siskin", "jay"], ["bankvole", "stoat"], ["lemming", "stoat"], ["hare", "stoat"], ["siskin", "stoat"], ["hare", "wolverine"], ["bankvole", "bear"], ["lemming", "bear"], ["bilberry", "bear"], ["birch", "bear"], ["reindeer", "bear"], ["moose", "bear"], ["moose", "wolf"], ["reindeer", "wolf"], ["hare", "wolf"], ["squirrel", "wolf"], ["stoat", "wolf"], ["bankvole", "wolf"], ["moose", "wolverine", "s"], ["reindeer", "wolverine", "s"], ["snow", "bilberry", "r"], ["snow", "cowberry", "r"], ["pine", "decomp", "d"], ["spruce", "decomp", "d"], ["birch", "decomp", "d"], ["willow", "decomp", "d"], ["bilberry", "decomp", "d"], ["cowberry", "decomp", "d"], ["bankvole", "decomp", "d"], ["lemming", "decomp", "d"], ["squirrel", "decomp",