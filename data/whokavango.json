{"id": "whokavango", "name": "Okavango Delta", "short": "Okavango Delta", "place": "Botswana", "lat": -19.3, "lon": 22.9, "side": "l", "cont": "Africa", "country": "Botswana", "kind": "Lakes & wetlands", "park": true, "blurb": "Africa's inland delta, where a yearly flood feeds grazers and big cats.", "tip": {"id": "lechwe", "title": "Cut the flood", "text": "Lower the red lechwe, the delta's most numerous large grazer, and watch what happens to lions, wild dogs, crocodiles and the wet-meadow grasses."}, "sources": [{"title": "Wikipedia: Okavango Delta", "url": "https://en.wikipedia.org/wiki/Okavango_Delta"}, {"title": "UNESCO World Heritage: Okavango Delta", "url": "https://whc.unesco.org/en/list/1432"}, {"title": "Wikipedia: Moremi Game Reserve", "url": "https://en.wikipedia.org/wiki/Moremi_Game_Reserve"}, {"title": "Wikipedia: Red lechwe", "url": "https://en.wikipedia.org/wiki/Red_lechwe"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Okavango Delta", "icon": "water", "tier": "overview", "nodes": [{"id": "flood", "sp": "seasonal flood", "xh": 0.15}, {"id": "sun", "sp": "sunlight", "xh": 0.4, "wiki": "Sunlight", "desc": "Strong sun drives plant growth in the shallows and heavy evaporation that removes most of the water."}, {"id": "soil", "sp": "island soils", "xh": 0.65}, {"id": "decomp", "sp": "macrotermes", "xh": 0.9}, {"id": "panicum", "sp": "panicum repens", "xh": 0.12}, {"id": "cynodon", "sp": "cynodon dactylon", "xh": 0.3, "desc": "Low creeping grass of drying floodplains and island edges, grazed by many hoofed animals."}, {"id": "mopane", "sp": "colophospermum mopane", "xh": 0.5, "desc": "A woodland tree of the drier ground whose leaves are browsed by elephants."}, {"id": "ilala", "sp": "hyphaene petersiana", "xh": 0.7}, {"id": "algae", "sp": "periphyton", "xh": 0.9, "name": "Algae and periphyton", "desc": "Films of algae on submerged plants and stems in clear channels that feed fish."}, {"id": "tilapia", "sp": "oreochromis", "xh": 0.05, "name": "Tilapia", "desc": "Common channel and lagoon fish of the delta, feeding on algae and plant material and taken by eagles and crocodiles."}, {"id": "lechwe", "sp": "kobus leche", "xh": 0.17, "name": "Red lechwe", "wiki": "Red lechwe", "desc": "The most numerous large mammal here. It grazes wet meadows and flees into knee-deep water.", "ic": "pronghorn"}, {"id": "hippo", "sp": "hippopotamus amphibius", "xh": 0.29, "desc": "Rests in channels by day and grazes on land at night. Its movements help keep channels open.", "ic": "bison"}, {"id": "zebra", "sp": "equus quagga", "xh": 0.41, "desc": "Grazes grasses on the drier floodplain and island margins and is taken by lions and wild dogs."}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.53, "desc": "Large herds graze floodplain grass and are preyed on mainly by lions."}, {"id": "impala", "sp": "aepyceros melampus", "xh": 0.65, "desc": "A mixed grazer and browser of woodland edges and a staple prey of many predators."}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.8, "desc": "Eats grass, palm fruit and mopane leaves. Botswana holds the world's largest elephant population."}, {"id": "fisheagle", "sp": "haliaeetus vocifer", "xh": 0.2, "desc": "Perches over channels and lagoons and takes fish from the surface, and is among the best-recorded birds here."}, {"id": "croc", "sp": "crocodylus niloticus", "xh": 0.5, "tl": 3, "desc": "Ambushes fish and mammals that come to drink at the channels and lagoons."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.8, "desc": "Hunts in clans and also scavenges carcasses, including kills of other predators."}, {"id": "lion", "sp": "panthera leo", "xh": 0.22, "desc": "Top predator that hunts buffalo, zebra, lechwe and impala."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.5, "desc": "A solitary predator of wooded islands that takes impala, lechwe and other mid-sized prey."}, {"id": "wilddog", "sp": "lycaon pictus", "xh": 0.78, "tl": 4, "desc": "A pack hunter of antelope; the Moremi area is a stronghold with a research project running since 1989.", "ic": "wolf"}], "raw": [["flood", "panicum", "r"], ["sun", "panicum", "r"], ["flood", "cynodon", "r"], ["sun", "cynodon", "r"], ["flood", "mopane", "r"], ["sun", "mopane", "r"], ["flood", "ilala", "r"], ["sun", "ilala", "r"], ["flood", "algae", "r"], ["sun", "algae", "r"], ["soil", "cynodon", "r"], ["soil", "mopane", "r"], ["soil", "ilala", "r"], ["decomp", "soil", "r"], ["cynodon", "zebra"], ["cynodon", "hippo"], ["panicum", "hippo"], ["cynodon", "impala"], ["cynodon", "buffalo"], ["panicum", "lechwe"], ["cynodon", "lechwe"], ["cynodon", "elephant"], ["mopane", "elephant"], ["ilala", "elephant"], ["algae", "tilapia"], ["panicum", "buffalo"], ["tilapia", "fisheagle"], ["tilapia", "croc"], ["lechwe", "croc"], ["zebra", "croc"], ["impala", "croc"], ["buffalo", "croc"], ["lechwe", "lion"], ["zebra", "lion"], ["buffalo", "lion"], ["impala", "lion"], ["hippo", "lion"], ["elephant", "lion"], ["lechwe", "leopard"], ["impala", "leopard"], ["zebra", "leopard"], ["lechwe", "wilddog"], ["impala", "wilddog"], ["zebra", "wilddog"], ["impala", "hyena"], ["zebra", "hyena"], ["buffalo", "hyena"], ["lechwe", "hyena"], ["lion", "hyena", "s"], ["leopard", "hyena", "s"], ["wilddog", "hyena", "s"], ["panicum", "decomp", "d"], ["cynodon", "decomp", "d"], ["mopane", "decomp", "d"], ["ilala", "decomp", "d"], ["algae", "decomp", "d"], ["lechwe", "decomp", "d"], ["zebra", "decomp", "d"], ["buffalo", "decomp", "d"], ["elephant", "decomp", "d"], ["hippo", "decomp", "d"], ["impala", "decomp", "d"], ["lion", "decomp", "d"], ["hippo", "croc"], ["elephant", "croc"], ["hippo", "hyena"], ["elephant", "hyena"], ["buffalo", "leopard"], ["hyena", "leopard"], ["buffalo", "wilddog"]], "ev": {"cynodon>zebra": ["g",