{"id": "npcongaree", "name": "Congaree National Park", "short": "Congaree", "place": "South Carolina, USA", "lat": 33.79, "lon": -80.78, "side": "r", "cont": "North America", "country": "United States of America", "states": ["South Carolina"], "kind": "Lakes & wetlands", "park": true, "blurb": "Old-growth floodplain forest, flood pulses, owls and the coyotes at the top.", "tip": {"id": "flood", "title": "Hold back the river floods", "text": "Floods bring silt and water to the floodplain trees. Set River floods to -100% and watch the oaks and cypress, then the deer, squirrels and the predators that eat them."}, "sources": [{"title": "Wikipedia: Congaree National Park", "url": "https://en.wikipedia.org/wiki/Congaree_National_Park"}, {"title": "National Park Service: Congaree National Park", "url": "https://www.nps.gov/cong/index.htm"}, {"title": "Wikipedia: Bald cypress", "url": "https://en.wikipedia.org/wiki/Bald_cypress"}, {"title": "Wikipedia: Barred owl", "url": "https://en.wikipedia.org/wiki/Barred_owl"}, {"title": "Wikipedia: Feral pig", "url": "https://en.wikipedia.org/wiki/Feral_pig"}, {"title": "Wikipedia: Bobcat", "url": "https://en.wikipedia.org/wiki/Bobcat"}, {"title": "Wikipedia: Taxodium distichum", "url": "https://en.wikipedia.org/wiki/Taxodium_distichum"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Congaree National Park, Taxodium distichum, Barred owl). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Congaree National Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "cypress", "sp": "taxodium distichum", "xh": 0.15, "wiki": "Bald cypress", "ic": "willow", "badge": "Foundation species"}, {"id": "oak", "sp": "quercus michauxii", "xh": 0.4}, {"id": "beech", "sp": "fagus grandifolia", "xh": 0.62, "wiki": "American beech"}, {"id": "maple", "sp": "acer rubrum", "xh": 0.84, "wiki": "Red maple", "desc": "A common floodplain tree. Deer, squirrels and beavers are recorded eating it.", "ic": "willow"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.06, "wiki": "White-tailed deer", "desc": "Browses leaves and twigs and eats acorns. A main large prey animal for coyotes and a common source of carrion."}, {"id": "squirrel", "sp": "sciurus niger", "xh": 0.24, "wiki": "Fox squirrel", "desc": "Eats tree seeds and nuts, including cypress seeds, and is prey for owls, coyotes and raccoons."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.42, "wiki": "North American beaver", "desc": "Gnaws trees such as maple and beech for food and building material, and can reshape waterways.", "badge": "Ecosystem engineer"}, {"id": "boar", "sp": "sus scrofa", "xh": 0.6, "name": "Feral hog", "wiki": "Feral pig", "desc": "An invasive omnivore, mostly plant food with some animals. Its rooting damages soil and vegetation, and few predators can take adults."}, {"id": "webworm", "sp": "hyphantria cunea", "xh": 0.82}, {"id": "frog", "sp": "lithobates sphenocephalus", "xh": 0.05}, {"id": "watersnake", "sp": "nerodia erythrogaster", "xh": 0.2}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.36, "wiki": "Raccoon", "desc": "A flexible omnivore of floodplain forests that eats small vertebrates and fruit."}, {"id": "opossum", "sp": "didelphis virginiana", "xh": 0.52, "wiki": "Virginia opossum", "desc": "An omnivore that eats fruit, insects and small animals, and also scavenges."}, {"id": "otter", "sp": "lontra canadensis", "xh": 0.68, "wiki": "North American river otter", "desc": "A semi-aquatic predator of Cedar Creek and the oxbow lakes, feeding on amphibians and other aquatic prey."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.88, "wiki": "Turkey vulture", "desc": "A soaring scavenger that cleans up carcasses of deer, hogs and other animals across the forest.", "ic": "raven"}, {"id": "owl", "sp": "strix varia", "xh": 0.3}, {"id": "coyote", "sp": "canis latrans", "xh": 0.7, "wiki": "Coyote", "desc": "The park's top mammal predator. It takes deer, hogs, beavers and smaller mammals, and also eats carrion."}, {"id": "flood", "sp": "environment", "xh": 0.1}, {"id": "silt", "sp": "environment", "xh": 0.3, "name": "Silt & nutrients", "wiki": "Sediment", "desc": "Floods lay down sediment that feeds the champion trees of the floodplain.", "ic": "soil"}, {"id": "sun", "sp": "environment", "xh": 0.5, "name": "Sunlight", "wiki": "Sunbeam", "desc": "Light reaching the forest through gaps in the canopy powers tree growth.", "ic": "sun"}, {"id": "rain", "sp": "environment", "xh": 0.7, "name": "Rainfall", "wiki": "Rain", "desc": "Rain on the upland watershed feeds the rivers and the floodplain pools.", "ic": "rain"}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & bacteria", "desc": "Break down fallen leaves, logs and carcasses on the damp floor, returning nutrients to the soil."}], "raw": [["cypress", "squirrel"], ["cypress", "webworm"], ["oak", "deer"], ["oak", "squirrel"], ["oak", "boar"], ["maple", "deer"], ["maple", "squirrel"], ["maple", "beaver"], ["maple", "webworm"], ["beech", "deer"], ["beech", "beaver"], ["beech", "webworm"], ["beech", "opossum"], ["webworm", "frog"], ["webworm", "opossum"], ["frog", "watersnake"], ["frog", "otter"], ["frog", "owl"], ["squirrel", "raccoon"], ["squirrel", "opossum"], ["squirrel", "owl"], ["squirrel", "coyote"], ["deer", "coyote"], ["beaver", "coyote"], ["boar", "coyote"], ["raccoon", "owl"], ["raccoon", "coyote"], ["opossum", "owl"], ["opossum", "coyote"], ["otter", "coyote"], ["watersnake", "owl"], ["deer", "vulture", "s"], ["boar", "vulture", "s"], ["beaver", "vulture", "s"], ["raccoon", "vulture", "s"], ["opossum", "vulture", "s"], ["coyote", "vulture", "s"], ["squirrel", "vulture", "s"], ["flood", "oak", "r"], ["silt", "oak", "r"], ["flood", "cypress", "r"], ["rain", "cypress", "r"], [