 "nodes": [
  {
   "id": "rain",
   "name": "Rain & snowmelt",
   "latin": "",
   "tl": 0,
   "xh": 0.12,
   "cat": "abiotic",
   "wiki": "Precipitation",
   "desc": "Snow in autumn and winter and rain in spring and summer give the park about 435 mm of precipitation a year. Seeps and springs add small local water sources.",
   "ic": "rain"
  },
  {
   "id": "fire",
   "name": "Wildfire",
   "latin": "",
   "tl": 0,
   "xh": 0.34,
   "cat": "abiotic",
   "wiki": "Wildfire",
   "desc": "Lightning-lit fires during drought burned more than half of the park between 1996 and 2003. Fire opens up the woodland and lets oak and wildflowers regrow.",
   "ic": "fire"
  },
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.56,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Strong sun on the high mesa tops drives plant growth and keeps the woodland dry and open.",
   "ic": "sun"
  },
  {
   "id": "soil",
   "name": "Mesa soils",
   "latin": "",
   "tl": 0,
   "xh": 0.78,
   "cat": "abiotic",
   "wiki": "Soil",
   "desc": "Thin, well-drained soils on the mesa tops hold the roots of the woodland and recycle nutrients from dead matter.",
   "ic": "soil"
  },
  {
   "id": "decomp",
   "name": "Fungi & bacteria",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.94,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Break down fallen needles, wood and carcasses, returning nutrients to the mesa soil.",
   "ic": "decomp"
  },
  {
   "id": "pinyon",
   "name": "Twoneedle pinyon",
   "latin": "Pinus edulis",
   "tl": 1,
   "xh": 0.1,
   "wiki": "Pinus edulis",
   "desc": "A small pine that, with juniper, dominates the park forests. Its seeds feed jays, mice and woodrats, and people have long gathered the nuts.",
   "ic": "sage",
   "badge": "Foundation species"
  },
  {
   "id": "juniper",
   "name": "Utah juniper",
   "latin": "Juniperus osteosperma",
   "tl": 1,
   "xh": 0.28,
   "wiki": "Juniperus osteosperma",
   "desc": "Grows with pinyon in the woodland. Its berries and foliage feed birds and browsing animals.",
   "ic": "sage",
   "badge": "Foundation species"
  },
  {
   "id": "oak",
   "name": "Gambel oak",
   "latin": "Quercus gambelii",
   "tl": 1,
   "xh": 0.46,
   "wiki": "Quercus gambelii",
   "desc": "A shrubby oak whose leaves are browsed by deer and whose acorns are eaten by jays and rodents. It resprouts readily after fire.",
   "ic": "willow"
  },
  {
   "id": "mahogany",
   "name": "Mountain mahogany",
   "latin": "Cercocarpus montanus",
   "tl": 1,
   "xh": 0.64,
   "wiki": "Cercocarpus montanus",
   "desc": "A tough shrub of dry slopes that mule deer browse.",
   "ic": "sage"
  },
  {
   "id": "forbs",
   "name": "Rabbitbrush & wildflowers",
   "latin": "Ericameria nauseosa and others",
   "tl": 1,
   "xh": 0.82,
   "wiki": "Ericameria nauseosa",
   "desc": "Rabbitbrush, penstemons and other shrubs and flowers of the open ground. They feed insects, rabbits and bumblebees.",
   "ic": "sage"
  },
  {
   "id": "hopper",
   "name": "Grasshoppers",
   "latin": "Xanthippus corallipes",
   "tl": 2,
   "xh": 0.06,
   "wiki": "Grasshopper",
   "desc": "Chew leaves of shrubs and flowers through summer and feed lizards and birds.",
   "ic": "hopper"
  },
  {
   "id": "deermouse",
   "name": "Deer mouse",
   "latin": "Peromyscus maniculatus",
   "tl": 2,
   "xh": 0.2,
   "wiki": "Deer mouse",
   "desc": "The most recorded mammal near the park, and an omnivore that eats seeds and insects. It is food for hawks, snakes and coyotes.",
   "ic": "vole"
  },
  {
   "id": "woodrat",
   "name": "Mexican woodrat",
   "latin": "Neotoma mexicana",
   "tl": 2,
   "xh": 0.34,
   "wiki": "Mexican woodrat",
   "desc": "A generalist that eats berries, nuts, acorns and foliage. It shelters in rock crevices and caves.",
   "ic": "vole"
  },
  {
   "id": "cottontail",
   "name": "Desert cottontail",
   "latin": "Sylvilagus audubonii",
   "tl": 2,
   "xh": 0.48,
   "wiki": "Desert cottontail",
   "desc": "A rabbit of open scrub that eats green plants and is prey for coyotes, hawks and bullsnakes.",
   "ic": "vole"
  },
  {
   "id": "pinjay",
   "name": "Pinyon jay",
   "latin": "Gymnorhinus cyanocephalus",
   "tl": 2,
   "xh": 0.62,
   "wiki": "Pinyon jay",
   "desc": "The staple of its diet is pinyon seed, which it caches in great numbers. Wikipedia calls it a keystone of pinyon woodland because it replants the trees.",
   "ic": "meadowlark",
   "badge": "Ecosystem engineer"
  },
  {
   "id": "muledeer",
   "name": "Mule deer",
   "latin": "Odocoileus hemionus",
   "tl": 2,
   "xh": 0.8,
   "wiki": "Mule deer",
   "desc": "Mostly browses shrubs and trees such as Gambel oak, juniper and mountain mahogany. Deer were also a main source of meat for the ancestral Puebloans.",
   "ic": "muledeer"
  },
  {
   "id": "sagelizard",
   "name": "Sagebrush lizard",
   "latin": "Sceloporus graciosus",
   "tl": 3,
   "xh": 0.1,
   "wiki": "Sagebrush lizard",
   "desc": "A small lizard of open, sunny ground that eats insects and is itself eaten by snakes and hawks.",
   "ic": "snake"
  },
  {
   "id": "bullsnake",
   "name": "Bullsnake",
   "latin": "Pituophis catenifer",
   "tl": 3,
   "xh": 0.28,
   "wiki": "Gopher snake",
   "desc": "A large constrictor that eats rodents, rabbits, lizards and birds.",
   "ic": "snake"
  },
  {
   "id": "redtail",
   "name": "Red-tailed hawk",
   "latin": "Buteo jamaicensis",
   "tl": 3,
   "xh": 0.46,
   "wiki": "Red-tailed hawk",
   "desc": "Hunts rabbits, rodents, snakes and lizards from the air.",
   "ic": "hawk"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.64,
   "wiki": "Common raven",
   "desc": "An omnivore that scavenges carrion and also takes eggs and young birds. Wikipedia names ravens as the main predators of pinyon jays.",
   "ic": "raven"
  },
  {
   "id": "vulture",
   "name": "Turkey vulture",
   "latin": "Cathartes aura",
   "tl": 3,
   "xh": 0.82,
   "wiki": "Turkey vulture",
   "desc": "Soars over the canyons looking for carcasses and cleans up dead animals.",
   "ic": "hawk"
  },
  {
   "id": "coyote",
   "name": "Coyote",
   "latin": "Canis latrans",
   "tl": 4,
   "xh": 0.3,
   "wiki": "Coyote",
   "desc": "Found in a wide range of park habitats. It eats rodents, rabbits, snakes and carrion, and takes deer fawns.",
   "ic": "coyote"
  },
  {
   "id": "cougar",
   "name": "Cougar",
   "latin": "Puma concolor",
   "tl": 4,
   "xh": 0.7,
   "wiki": "Cougar",
   "desc": "Mule deer are a core prey of the cougar. It is often called a keystone predator because it connects so many species.",
   "ic": "lion",
   "badge": "Keystone predator"
  }
 ],
