{"id": "npmesaverde", "name": "Mesa Verde National Park", "short": "Mesa Verde", "place": "Colorado, USA", "lat": 37.18, "lon": -108.49, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Colorado"], "kind": "Desert", "park": true, "blurb": "Pinyon, juniper and oak mesas, where jays plant the forest and fire resets it.", "tip": {"id": "rain", "title": "Dry out the mesa", "text": "Rain and snowmelt feed every plant here. Set Rain & snowmelt to -100% and watch the pinyon, oak and shrubs fade, then the deer, jays and the predators above them."}, "sources": [{"title": "Wikipedia: Mesa Verde National Park", "url": "https://en.wikipedia.org/wiki/Mesa_Verde_National_Park"}, {"title": "NPS: Mesa Verde animals", "url": "https://www.nps.gov/meve/learn/nature/animals.htm"}, {"title": "Wikipedia: Pinyon-juniper woodland", "url": "https://en.wikipedia.org/wiki/Pinyon%E2%80%93juniper_woodland"}, {"title": "Wikipedia: Pinyon jay", "url": "https://en.wikipedia.org/wiki/Pinyon_jay"}, {"title": "Wikipedia: Mule deer", "url": "https://en.wikipedia.org/wiki/Mule_deer"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Mesa Verde National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "rain", "sp": "rain & snowmelt", "xh": 0.12, "desc": "Snow in autumn and winter and rain in spring and summer give the park about 435 mm of precipitation a year. Seeps and springs add small local water sources."}, {"id": "fire", "sp": "wildfire", "xh": 0.34, "desc": "Lightning-lit fires during drought burned more than half of the park between 1996 and 2003. Fire opens up the woodland and lets oak and wildflowers regrow."}, {"id": "sun", "sp": "sunlight", "xh": 0.56, "desc": "Strong sun on the high mesa tops drives plant growth and keeps the woodland dry and open."}, {"id": "soil", "sp": "mesa soils", "xh": 0.78}, {"id": "decomp", "sp": "decomposer community", "xh": 0.94, "name": "Fungi & bacteria", "desc": "Break down fallen needles, wood and carcasses, returning nutrients to the mesa soil."}, {"id": "pinyon", "sp": "pinus edulis", "xh": 0.1, "name": "Twoneedle pinyon", "desc": "A small pine that, with juniper, dominates the park forests. Its seeds feed jays, mice and woodrats, and people have long gathered the nuts.", "ic": "sage", "badge": "Foundation species"}, {"id": "juniper", "sp": "juniperus osteosperma", "xh": 0.28, "desc": "Grows with pinyon in the woodland. Its berries and foliage feed birds and browsing animals.", "ic": "sage", "badge": "Foundation species"}, {"id": "oak", "sp": "quercus gambelii", "xh": 0.46, "desc": "A shrubby oak whose leaves are browsed by deer and whose acorns are eaten by jays and rodents. It resprouts readily after fire.", "ic": "willow"}, {"id": "mahogany", "sp": "cercocarpus montanus", "xh": 0.64, "desc": "A tough shrub of dry slopes that mule deer browse."}, {"id": "forbs", "sp": "ericameria nauseosa and others", "xh": 0.82}, {"id": "hopper", "sp": "xanthippus corallipes", "xh": 0.06}, {"id": "deermouse", "sp": "peromyscus maniculatus", "xh": 0.2, "wiki": "Deer mouse", "desc": "The most recorded mammal near the park, and an omnivore that eats seeds and insects. It is food for hawks, snakes and coyotes.", "ic": "vole"}, {"id": "woodrat", "sp": "neotoma mexicana", "xh": 0.34}, {"id": "cottontail", "sp": "sylvilagus audubonii", "xh": 0.48, "wiki": "Desert cottontail", "desc": "A rabbit of open scrub that eats green plants and is prey for coyotes, hawks and bullsnakes.", "ic": "vole"}, {"id": "pinjay", "sp": "gymnorhinus cyanocephalus", "xh": 0.62, "desc": "The staple of its diet is pinyon seed, which it caches in great numbers. Wikipedia calls it a keystone of pinyon woodland because it replants the trees.", "badge": "Ecosystem engineer"}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.8, "wiki": "Mule deer", "desc": "Mostly browses shrubs and trees such as Gambel oak, juniper and mountain mahogany. Deer were also a main source of meat for the ancestral Puebloans."}, {"id": "sagelizard", "sp": "sceloporus graciosus", "xh": 0.1}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.28, "wiki": "Gopher snake", "desc": "A large constrictor that eats rodents, rabbits, lizards and birds.", "ic": "snake"}, {"id": "redtail", "sp": "buteo jamaicensis", "xh": 0.46, "tl": 3, "wiki": "Red-tailed hawk", "desc": "Hunts rabbits, rodents, snakes and lizards from the air.", "ic": "hawk"}, {"id": "raven", "sp": "corvus corax", "xh": 0.64, "desc": "An omnivore that scavenges carrion and also takes eggs and young birds. Wikipedia names ravens as the main predators of pinyon jays."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.82, "wiki": "Turkey vulture", "desc": "Soars over the canyons looking for carcasses and cleans up dead animals."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "Found in a wide range of park habitats. It eats rodents, rabbits, snakes and carrion, and takes deer fawns."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.7, "name": "Cougar", "desc": "Mule deer are a core prey of the cougar. It is often called a keystone predator because it connects so many species.", "badge": "Keystone predator"}], "raw": [["rain", "pinyon", "r"], ["soil", "pinyon", "r"], ["rain", "juniper", "r"], ["soil", "juniper", "r"], ["rain", "oak", "r"], ["soil", "oak", "r"], ["rain", "mahogany", "r"], ["soil", "mahogany", "r"], ["rain", "forbs", "r"], ["soil", "forbs", "r"], ["fire", "oak", "r"], ["fire", "forbs", "r"], ["sun", "oak", "r"], ["sun", "forbs", "r"], ["sun", "pinyon", "r"], ["pinyon", "pinjay"], ["juniper", "pinjay"], ["oak", "pinjay"], ["pinyon", "deermouse"], ["pinyon", "woodrat"], ["juniper", "woodrat"], ["oak", "woodrat"], ["oak", "muledeer"], ["juniper", "muledeer"], ["mahogany", "muledeer"], ["forbs", "hopper"], ["forbs", "cottontail"], ["oak", "hopper"], ["hopper", "sagelizard"], ["hopper", "pinjay"], ["hopper", "deermouse"], ["deermouse", "bullsnake"], ["deermouse", "redtail"], ["deermouse", "coyote"], ["cottontail", "bullsnake"], ["cottontail", "redtail"], ["cottontail", "coyote"], ["sagelizard", "bullsnake"], ["sagelizard", "redtail"], ["bullsnake", "redtail"], ["bullsnake", "coyote"], ["bullsnake", "raven"], ["pinjay", "raven"], ["muledeer", "coyote"], ["muledeer", "cougar"], ["cottontail", "cougar"], ["raven", "coyote"], ["muledeer", "vulture", "s"], ["coyote", "vulture", "s"], ["cougar", "vulture", "s"], ["deermouse", "vulture", "s"], ["cottontail", "vulture", "s"], ["sagelizard", "vulture", "s"], ["bullsnake", "vulture", "s"], ["deermouse", "vulture"], ["muledeer", "raven", "s"], ["oak", "decomp", "d"], ["pinyon", "decomp", "d"], ["muledeer", "decomp", "d"], ["cougar", "decomp", "d"], ["coyote", "decomp", "d"], ["vulture", "decomp", "d"], ["decomp", "soil", "r"], ["muledeer", "redtail"]], "ev": {"pinyon>pinjay": ["g", "Gymnorhinus cyanocephalus", "Pinus edulis"], "juniper>pinjay": ["a"], "oak>pinjay": ["a"], "pinyon>deermouse": ["a"], "pinyon>woodrat": ["a"], "juniper>woodrat": ["a"], "oak>woodrat": ["a"], "oak>muledeer": ["gg", "Odocoileus hemionus", "Quercus gambelii"], "juniper>muledeer": ["a"], "mahogany>muledeer": ["a"], "forbs>hopper": ["a"], "forbs>cottontail": ["a"], "oak>hopper": ["a"], "hopper>sagelizard": ["a"], "hopper>pinjay": ["a"], "hopper>deermouse": ["a"], "deermouse>bullsnake": ["g", "Pituophis catenifer", "Peromyscus maniculatus"], "deermouse>redtail": ["g", "Buteo jamaicensis", "Peromyscus maniculatus"], "deermouse>coyote": ["g", "Canis latrans", "Peromyscus maniculatus"], "cottontail>bullsnake": ["g", "Pituophis catenifer", "Sylvilagus audubonii"], "cottontail>redtail": ["g", "Buteo jamaicensis", "Sylvilagus audubonii"], "cottontail>