 "nodes": [
  {
   "id": "sun",
   "name": "Sunlight and heat",
   "latin": "",
   "tl": 0,
   "xh": 0.1,
   "wiki": "Sun",
   "desc": "Intense light powers the sparse plant life, but extreme summer heat and dryness limit where plants and animals can live.",
   "ic": "sun",
   "cat": "abiotic"
  },
  {
   "id": "rain",
   "name": "Winter rain and flash floods",
   "latin": "",
   "tl": 0,
   "xh": 0.4,
   "wiki": "Flash flood",
   "desc": "Rain is scarce because mountain ranges block moisture. Rare wet winters trigger wildflower blooms and brief shallow lakes on the valley floor.",
   "ic": "rain",
   "cat": "abiotic"
  },
  {
   "id": "soil",
   "name": "Thin desert soil",
   "latin": "",
   "tl": 0,
   "xh": 0.7,
   "wiki": "Soil",
   "desc": "Hot, dry conditions limit soil formation, so slopes stay stony and plants depend on what nutrients decomposers release.",
   "ic": "soil",
   "cat": "abiotic"
  },
  {
   "id": "decomp",
   "name": "Soil microbes and beetles",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.92,
   "wiki": "Decomposer",
   "desc": "Slowly break down dead plants and animals in dry soil and return nutrients to it.",
   "ic": "decomp",
   "cat": "decomp"
  },
  {
   "id": "creosote",
   "name": "Creosote bush",
   "latin": "Larrea tridentata",
   "tl": 1,
   "xh": 0.06,
   "wiki": "Creosote bush",
   "desc": "A resinous, drought-hardy shrub that dominates much of the lower desert. Its seeds feed small rodents and its leaves feed some lizards.",
   "ic": "sage",
   "badge": "Foundation species"
  },
  {
   "id": "bursage",
   "name": "White bursage",
   "latin": "Ambrosia dumosa",
   "tl": 1,
   "xh": 0.22,
   "wiki": "Ambrosia dumosa",
   "desc": "A low shrub that often grows alongside creosote bush across the desert floor.",
   "ic": "sage"
  },
  {
   "id": "brittle",
   "name": "Brittlebush",
   "latin": "Encelia farinosa",
   "tl": 1,
   "xh": 0.38,
   "wiki": "Encelia farinosa",
   "desc": "A silvery shrub with yellow flowers that grows on rocky desert slopes.",
   "ic": "sage"
  },
  {
   "id": "flowers",
   "name": "Desert wildflowers",
   "latin": "Chylismia",
   "tl": 1,
   "xh": 0.6,
   "wiki": "Chylismia",
   "desc": "Annual flowers such as browneyes burst out after good rains and provide leaves and nectar for many desert animals.",
   "ic": "sage"
  },
  {
   "id": "cactus",
   "name": "Beavertail cactus",
   "latin": "Opuntia basilaris",
   "tl": 1,
   "xh": 0.82,
   "wiki": "Opuntia basilaris",
   "desc": "A flat-padded prickly pear whose fleshy pads store water; bighorn sheep use their horns to break open cactus to eat.",
   "ic": "sage"
  },
  {
   "id": "bighorn",
   "name": "Desert bighorn sheep",
   "latin": "Ovis canadensis nelsoni",
   "tl": 2,
   "xh": 0.05,
   "wiki": "Desert bighorn sheep",
   "desc": "Eats mainly grasses and shifts to other plants and cactus when grass is scarce. It can go long periods without drinking and escapes predators on steep rocky ground.",
   "ic": "quad"
  },
  {
   "id": "kroo",
   "name": "Desert kangaroo rat",
   "latin": "Dipodomys deserti",
   "tl": 2,
   "xh": 0.17,
   "wiki": "Desert kangaroo rat",
   "desc": "A seed-eater that lives in sand burrows. NPS notes it gets all its water from its food and never needs to drink.",
   "ic": "vole"
  },
  {
   "id": "squirrel",
   "name": "White-tailed antelope squirrel",
   "latin": "Ammospermophilus leucurus",
   "tl": 2,
   "xh": 0.29,
   "wiki": "White-tailed antelope squirrel",
   "desc": "A daytime ground squirrel that stays active in desert heat and feeds on seeds, cactus and other items.",
   "ic": "gsquirrel"
  },
  {
   "id": "jack",
   "name": "Black-tailed jackrabbit",
   "latin": "Lepus californicus",
   "tl": 2,
   "xh": 0.41,
   "wiki": "Black-tailed jackrabbit",
   "desc": "A nocturnal hare whose big ears shed heat. It is prey for coyotes, as NPS notes.",
   "ic": "vole"
  },
  {
   "id": "chuck",
   "name": "Common chuckwalla",
   "latin": "Sauromalus ater",
   "tl": 2,
   "xh": 0.53,
   "wiki": "Common chuckwalla",
   "desc": "A large plant-eating lizard that feeds on desert shrubs such as creosote bush and wedges into rock crevices.",
   "ic": "snake"
  },
  {
   "id": "moth",
   "name": "White-lined sphinx moth",
   "latin": "Hyles lineata",
   "tl": 2,
   "xh": 0.7,
   "wiki": "White-lined sphinx",
   "desc": "A hawk-moth whose caterpillars and adults feed on desert flowers and shrubs, and which is eaten by birds and lizards.",
   "ic": "mayfly"
  },
  {
   "id": "uta",
   "name": "Side-blotched lizard",
   "latin": "Uta stansburiana",
   "tl": 3,
   "xh": 0.1,
   "wiki": "Common side-blotched lizard",
   "desc": "A small, very commonly recorded lizard that hunts insects and is prey for snakes, other lizards and hawks.",
   "ic": "snake"
  },
  {
   "id": "lizard",
   "name": "Long-nosed leopard lizard",
   "latin": "Gambelia wislizenii",
   "tl": 3,
   "xh": 0.3,
   "wiki": "Long-nosed leopard lizard",
   "desc": "A sit-and-chase predator that eats insects and other lizards.",
   "ic": "snake"
  },
  {
   "id": "sidewinder",
   "name": "Sidewinder",
   "latin": "Crotalus cerastes",
   "tl": 3,
   "xh": 0.55,
   "wiki": "Sidewinder",
   "desc": "A small desert rattlesnake that hunts rodents and lizards, moving by a looping sidewinding motion over sand.",
   "ic": "snake"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.82,
   "wiki": "Common raven",
   "desc": "An omnivorous scavenger and the most recorded bird in the area. Mojave ravens have boomed around towns and garbage, and prey on young desert tortoises.",
   "ic": "raven"
  },
  {
   "id": "coyote",
   "name": "Coyote",
   "latin": "Canis latrans",
   "tl": 4,
   "xh": 0.2,
   "wiki": "Coyote",
   "desc": "A widespread predator that NPS says hunts mainly at night and in the cool of early morning. Eats rodents, hares, lizards and carrion.",
   "ic": "coyote"
  },
  {
   "id": "hawk",
   "name": "Red-tailed hawk",
   "latin": "Buteo jamaicensis",
   "tl": 4,
   "xh": 0.5,
   "wiki": "Red-tailed hawk",
   "desc": "A large hawk that hunts rodents, hares, lizards and snakes from the air.",
   "ic": "hawk"
  },
  {
   "id": "cougar",
   "name": "Mountain lion",
   "latin": "Puma concolor",
   "tl": 4,
   "xh": 0.8,
   "wiki": "Cougar",
   "desc": "Listed among the park predators on Wikipedia, it hunts large prey such as bighorn sheep in rugged mountain terrain.",
   "ic": "lion",
   "badge": "Keystone predator"
  }
