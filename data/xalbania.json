{"id": "xalbania", "name": "Karavasta Lagoon (Divjaka-Karavasta National Park)", "short": "Karavasta Lagoon", "place": "Albania", "lat": 40.9, "lon": 19.5, "side": "r", "cont": "Europe", "country": "Albania", "blurb": "Adriatic lagoon where Dalmatian pelicans, flamingos and egrets fish the shallows.", "tip": {"id": "mullet", "title": "Remove the mullet", "text": "Fish like mullet feed the pelican, egret and cormorant. Set Flathead grey mullet to -100% and watch which fish-eating birds and predators lose food."}, "sources": [{"title": "Wikipedia: Karavasta Lagoon", "url": "https://en.wikipedia.org/wiki/Karavasta_Lagoon"}, {"title": "Wikipedia: Divjaka-Karavasta National Park", "url": "https://en.wikipedia.org/wiki/Divjak%C3%AB-Karavasta_National_Park"}, {"title": "Wikipedia: Dalmatian pelican", "url": "https://en.wikipedia.org/wiki/Dalmatian_pelican"}, {"title": "Wikipedia: Golden jackal", "url": "https://en.wikipedia.org/wiki/Golden_jackal"}, {"title": "Wikipedia: Greater flamingo", "url": "https://en.wikipedia.org/wiki/Greater_flamingo"}, {"title": "Wikipedia: Little egret", "url": "https://en.wikipedia.org/wiki/Little_egret"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Karavasta Lagoon", "icon": "water", "tier": "overview", "kind": "Lakes & wetlands", "park": true, "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Warm Mediterranean sunshine drives growth of the lagoon algae, reeds, salt-marsh plants and pines."}, {"id": "lagoon", "sp": "brackish lagoon water", "xh": 0.3}, {"id": "rivers", "sp": "river sediment and nutrients", "xh": 0.52}, {"id": "dunes", "sp": "coastal sand dunes", "xh": 0.72}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Bacteria and fungi", "desc": "Break down dead reeds, algae, pine litter and animal remains, returning nutrients to the mud and water."}, {"id": "phyto", "sp": "microscopic algae", "xh": 0.12, "wiki": "Algae", "desc": "Microscopic and mat-forming algae in the nutrient-rich shallows form the base of the aquatic food chain."}, {"id": "salicornia", "sp": "salicornia europaea", "xh": 0.3}, {"id": "reed", "sp": "phragmites australis", "xh": 0.5, "desc": "Forms dense reed beds along wetland edges, giving shelter and nesting cover for birds and amphibians.", "badge": "Foundation species"}, {"id": "pine", "sp": "pinus halepensis", "xh": 0.7}, {"id": "mastic", "sp": "pistacia lentiscus", "xh": 0.9}, {"id": "mosquito", "sp": "culex pipiens", "xh": 0.12}, {"id": "mullet", "sp": "mugil cephalus", "xh": 0.37, "desc": "Tolerates fresh, brackish and salt water and often enters lagoons, grazing on algae and detritus."}, {"id": "flamingo", "sp": "phoenicopterus roseus", "xh": 0.62, "desc": "Filters mud and water for small crustaceans, algae, insect larvae and molluscs; its eggs and chicks are taken by gulls."}, {"id": "badger", "sp": "meles meles", "xh": 0.87, "tl": 2, "desc": "An omnivore that eats fruits such as mastic berries along with amphibians and other small animals."}, {"id": "egret", "sp": "egretta garzetta", "xh": 0.1}, {"id": "cormorant", "sp": "microcarbo pygmaeus", "xh": 0.26, "desc": "A small cormorant that hunts fish, often in groups, in vegetated pools and lagoons."}, {"id": "frog", "sp": "pelophylax ridibundus", "xh": 0.42, "desc": "A large water frog of ponds and wetlands that eats insects and other small prey."}, {"id": "dice", "sp": "natrix tessellata", "xh": 0.58}, {"id": "gull", "sp": "larus michahellis", "xh": 0.74, "desc": "A widespread coastal gull that eats fish and other food, and raids flamingo eggs and chicks.", "ic": "hawk"}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.9, "desc": "An adaptable predator of frogs, snakes and wetland birds around the lagoon margins."}, {"id": "pelican", "sp": "pelecanus crispus", "x