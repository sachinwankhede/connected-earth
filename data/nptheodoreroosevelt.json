{"id": "nptheodoreroosevelt", "name": "Theodore Roosevelt National Park", "short": "T. Roosevelt NP", "place": "North Dakota, USA", "lat": 46.97, "lon": -103.45, "side": "r", "cont": "North America", "country": "United States of America", "states": ["North Dakota"], "kind": "Grassland", "park": true, "blurb": "Badlands prairie where bison, prairie dogs and wild horses graze.", "tip": {"id": "pdog", "title": "Remove the prairie dogs", "text": "Prairie dogs feed badgers, coyotes, rattlesnakes and golden eagles. Set Black-tailed prairie dog to -100% and watch the predators that rely on them."}, "sources": [{"title": "Wikipedia: Theodore Roosevelt National Park", "url": "https://en.wikipedia.org/wiki/Theodore_Roosevelt_National_Park"}, {"title": "NPS: Nature and Science, Theodore Roosevelt National Park", "url": "https://www.nps.gov/thro/learn/nature/index.htm"}, {"title": "Wikipedia: Black-tailed prairie dog", "url": "https://en.wikipedia.org/wiki/Black-tailed_prairie_dog"}, {"title": "Wikipedia: American bison", "url": "https://en.wikipedia.org/wiki/American_bison"}, {"title": "Wikipedia: Golden eagle", "url": "https://en.wikipedia.org/wiki/Golden_eagle"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Theodore Roosevelt National Park", "icon": "bison", "tier": "overview", "nodes": [{"id": "wheatgrass", "sp": "pascopyrum smithii", "xh": 0.15, "desc": "A cool-season native grass of the mixed-grass prairie. Prairie dogs and bison both feed on it in spring and early summer."}, {"id": "bluegrama", "sp": "bouteloua gracilis", "xh": 0.35, "desc": "A short, drought-tolerant prairie grass that grazers such as prairie dogs and bison eat."}, {"id": "sagebrush", "sp": "artemisia tridentata", "xh": 0.55, "desc": "A grey-green shrub of the dry uplands. Prairie dogs eat shrubs like sagebrush in winter, and bison turn to it when grass is scarce."}, {"id": "pricklypear", "sp": "opuntia polyacantha", "xh": 0.75, "name": "Plains prickly pear", "desc": "A low cactus of the open prairie. Prairie dogs rely on it for food and moisture in winter.", "ic": "sage"}, {"id": "bison", "sp": "bison bison", "xh": 0.05, "desc": "Reintroduced to the park. Mostly eats grasses and sedges, and its wallows are a form of ecosystem engineering that adds to prairie diversity."}, {"id": "horse", "sp": "equus caballus", "xh": 0.17}, {"id": "elk", "sp": "cervus canadensis", "xh": 0.29, "desc": "Reintroduced to the park. A large grazing and browsing deer that is managed by park staff along with bison and horses."}, {"id": "pdog", "sp": "cynomys ludovicianus", "xh": 0.43, "wiki": "Black-tailed prairie dog", "desc": "Eats mostly grasses, plus prickly pear and shrubs in winter. Its burrowing mixes the soil and its colonies support many other species.", "badge": "Ecosystem engineer"}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.57, "wiki": "Pronghorn", "desc": "A fast prairie grazer and browser of open country, recorded often in the park area.", "ic": "pronghorn"}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.71, "wiki": "Mule deer", "desc": "A browsing deer of the draws and breaks, common in the badlands."}, {"id": "grasshopper", "sp": "melanoplus sanguinipes", "xh": 0.87, "desc": "One of several grasshopper species recorded in the park area. It feeds on prairie grasses and forbs."}, {"id": "badger", "sp": "taxidea taxus", "xh": 0.12, "wiki": "American badger", "desc": "A digging predator of burrowing rodents such as prairie dogs and pocket gophers.", "ic": "quad"}, {"id": "rattlesnake", "sp": "crotalus viridis", "xh": 0.36}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.62, "name": "Turkey vulture", "wiki": "Turkey vulture", "desc": "A soaring scavenger that cleans up carcasses of animals such as deer and bison."}, {"id": "magpie", "sp": "pica hudsonia", "xh": 0.88, "wiki": "Black-billed magpie"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.22, "wiki": "Coyote", "desc": "A flexible predator and scavenger. GloBI records show it eating prairie dogs, pronghorn, deer and elk."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.5, "name": "Cougar", "desc": "A secretive big cat of the badlands that preys mainly on deer and elk.", "badge": "Keystone predator"}, {"id": "goldeneagle", "sp": "aquila chrysaetos", "xh": 0.78, "desc": "A large raptor that hunts prairie dogs, rabbits and ground squirrels over open ground."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Drives the growth of the prairie grasses and shrubs."}, {"id": "rain", "sp": "rain & snow", "xh": 0.3}, {"id": "river", "sp": "little missouri river", "xh": 0.5}, {"id": "fire", "sp": "prairie fire", "xh": 0.7}, {"id": "soil", "sp": "badlands soil", "xh": 0.9}, {"id": "decomp", "sp": "decomposers", "xh": 0.03, "desc": "Fungi, bacteria and insects that break down dead plants and carcasses."}], "raw": [["wheatgrass", "bison"], ["wheatgrass", "horse"], ["wheatgrass", "elk"], ["wheatgrass", "pdog"], ["wheatgrass", "grasshopper"], ["bluegrama", "bison"], ["bluegrama", "horse"], ["bluegrama", "elk"], ["bluegrama", "pdog"], ["bluegrama", "grasshopper"], ["sagebrush", "pronghorn"], ["sagebrush", "muledeer"], ["sagebrush", "pdog"], ["sagebrush", "bison"], ["pricklypear", "pdog"], ["grasshopper", "pdog"], ["pdog", "badger"], ["pdog", "rattlesnake"], ["pdog", "coyote"], ["pdog", "goldeneagle"], ["pronghorn", "coyote"], ["muledeer", "coyote"], ["elk", "coyote"], ["muledeer", "cougar"], ["elk", "cougar"], ["grasshopper", "magpie"], ["bison", "coyote", "s"], ["horse", "coyote", "s"], ["bison", "vulture", "s"], ["muledeer", "vulture", "s"], ["elk", "vulture", "s"], ["bison", "magpie", "s"], ["muledeer", "magpie", "s"], ["horse", "magpie", "s"], ["sun", "wheatgrass", "r"], ["sun", "bluegrama", "r"], ["sun", "sagebrush", "r"], ["sun", "p