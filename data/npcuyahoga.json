{"id": "npcuyahoga", "name": "Cuyahoga Valley National Park", "short": "Cuyahoga Valley", "place": "Ohio, USA", "lat": 41.24, "lon": -81.55, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Ohio"], "kind": "Forest", "park": true, "blurb": "Beaver ponds, river marsh and ravine forest along the Cuyahoga River.", "tip": {"id": "beaver", "title": "Remove the beavers", "text": "Beavers dam streams into ponds and marshes. Set American beaver to -100% and watch the cattail marsh, muskrats and the predators that hunt them."}, "sources": [{"title": "Wikipedia: Cuyahoga Valley National Park", "url": "https://en.wikipedia.org/wiki/Cuyahoga_Valley_National_Park"}, {"title": "National Park Service: Cuyahoga Valley nature", "url": "https://www.nps.gov/cuva/learn/nature/index.htm"}, {"title": "Wikipedia: Beaver", "url": "https://en.wikipedia.org/wiki/Beaver"}, {"title": "Wikipedia: Coyote", "url": "https://en.wikipedia.org/wiki/Coyote"}, {"title": "Wikipedia: Bald eagle", "url": "https://en.wikipedia.org/wiki/Bald_eagle"}, {"title": "Wikipedia: Red-tailed hawk", "url": "https://en.wikipedia.org/wiki/Red-tailed_hawk"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Cuyahoga Valley National Park", "icon": "beaver", "tier": "overview", "nodes": [{"id": "hemlock", "sp": "tsuga canadensis", "xh": 0.1, "name": "Eastern hemlock", "wiki": "Eastern hemlock", "desc": "A shade-tolerant evergreen of the park's cool ravines. GloBI records both deer and beavers feeding on it.", "ic": "willow"}, {"id": "sycamore", "sp": "platanus occidentalis", "xh": 0.28, "name": "American sycamore", "desc": "A large floodplain tree along the Cuyahoga River and its streams. GloBI records fox squirrels eating it."}, {"id": "trillium", "sp": "trillium grandiflorum", "xh": 0.46, "ic": "sage"}, {"id": "jewelweed", "sp": "impatiens capensis", "xh": 0.64, "name": "Jewelweed", "ic": "sage"}, {"id": "cattail", "sp": "typha", "xh": 0.84}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.05, "wiki": "White-tailed deer", "desc": "The most recorded large mammal near the park. It browses woodland plants such as trillium and hemlock, and its fawns are prey for coyotes."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.2, "wiki": "North American beaver", "desc": "Wikipedia calls beavers ecosystem engineers: dams turn streams into ponds and wetlands used by fish, frogs, turtles and waterfowl. The park notes beaver signs along its trails.", "badge": "Ecosystem engineer"}, {"id": "muskrat", "sp": "ondatra zibethicus", "xh": 0.36, "wiki": "Muskrat", "desc": "A wetland rodent that feeds on marsh plants such as cattails. It is prey for otters, hawks, eagles and coyotes.", "ic": "vole"}, {"id": "cottontail", "sp": "sylvilagus floridanus", "xh": 0.52, "wiki": "Eastern cottontail", "desc": "A rabbit of field and forest edges. It eats herbs such as jewelweed and is prey for many predators."}, {"id": "groundhog", "sp": "marmota monax", "xh": 0.68, "wiki": "Groundhog", "desc": "A burrowing herbivore of meadows and edges. GloBI records it eating jewelweed."}, {"id": "foxsq", "sp": "sciurus niger", "xh": 0.85, "wiki": "Fox squirrel", "desc": "A tree squirrel that eats seeds such as sycamore and is taken by hawks, foxes and coyotes."}, {"id": "opossum", "sp": "didelphis virginiana", "xh": 0.1, "wiki": "Virginia opossum", "desc": "An omnivore and scavenger that eats small mammals and carrion such as dead deer."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.3, "desc": "A small canid that hunts rabbits, groundhogs, squirrels and muskrats. Coyotes also prey on it."}, {"id": "otter", "sp": "lontra canadensis", "xh": 0.5, "wiki": "North American river otter", "desc": "Hunts in the river and wetlands. GloBI records it eating muskrats and bullfrogs; the park lists river otters among its mammals."}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.7, "tl": 3, "wiki": "Red-tailed hawk", "desc": "A common raptor that takes mostly rodents, plus rabbits and birds, hunting over fields and forest edges.", "ic": "hawk"}, {"id": "crow", "sp": "corvus brachyrhynchos", "xh": 0.9, "wiki": "American crow", "desc": "A very common omnivore that scavenges carcasses; here it is shown feeding on deer carrion."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "The park's main wild canid. It takes rabbits, rodents and birds, and mostly fawns rather than adult deer, and scavenges carcasses. Eastern coyotes are larger than western ones.", "badge": "Keystone predator"}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.7, "wiki": "Bald eagle", "desc": "Lives near rivers and marshes. It eats fish, waterfowl and muskrats, and much of its food is carrion."}, {"id": "sun", "sp": "sunlight", "xh": 0.05, "desc": "Light reaching the forest floor in spring and the open marsh drives plant growth."}, {"id": "river", "sp": "cuyahoga river & wetlands", "xh": 0.25}, {"id": "rain", "sp": "rain & snowmelt", "xh": 0.45, "wiki": "Rain", "desc": "Precipitation feeds the streams and ravines that drain toward the river."}, {"id": "soil", "sp": "forest soil", "xh": 0.65}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Fungi & bacteria", "desc": "Break down leaf litter, wood and carcasses, returning nutrients to the soil."}], "raw": [["hemlock", "deer"], ["hemlock", "beaver"], ["trillium", "deer"], ["jewelweed", "cottontail"], ["jewelweed", "groundhog"], ["sycamore", "foxsq"], ["cattail", "muskrat"], ["cattail", "beaver"], ["beaver", "coyote"], ["muskrat", "coyote"], ["muskrat", "otter"], ["muskrat", "fox"], ["muskrat", "hawk"], ["muskrat", "eagle"], ["cottontail", "coyote"], ["cottontail", "fox"], ["cottontail", "opossum"], ["cottontail", "hawk"], ["groundhog", "coyote"], ["groun