   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.1,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Strong sun on thin, rocky canyon-rim soils drives the dry-country shrubs and woodland of the rim.",
   "ic": "sun"
  },
  {
   "id": "snow",
   "name": "Snow and snowmelt",
   "latin": "",
   "tl": 0,
   "xh": 0.3,
   "cat": "abiotic",
   "wiki": "Snowmelt",
   "desc": "Winter snow supplies much of the moisture the rim plants use; the park averages about 120 inches of snowfall a year.",
   "ic": "ice"
  },
  {
   "id": "fire",
   "name": "Wildfire",
   "latin": "",
   "tl": 0,
   "xh": 0.5,
   "cat": "abiotic",
   "wiki": "Wildfire",
   "desc": "Fire is a recurring disturbance on the rim. Gambel oak quickly resprouts from its roots afterwards.",
   "ic": "fire"
  },
  {
   "id": "soil",
   "name": "Thin rocky soil",
   "latin": "",
   "tl": 0,
   "xh": 0.7,
   "cat": "abiotic",
   "wiki": "Soil",
   "desc": "Shallow soils on the canyon rim hold little water and nutrients, so decomposers recycling dead matter matter to the plants.",
   "ic": "soil"
  },
  {
   "id": "decomp",
   "name": "Fungi and bacteria",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.9,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Break down dead plants and carcasses and return nutrients to the soil.",
   "ic": "decomp"
  },
  {
   "id": "oak",
   "name": "Gambel oak",
   "latin": "Quercus gambelii",
   "tl": 1,
   "xh": 0.12,
   "wiki": "Quercus gambelii",
   "desc": "Oak scrub of the canyon rim. Deer browse it and squirrels and bears eat the acorns; it regrows from root sprouts after fire.",
   "ic": "willow",
   "badge": "Foundation species"
  },
  {
   "id": "pinyon",
   "name": "Colorado pinyon",
   "latin": "Pinus edulis",
   "tl": 1,
   "xh": 0.35,
   "wiki": "Pinus edulis",
   "desc": "A slow-growing pine of the pinyon-juniper woodland that covers much of the rim. Its large seeds feed wildlife.",
   "ic": "willow"
  },
  {
   "id": "sage",
   "name": "Big sagebrush",
   "latin": "Artemisia tridentata",
   "tl": 1,
   "xh": 0.6,
   "wiki": "Artemisia tridentata",
   "desc": "An aromatic shrub of dry rim flats. Mule deer eat it, along with bitterbrush and oak.",
   "ic": "sage"
  },
  {
   "id": "mahogany",
   "name": "Mountain mahogany",
   "latin": "Cercocarpus montanus",
   "tl": 1,
   "xh": 0.85,
   "wiki": "Cercocarpus montanus",
   "desc": "A tough rocky-slope shrub that elk and deer browse heavily, often keeping it short.",
   "ic": "sage"
  },
  {
   "id": "bighorn",
   "name": "Bighorn sheep",
   "latin": "Ovis canadensis",
   "tl": 2,
   "xh": 0.06,
   "wiki": "Bighorn sheep",
   "desc": "Grazes grass and browses shrubs on rugged, rocky ground near cliffs. Mountain lions are its greatest threat.",
   "ic": "quad"
  },
  {
   "id": "elk",
   "name": "Elk",
   "latin": "Cervus canadensis",
   "tl": 2,
   "xh": 0.2,
   "wiki": "Elk",
   "desc": "Mostly grazes native grasses but also browses shrubs. Bears and coyotes take calves, and cougars take adults.",
   "ic": "elk"
  },
  {
   "id": "muledeer",
   "name": "Mule deer",
   "latin": "Odocoileus hemionus",
   "tl": 2,
   "xh": 0.34,
   "wiki": "Mule deer",
   "desc": "Mainly browses shrubs and trees such as sagebrush and Gambel oak. Coyotes and cougars are its leading predators.",
   "ic": "muledeer",
   "badge": "Keystone grazer"
  },
  {
   "id": "cottontail",
   "name": "Mountain cottontail",
   "latin": "Sylvilagus nuttallii",
   "tl": 2,
   "xh": 0.48,
   "wiki": "Mountain cottontail",
   "desc": "A rabbit of sagebrush and woodland edges that feeds on plants and is prey for many predators.",
   "ic": "quad"
  },
  {
   "id": "rocksq",
   "name": "Rock squirrel",
   "latin": "Otospermophilus variegatus",
   "tl": 2,
   "xh": 0.62,
   "wiki": "Rock squirrel",
   "desc": "Eats seeds, acorns, pine nuts and fruit, storing food in its burrow. Snakes, hawks and coyotes prey on it.",
   "ic": "gsquirrel"
  },
  {
   "id": "deermouse",
   "name": "Deer mouse",
   "latin": "Peromyscus maniculatus",
   "tl": 2,
   "xh": 0.76,
   "wiki": "Deer mouse",
   "desc": "A very common small rodent that eats seeds and insects, and is eaten by snakes, hawks and coyotes.",
   "ic": "vole"
  },
  {
   "id": "scrubjay",
   "name": "Woodhouse's scrub-jay",
   "latin": "Aphelocoma woodhouseii",
   "tl": 2,
   "xh": 0.9,
   "wiki": "Woodhouse's scrub jay",
   "desc": "A common oak-scrub bird that eats acorns, seeds and insects, and is among the most recorded birds here.",
   "ic": "meadowlark"
  },
  {
   "id": "bullsnake",
   "name": "Bullsnake",
   "latin": "Pituophis catenifer",
   "tl": 3,
   "xh": 0.12,
   "wiki": "Bullsnake",
   "desc": "A large constrictor of dry open country that eats rodents, rabbits and birds.",
   "ic": "snake"
  },
  {
   "id": "redtail",
   "name": "Red-tailed hawk",
   "latin": "Buteo jamaicensis",
   "tl": 3,
   "xh": 0.32,
   "wiki": "Red-tailed hawk",
   "desc": "A common hawk soaring over the rim that hunts squirrels, rodents, rabbits and snakes.",
   "ic": "hawk"
  },
  {
   "id": "coyote",
   "name": "Coyote",
   "latin": "Canis latrans",
   "tl": 3,
   "xh": 0.52,
   "wiki": "Coyote",
   "desc": "Adaptable predator of the rim that takes rodents, rabbits and young deer and elk.",
   "ic": "coyote"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.72,
   "wiki": "Common raven",
   "desc": "The most recorded bird here. A clever omnivore that scavenges carcasses.",
   "ic": "raven"
  },
  {
   "id": "vulture",
   "name": "Turkey vulture",
   "latin": "Cathartes aura",
   "tl": 3,
   "xh": 0.9,
   "wiki": "Turkey vulture",
   "desc": "Soars over the canyon looking for carrion, such as dead deer.",
   "ic": "hawk"
  },
  {
   "id": "cougar",
   "name": "Cougar",
   "latin": "Puma concolor",
   "tl": 4,
   "xh": 0.3,
   "wiki": "Cougar",
   "desc": "Elusive big cat that mostly kills deer and elk, and also bighorn sheep. Its kills feed bears and scavengers.",
   "ic": "lion",
   "badge": "Keystone predator"
  },
  {
   "id": "bear",
   "name": "American black bear",
   "latin": "Ursus americanus",
   "tl": 4,
   "xh": 0.7,
   "wiki": "American black bear",
   "desc": "Omnivore that eats acorns and plants, takes young deer and elk and often steals cougar kills.",
   "ic": "grizzly"
  }
