{"id": "npblackcanyon", "name": "Black Canyon of the Gunnison National Park", "short": "Black Canyon", "place": "Colorado, USA", "lat": 38.58, "lon": -107.72, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Colorado"], "kind": "Polar & mountain", "park": true, "blurb": "Oak scrub, mule deer and the cougars of a sheer-walled canyon rim.", "tip": {"id": "muledeer", "title": "Thin out the mule deer", "text": "Mule deer browse oak and sagebrush and are the cougar's main prey. Set Mule deer to -100% and watch cougars, coyotes and the scavengers that share their kills."}, "sources": [{"title": "Wikipedia: Black Canyon of the Gunnison National Park", "url": "https://en.wikipedia.org/wiki/Black_Canyon_of_the_Gunnison_National_Park"}, {"title": "NPS: Nature at Black Canyon of the Gunnison", "url": "https://www.nps.gov/blca/learn/nature/index.htm"}, {"title": "Wikipedia: Gambel oak", "url": "https://en.wikipedia.org/wiki/Gambel_oak"}, {"title": "Wikipedia: Mule deer", "url": "https://en.wikipedia.org/wiki/Mule_deer"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}, {"title": "Wikipedia: Rock squirrel", "url": "https://en.wikipedia.org/wiki/Rock_squirrel"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Black Canyon of the Gunnison National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Strong sun on thin, rocky canyon-rim soils drives the dry-country shrubs and woodland of the rim."}, {"id": "snow", "sp": "snow and snowmelt", "xh": 0.3, "wiki": "Snowmelt"}, {"id": "fire", "sp": "wildfire", "xh": 0.5, "desc": "Fire is a recurring disturbance on the rim. Gambel oak quickly resprouts from its roots afterwards."}, {"id": "soil", "sp": "thin rocky soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "desc": "Break down dead plants and carcasses and return nutrients to the soil."}, {"id": "oak", "sp": "quercus gambelii", "xh": 0.12, "ic": "willow", "badge": "Foundation species"}, {"id": "pinyon", "sp": "pinus edulis", "xh": 0.35, "name": "Colorado pinyon", "ic": "willow"}, {"id": "sage", "sp": "artemisia tridentata", "xh": 0.6, "ic": "sage"}, {"id": "mahogany", "sp": "cercocarpus montanus", "xh": 0.85}, {"id": "bighorn", "sp": "ovis canadensis", "xh": 0.06, "desc": "Grazes grass and browses shrubs on rugged, rocky ground near cliffs. Mountain lions are its greatest threat."}, {"id": "elk", "sp": "cervus canadensis", "xh": 0.2}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.34, "wiki": "Mule deer", "desc": "Mainly browses shrubs and trees such as sagebrush and Gambel oak. Coyotes and cougars are its leading predators.", "badge": "Keystone grazer"}, {"id": "cottontail", "sp": "sylvilagus nuttallii", "xh": 0.48, "wiki": "Mountain cottontail", "desc": "A rabbit of sagebrush and woodland edges that feeds on plants and is prey for many predators."}, {"id": "rocksq", "sp": "otospermophilus variegatus", "xh": 0.62, "wiki": "Rock squirrel", "desc": "Eats seeds, acorns, pine nuts and fruit, storing food in its burrow. Snakes, hawks and coyotes prey on it."}, {"id": "deermouse", "sp": "peromyscus maniculatus", "xh": 0.76, "wiki": "Deer mouse", "desc": "A very common small rodent that eats seeds and insects, and is eaten by snakes, hawks and coyotes.", "ic": "vole"}, {"id": "scrubjay", "sp": "aphelocoma woodhouseii", "xh": 0.9, "tl": 2, "wiki": "Woodhouse's scrub jay", "ic": "meadowlark"}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.12, "wiki": "Bullsnake", "desc": "A large constrictor of dry open country that eats rodents, rabbits and birds.", "ic": "snake"}, {"id": "redtail", "sp": "buteo jamaicensis", "xh": 0.32, "tl": 3, "wiki": "Red-tailed hawk", "desc": "A common hawk soaring over the rim that hunts squirrels, rodents, rabbits and snakes.", "ic": "hawk"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.52, "tl": 3, "wiki": "Coyote", "desc": "Adaptable predator of the rim that takes rodents, rabbits and young deer and elk."}, {"id": "raven", "sp": "corvus corax", "xh": 0.72, "desc": "The most recorded bird here. A clever omnivore that scavenges carcasses."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.9, "wiki": "Turkey vulture", "desc": "Soars over the canyon looking for carrion, such as dead deer."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.3, "name": "Cougar", "desc": "Elusive big cat that mostly kills deer and elk, and also bighorn sheep. Its kills feed bears and scavengers.", "badge": "Keystone predator"}, {"id": "bear", "sp": "ursus americanus", "xh": 0.7, "name": "American black bear", "wiki": "American black bear", "desc": "Omnivore that eats acorns and plants, takes young deer and elk and often steals cougar kills."}], "raw": [["sun", "oak", "r"], ["snow", "oak", "r"], ["soil", "oak", "r"], ["sun", "pinyon", "r"], ["snow", "pinyon", "r"], ["soil", "pinyon", "r"], ["sun", "sage", "r"], ["snow", "sage", "r"], ["soil", "sage", "r"], ["sun", "mahogany", "r"], ["snow", "mahogany", "r"], ["soil", "mahogany", "r"], ["fire", "oak", "r"], ["decomp", "soil", "r"], ["oak", "muledeer"], ["oak", "rocksq"], ["oak", "scrubjay"], ["oak", "bear"], ["oak", "deermouse"], ["sage", "muledeer"], ["sage", "cottontail"], ["sage", "bighorn"], ["pinyon", "rocksq"], ["mahogany", "elk"], ["mahogany", "muledeer"], ["rocksq", "bullsnake"], ["deermouse", "bullsnake"], ["cottontail", "bullsnake"], ["scrubjay", "bullsnake"], ["rocksq", "redtail"], ["deermouse", "redtail"], ["cottontail", "redtail"], ["bullsnake", "redtail"], ["rocksq", "coyote"], ["deermouse", "coyote"], ["cottontail", "coyote"], ["muledeer", "coyote"], ["elk", "coyote"], ["muledeer", "cougar"], ["elk", "cougar"], ["bighorn", "cougar"], ["muledeer", "bear"]