{"id": "xuzb", "name": "Nuratau-Kyzylkum Biosphere Reserve", "short": "Nuratau-Kyzylkum", "place": "Uzbekistan", "lat": 40.7, "lon": 66.6, "side": "r", "cont": "Asia", "country": "Uzbekistan", "blurb": "Wild sheep, vultures and almond groves where the Nuratau range meets the desert.", "tip": {"id": "rain", "title": "Take away the spring rain", "text": "Spring moisture drives the grasses and milkvetches. Set Spring rain to -100% and watch argali and hares, then the wolves, foxes and vultures that depend on them."}, "sources": [{"title": "Wikipedia: Nuratau Mountains", "url": "https://en.wikipedia.org/wiki/Nuratau_Mountains"}, {"title": "Key Biodiversity Areas: Nuratau Range", "url": "https://www.keybiodiversityareas.org/site/factsheet/20676"}, {"title": "Uzbekistan government: The Nurata State Reserve", "url": "https://gov.uz/en/eco/news/view/22697"}, {"title": "Wikipedia: Argali", "url": "https://en.wikipedia.org/wiki/Argali"}, {"title": "Wikipedia: Long-legged buzzard", "url": "https://en.wikipedia.org/wiki/Long-legged_buzzard"}, {"title": "Wikipedia: Cinereous vulture", "url": "https://en.wikipedia.org/wiki/Cinereous_vulture"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Nuratau Mountains", "icon": "sage", "tier": "overview", "kind": "Desert", "park": true, "nodes": [{"id": "almond", "sp": "prunus bucharica", "xh": 0.12}, {"id": "walnut", "sp": "juglans regia", "xh": 0.34}, {"id": "vetch", "sp": "oxytropis, astragalus", "xh": 0.56}, {"id": "grass", "sp": "taeniatherum caput-medusae", "xh": 0.8}, {"id": "argali", "sp": "ovis ammon", "xh": 0.05, "name": "Severtsov argali", "desc": "A wild mountain sheep. The Nuratau-Kyzylkum reserve is said to hold the only wild population of the Severtsov subspecies. Wikipedia names wolves as the main argali predators.", "badge": "Keystone grazer"}, {"id": "boar", "sp": "sus scrofa", "xh": 0.2, "desc": "An omnivore that roots for plant foods, nuts and small animals. Listed among the mammals of the Nurata reserve."}, {"id": "hare", "sp": "lepus tolai", "xh": 0.35, "desc": "A hare of Central Asian steppe and desert that eats grasses and herbs. It is common prey for foxes and buzzards."}, {"id": "squirrel", "sp": "spermophilus fulvus", "xh": 0.5}, {"id": "chukar", "sp": "alectoris chukar", "xh": 0.65, "desc": "A rocky-slope game bird that eats seeds, leaves and some insects. Well recorded in the reserve area, and prey for eagles, buzzards and foxes."}, {"id": "cricket", "sp": "tettigonia caudata", "xh": 0.82}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.08, "wiki": "Red fox", "desc": "An adaptable predator and scavenger. GloBI records it eating many of the birds, hares and lizards of the area."}, {"id": "booted", "sp": "hieraaetus pennatus", "xh": 0.22}, {"id": "glass", "sp": "pseudopus apodus", "xh": 0.36}, {"id": "racer", "sp": "eremias velox", "xh": 0.5}, {"id": "griffon", "sp": "gyps fulvus", "xh": 0.66, "name": "Eurasian griffon", "desc": "A cliff-nesting vulture that feeds on carcasses of large animals. It is listed in the Uzbekistan Red Data Book as a breeder in the range."}, {"id": "cinereous", "sp": "aegypius monachus", "xh": 0.86, "desc": "A huge vulture that eats mainly carrion, including carcasses of wild sheep and domestic livestock. Globally threatened, and it breeds in the Nuratau range."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "name": "Grey wolf", "wiki": "Wolf", "desc": "Listed among the mammals of the Nurata reserve. Wikipedia names wolves as the main predators of argali, especially in hard winters.", "no": ["badge"]}, {"id": "buzzard", "sp": "buteo rufinus", "xh": 0.7, "desc": "A raptor of open dry steppe and rocky country. It takes ground squirrels, hares, lizards and chukars, and nests on cliffs.", "ic": "hawk"}, {"id": "sun", "sp": "sunlight", "xh": 0.12, "desc": "Long, hot, dry summers drive the desert and foothill plants."}, {"id": "rain", "sp": "spring rain & snowmelt", "xh": 0.32}, {"id": "soil", "sp": "rocky shale & desert soil", "xh": 0.52}, {"id": "decomp", "sp": "decomposer community", "xh": 0.82, "name": "Soil microbes & beetles", "desc": "Break down dead plants, dung and carcasses and return nutrients to the thin dry soil."}], "raw": [["sun", "almond", "r"], ["rain", "almond", "r"], ["soil", "almond", "r"], ["almond", "decomp", "d"], ["sun", "walnut", "r"], ["rain", "walnut", "r"], ["soil", "walnut", "r"], ["walnut", "decomp", "d"], ["sun", "vetch", "r"], ["rain", "vetch", "r"], ["soil", "vetch", "r"], ["vetch", "decomp", "d"], ["sun", "grass", "r"], ["rain", "grass", "r"], ["soil", "grass", "r"], ["grass", "decomp", "d"], ["decomp", "soil", "r"], ["almond", "argali"], ["walnut", "boar"], ["almond", "boar"], ["vetch", "argali"], ["grass", "argali"], ["grass", "boar"], ["grass", "hare"], ["vetch", "hare"], ["grass", "squirrel"], ["vetch", "squirrel"], ["vetch", "chukar"], ["grass", "chukar"], ["vetch", "cricket"], ["grass", "cricket"], ["argali", "wolf"], ["boar", "wolf"], ["hare", "wolf"], ["hare", "fox"], ["hare", "buzzard"], ["squirrel", "fox"], ["squirrel", "buzzard"], ["squirrel", "booted"], ["chukar", "fox"], ["chukar", "booted"], ["chukar", "buzzard"], ["cricket", "racer"], ["racer", "glass"], ["racer", "fox"], ["racer", "buzzard"], ["glass", "fox"], ["cricket", "glass"], ["argali", "griffon"], ["argali", "cinereous"], ["boar", "griffon", "s"], ["argali", "decomp", "d"], ["boar", "decomp", "d"], ["griffon", "decomp", "d"], ["wolf", "decomp", "d"], ["argali", "fox"], ["boar", "fox"], ["cricket", "fox"], ["squirrel", "glass"], ["squirrel", "wolf"], ["chukar", "wolf"], ["fox", "wolf"], ["glass", "wolf"]], "ev": {"almond>argali": ["a"], "walnut>boar": ["a"], "almond>boar": ["gg", "Sus scrofa", "Prunus bucharica"], "vetch>argali": ["a"], "grass>argali": ["a"], "grass>boar": ["a"], "grass