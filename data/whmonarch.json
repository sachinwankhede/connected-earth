poser community", "xh": 0.85, "name": "Fungi & bacteria", "desc": "Break down fallen needles, leaves, wood and carcasses and return nutrients to the soil."}], "raw": [["sun", "oyamel", "r"], ["rain", "oyamel", "r"], ["soil", "oyamel", "r"], ["sun", "pine", "r"], ["rain", "pine", "r"], ["soil", "pine", "r"], ["sun", "oak", "r"], ["rain", "oak", "r"], ["soil", "oak", "r"], ["sun", "milkweed", "r"], ["rain", "milkweed", "r"], ["soil", "milkweed", "r"], ["sun", "salvia", "r"], ["rain", "salvia", "r"], ["soil", "salvia", "r"], ["decomp", "soil", "r"], ["oyamel", "decomp", "d"], ["pine", "decomp", "d"], ["oak", "decomp", "d"], ["deer", "decomp", "d"], ["coyote", "decomp", "d"], ["milkweed", "monarch"], ["salvia", "monarch"], ["salvia", "bee"], ["salvia", "hummer"], ["oak", "deer"], ["salvia", "deer"], ["pine", "volcano"], ["oak", "volcano"], ["pine", "deermouse"], ["oak", "deermouse"], ["monarch", "grosbeak"], ["monarch", "deermouse"], ["bee", "lizard"], ["lizard", "rattler"], ["volcano", "rattler"], ["deermouse", "rattler"], ["deer", "raven", "s"], ["deer", "coyote", "s"], ["deer", "coyote"], ["deermouse", "coyote"], ["volcano", "coyote"], ["deer", "bobcat"], ["deermouse", "bobcat"], ["volcano", "owl"], ["deermouse", "owl"], ["deermouse", "raven"], ["pine", "monarch"], ["oak", "bee"], ["milkweed", "bee"], ["oak", "raven"], ["raven", "coyote"], ["deer", "owl"], ["raven", "owl"]], "link_ideas": [{"kind": "species", "with": "United States and Canada", "what": "Eastern monarchs migrate south each autumn to overwinter in these oyamel forests, and depend on milkweed along the way.", "evidence_url": "https://en.wikipedia.org/wiki/Monarch_butterfly"}], "ev": {"milkweed>monarch": ["g", "Danaus plexippus", "Asclepias"], "salvia>monarch": ["g", "Danaus plexippus", "Salvia elegans"], "salvia>bee": ["g", "Apis mellifera", "Salvia elegans"], "salvia>hummer": ["gg", "Basilinna leucotis", "Salvia elegans"], "oak>deer": ["g", "Odocoileus virginianus", "Quercus"], "salvia>deer": ["a"], "p