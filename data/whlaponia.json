{"id": "whlaponia", "name": "Laponian Area", "short": "Laponian Area", "place": "Sweden", "lat": 67.3, "lon": 18.0, "side": "r", "cont": "Europe", "country": "Sweden", "blurb": "Lemmings, lichen and reindeer, with wolverines and bears above the Arctic Circle.", "tip": {"id": "lemming", "title": "Crash the lemmings", "text": "Lemming numbers boom and crash. Set Norway lemming to -100% and watch the Arctic fox, red fox, wolverine and bear, which lose a key food."}, "sources": [{"title": "UNESCO World Heritage Centre: Laponian Area", "url": "https://whc.unesco.org/en/list/774"}, {"title": "Wikipedia: Reindeer", "url": "https://en.wikipedia.org/wiki/Reindeer"}, {"title": "Wikipedia: Wolverine", "url": "https://en.wikipedia.org/wiki/Wolverine"}, {"title": "Wikipedia: Norway lemming", "url": "https://en.wikipedia.org/wiki/Norway_lemming"}, {"title": "Wikipedia: Arctic fox", "url": "https://en.wikipedia.org/wiki/Arctic_fox"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Sarek National Park", "icon": "ice", "tier": "overview", "kind": "Polar & mountain", "park": true, "nodes": [{"id": "snow", "sp": "snow cover", "xh": 0.08, "desc": "Long winters bury the ground under snow. It insulates low shrubs, but reindeer must dig through it to reach their winter food."}, {"id": "sun", "sp": "sunlight", "xh": 0.28, "desc": "Within the Arctic Circle the growing season is short, but summer light lasts around the clock, driving fast plant growth."}, {"id": "melt", "sp": "meltwater and rivers", "xh": 0.5}, {"id": "soil", "sp": "thin mountain soil", "xh": 0.7, "desc": "Cold, thin soils and peat hold the nutrients that the dwarf shrubs, grasses and birch woods depend on."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi and soil microbes", "desc": "Break down dead plants, droppings and carcasses slowly in the cold, returning nutrients to the soil."}, {"id": "lichen", "sp": "cladonia rangiferina", "xh": 0.08, "desc": "A pale ground lichen that reindeer dig out from under the snow. It is their main winter food.", "badge": "Foundation species"}, {"id": "mbirch", "sp": "betula pubescens", "xh": 0.28}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.48, "desc": "A low berry shrub of forests and heath. Its leaves and berries are eaten by many animals, including bears."}, {"id": "crowberry", "sp": "empetrum nigrum", "xh": 0.68, "name": "Crowberry", "desc": "An evergreen dwarf shrub of heath and tundra with black berries, eaten by reindeer, voles, ptarmigan and bears."}, {"id": "sedge", "sp": "carex", "xh": 0.88, "name": "Sedges and grasses", "desc": "Sedges and grasses grow on the wet mires and meadows, and lemmings feed on them."}, {"id": "reindeer", "sp": "rangifer tarandus", "xh": 0.06, "name": "Reindeer", "desc": "Herded semi-wild by Sami villages. They eat lichen in winter and the berry shrubs and herbs of summer.", "badge": "Keystone grazer"}, {"id": "moose", "sp": "alces alces", "xh": 0.22, "desc": "The largest deer, browsing twigs of birch and other woody plants. It is a major prey of bears and wolverines."}, {"id": "hare", "sp": "lepus timidus", "xh": 0.38, "desc": "Turns white in winter and eats birch twigs and buds and dwarf shrubs, and is prey for foxes, eagles and wolverines."}, {"id": "lemming", "sp": "lemmus lemmus", "xh": 0.54}, {"id": "vole", "sp": "myodes rufocanus", "xh": 0.7, "desc": "A small rodent of forest and heath that eats crowberry and bilberry, and is eaten by foxes, wolverines and bears."}, {"id": "ptarmigan", "sp": "lagopus lagopus", "xh": 0.86, "desc": "A ground bird that eats buds, shoots and berries in the birch and shrub zone and is prey for foxes and eagles."}, {"id": "arcticfox", "sp": "vulpes lagopus", "xh": 0.12, "desc": "Rare in Scandinavia. Lemmings are its most common prey, and its breeding success follows the lemming cycle."}, {"id": "redfox", "sp": "vulpes vulpes", "xh": 0.4, "desc": "Hunts lemmings, voles, hares and ptarmigan, and can kill Arctic foxes where their ranges overlap."}, {"id": "raven", "sp": "corvus corax", "xh": 0.72, "wiki": "Common raven", "desc": "A clever scavenger that feeds on carcasses of reindeer and moose, and also eats berries and other foods."}, {"id": "wolverine", "sp": "gulo gulo", "xh": 0.2, "tl": 4, "desc": "Mostly a scavenger on carrion in winter, but also an active hunter in Fennoscandia. Often feeds on kills left by other predators.", "badge": "Keystone predator"}, {"id": "bear", "sp": "ursus arctos", "xh": 0.5, "desc": "An omnivore getting most of its food energy from plants such as berries, and also taking rodents and young moose and reindeer."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.8, "desc": "A large raptor that hunts hares and gamebirds and also scans for carrion in winter."}], "raw": [["sun", "lichen", "r"], ["sun", "mbirch", "r"], ["sun", "bilberry", "r"], ["sun", "crowberry", "r"], ["sun", "sedge", "r"], ["snow", "bilberry", "r"], ["snow", "crowberry", "r"], ["snow", "sedge", "r"], ["melt", "mbirch", "r"], ["melt", "bilberry", "r"], ["melt", "sedge", "r"], ["soil", "mbirch", "r"], ["soil", "bilberry", "r"], ["soil", "crowberry", "r"], ["soil", "sedge", "r"], ["decomp", "soil", "r"], ["mbirch", "decomp", "d"], ["bilberry", "decomp", "d"], ["lemming", "decomp", "d"], ["reindeer", "decomp", "d"], ["moose", "decomp", "d"], ["lichen", "reindeer"], ["crowberry", "reindeer"], ["mbirch", "moose"], ["bilberry", "moose"], ["mbirch", "hare"], ["bilberry", "hare"], ["sedge", "lemming"], ["crowberry", "vole"], ["bilberry", "vole"], ["crowberry", "ptarmigan"], ["mbirch", "ptarmigan"], ["lemming", "arcticfox"], ["vole", "arcticfox"], ["ptarmigan", "arcticfox"], ["lemming", "redfox"], ["vole", "