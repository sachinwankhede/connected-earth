 "nodes": [
  {
   "id": "snow",
   "name": "Snow cover",
   "latin": "",
   "tl": 0,
   "xh": 0.08,
   "wiki": "Snow",
   "desc": "Long winters bury the ground under snow. It insulates low shrubs, but reindeer must dig through it to reach their winter food.",
   "ic": "ice",
   "cat": "abiotic"
  },
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.28,
   "wiki": "Sun",
   "desc": "Within the Arctic Circle the growing season is short, but summer light lasts around the clock, driving fast plant growth.",
   "ic": "sun",
   "cat": "abiotic"
  },
  {
   "id": "melt",
   "name": "Meltwater and rivers",
   "latin": "",
   "tl": 0,
   "xh": 0.5,
   "wiki": "Meltwater",
   "desc": "Snow and glacier melt feeds the lakes, mires and the river delta that wets the valleys and lowlands of the site.",
   "ic": "water",
   "cat": "abiotic"
  },
  {
   "id": "soil",
   "name": "Thin mountain soil",
   "latin": "",
   "tl": 0,
   "xh": 0.7,
   "wiki": "Soil",
   "desc": "Cold, thin soils and peat hold the nutrients that the dwarf shrubs, grasses and birch woods depend on.",
   "ic": "soil",
   "cat": "abiotic"
  },
  {
   "id": "decomp",
   "name": "Fungi and soil microbes",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.9,
   "wiki": "Decomposer",
   "desc": "Break down dead plants, droppings and carcasses slowly in the cold, returning nutrients to the soil.",
   "ic": "decomp",
   "cat": "decomp"
  },
  {
   "id": "lichen",
   "name": "Reindeer lichen",
   "latin": "Cladonia rangiferina",
   "tl": 1,
   "xh": 0.08,
   "wiki": "Cladonia rangiferina",
   "desc": "A pale ground lichen that reindeer dig out from under the snow. It is their main winter food.",
   "ic": "sage",
   "badge": "Foundation species"
  },
  {
   "id": "mbirch",
   "name": "Mountain birch",
   "latin": "Betula pubescens",
   "tl": 1,
   "xh": 0.28,
   "wiki": "Betula pubescens",
   "desc": "A pale-barked tree that forms the open woodland on the lower mountain slopes. Moose and hares eat its twigs and buds.",
   "ic": "aspen"
  },
  {
   "id": "bilberry",
   "name": "Bilberry",
   "latin": "Vaccinium myrtillus",
   "tl": 1,
   "xh": 0.48,
   "wiki": "Vaccinium myrtillus",
   "desc": "A low berry shrub of forests and heath. Its leaves and berries are eaten by many animals, including bears.",
   "ic": "sage"
  },
  {
   "id": "crowberry",
   "name": "Crowberry",
   "latin": "Empetrum nigrum",
   "tl": 1,
   "xh": 0.68,
   "wiki": "Empetrum nigrum",
   "desc": "An evergreen dwarf shrub of heath and tundra with black berries, eaten by reindeer, voles, ptarmigan and bears.",
   "ic": "sage"
  },
  {
   "id": "sedge",
   "name": "Sedges and grasses",
   "latin": "Carex",
   "tl": 1,
   "xh": 0.88,
   "wiki": "Carex",
   "desc": "Sedges and grasses grow on the wet mires and meadows, and lemmings feed on them.",
   "ic": "grass"
  },
  {
   "id": "reindeer",
   "name": "Reindeer",
   "latin": "Rangifer tarandus",
   "tl": 2,
   "xh": 0.06,
   "wiki": "Reindeer",
   "desc": "Herded semi-wild by Sami villages. They eat lichen in winter and the berry shrubs and herbs of summer.",
   "ic": "elk",
   "badge": "Keystone grazer"
  },
  {
   "id": "moose",
   "name": "Moose",
   "latin": "Alces alces",
   "tl": 2,
   "xh": 0.22,
   "wiki": "Moose",
   "desc": "The largest deer, browsing twigs of birch and other woody plants. It is a major prey of bears and wolverines.",
   "ic": "moose"
  },
  {
   "id": "hare",
   "name": "Mountain hare",
   "latin": "Lepus timidus",
   "tl": 2,
   "xh": 0.38,
   "wiki": "Mountain hare",
   "desc": "Turns white in winter and eats birch twigs and buds and dwarf shrubs, and is prey for foxes, eagles and wolverines.",
   "ic": "quad"
  },
  {
   "id": "lemming",
   "name": "Norway lemming",
   "latin": "Lemmus lemmus",
   "tl": 2,
   "xh": 0.54,
   "wiki": "Norway lemming",
   "desc": "Eats mainly sedges, grasses and moss. Its population booms and crashes every three to four years, which in turn drives its predators.",
   "ic": "vole",
   "badge": "Keystone species"
  },
  {
   "id": "vole",
   "name": "Grey red-backed vole",
   "latin": "Myodes rufocanus",
   "tl": 2,
   "xh": 0.7,
   "wiki": "Grey red-backed vole",
   "desc": "A small rodent of forest and heath that eats crowberry and bilberry, and is eaten by foxes, wolverines and bears.",
   "ic": "vole"
  },
  {
   "id": "ptarmigan",
   "name": "Willow ptarmigan",
   "latin": "Lagopus lagopus",
   "tl": 2,
   "xh": 0.86,
   "wiki": "Willow ptarmigan",
   "desc": "A ground bird that eats buds, shoots and berries in the birch and shrub zone and is prey for foxes and eagles.",
   "ic": "meadowlark"
  },
  {
   "id": "arcticfox",
   "name": "Arctic fox",
   "latin": "Vulpes lagopus",
   "tl": 3,
   "xh": 0.12,
   "wiki": "Arctic fox",
   "desc": "Rare in Scandinavia. Lemmings are its most common prey, and its breeding success follows the lemming cycle.",
   "ic": "fox"
  },
  {
   "id": "redfox",
   "name": "Red fox",
   "latin": "Vulpes vulpes",
   "tl": 3,
   "xh": 0.4,
   "wiki": "Red fox",
   "desc": "Hunts lemmings, voles, hares and ptarmigan, and can kill Arctic foxes where their ranges overlap.",
   "ic": "fox"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.72,
   "wiki": "Common raven",
   "desc": "A clever scavenger that feeds on carcasses of reindeer and moose, and also eats berries and other foods.",
   "ic": "raven"
  },
  {
   "id": "wolverine",
   "name": "Wolverine",
   "latin": "Gulo gulo",
   "tl": 4,
   "xh": 0.2,
   "wiki": "Wolverine",
   "desc": "Mostly a scavenger on carrion in winter, but also an active hunter in Fennoscandia. Often feeds on kills left by other predators.",
   "ic": "quad",
   "badge": "Keystone predator"
  },
  {
   "id": "bear",
   "name": "Brown bear",
   "latin": "Ursus arctos",
   "tl": 4,
   "xh": 0.5,
   "wiki": "Brown bear",
   "desc": "An omnivore getting most of its food energy from plants such as berries, and also taking rodents and young moose and reindeer.",
   "ic": "grizzly"
  },
  {
   "id": "eagle",
   "name": "Golden eagle",
   "latin": "Aquila chrysaetos",
   "tl": 4,
   "xh": 0.8,
   "wiki": "Golden eagle",
   "desc": "A large raptor that hunts hares and gamebirds and also scans for carrion in winter.",
   "ic": "goldeneagle"
  }
 ],
