{"id": "whchapada", "name": "Chapada dos Veadeiros National Park", "short": "Chapada Veadeiros", "place": "Goiás, Brazil", "lat": -14.0, "lon": -47.6, "side": "r", "cont": "South America", "country": "Brazil", "kind": "Grassland", "park": true, "blurb": "Cerrado savanna, maned wolves and the fire that shapes the grass.", "tip": {"id": "fire", "title": "Take away fire", "text": "Fire renews the grasses and keeps the savanna open. Set Seasonal fire to -100% and watch the grasses, then the deer, rheas and termites that rely on them."}, "sources": [{"title": "Wikipedia: Chapada dos Veadeiros National Park", "url": "https://en.wikipedia.org/wiki/Chapada_dos_Veadeiros_National_Park"}, {"title": "Wikipedia: Cerrado", "url": "https://en.wikipedia.org/wiki/Cerrado"}, {"title": "Wikipedia: Maned wolf", "url": "https://en.wikipedia.org/wiki/Maned_wolf"}, {"title": "Wikipedia: Giant anteater", "url": "https://en.wikipedia.org/wiki/Giant_anteater"}, {"title": "Wikipedia: Pampas deer", "url": "https://en.wikipedia.org/wiki/Pampas_deer"}, {"title": "Wikipedia: Mauritia flexuosa", "url": "https://en.wikipedia.org/wiki/Mauritia_flexuosa"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Chapada dos Veadeiros National Park", "icon": "grass", "tier": "overview", "nodes": [{"id": "rain", "sp": "wet-season rains", "xh": 0.08}, {"id": "fire", "sp": "seasonal fire", "xh": 0.27}, {"id": "water", "sp": "veredas & rio preto streams", "xh": 0.46}, {"id": "soil", "sp": "poor acidic soils", "xh": 0.65}, {"id": "decomp", "sp": "decomposers", "xh": 0.85, "desc": "Fungi and soil microbes break down dead grass, leaves and wood and return nutrients to the soil."}, {"id": "grass", "sp": "axonopus, paspalum", "xh": 0.1}, {"id": "qualea", "sp": "qualea", "xh": 0.28}, {"id": "myrcia", "sp": "myrcia", "xh": 0.46, "name": "Myrcia shrubs", "desc": "Common fruiting shrubs and trees of the Cerrado. GloBI records link their fruit to many birds, tapirs, coatis and foxes."}, {"id": "wolfapple", "sp": "solanum lycocarpum", "xh": 0.64}, {"id": "buriti", "sp": "mauritia flexuosa", "xh": 0.82}, {"id": "termite", "sp": "isoptera", "xh": 0.1, "ic": "hopper"}, {"id": "leafcutter", "sp": "atta", "xh": 0.26}, {"id": "deer", "sp": "ozotoceros bezoarticus", "xh": 0.42}, {"id": "rhea", "sp": "rhea americana", "xh": 0.58}, {"id": "tapir", "sp": "tapirus terrestris", "xh": 0.74, "desc": "Eats fruit and leaves, and GloBI records it eating Myrcia. Buriti fruit is a food for tapirs, and the park lists tapir as present."}, {"id": "kiskadee", "sp": "pitangus sulphuratus", "xh": 0.9}, {"id": "anteater", "sp": "myrmecophaga tridactyla", "xh": 0.12, "desc": "Tears open termite and ant nests with its claws and licks up the insects. Only jaguars and pumas are known to hunt adults."}, {"id": "armadillo", "sp": "dasypus novemcinctus", "xh": 0.3, "wiki": "Nine-banded armadillo"}, {"id": "seriema", "sp": "cariama cristata", "xh": 0.48}, {"id": "manedwolf", "sp": "chrysocyon brachyurus", "xh": 0.68}, {"id": "vulture", "sp": "coragyps atratus", "xh": 0.86, "desc": "The park lists black vultures among its birds. They clean up carcasses of animals that have died."}, {"id": "jaguar", "sp": "panthera onca", "xh": 0.35, "desc": "The largest cat here. Its prey in the Cerrado includes giant anteater, tapir and deer, and it also hunts maned wolves."}, {"id": "puma", "sp": "puma concolor", "xh": 0.65, "desc": "A widespread big cat that hunts deer, rheas, armadillos and anteaters. It is a main predator of pampas deer."}], "raw": [["grass", "decomp", "d"], ["qualea", "decomp", "d"], ["myrcia", "decomp", "d"], ["buriti", "decomp", "d"], ["wolfapple", "decomp", "d"], ["rain", "grass", "r"], ["rain", "buriti", "r"], ["fire", "grass", "r"], ["fire", "qualea", "r"], ["water", "buriti", "r"], ["