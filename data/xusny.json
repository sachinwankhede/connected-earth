{"id": "xusny", "name": "Adirondack Park", "short": "Adirondacks", "place": "New York, USA", "lat": 44.0, "lon": -74.2, "side": "r", "cont": "North America", "country": "United States of America", "states": ["New York"], "kind": "Forest", "park": true, "blurb": "Northern forest, beaver ponds and loon lakes, with fishers and coyotes on top.", "tip": {"id": "hare", "title": "Lose the snowshoe hares", "text": "Hares are the fisher's main prey and food for coyotes and bobcats. Set Snowshoe hare to -100% and watch the fisher and the cats."}, "sources": [{"title": "Wikipedia: Adirondack Park", "url": "https://en.wikipedia.org/wiki/Adirondack_Park"}, {"title": "Wikipedia: Moose", "url": "https://en.wikipedia.org/wiki/Moose"}, {"title": "Wikipedia: Fisher (animal)", "url": "https://en.wikipedia.org/wiki/Fisher_(animal)"}, {"title": "Wikipedia: Common loon", "url": "https://en.wikipedia.org/wiki/Common_loon"}, {"title": "Wikipedia: Eastern coyote", "url": "https://en.wikipedia.org/wiki/Eastern_coyote"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Adirondack Park", "icon": "aspen", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Drives growth in forest canopy and lake algae alike; short northern winter days slow it."}, {"id": "water", "sp": "lakes, ponds & wetlands", "xh": 0.35}, {"id": "snow", "sp": "snow & winter cold", "xh": 0.6}, {"id": "soil", "sp": "forest soil & nutrients", "xh": 0.8, "desc": "Nutrients in thin forest and wetland soils are cycled mainly by decomposers."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.95, "name": "Fungi, insects & bacteria", "desc": "Break down fallen leaves, wood and carcasses and return nutrients to the soil."}, {"id": "fir", "sp": "abies balsamea", "xh": 0.1, "desc": "A common evergreen of the northern forest; its twigs and needles feed browsers in winter."}, {"id": "beech", "sp": "fagus grandifolia", "xh": 0.3, "name": "American beech", "desc": "A hardwood whose nuts are food for birds and mammals; GloBI records link it to several eaters.", "ic": "willow"}, {"id": "maple", "sp": "acer pensylvanicum", "xh": 0.5, "desc": "A small understory maple; Wikipedia lists striped maple among the new growth moose prefer."}, {"id": "lily", "sp": "nuphar", "xh": 0.7}, {"id": "algae", "sp": "algae", "xh": 0.9, "name": "Freshwater algae", "desc": "Microscopic plant-like growth in lakes and streams that feeds aquatic insects."}, {"id": "moose", "sp": "alces alces", "xh": 0.08, "desc": "A big browser of new tree growth and water plants; aquatic plants supply sodium that land plants lack.", "badge": "Keystone grazer"}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.24, "name": "North American beaver", "wiki": "North American beaver", "desc": "Nearly wiped out by 1893 in the Adirondacks, then returned; it dams streams and creates ponds.", "badge": "Ecosystem engineer"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.4, "wiki": "White-tailed deer", "desc": "Browses twigs and eats beechnuts; a main prey and carrion source for predators."}, {"id": "porcupine", "sp": "erethizon dorsatum", "xh": 0.56}, {"id": "hare", "sp": "lepus americanus", "xh": 0.72, "desc": "Feeds on twigs and buds in winter; the fisher's main prey."}, {"id": "mayfly", "sp": "ephemeroptera", "xh": 0.9, "desc": "Aquatic larvae graze algae in streams and lakes, then emerge as adults that fish and birds eat."}, {"id": "perch", "sp": "perca flavescens", "xh": 0.1, "tl": 3, "desc": "A common lake fish that eats insects and small prey and is food for loons."}, {"id": "loon", "sp": "gavia immer", "xh": 0.3, "desc": "Dives for fish in clear lakes; mercury that builds up in acidic lakes is a risk at the top of this chain."}, {"id": "fisher", "sp": "pekania pennanti", "xh": 