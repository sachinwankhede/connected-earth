 "tier": "overview",
 "nodes": [
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.12,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Summer light reaching the forest floor is limited once the oak canopy leafs out; spring wildflowers and shrubs make use of it first.",
   "ic": "sun"
  },
  {
   "id": "rain",
   "name": "Rain & mountain moisture",
   "latin": "",
   "tl": 0,
   "xh": 0.37,
   "cat": "abiotic",
   "wiki": "Rain",
   "desc": "The park gets roughly 50 inches of rain a year with no dry season, plus winter snow, which keeps the ridge forests and streams moist.",
   "ic": "rain"
  },
  {
   "id": "soil",
   "name": "Forest soil & leaf litter",
   "latin": "",
   "tl": 0,
   "xh": 0.62,
   "cat": "abiotic",
   "wiki": "Soil",
   "desc": "Thin mountain soils and fallen leaves hold the nutrients that trees, shrubs and the small animals of the forest floor depend on.",
   "ic": "soil"
  },
  {
   "id": "decomp",
   "name": "Fungi & bacteria",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.88,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Break down fallen leaves, logs and carcasses and return nutrients to the soil.",
   "ic": "decomp"
  },
  {
   "id": "oak",
   "name": "Oaks",
   "latin": "Quercus",
   "tl": 1,
   "xh": 0.1,
   "wiki": "Quercus",
   "desc": "Oaks dominate the park forests, especially since the chestnut was lost. Their acorns are an important autumn food for many animals.",
   "ic": "willow",
   "badge": "Foundation species"
  },
  {
   "id": "chestnut",
   "name": "American chestnut",
   "latin": "Castanea dentata",
   "tl": 1,
   "xh": 0.3,
   "wiki": "Castanea dentata",
   "desc": "Once a major forest tree, nearly wiped out by chestnut blight in the 1930s. It still sprouts from old roots but usually dies back before maturing.",
   "ic": "willow"
  },
  {
   "id": "rubus",
   "name": "Brambles & wild raspberries",
   "latin": "Rubus",
   "tl": 1,
   "xh": 0.5,
   "wiki": "Rubus",
   "desc": "Thorny shrubs whose summer fruit is food for bears, birds and small mammals.",
   "ic": "sage"
  },
  {
   "id": "sassafras",
   "name": "Sassafras",
   "latin": "Sassafras albidum",
   "tl": 1,
   "xh": 0.7,
   "wiki": "Sassafras albidum",
   "desc": "A common understory tree of the park with aromatic twigs and leaves. Its fruit and twigs feed wildlife.",
   "ic": "willow"
  },
  {
   "id": "litter",
   "name": "Leaf-litter invertebrates",
   "latin": "Collembola",
   "tl": 2,
   "xh": 0.05,
   "wiki": "Springtail",
   "desc": "Springtails, mites and other tiny animals of the leaf litter that feed on decaying leaves and fungi.",
   "ic": "ant"
  },
  {
   "id": "moth",
   "name": "Spongy (gypsy) moth",
   "latin": "Lymantria dispar",
   "tl": 2,
   "xh": 0.19,
   "wiki": "Spongy moth",
   "desc": "An introduced moth whose caterpillars strip oak and other leaves. Infestations from the early 1990s weakened the park's oak forests.",
   "ic": "hopper"
  },
  {
   "id": "mouse",
   "name": "White-footed mouse",
   "latin": "Peromyscus leucopus",
   "tl": 2,
   "xh": 0.33,
   "wiki": "White-footed mouse",
   "desc": "Abundant small rodent of the forest floor that eats seeds, nuts, fruit and insects, and is prey for many predators.",
   "ic": "vole"
  },
  {
   "id": "squirrel",
   "name": "Eastern gray squirrel",
   "latin": "Sciurus carolinensis",
   "tl": 2,
   "xh": 0.47,
   "wiki": "Eastern gray squirrel",
   "desc": "Tree squirrel that buries and eats acorns and other nuts.",
   "ic": "rsquirrel"
  },
  {
   "id": "rabbit",
   "name": "Eastern cottontail",
   "latin": "Sylvilagus floridanus",
   "tl": 2,
   "xh": 0.61,
   "wiki": "Eastern cottontail",
   "desc": "A common rabbit that eats grasses, herbs and the bark and twigs of woody plants in winter.",
   "ic": "quad"
  },
  {
   "id": "deer",
   "name": "White-tailed deer",
   "latin": "Odocoileus virginianus",
   "tl": 2,
   "xh": 0.8,
   "wiki": "White-tailed deer",
   "desc": "The park's most-recorded large mammal. It browses leaves, twigs, acorns and herbs, and is the main large prey for predators.",
   "ic": "muledeer",
   "badge": "Keystone grazer"
  },
  {
   "id": "sal",
   "name": "Eastern red-backed salamander",
   "latin": "Plethodon cinereus",
   "tl": 3,
   "xh": 0.1,
   "wiki": "Red-backed salamander",
   "desc": "Lungless salamander of the leaf litter that eats small invertebrates. It is among the most recorded animals near the park.",
   "ic": "snake"
  },
  {
   "id": "fox",
   "name": "Red fox",
   "latin": "Vulpes vulpes",
   "tl": 3,
   "xh": 0.3,
   "wiki": "Red fox",
   "desc": "Small omnivorous canid that hunts mice, rabbits and squirrels and also eats fruit and carrion.",
   "ic": "fox"
  },
  {
   "id": "raccoon",
   "name": "Raccoon",
   "latin": "Procyon lotor",
   "tl": 3,
   "xh": 0.5,
   "wiki": "Raccoon",
   "desc": "Omnivore that eats insects, amphibians, small mammals, fruit and nuts.",
   "ic": "quad"
  },
  {
   "id": "vulture",
   "name": "Turkey vulture",
   "latin": "Cathartes aura",
   "tl": 3,
   "xh": 0.7,
   "wiki": "Turkey vulture",
   "desc": "Soaring scavenger that finds and eats carrion.",
   "ic": "hawk"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.9,
   "wiki": "Common raven",
   "desc": "Large omnivorous crow that scavenges carcasses and also takes eggs, insects and berries.",
   "ic": "raven"
  },
  {
   "id": "bobcat",
   "name": "Bobcat",
   "latin": "Lynx rufus",
   "tl": 4,
   "xh": 0.2,
   "wiki": "Bobcat",
   "desc": "Wildcat that mostly hunts rabbits and rodents, and sometimes deer fawns.",
   "ic": "lion"
  },
  {
   "id": "coyote",
   "name": "Coyote",
   "latin": "Canis latrans",
   "tl": 4,
   "xh": 0.5,
   "wiki": "Coyote",
   "desc": "Adaptable canid that eats small mammals, fruit, carrion and sometimes deer fawns.",
   "ic": "coyote"
  },
  {
   "id": "bear",
   "name": "American black bear",
   "latin": "Ursus americanus",
   "tl": 4,
   "xh": 0.8,
   "wiki": "American black bear",
   "desc": "Mostly a plant eater. It relies on acorns, berries and insects, takes fawns in spring and scavenges carrion.",
   "ic": "grizzly"
  }
 ],
