{"id": "npshenandoah", "name": "Shenandoah National Park", "short": "Shenandoah", "place": "Virginia, USA", "lat": 38.53, "lon": -78.35, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Virginia"], "kind": "Forest", "park": true, "blurb": "Oaks, acorns and black bears along the Blue Ridge.", "tip": {"id": "oak", "title": "Lose the oaks", "text": "Acorns feed deer, bears, squirrels and mice. Set Oaks to -100% and watch the acorn eaters, then the predators that rely on them."}, "sources": [{"title": "Wikipedia: Shenandoah National Park", "url": "https://en.wikipedia.org/wiki/Shenandoah_National_Park"}, {"title": "NPS: Shenandoah nature and science", "url": "https://www.nps.gov/shen/learn/nature/index.htm"}, {"title": "Wikipedia: American black bear", "url": "https://en.wikipedia.org/wiki/American_black_bear"}, {"title": "Wikipedia: Shenandoah salamander", "url": "https://en.wikipedia.org/wiki/Shenandoah_salamander"}, {"title": "Wikipedia: Bobcat", "url": "https://en.wikipedia.org/wiki/Bobcat"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Shenandoah National Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.12, "desc": "Summer light reaching the forest floor is limited once the oak canopy leafs out; spring wildflowers and shrubs make use of it first."}, {"id": "rain", "sp": "rain & mountain moisture", "xh": 0.37}, {"id": "soil", "sp": "forest soil & leaf litter", "xh": 0.62}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Fungi & bacteria", "desc": "Break down fallen leaves, logs and carcasses and return nutrients to the soil."}, {"id": "oak", "sp": "quercus", "xh": 0.1, "desc": "Oaks dominate the park forests, especially since the chestnut was lost. Their acorns are an important autumn food for many animals.", "ic": "willow", "badge": "Foundation species"}, {"id": "chestnut", "sp": "castanea dentata", "xh": 0.3}, {"id": "rubus", "sp": "rubus", "xh": 0.5}, {"id": "sassafras", "sp": "sassafras albidum", "xh": 0.7, "desc": "A common understory tree of the park with aromatic twigs and leaves. Its fruit and twigs feed wildlife.", "ic": "willow"}, {"id": "litter", "sp": "collembola", "xh": 0.05}, {"id": "moth", "sp": "lymantria dispar", "xh": 0.19, "name": "Spongy (gypsy) moth", "wiki": "Spongy moth"}, {"id": "mouse", "sp": "peromyscus leucopus", "xh": 0.33, "wiki": "White-footed mouse", "desc": "Abundant small rodent of the forest floor that eats seeds, nuts, fruit and insects, and is prey for many predators.", "ic": "vole"}, {"id": "squirrel", "sp": "sciurus carolinensis", "xh": 0.47, "wiki": "Eastern gray squirrel", "desc": "Tree squirrel that buries and eats acorns and other nuts."}, {"id": "rabbit", "sp": "sylvilagus floridanus", "xh": 0.61, "wiki": "Eastern cottontail", "desc": "A common rabbit that eats grasses, herbs and the bark and twigs of woody plants in winter."}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.8, "wiki": "White-tailed deer", "desc": "The park's most-recorded large mammal. It browses leaves, twigs, acorns and herbs, and is the main large prey for predators.", "badge": "Keystone grazer"}, {"id": "sal", "sp": "plethodon cinereus", "xh": 0.1}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.3, "desc": "Small omnivorous canid that hunts mice, rabbits and squirrels and also eats fruit and carrion."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.5, "wiki": "Raccoon", "desc": "Omnivore that eats insects, amphibians, small mammals, fruit and nuts."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.7, "wiki": "Turkey vulture", "desc": "Soaring scavenger that finds and eats carrion."}, {"id": "raven", "sp": "corvus corax", "xh": 0.9, "wiki": "Common raven", "desc": "Large omnivorous crow that scavenges carcasses and also takes eggs, insects and berries."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.2, "wiki": "Bobcat", "desc": "Wildcat that mostly hunts rabbits and rodents, and sometimes deer fawns.", "ic": "lion"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.5, "wiki": "Coyote", "desc": "Adaptable canid that eats small mammals, fruit, carrion and sometimes deer fawns."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.8, "name": "American black bear", "wiki": "American black bear", "desc": "Mostly a plant eater. It relies on acorns, berries and insects, takes fawns in spring and scavenges carrion."}], "raw": [["sun", "oak", "r"], ["rain", "oak", "r"], ["soil", "oak", "r"], ["sun", "chestnut", "r"], ["rain", "chestnut", "r"], ["soil", "chestnut", "r"], ["sun", "rubus", "r"], ["rain", "rubus", "r"], ["soil", "rubus", "r"], ["sun", "sassafras", "r"], ["rain", "sassafras", "r"], ["soil", "sassafras", "r"], ["decomp", "soil", "r"], ["oak", "decomp", "d"], ["deer", "decomp", "d"], ["bear", "decomp", "d"], ["bobcat", "decomp", "d"], ["coyote", "decomp", "d"], ["chestnut", "decomp", "d"], ["oak", "litter"], ["oak", "moth"], ["chestnut", "moth"], ["sassafras", "moth"], ["oak", "mouse"], ["oak", "squirrel"], ["oak", "deer"], ["oak", "bear"], ["rubus", "bear"], ["rubus", "mouse"], ["rubus", "rabbit"], ["rubus", "deer"], ["sassafras", "bear"], ["sassafras", "deer"], ["sassafras", "rabbit"], ["litter", "sal"], ["moth", "mouse"], ["moth", "raccoon"], ["mouse", "fox"], ["mouse", "bobcat"], ["mouse", "coyote"], ["squirrel", "fox"], ["squirrel", "bobcat"], ["squirrel", "coyote"], ["rabbit", "fox"], ["rabbit", "bobcat"], ["rabbit", "coyote"], ["rabbit", "raccoon"], ["sal", "raccoon"], ["deer", "bear"], ["deer", "coyote"], ["deer", "bobcat"], ["rubus", "raven"], ["deer", "vulture", "s"], ["deer", "raven", "s"], ["rubus", "fox"], ["deer", "fox"], ["oak", "raccoon"], ["rubus", "raccoon"], ["squirrel", "raccoon"], ["deer", "raccoon"], ["squirrel", "