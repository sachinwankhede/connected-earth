{"id": "whetosha", "name": "Etosha National Park", "short": "Etosha", "place": "Namibia", "lat": -18.9, "lon": 16.0, "side": "l", "cont": "Africa", "country": "Namibia", "kind": "Grassland", "park": true, "blurb": "A vast salt pan, waterholes and the lions, elephants and rhinos that gather there.", "tip": {"id": "springbok", "title": "Thin the springbok", "text": "Springbok are the commonest antelope and the main prey of Etosha hyenas. Lower their numbers and watch hyenas, cheetahs, jackals and lions shift to other prey."}, "sources": [{"title": "Wikipedia: Etosha National Park", "url": "https://en.wikipedia.org/wiki/Etosha_National_Park"}, {"title": "Wikipedia: Springbok", "url": "https://en.wikipedia.org/wiki/Springbok"}, {"title": "Wikipedia: Spotted hyena", "url": "https://en.wikipedia.org/wiki/Spotted_hyena"}, {"title": "Wikipedia: Black rhinoceros", "url": "https://en.wikipedia.org/wiki/Black_rhinoceros"}, {"title": "Wikipedia: African bush elephant", "url": "https://en.wikipedia.org/wiki/African_bush_elephant"}, {"title": "Wikipedia: Mopane", "url": "https://en.wikipedia.org/wiki/Mopane"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Etosha National Park", "icon": "lion", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Strong year-round sun powers growth; in this dry savanna, water rather than light limits the plants."}, {"id": "rain", "sp": "summer rains", "xh": 0.3, "desc": "Rain falls mostly in the hot summer and varies a lot between years. It sets how much grass grows and briefly floods parts of the pan."}, {"id": "soil", "sp": "saline limestone soils", "xh": 0.52}, {"id": "water", "sp": "springs & waterholes", "xh": 0.74}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Termites, fungi & bacteria", "desc": "Break down dead grass, leaves and carcasses and return nutrients to the soil."}, {"id": "mopane", "sp": "colophospermum mopane", "xh": 0.12, "wiki": "Mopane", "ic": "willow", "badge": "Foundation species"}, {"id": "thorn", "sp": "vachellia tortilis", "xh": 0.36, "name": "Umbrella thorn & other acacias", "desc": "Thorn-bush savanna near the pan is dominated by acacias on limestone soils. Elephants, giraffes and rhinos browse them.", "ic": "sage"}, {"id": "pangrass", "sp": "sporobolus", "xh": 0.62}, {"id": "lovegrass", "sp": "eragrostis", "xh": 0.86}, {"id": "springbok", "sp": "antidorcas marsupialis", "xh": 0.06, "desc": "The most commonly recorded antelope here. It eats shrubs, succulents and grasses, and is the main prey of Etosha spotted hyenas."}, {"id": "zebra", "sp": "equus quagga", "xh": 0.18, "desc": "A very common grazer of the open grassland, and an important prey for lions and other predators."}, {"id": "wildebeest", "sp": "connochaetes taurinus", "xh": 0.3, "desc": "A grazer of short grassland, including the protein-rich grass fringing the pan."}, {"id": "gemsbok", "sp": "oryx gazella", "xh": 0.42, "desc": "A large desert-adapted antelope of the dry grassland and shrubland, and prey for lions."}, {"id": "kudu", "sp": "tragelaphus strepsiceros", "xh": 0.54}, {"id": "giraffe", "sp": "giraffa giraffa", "xh": 0.66}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.78, "name": "African bush elephant", "desc": "Mixed feeder that can eat 150 kg a day and topples trees, thinning woodland. Etosha elephants are very tall but have short tusks, linked to mineral deficiency."}, {"id": "rhino", "sp": "diceros bicornis", "xh": 0.9}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.15, "desc": "Mostly a hunter rather than a scavenger. In Etosha springbok and kudu are its main prey, and lions cause most hyena deaths."}, {"id": "cheetah", "sp": "acinonyx jubatus", "xh": 0.38, "desc": "A sprinting hunter of open country that takes medium antelope such as springbok. It is uncommon in Etosha."}, {"id": "jackal", "sp": "lupulella mesomelas", "xh": 0.62, "desc": "A very common small canid that scavenges kills and takes young springbok."}, {"id": "tawny", "sp": "aquila rapax", "xh": 0.85}, {"id": "lion", "sp": "panthera leo", "xh": 0.5, "desc": "Etosha's top predator. It hunts zebra, wildebeest, gemsbok, springbok and kudu, and also kills hyenas and scavenges."}], "raw": [["sun", "mopane", "r"], ["rain", "mopane", "r"], ["soil", "mopane", "r"], ["sun", "thorn", "r"], ["rain", "thorn", "r"], ["soil", "thorn", "r"], ["sun", "pangrass", "r"], ["rain", "pangrass", "r"], ["soil", "pangrass", "r"], ["sun", "lovegrass", "r"], ["rain", "lovegrass", "r"], ["soil", "lovegrass", "r"], ["water", "thorn", "r"], ["water", "lovegrass", "r"], ["water", "pangrass", "r"], ["decomp", "soil", "r"], ["mopane", "elephant"], ["mopane", "giraffe"], ["mopane", "kudu"], ["thorn", "springbok"], ["thorn", "elephant"], ["thorn", "giraffe"], ["thorn", "kudu"], ["thorn", "rhino"], ["pangrass", "wildebeest"], ["pangrass", "springbok"], ["lovegrass", "zebra"], ["lovegrass", "wildebeest"], ["lovegrass", "gemsbok"], ["springbok", "lion"], ["springbok", "hyena"], ["springbok", "cheetah"], ["springbok", "jackal"], ["springbok", "tawny"], ["zebra", "lion"], ["zebra", "hyena"], ["zebra", "cheetah"], ["wildebeest", "lion"], ["wildebeest", "hyena"], ["wildebeest", "cheetah"], ["gemsbok", "lion"], ["gemsbok", "hyena"], ["gemsbok", "cheetah"], ["kudu", "lion"], ["kudu", "hyena"], ["giraffe", "lion"], ["rhino", "lion"], ["hyena", "lion"], ["cheetah", "lion"], ["lion", "tawny", "s"], ["lion", "jackal", "s"], ["elephant", "jackal", "s"], ["elephant", "hyena", "s"], ["mopane", "decomp", "d"], ["lovegrass", "decomp", "d"], ["zebra", "decomp", "d"], ["elephant", "decomp", "d"], ["lion", "decomp", "d"], ["hyena", "decomp", "d"], ["giraffe", "hyena"], ["kudu", "cheetah"], ["giraffe", "cheetah"], ["zebra", "jackal"], ["wildebeest", "jackal"], ["kudu",