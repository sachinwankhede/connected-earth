 "nodes": [
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.08,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Strong year-round sun powers growth; in this dry savanna, water rather than light limits the plants.",
   "ic": "sun"
  },
  {
   "id": "rain",
   "name": "Summer rains",
   "latin": "",
   "tl": 0,
   "xh": 0.3,
   "cat": "abiotic",
   "wiki": "Rain",
   "desc": "Rain falls mostly in the hot summer and varies a lot between years. It sets how much grass grows and briefly floods parts of the pan.",
   "ic": "rain"
  },
  {
   "id": "soil",
   "name": "Saline limestone soils",
   "latin": "",
   "tl": 0,
   "xh": 0.52,
   "cat": "abiotic",
   "wiki": "Soil",
   "desc": "Alkaline, mineral-rich soils around the pan. Salty dust blown from the pan adds minerals to soils downwind.",
   "ic": "soil"
  },
  {
   "id": "water",
   "name": "Springs & waterholes",
   "latin": "",
   "tl": 0,
   "xh": 0.74,
   "cat": "abiotic",
   "wiki": "Water",
   "desc": "Dry-season waterholes fed by springs concentrate wildlife, so animals gather and are easier for predators to find.",
   "ic": "water"
  },
  {
   "id": "decomp",
   "name": "Termites, fungi & bacteria",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.92,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Break down dead grass, leaves and carcasses and return nutrients to the soil.",
   "ic": "decomp"
  },
  {
   "id": "mopane",
   "name": "Mopane",
   "latin": "Colophospermum mopane",
   "tl": 1,
   "xh": 0.12,
   "wiki": "Mopane",
   "desc": "The most common tree in Etosha, making up most of its trees. Elephants, giraffes and antelopes browse the leaves.",
   "ic": "willow",
   "badge": "Foundation species"
  },
  {
   "id": "thorn",
   "name": "Umbrella thorn & other acacias",
   "latin": "Vachellia tortilis",
   "tl": 1,
   "xh": 0.36,
   "wiki": "Vachellia tortilis",
   "desc": "Thorn-bush savanna near the pan is dominated by acacias on limestone soils. Elephants, giraffes and rhinos browse them.",
   "ic": "sage"
  },
  {
   "id": "pangrass",
   "name": "Pan-edge salt grass",
   "latin": "Sporobolus",
   "tl": 1,
   "xh": 0.62,
   "wiki": "Sporobolus",
   "desc": "Salt-tolerant Sporobolus grass grows on the otherwise bare pan margins. It is protein-rich and eaten by wildebeest and springbok.",
   "ic": "grass"
  },
  {
   "id": "lovegrass",
   "name": "Lovegrasses",
   "latin": "Eragrostis",
   "tl": 1,
   "xh": 0.86,
   "wiki": "Eragrostis",
   "desc": "Eragrostis grasses dominate sandy grasslands around the pan, depending on soil and pan effects.",
   "ic": "grass"
  },
  {
   "id": "springbok",
   "name": "Springbok",
   "latin": "Antidorcas marsupialis",
   "tl": 2,
   "xh": 0.06,
   "wiki": "Springbok",
   "desc": "The most commonly recorded antelope here. It eats shrubs, succulents and grasses, and is the main prey of Etosha spotted hyenas.",
   "ic": "pronghorn"
  },
  {
   "id": "zebra",
   "name": "Plains zebra",
   "latin": "Equus quagga",
   "tl": 2,
   "xh": 0.18,
   "wiki": "Plains zebra",
   "desc": "A very common grazer of the open grassland, and an important prey for lions and other predators.",
   "ic": "quad"
  },
  {
   "id": "wildebeest",
   "name": "Blue wildebeest",
   "latin": "Connochaetes taurinus",
   "tl": 2,
   "xh": 0.3,
   "wiki": "Blue wildebeest",
   "desc": "A grazer of short grassland, including the protein-rich grass fringing the pan.",
   "ic": "bison"
  },
  {
   "id": "gemsbok",
   "name": "Gemsbok",
   "latin": "Oryx gazella",
   "tl": 2,
   "xh": 0.42,
   "wiki": "Gemsbok",
   "desc": "A large desert-adapted antelope of the dry grassland and shrubland, and prey for lions.",
   "ic": "quad"
  },
  {
   "id": "kudu",
   "name": "Greater kudu",
   "latin": "Tragelaphus strepsiceros",
   "tl": 2,
   "xh": 0.54,
   "wiki": "Greater kudu",
   "desc": "A woodland browser of leaves and shoots. Kudu are a main prey of spotted hyenas in Etosha.",
   "ic": "elk"
  },
  {
   "id": "giraffe",
   "name": "Angolan giraffe",
   "latin": "Giraffa giraffa",
   "tl": 2,
   "xh": 0.66,
   "wiki": "Southern giraffe",
   "desc": "Etosha giraffes belong to the Angolan form of the southern giraffe and browse leaves, shoots and fruits of acacias and other trees.",
   "ic": "giraffe"
  },
  {
   "id": "elephant",
   "name": "African bush elephant",
   "latin": "Loxodonta africana",
   "tl": 2,
   "xh": 0.78,
   "wiki": "African bush elephant",
   "desc": "Mixed feeder that can eat 150 kg a day and topples trees, thinning woodland. Etosha elephants are very tall but have short tusks, linked to mineral deficiency.",
   "ic": "elephant",
   "badge": "Ecosystem engineer"
  },
  {
   "id": "rhino",
   "name": "Black rhinoceros",
   "latin": "Diceros bicornis",
   "tl": 2,
   "xh": 0.9,
   "wiki": "Black rhinoceros",
   "desc": "A selective browser that strips leaves and twigs with its prehensile lip, favouring acacias. Etosha is a major stronghold for the species.",
   "ic": "quad"
  },
  {
   "id": "hyena",
   "name": "Spotted hyena",
   "latin": "Crocuta crocuta",
   "tl": 3,
   "xh": 0.15,
   "wiki": "Spotted hyena",
   "desc": "Mostly a hunter rather than a scavenger. In Etosha springbok and kudu are its main prey, and lions cause most hyena deaths.",
   "ic": "quad"
  },
  {
   "id": "cheetah",
   "name": "Cheetah",
   "latin": "Acinonyx jubatus",
   "tl": 3,
   "xh": 0.38,
   "wiki": "Cheetah",
   "desc": "A sprinting hunter of open country that takes medium antelope such as springbok. It is uncommon in Etosha.",
   "ic": "lion"
  },
  {
   "id": "jackal",
   "name": "Black-backed jackal",
   "latin": "Lupulella mesomelas",
   "tl": 3,
   "xh": 0.62,
   "wiki": "Black-backed jackal",
   "desc": "A very common small canid that scavenges kills and takes young springbok.",
   "ic": "fox"
  },
  {
   "id": "tawny",
   "name": "Tawny eagle",
   "latin": "Aquila rapax",
   "tl": 3,
   "xh": 0.85,
   "wiki": "Tawny eagle",
   "desc": "A raptor that hunts and also feeds at carcasses; it is known to take young springbok.",
   "ic": "goldeneagle"
  },
  {
   "id": "lion",
   "name": "Lion",
   "latin": "Panthera leo",
   "tl": 4,
   "xh": 0.5,
   "wiki": "Lion",
   "desc": "Etosha's top predator. It hunts zebra, wildebeest, gemsbok, springbok and kudu, and also kills hyenas and scavenges.",
   "ic": "lion",
   "badge": "Keystone predator"
  }
 ],
