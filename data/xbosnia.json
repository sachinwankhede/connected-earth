{"id": "xbosnia", "name": "Sutjeska National Park", "short": "Sutjeska", "place": "Bosnia and Herzegovina", "lat": 43.3, "lon": 18.7, "side": "r", "cont": "Europe", "country": "Bosnia and Herz.", "blurb": "Primeval beech forest, chamois and the bears and wolves of the Dinaric mountains.", "tip": {"id": "chamois", "title": "Remove the chamois", "text": "Chamois are a main wild prey of wolves and golden eagles. Set Balkan chamois to -100% and see who loses food, and what changes for the bear and ravens that scavenge them."}, "sources": [{"title": "Wikipedia: Sutjeska National Park", "url": "https://en.wikipedia.org/wiki/Sutjeska_National_Park"}, {"title": "Wikipedia: Balkan chamois", "url": "https://en.wikipedia.org/wiki/Balkan_chamois"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}, {"title": "Wikipedia: European beech", "url": "https://en.wikipedia.org/wiki/European_beech"}, {"title": "Wikipedia: Wolf", "url": "https://en.wikipedia.org/wiki/Wolf"}, {"title": "Wikipedia: Wild boar", "url": "https://en.wikipedia.org/wiki/Wild_boar"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Sutjeska National Park", "icon": "aspen", "tier": "overview", "kind": "Forest", "park": true, "nodes": [{"id": "beech", "sp": "fagus sylvatica", "xh": 0.15, "desc": "The dominant tree of the Perućica primeval forest, where some beeches reach about 60 m. Its nuts are food for many animals, including jays and wild boar.", "ic": "willow"}, {"id": "fir", "sp": "abies alba", "xh": 0.4, "wiki": "Abies alba", "desc": "A conifer of the coniferous and beech forests on the park's northwestern slopes. Chamois eat conifer needles and bark in winter.", "ic": "aspen"}, {"id": "herbs", "sp": "trollius europaeus and others", "xh": 0.65}, {"id": "elder", "sp": "sambucus ebulus", "xh": 0.88}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.1, "name": "Balkan chamois", "wiki": "Balkan chamois", "desc": "A goat-antelope of steep rocky ground. It grazes highland grasses and herbs in summer and eats conifer needles and bark in winter.", "badge": "Keystone grazer"}, {"id": "boar", "sp": "sus scrofa", "xh": 0.25, "desc": "An omnivore for which acorns and beechnuts are key foods in temperate forests. It digs up roots and bulbs and eats carrion."}, {"id": "jay", "sp": "garrulus glandarius", "xh": 0.4, "ic": "raven"}, {"id": "pigeon", "sp": "columba palumbus", "xh": 0.55}, {"id": "finch", "sp": "fringilla coelebs", "xh": 0.7, "desc": "A common forest songbird that eats seeds and berries and feeds insects to its young."}, {"id": "moth", "sp": "euplagia quadripunctaria", "xh": 0.88}, {"id": "raven", "sp": "corvus corax", "xh": 0.15, "wiki": "Common raven", "desc": "An omnivorous crow that scavenges carcasses and is regularly seen in the park."}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.38, "desc": "A medium-sized raptor that takes small mammals, birds and reptiles, including snakes."}, {"id": "shrike", "sp": "lanius collurio", "xh": 0.62}, {"id": "viper", "sp": "vipera ammodytes", "xh": 0.86}, {"id": "bear", "sp": "ursus arctos", "xh": 0.2, "desc": "A largely plant-eating omnivore that also takes wild boar and feeds on carrion, especially in early spring. Bears have been sighted in Perućica.", "badge": "Keystone predator"}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "wiki": "Wolf", "desc": "A pack hunter whose prey across Eurasia includes red deer, roe deer and wild boar. Wolves have been sighted in Perućica.", "no": ["badge"]}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.8, "desc": "A large raptor reported in Perućica. It eats mostly small mammals, medium-sized birds and reptiles, and also uses carrion."}, {"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Summer light drives growth in the forest canopy and on the open pastures above it."}, {"id": "rain", "sp": "rain and snowmelt", "xh": 0.3, "wiki": "Rain", "desc": "Mountain precipitation feeds streams and the glacial lakes of Zelengora, and sustains the forest."}, {"id": "snow", "sp": "winter snow", "xh": 0.52, "desc": "Deep mountain snow pushes chamois down from the meadows to forested slopes, where they eat conifer needles."}, {"id": "soil", "sp": "forest soil", "xh": 0.72, "desc": "Leaf litter and dead wood build the soil that the primeval beech and fir forest grows on."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Fungi & soil life", "desc": "Fungi and soil organisms break down dead wood, leaves and carcasses and return nutrients to the soil. The park has about 100 edible fungi species."}], "raw": [["sun", "beech", "r"], ["rain", "beech", "r"], ["soil", "beech", "r"], ["sun", "fir", "r"], ["rain", "fir", "r"], ["soil", "fir", "r"], ["sun", "herbs", "r"], ["rain", "herbs", "r"], ["soil", "herbs", "r"], ["sun", "elder", "r"], ["rain", "elder", "r"], ["soil", "elder", "r"], ["snow", "herbs", "r"], ["decomp", "soil", "r"], ["fir", "chamois"], ["herbs", "chamois"], ["beech", "boar"], ["herbs", "boar"], ["beech", "jay"], ["beech", "finch"], ["herbs", "finch"], ["elder", "finch"], ["herbs", "pigeon"], ["elder", "pigeon"], ["beech", "pigeon"], ["elder", "moth"], ["finch", "shrike"], ["finch", "buzzard"], ["jay", "buzzard"], ["pigeon", "buzzard"], ["viper", "buzzard"], ["finch", "viper"], ["boar", "bear"], ["herbs", "bear"], ["chamois", "wolf"], ["boar", "wolf"], ["beech", "raven"], ["chamois", "eagle"], ["viper", "eagle"], ["pigeon", "eagle"], ["chamois", "raven", "s"], ["boar", "raven", "s"], ["chamois", "bear", "s"], ["chamois", "eagle", "s"], ["beech", "decomp", "d"], ["fir", "decomp", "d"], ["herbs", "decomp", "d"], ["elder", "decomp", "d"], ["chamois", "decomp", "d"], ["boar", "decomp", "d"], ["wolf", "decomp", "d"], ["bear", "decomp", "d"], ["fir", "jay"], ["herbs", "jay"],