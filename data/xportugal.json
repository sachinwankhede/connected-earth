{"id": "xportugal", "name": "Peneda-Gerês National Park", "short": "Peneda-Gerês", "place": "Portugal", "lat": 41.75, "lon": -8.15, "side": "l", "cont": "Europe", "country": "Portugal", "kind": "Forest", "park": true, "blurb": "Atlantic oak woods, heath and clear streams, home to wolves and desmans.", "tip": {"id": "wolf", "title": "Remove the wolf", "text": "Wolves eat roe deer, boar and ibex. Set Iberian wolf to -100% and watch those herbivores, then the heath and oak shoots they browse."}, "sources": [{"title": "Wikipedia: Peneda-Gerês National Park", "url": "https://en.wikipedia.org/wiki/Peneda-Gerês_National_Park"}, {"title": "Wikipedia: Iberian wolf", "url": "https://en.wikipedia.org/wiki/Iberian_wolf"}, {"title": "Wikipedia: Pyrenean desman", "url": "https://en.wikipedia.org/wiki/Pyrenean_desman"}, {"title": "Wikipedia: Wild boar", "url": "https://en.wikipedia.org/wiki/Wild_boar"}, {"title": "Wikipedia: Garrano", "url": "https://en.wikipedia.org/wiki/Garrano"}, {"title": "Wikipedia: Eurasian otter", "url": "https://en.wikipedia.org/wiki/Eurasian_otter"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Peneda-Gerês National Park", "icon": "aspen", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Light drives growth of the oaks, heath and gorse that cover the slopes and valleys of the site."}, {"id": "rain", "sp": "atlantic rainfall", "xh": 0.3}, {"id": "river", "sp": "clear mountain streams", "xh": 0.5}, {"id": "soil", "sp": "mountain soil and litter", "xh": 0.7, "desc": "Thin soils and leaf litter hold the nutrients that oak woods, heath and bilberry draw back up."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "desc": "Break down fallen leaves, carcasses and dung, returning nutrients to the soil and streams."}, {"id": "oak", "sp": "quercus robur", "xh": 0.12, "desc": "One of the oaks that dominate the broadleaf woods of the valleys. Its acorns and leaves feed boar and roe deer."}, {"id": "heather", "sp": "calluna vulgaris", "xh": 0.32, "desc": "Dwarf shrub of the heath that makes up much of the shrubland, with gorse. Browsed by roe deer and grazers."}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.5, "desc": "Low berry shrub of the upland woods and heath. Its leaves and fruit are eaten by roe deer and foxes."}, {"id": "gorse", "sp": "ulex minor", "xh": 0.7}, {"id": "willow", "sp": "salix atrocinerea", "xh": 0.88}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.1, "name": "Roe deer", "wiki": "Roe deer", "desc": "Small deer, abundant around the park margins and a symbol of the site. Feeds on shoots, leaves and berries."}, {"id": "boar", "sp": "sus scrofa", "xh": 0.3, "desc": "Omnivore that digs roots and eats acorns, berries, small animals and carrion. A main prey of the wolf."}, {"id": "ibex", "sp": "capra pyrenaica", "xh": 0.5}, {"id": "garrano", "sp": "equus caballus", "xh": 0.7, "name": "Garrano horse", "wiki": "Garrano", "desc": "Small semi-feral mountain horse, present across about 97% of the park, living in harems on the high plateaus."}, {"id": "caddis", "sp": "trichoptera", "xh": 0.9, "name": "Stream insect larvae", "desc": "Caddisfly and similar larvae shred fallen leaves in the streams; the main food of the Pyrenean desman."}, {"id": "desman", "sp": "galemys pyrenaicus", "xh": 0.06, "desc": "Small aquatic mole that hunts stream insect larvae, mostly. Vulnerable in Portugal and a sign of clean water."}, {"id": "trout", "sp": "salmo trutta", "xh": 0.2, "desc": "Fish of the park rivers, eating stream insects. Native fish are the preferred food of otters in Iberia."}, {"id": "otter", "sp": "lutra lutra", "xh": 0.34, "desc": "Well adapted to the park waters. Eats mainly fish, plus amphibians and sometimes the desman."}, {"id": "frog", "sp": "rana iberica", "xh": 0.48}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.62, "wiki": "Red fox", "desc": "Opportunist that takes small animals and berries and scavenges carcasses."}, {"id": "genet", "sp": "genetta genetta", "xh": 0.76, "desc": "Slender nocturnal carnivore that hunts amphibians, reptiles, birds and small mammals."}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.9, "desc": "Raptor that hunts small animals and also takes carrion."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "name": "Iberian wolf", "wiki": "Iberian wolf", "desc": "Top predator, now rare in the park. In the Iberian mountains boar and roe deer are its main prey."}], "raw": [["sun", "oak", "r"], ["sun", "heather", "r"], ["sun", "bilberry", "r"], ["sun", "gorse", "r"], ["sun", "willow", "r"], ["rain", "oak", "r"], ["soil", "oak", "r"], ["rain", "heather", "r"], ["soil", "heather", "r"], ["rain", "bilberry", "r"], ["soil", "bilberry", "r"], ["rain", "gorse", "r"], ["soil", "gorse", "r"], ["rain", "willow", "r"], ["soil", "willow", "r"], ["river", "willow", "r"], ["decomp", "soil", "r"], ["oak", "decomp", "d"], ["heather", "decomp", "d"], ["bilberry", "decomp", "d"], ["gorse", "decomp", "d"], ["willow", "decomp", "d"], ["roe", "decomp", "d"], ["boar", "decomp", "d"], ["ibex", "decomp", "d"], ["garrano", "decomp", "d"], ["caddis", "decomp", "d"], ["desman", "decomp", "d"], ["trout", "decomp", "d"], ["otter", "decomp", "d"], ["frog", "decomp", "d"], ["fox", "decomp", "d"], ["genet", "decomp", "d"], ["buzzard", "decomp", "d"], ["wolf", "decomp", "d"], ["oak", "roe"], ["heather", "roe"], ["bilberry", "roe"], ["oak", "boar"], ["heather", "boar"], ["heather", "ibex"], ["gorse", "ibex"], ["heather", "garrano"], ["gorse", "garrano"], ["oak", "caddis"], ["willow", "caddis"], ["caddis", "desman"], ["caddis", "trout"], ["caddis", "frog"], ["trout", "otter"], ["frog", "otter"], ["desman", "otter"], ["desman", "fox"], ["frog", "fox"], ["bilberry", "fox"], ["roe", "fox", "s"], ["frog", "gene