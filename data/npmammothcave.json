{"id": "npmammothcave", "name": "Mammoth Cave National Park", "short": "Mammoth Cave", "place": "Kentucky, USA", "lat": 37.19, "lon": -86.1, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Kentucky"], "kind": "Forest", "park": true, "blurb": "Oak-hickory karst forest above the longest known cave system, with its bats and crickets.", "tip": {"id": "oak", "title": "Fail the acorn crop", "text": "Oaks feed deer, squirrels, mice and cave crickets. Set Oaks & hickories to -100% and watch them fall, then the coyotes and rattlesnakes that eat them."}, "sources": [{"title": "Wikipedia: Mammoth Cave National Park", "url": "https://en.wikipedia.org/wiki/Mammoth_Cave_National_Park"}, {"title": "NPS: Mammoth Cave animals", "url": "https://www.nps.gov/maca/learn/nature/animals.htm"}, {"title": "Wikipedia: Mammoth Cave cricket", "url": "https://en.wikipedia.org/wiki/Hadenoecus_subterraneus"}, {"title": "Wikipedia: Indiana bat", "url": "https://en.wikipedia.org/wiki/Indiana_bat"}, {"title": "Wikipedia: Gray bat", "url": "https://en.wikipedia.org/wiki/Gray_bat"}, {"title": "Wikipedia: Timber rattlesnake", "url": "https://en.wikipedia.org/wiki/Timber_rattlesnake"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Mammoth Cave National Park", "icon": "aspen", "tier": "overview", "nodes": [{"id": "oak", "sp": "quercus", "xh": 0.12, "name": "Oaks & hickories", "desc": "Wikipedia classes the park's natural vegetation as oak/hickory forest. Their leaves, acorns and nuts feed many forest animals, and their litter feeds the soil.", "ic": "willow", "badge": "Foundation species"}, {"id": "beech", "sp": "fagus grandifolia", "xh": 0.34, "name": "American beech", "desc": "A hardwood common in the park's forest. Its nuts and leaves are eaten by deer and mice, with GloBI records for both."}, {"id": "pawpaw", "sp": "asimina triloba", "xh": 0.56, "desc": "A woodland understory tree with large fruit. GloBI records show raccoons and opossums eating it.", "ic": "willow"}, {"id": "wild", "sp": "trillium", "xh": 0.78}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.08, "wiki": "White-tailed deer", "desc": "Often seen along park roads. Browses leaves, wildflowers and nuts, and is eaten by coyotes and scavenged by vultures."}, {"id": "squirrel", "sp": "sciurus carolinensis", "xh": 0.24, "wiki": "Eastern gray squirrel", "desc": "Common in the park's hardwood forest. Eats acorns and nuts, and is prey for coyotes and snakes."}, {"id": "mouse", "sp": "peromyscus leucopus", "xh": 0.4, "wiki": "White-footed mouse", "desc": "A small forest rodent that eats seeds and nuts. Wikipedia says it is the most common prey of the timber rattlesnake.", "ic": "vole"}, {"id": "moth", "sp": "halysidota tessellaris", "xh": 0.56, "desc": "Its caterpillars chew leaves of oak and many other trees. The adult moths are food for bats; GloBI records the red bat eating them.", "ic": "mayfly"}, {"id": "cricket", "sp": "hadenoecus subterraneus", "xh": 0.72}, {"id": "crayfish", "sp": "orconectes pellucidus", "xh": 0.88}, {"id": "indbat", "sp": "myotis sodalis", "xh": 0.08}, {"id": "graybat", "sp": "myotis grisescens", "xh": 0.24}, {"id": "cavefish", "sp": "amblyopsis spelaea", "xh": 0.4}, {"id": "ratsnake", "sp": "pantherophis alleghaniensis", "xh": 0.56, "name": "Central ratsnake", "wiki": "Central ratsnake", "desc": "Adults eat small mammals, birds and eggs. Wikipedia says black rat snakes also prey on hibernating Indiana bats.", "ic": "snake"}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.72, "wiki": "Raccoon", "desc": "An omnivore that eats fruit like pawpaw, crayfish and other small animals, and takes hibernating bats."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.88, "wiki": "Turkey vulture", "desc": "Among the most recorded birds near the park. Scavenges carcasses such as deer and other mammals."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "Top mammal predator in the region. GloBI records it eating deer, squirrels, mice, rabbits and raccoons."}, {"id": "rattler", "sp": "crotalus horridus", "xh": 0.7, "tl": 4, "wiki": "Timber rattlesnake", "ic": "snake"}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Spring light reaching the forest floor before the canopy leafs out powers the wildflowers and trees."}, {"id": "rain", "sp": "rainfall", "xh": 0.3, "desc": "Rain feeds the Green River and the sinking streams that flow into the cave system."}, {"id": "karst", "sp": "karst limestone soil", "xh": 0.5}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, beetles & bacteria", "desc": "Break down leaf litter, carcasses and cave guano and return nutrients to the soil."}], "raw": [["sun", "oak", "r"], ["rain", "oak", "r"], ["karst", "oak", "r"], ["oak", "decomp", "d"], ["sun", "beech", "r"], ["rain", "beech", "r"], ["karst", "beech", "r"], ["beech", "decomp", "d"], ["sun", "pawpaw", "r"], ["rain", "pawpaw", "r"], ["karst", "pawpaw", "r"], ["pawpaw", "decomp", "d"], ["sun", "wild", "r"], ["rain", "wild", "r"], ["karst", "wild", "r"], ["wild", "decomp", "d"], ["decomp", "karst", "r"], ["oak", "deer"], ["oak", "squirrel"], ["oak", "mouse"], ["oak", "moth"], ["oak", "cricket"], ["oak", "crayfish"], ["beech", "deer"], ["beech", "mouse"], ["beech", "squirrel"], ["wild", "deer"], ["pawpaw", "raccoon"], ["deer", "coyote"], ["squirrel", "coyote"], ["mouse", "coyote"], ["mouse", "rattler"], ["squirrel", "rattler"], ["mouse", "ratsnake"], ["squirrel", "ratsnake"], ["moth", "indbat"], ["moth", "graybat"], ["crayfish", "cavefish"], ["crayfish", "raccoon"], ["indbat", "ratsnake"], ["indbat", "raccoon"], ["ratsnake", "coyote"], ["raccoon", "coyote"], ["deer", "vulture", "s"], ["coyote", "vulture", "s"], ["raccoon", "vulture", "s"], ["dee