{"id": "xmacedonia", "name": "Lake Ohrid Region", "short": "Lake Ohrid", "place": "North Macedonia and Albania", "lat": 41.05, "lon": 20.7, "side": "r", "cont": "Europe", "country": "Macedonia", "countries": ["Macedonia", "Albania"], "blurb": "A clear, ancient lake with over 200 endemic species, from trout to snails.", "tip": {"id": "phyto", "title": "Remove the algae", "text": "Set Phytoplankton to -100% and watch zooplankton, snails and roach fall, then the Ohrid trout, eel, pelican and dice snake that eat them."}, "sources": [{"title": "Wikipedia: Lake Ohrid", "url": "https://en.wikipedia.org/wiki/Lake_Ohrid"}, {"title": "Wikipedia: Ohrid trout", "url": "https://en.wikipedia.org/wiki/Ohrid_trout"}, {"title": "Wikipedia: Dalmatian pelican", "url": "https://en.wikipedia.org/wiki/Dalmatian_pelican"}, {"title": "Wikipedia: Dice snake", "url": "https://en.wikipedia.org/wiki/Dice_snake"}, {"title": "Wikipedia: European eel", "url": "https://en.wikipedia.org/wiki/European_eel"}, {"title": "Wikipedia: Marsh frog", "url": "https://en.wikipedia.org/wiki/Marsh_frog"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Lake Ohrid", "icon": "water", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light drives the algae of the clear lake, the reed beds and the crops and vines of the shore."}, {"id": "springs", "sp": "karst springs and prespa seepage", "xh": 0.35}, {"id": "clear", "sp": "clear, low-nutrient water", "xh": 0.6}, {"id": "phos", "sp": "phosphorus inputs", "xh": 0.8}, {"id": "decomp", "sp": "decomposer community", "xh": 0.95, "name": "Bacteria and fungi", "desc": "Break down dead algae, reeds, fish and land animals, returning nutrients to the water and soil."}, {"id": "phyto", "sp": "bacillariophyceae and other microalgae", "xh": 0.15}, {"id": "reed", "sp": "phragmites australis", "xh": 0.35, "wiki": "Common reed", "desc": "Forms reed beds along wetland shores. Most Ohrid shore wetlands have been drained, and the reed belt is under pressure from building."}, {"id": "vine", "sp": "vitis vinifera", "xh": 0.62}, {"id": "maize", "sp": "zea mays", "xh": 0.85}, {"id": "zoo", "sp": "copepoda", "xh": 0.1, "desc": "Tiny crustaceans of open water. Ohrid has about five endemic zooplankton species. General ecology: they graze algae."}, {"id": "snail", "sp": "gastropoda", "xh": 0.27}, {"id": "roach", "sp": "pachychilon pictum", "xh": 0.44}, {"id": "dormouse", "sp": "glis glis", "xh": 0.64, "desc": "Forest and orchard rodent recorded near the lake. GloBI links it to grapes and dwarf elder.", "ic": "quad"}, {"id": "mouse", "sp": "apodemus sylvaticus", "xh": 0.84, "desc": "A common small rodent of the shore scrub and fields that eats crop seed such as maize and is prey for many predators."}, {"id": "trout", "sp": "salmo letnica", "xh": 0.06}, {"id": "eel", "sp": "anguilla anguilla", "xh": 0.2, "desc": "Eats fish and molluscs at night. Dams on the Drin block its return, so Ohrid eels are stocked."}, {"id": "pelican", "sp": "pelecanus crispus", "xh": 0.34, "desc": "A big fish-eater among the waterbirds that winter in the Ohrid reed beds. Wetland drainage caused its decline."}, {"id": "frog", "sp": "pelophylax ridibundus", "xh": 0.48, "desc": "Large water frog of lakes and rivers. Mostly eats invertebrates but also takes small fish and other amphibians.", "ic": "quad"}, {"id": "dice", "sp": "natrix tessellata", "xh": 0.62, "desc": "Water snake of lake shores, recorded very often near Ohrid. It often eats fish and sometimes frogs and toads."}, {"id": "marten", "sp": "martes foina", "xh": 0.78, "wiki": "Stone marten", "desc": "Omnivore. GloBI records link it to rodents, frogs, snakes and grapes."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.92, "wiki": "Red fox", "desc": "Generalist that eats rodents, frogs, snakes and fruit, per GloBI records."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.35, "desc": "Top predator of the surrounding mountains, with GloBI records of it eating rodents, foxes, martens and snakes.", "no": ["badge"]}, {"id": "bear", "sp": "ursus arctos", "xh": 0.65, "desc": "Omnivore of the mountains. GloBI records show it eating rodents, foxes, grapes and maize."}], "raw": [["sun", "phyto", "r"], ["sun", "reed", "r"], ["sun", "vine", "r"], ["sun", "maize", "r"], ["springs", "phyto", "r"], ["springs", "reed", "r"], ["clear", "phyto", "r"], ["phos", "phyto", "r"], ["phos", "reed", "r"], ["phyto", "zoo"], ["phyto", "snail"], ["phyto", "roach"], ["zoo", "roach"], ["snail", "eel"], ["roach", "trout"], ["roach", "eel"], ["roach", "pelican"], ["roach", "frog"], ["roach", "dice"], ["frog", "dice"], ["vine", "dormouse"], ["maize", "mouse"], ["vine", "fox"], ["vine", "marten"], ["vine", "bear"], ["maize", "bear"], ["mouse", "fox"], ["mouse", "marten"], ["mouse", "wolf"], ["mouse", "bear"], ["dormouse", "fox"], ["dormouse", "marten"], ["dormouse", "wolf"], ["dormouse", "bear"], ["frog", "fox"], ["frog", "marten"], ["dice", "fox"], ["dice", "marten"], ["dice", "wolf"], ["fox", "wolf"], ["marten", "wolf"], ["fox", "bear"], ["phyto", "decomp", "d"], ["reed", "decomp", "d"], ["vine", "decomp", "d"], ["maize", "decomp", "d"], ["zoo", "decomp", "d"], ["snail", "decomp", "d"], ["roach", "decomp", "d"], ["trout", "decomp", "d"], ["eel", "decomp", "d"], ["pelican", "decomp", "d"], ["frog", "decomp", "d"], ["dice", "decomp", "d"], ["dormouse", "decomp", "d"], ["mouse", "decomp", "d"], ["marten", "decomp", "d"], ["fox", "decomp", "d"], ["wolf", "decomp", "d"], ["bear", "decomp", "d"], ["decomp", "phos", "r"], ["zoo", "eel"], ["snail", "dice"], ["snail", "fox"], ["zoo", "wolf"], ["snail", "wolf"], ["pelican", "wolf"], ["frog", "wolf"]], "kind": "Lakes & wetlands", "park": true, "ev": {"phyto>zoo": ["a"], "phyto>snail": ["a"], "phyto>roach": ["a"], "zoo>roach": 