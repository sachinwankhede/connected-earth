ayfish and frogs. It needs permanent clean water with cover."}, {"id": "osprey", "sp": "pandion haliaetus", "xh": 0.56, "desc": "A fish-eating hawk that dives feet-first for live fish in the river and nearby coast."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.72, "wiki": "Turkey vulture", "desc": "A scavenger that finds carrion by scent and cleans dead deer, raccoons and other animals from the floodplain.", "ic": "raven"}, {"id": "cotton", "sp": "agkistrodon piscivorus", "xh": 0.88, "desc": "A semi-aquatic pit viper of swamps and sloughs that eats fish, frogs and other small animals.", "ic": "snake"}, {"id": "gator", "sp": "alligator mississippiensis", "xh": 0.3, "desc": "An opportunistic apex predator of swamps and rivers that eats fish, turtles, raccoons and nutria. Its dug holes hold water in dry spells."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.7, "wiki": "Bobcat", "desc": "A stealthy cat that takes rabbits, rodents, squirrels, nutria and deer fawns across the forests.", "ic": "lion"}], "raw": [["sun", "cypress", "r"], ["soil", "cypress", "r"], ["sun", "wateroak", "r"], ["soil", "wateroak", "r"], ["sun", "catbrier", "r"], ["soil", "catbrier", "r"], ["sun", "yaupon", "r"], ["soil", "yaupon", "r"], ["flood", "cypress", "r"], ["flood", "wateroak", "r"], ["flood", "soil", "r"], ["decomp", "soil", "r"], ["cypress", "decomp", "d"], ["wateroak", "decomp", "d"], ["gator", "decomp", "d"], ["deer", "decomp", "d"], ["wateroak", "deer"], ["catbrier", "deer"], ["cypress", "foxsq"], ["yaupon", "foxsq"], ["wateroak", "foxsq"], ["cypress", "nutria"], ["wateroak", "jay"], ["cypress", "mayfly"], ["wateroak", "mayfly"], ["mayfly", "bluegill"], ["yaupon", "raccoon"], ["catbrier", "raccoon"], ["jay", "raccoon"], ["bluegill", "gator"], ["nutria", "gator"], ["raccoon", "gator"], ["otter", "gator"], ["bluegill", "otter"], ["bluegill", "osprey"], ["bluegill", "cotton"], ["deer", "bobcat"], ["foxsq", "bobcat"], ["nutria", "bobcat"], ["raccoon", "bobcat"], ["deer", "vulture"