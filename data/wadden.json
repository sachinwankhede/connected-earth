y", "Denmark"], "ev": {"mpb>snail": ["a"], "mpb>lugworm": ["g", "Arenicola marina", "Microphytobenthos"], "mpb>ragworm": ["g", "Hediste diversicolor", "Microphytobenthos"], "mpb>tellin": ["a"], "mpb>cockle": ["g", "Cerastoderma edule", "Microphytobenthos"], "mpb>mussel": ["a"], "phyto>cockle": ["a"], "phyto>mussel": ["a"], "eelgrass>crab": ["a"], "snail>shrimp": ["a"], "snail>knot": ["g", "Calidris canutus", "Peringia ulvae"], "lugworm>godwit": ["g", "Limosa lapponica", "Arenicola marina"], "lugworm>plaice": ["g", "Pleuronectes platessa", "Arenicola marina"], "ragworm>godwit": ["a"], "ragworm>plaice": ["g", "Pleuronectes platessa", "Hediste diversicolor"], "ragworm>crab": ["g", "Carcinus maenas", "Hediste diversicolor"], "cockle>knot": ["g", "Calidris canutus", "Cerastoderma edule"], "cockle>oyc": ["g", "Haematopus ostralegus", "Cerastoderma edule"], "cockle>crab": ["g", "Carcinus maenas", "Cerastoderma edule"], "mussel>oyc": ["g", "Haematopus ostralegus", "Mytilus edulis"], "mussel>eider": ["g", "Somateria mollissima", "Mytilus edulis"], "mussel>crab": ["g", "Carcinus maenas", "Mytilus edulis"], "tellin>knot": ["g", "Calidris canutus", "Macoma balthica"], "tellin>plaice": ["g", "Pleuronectes platessa", "Macoma balthica"], "tellin>crab": ["g", "Carcinus maenas", "Macoma balthica"], "shrimp>plaice": ["g", "Pleuronectes platessa", "Crangon crangon"], "shrimp>seal": ["g", "Phoca vitulina", "Crangon crangon"], "crab>eider": ["g", "Somateria mollissima", "Carcinus maenas"], "crab>gull": ["g", "Larus argentatus", "Carcinus maenas"], "crab>seal": ["g", "Phoca vitulina", "Carcinus maenas"], "plaice>seal": ["g", "Phoca vitulina", "Pleuronectes platessa"], "eelgrass>lugworm": ["g", "Arenicola marina", "Zostera marina"], "lugworm>shrimp": ["g", "Crangon crangon", "Arenicola marina"], "ragworm>shrimp": ["g", "Crangon crangon", "Hediste diversicolor"], "cockle>shrimp": ["g", "Crangon crangon", "Cerastoderma edule"], "mussel>shrimp": ["g", "Crangon crangon", "Mytilus edulis"], "t