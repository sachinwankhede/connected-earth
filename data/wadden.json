a edule", "xh": 0.39}, {"id": "mussel", "sp": "mytilus edulis", "xh": 0.51, "desc": "Forms dense beds on the flats by attaching to each other and to hard bits of ground. A preferred food of eiders and oystercatchers.", "badge": "Ecosystem engineer"}, {"id": "tellin", "sp": "macoma balthica", "xh": 0.62}, {"id": "shrimp", "sp": "crangon crangon", "xh": 0.06}, {"id": "crab", "sp": "carcinus maenas", "xh": 0.18}, {"id": "plaice", "sp": "pleuronectes platessa", "xh": 0.3}, {"id": "knot", "sp": "calidris canutus", "xh": 0.42, "ic": "hawk"}, {"id": "godwit", "sp": "limosa lapponica", "xh": 0.54}, {"id": "oyc", "sp": "haematopus ostralegus", "xh": 0.66}, {"id": "eider", "sp": "somateria mollissima", "xh": 0.78, "desc": "A diving sea duck that swallows mussels whole and crushes them in its gizzard. It also eats crabs and other crustaceans."}, {"id": "gull", "sp": "larus argentatus", "xh": 0.9, "desc": "An opportunistic gull of the coast that feeds on shore crabs and other items found on the flats."}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.34, "name": "Harbour seal", "tl": 4, "wiki": "Harbour seal", "desc": "Rests on sandbanks at low tide. Eats mainly fish, including flatfish, and occasionally shrimp and crabs.", "badge": "Top predator"}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light reaching the exposed flats at low tide lets mud-surface algae and eelgrass grow."}, {"id": "nutrients", "sp": "nutrients", "xh": 0.36, "desc": "Nitrogen and phosphorus carried in from rivers and the sea. Bacteria in the mud release them again from dead matter.", "ic": "water"}, {"id": "tide", "sp": "tides", "xh": 0.64, "desc": "Twice daily the sea floods and uncovers the flats, setting feeding times for birds, fish and shellfish."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Mud bacteria", "desc": "Break down dead algae, plants and animals in the mud and return nutrients to the water."}], "raw": [["sun", "mpb", "r"], ["sun", "eelgrass", "r"], ["sun", 