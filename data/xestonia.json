{"id": "xestonia", "name": "Soomaa National Park", "short": "Soomaa", "place": "Estonia", "lat": 58.44, "lon": 25.1, "side": "r", "cont": "Europe", "country": "Estonia", "kind": "Lakes & wetlands", "park": true, "blurb": "Raised bogs, floodplain meadows and the spring flood Estonians call the fifth season.", "tip": {"id": "flood", "title": "Skip the fifth season", "text": "Spring floods water the meadows and forest edges. Set Spring flood to -100% and watch the sedges and willows, then the beavers, deer and predators that rely on them."}, "sources": [{"title": "Wikipedia: Soomaa National Park", "url": "https://en.wikipedia.org/wiki/Soomaa_National_Park"}, {"title": "Wikipedia: Eurasian beaver", "url": "https://en.wikipedia.org/wiki/Eurasian_beaver"}, {"title": "Wikipedia: Eurasian lynx", "url": "https://en.wikipedia.org/wiki/Eurasian_lynx"}, {"title": "Wikipedia: Northern pike", "url": "https://en.wikipedia.org/wiki/Northern_pike"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Soomaa National Park", "icon": "water", "tier": "overview", "nodes": [{"id": "sphagnum", "sp": "sphagnum", "xh": 0.15, "desc": "Bog moss that builds the wet peat of raised bogs such as Kuresoo, the best-known bog in the park."}, {"id": "sedge", "sp": "carex", "xh": 0.38, "name": "Floodplain sedges & grasses", "desc": "Sedges of the riverside meadows that spend each spring under floodwater and feed many grazers."}, {"id": "pine", "sp": "pinus sylvestris", "xh": 0.62, "ic": "willow", "no": ["badge"]}, {"id": "willow", "sp": "salix", "xh": 0.85, "wiki": "Salix", "desc": "Waterside trees and shrubs; willow is a staple food and building material for beavers."}, {"id": "vole", "sp": "microtus agrestis", "xh": 0.06}, {"id": "hare", "sp": "lepus europaeus", "xh": 0.2, "desc": "Grazer of open ground that lynx turn to when roe deer are scarce."}, {"id": "mallard", "sp": "anas platyrhynchos", "xh": 0.34, "wiki": "Mallard", "desc": "Dabbling duck of flooded meadows and rivers that eats plant matter and small invertebrates."}, {"id": "beaver", "sp": "castor fiber", "xh": 0.5, "desc": "Eats waterside plants and the bark and shoots of willow, aspen and birch. Its dams create wetland habitat for otters and others."}, {"id": "boar", "sp": "sus scrofa", "xh": 0.65, "desc": "One of the most numerous large mammals in the park. An omnivore that roots for plants and small animals."}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.8, "name": "Roe deer", "wiki": "Roe deer", "desc": "A numerous browser of shoots and herbs, and the preferred prey of lynx in Estonia."}, {"id": "moose", "sp": "alces alces", "xh": 0.94, "name": "Elk (moose)", "wiki": "Moose", "desc": "Large browser of willow and pine twigs, and one of the park's most numerous big mammals.", "ic": "moose", "badge": "Keystone grazer"}, {"id": "crane", "sp": "grus grus", "xh": 0.1, "tl": 3, "desc": "Breeds and gathers on the bogs and floodplain; about a thousand gather here in autumn. Eats plants, voles and other small animals."}, {"id": "otter", "sp": "lutra lutra", "xh": 0.3, "desc": "Hunts along rivers and beaver wetlands. Recorded eating ducks, frogs and snakes."}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.5, "desc": "Raptor of forest edges and meadows that hunts voles, hares and other small animals."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.75, "desc": "Generalist hunter of voles, hares and ducks that also scavenges carcasses."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.2, "desc": "Ambush hunter. In Estonia roe deer are its main prey, with hares, beavers and foxes taken too."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "name": "Grey wolf", "wiki": "Wolf", "desc": "Pack hunter of moose, roe deer and wild boar, and a top predator of the forest."}, {"id": "bear", "sp": "ursus arctos", "xh": 0.8, "desc": "Omnivore that takes young deer and moose, beavers and carrion as well as plant foods."}, {"id": "flood", "sp": "fifth season", "xh": 0.2}, {"id": "snow", "sp": "snow", "xh": 0.4, "name": "Snowmelt & winter", "desc": "Winter snow and ice that melt into the yearly flood and shape how easily deer and moose can feed."}, {"id": "peat", "sp": "peat", "xh": 0.6, "latin": "Peat", "name": "Peat & bog", "desc": "Wet raised-bog peat and swamp-forest soils that anchor mosses and trees."}, {"id": "sun", "sp": "sun", "xh": 0.8, "latin": "Sun", "name": "Sunlight", "desc": "Summer light that drives growth of meadow plants and trees."}, {"id": "decomp", "sp": "fungi and bacteria", "xh": 0.95, "desc": "Fungi and microbes that break down dead plants and carcasses into nutrients."}], "raw": [["flood", "sedge", "r"], ["flood", "willow", "r"], ["peat", "sphagnum", "r"], ["peat", "pine", "r"], ["sun", "sedge", "r"], ["sun", "pine", "r"], ["sun", "willow", "r"], ["snow", "flood", "r"], ["decomp", "peat", "r"], ["sphagnum", "decomp", "d"], ["sedge", "decomp", "d"], ["pine", "decomp", "d"], ["willow", "decomp", "d"], ["sedge", "vole"], ["sedge", "hare"], ["willow", "hare"], ["sedge", "mallard"], ["sedge", "beaver"], ["willow", "beaver"], ["sedge", "boar"], ["sedge", "roe"], ["willow", "roe"], ["willow", "moose"], ["pine", "moose"], ["sedge", "crane"], ["vole", "crane"], ["vole", "fox"], ["hare", "fox"], ["mallard", "fox"], ["vole", "buzzard"], ["hare", "buzzard"], ["mallard", "otter"], ["vole", "boar"], ["roe", "fox"], ["roe", "lynx"], ["hare", "lynx"], ["beaver", "lynx"], ["fox", "lynx"], ["moose", "wolf"], ["roe", "wolf"], ["boar", "wolf"], ["beaver", "wolf"], ["moose", "bear"], ["roe", "bear"], ["beaver", "bear"], ["vole", "bear"], ["boar", "lynx"], ["sedge", "bear"], ["moose", "fox", "s"], ["moose", "bear", "s"], ["pine", "mallard"], ["pine", "roe"], ["roe", "buzzard"], ["beaver", "fox"], ["boar", "fox"], ["vole", "lynx"], ["moose", "lynx"], ["otter", "