{"id": "xlithuania", "name": "Curonian Spit", "short": "Curonian Spit", "place": "Lithuania and Russia", "lat": 55.3, "lon": 21.0, "side": "r", "cont": "Europe", "country": "Lithuania", "countries": ["Lithuania", "Russia"], "kind": "Coast & ocean", "park": true, "blurb": "A 98 km sand spit of moving dunes, planted pines, and a lagoon on a bird flyway.", "tip": {"id": "wolf", "title": "Remove the wolf", "text": "Take the gray wolf out and watch moose, roe deer and wild boar numbers rise, with more browsing pressure on the pine forest."}, "sources": [{"title": "Wikipedia: Curonian Spit", "url": "https://en.wikipedia.org/wiki/Curonian_Spit"}, {"title": "UNESCO World Heritage: Curonian Spit", "url": "https://whc.unesco.org/en/list/994"}, {"title": "Wikipedia: Curonian Lagoon", "url": "https://en.wikipedia.org/wiki/Curonian_Lagoon"}, {"title": "Wikipedia: Curonian Spit National Park (Lithuania)", "url": "https://en.wikipedia.org/wiki/Curonian_Spit_National_Park_(Lithuania)"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Curonian Spit", "icon": "soil", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.2, "desc": "Light powers the pine forest, the dune grasses and the algae of the shallow lagoon."}, {"id": "sand", "sp": "drifting sand and dunes", "xh": 0.4}, {"id": "nutr", "sp": "river nutrients", "xh": 0.6, "wiki": "Nutrient", "desc": "The Neman River supplies most of the water entering the shallow Curonian Lagoon, bringing the nutrients that feed its algae."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.8, "name": "Soil fungi and bacteria", "desc": "Break down pine litter, reeds, algae and carcasses, returning nutrients to the thin sandy soil and the lagoon."}, {"id": "pine", "sp": "pinus sylvestris", "xh": 0.15, "desc": "The main forest tree of the spit, much of it planted since the 1800s to hold moving sand in place. Its shoots and seeds feed deer, moose and rodents."}, {"id": "ammophila", "sp": "ammophila arenaria", "xh": 0.38}, {"id": "reed", "sp": "phragmites australis", "xh": 0.62, "wiki": "Common reed", "desc": "Forms reed beds along the lagoon shore, giving food and cover to waterbirds, beavers and fish."}, {"id": "phyto", "sp": "algae and cyanobacteria", "xh": 0.85}, {"id": "mouse", "sp": "apodemus agrarius", "xh": 0.06}, {"id": "boar", "sp": "sus scrofa", "xh": 0.2, "name": "Wild boar", "desc": "An omnivore that roots for plant matter and small animals in the forest. Wolves prey on it."}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.34, "desc": "A small browser of the forest edge, feeding on shoots, leaves and berries. The best-recorded deer near the spit."}, {"id": "moose", "sp": "alces alces", "xh": 0.48, "wiki": "Moose", "desc": "The largest browser in the area, feeding on twigs and shoots of trees and shrubs. Wolves and white-tailed eagles feed on it, the eagles as carrion.", "ic": "moose", "badge": "Keystone grazer"}, {"id": "beaver", "sp": "castor fiber", "xh": 0.62, "desc": "Feeds on bark, shoots and water plants, and builds dams and lodges along waterways."}, {"id": "swan", "sp": "cygnus olor", "xh": 0.76, "desc": "A large waterbird that grazes on aquatic plants in the lagoon and its reed beds."}, {"id": "roach", "sp": "rutilus rutilus", "xh": 0.9, "wiki": "Roach", "desc": "A common freshwater fish that eats plankton, plants and small invertebrates. Perch, cormorants and eagles eat it."}, {"id": "stoat", "sp": "mustela erminea", "xh": 0.12, "desc": "A small hunter of mice, voles and small birds in dunes and forest edges."}, {"id": "raven", "sp": "corvus corax", "xh": 0.3, "desc": "An omnivorous scavenger that feeds on carcasses and small animals."}, {"id": "gull", "sp": "larus argentatus", "xh": 0.5, "desc": "An opportunistic feeder on the coast, taking fish, small animals and scraps.", "ic": "hawk"}, {"id": "cormorant", "sp": "phalacrocorax carbo", "xh": 0.7, "desc": "A diving fish-eater that is abundant on the lagoon and coast.", "ic": "osprey"}, {"id": "perch", "sp": "perca fluviatilis", "xh": 0.88}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "desc": "Hunts deer, moose and wild boar in the forests."}, {"id": "eagle", "sp": "haliaeetus albicilla", "xh": 0.7, "desc": "Hunts fish and waterbirds around the lagoon and also scavenges carrion."}], "raw": [["sun", "pine", "r"], ["sun", "ammophila", "r"], ["sun", "reed", "r"], ["sun", "phyto", "r"], ["sand", "ammophila", "r"], ["sand", "pine", "r"], ["nutr", "phyto", "r"], ["nutr", "reed", "r"], ["decomp", "nutr", "r"], ["pine", "moose"], ["pine", "roe"], ["pine", "mouse"], ["pine", "boar"], ["reed", "beaver"], ["reed", "swan"], ["phyto", "roach"], ["mouse", "boar"], ["mouse", "stoat"], ["mouse", "gull"], ["mouse", "wolf"], ["roach", "perch"], ["roach", "cormorant"], ["perch", "cormorant"], ["roach", "gull"], ["roach", "eagle"], ["perch", "eagle"], ["cormorant", "eagle"], ["swan", "eagle"], ["roe", "eagle"], ["moose", "wolf"], ["roe", "wolf"], ["boar", "wolf"], ["beaver", "wolf"], ["stoat", "raven"], ["moose", "raven", "s"], ["roe", "raven", "s"], ["moose", "eagle", "s"], ["ammophila", "mouse"], ["pine", "decomp", "d"], ["moose", "decomp", "d"], ["roe", "decomp", "d"], ["boar", "decomp", "d"], ["beaver", "decomp", "d"], ["swan", "decomp", "d"], ["roach", "decomp", "d"], ["mouse", "decomp", "d"], ["wolf", "decomp", "d"], ["eagle", "decomp", "d"], ["reed", "decomp", "d"], ["phyto", "decomp", "d"], ["perch", "decomp", "d"], ["cormorant", "decomp", "d"], ["raven", "decomp", "d"], ["gull", "decomp", "d"], ["stoat", "decomp", "d"], ["ammophila", "decomp", "d"], ["pine", "swan"], ["phyto", "swan"], ["pine", "raven"], ["reed", "raven"], ["mouse", "raven"], ["swan", "raven"], ["swan", "gull"], ["swan", "wolf"], ["stoat", "wolf"], ["raven", "wolf"], ["gull", "wolf"], ["cormo