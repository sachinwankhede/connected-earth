{"id": "xarmenia", "name": "Khosrov Forest State Reserve", "short": "Khosrov Forest", "place": "Armenia", "lat": 40.04, "lon": 44.9, "side": "r", "cont": "Asia", "country": "Armenia", "kind": "Forest", "park": true, "blurb": "Juniper, oak and wild pear slopes where leopards, bears and vultures live.", "tip": {"id": "ibex", "title": "Remove the bezoar ibex", "text": "Set Bezoar ibex to -100% and watch the leopard and wolf lose a main prey, then the vultures lose carrion they depend on."}, "sources": [{"title": "Wikipedia: Khosrov Forest State Reserve", "url": "https://en.wikipedia.org/wiki/Khosrov_Forest_State_Reserve"}, {"title": "Wikipedia: Bezoar ibex", "url": "https://en.wikipedia.org/wiki/Bezoar_ibex"}, {"title": "Wikipedia: Cinereous vulture", "url": "https://en.wikipedia.org/wiki/Cinereous_vulture"}, {"title": "Wikipedia: Bearded vulture", "url": "https://en.wikipedia.org/wiki/Bearded_vulture"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Khosrov Forest State Reserve", "icon": "aspen", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Strong summer sun and dry air shape the semi-desert, steppe and juniper slopes of the reserve."}, {"id": "snow", "sp": "snow and snowmelt", "xh": 0.45, "desc": "The reserve climbs from about 700 m to 2,800 m, so winter snow and spring melt water the upper slopes and meadows."}, {"id": "soil", "sp": "stony mountain soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi and soil bacteria", "desc": "Break down dead plants, dung and carcasses and return nutrients to the soil."}, {"id": "grass", "sp": "aegilops", "xh": 0.15}, {"id": "juniper", "sp": "juniperus polycarpos", "xh": 0.38}, {"id": "oak", "sp": "quercus macranthera", "xh": 0.62}, {"id": "pear", "sp": "pyrus", "xh": 0.85}, {"id": "ibex", "sp": "capra aegagrus", "xh": 0.15}, {"id": "hare", "sp": "lepus europaeus", "xh": 0.32, "desc": "Grazes grasses and herbs in open ground and is eaten by foxes, eagles, lynx and wolves."}, {"id": "vole", "sp": "microtus arvalis", "xh": 0.5}, {"id": "boar", "sp": "sus scrofa", "xh": 0.68, "name": "Wild boar", "wiki": "Wild boar", "desc": "An omnivore that eats acorns, fruit, roots and other foods in the reserve."}, {"id": "chukar", "sp": "alectoris chukar", "xh": 0.86, "wiki": "Chukar"}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.12, "desc": "A flexible hunter and fruit eater that takes voles, hares, birds and wild pears."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.3, "tl": 3, "desc": "A secretive cat of the reserve that hunts hares and ground birds.", "no": ["badge"]}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.48, "tl": 3, "desc": "A large raptor of open mountain country that hunts hares and game birds such as chukar."}, {"id": "cinereous", "sp": "aegypius monachus", "xh": 0.66, "desc": "Eats mostly carrion. The reserve is the only place in Armenia where it is known to nest, on juniper trees."}, {"id": "bearded", "sp": "gypaetus barbatus", "xh": 0.85, "desc": "The only bird that lives mostly on bones, dropping large ones from the air to break them open."}, {"id": "leopard", "sp": "panthera pardus tulliana", "xh": 0.22}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "desc": "A pack hunter that takes hares, wild ungulates and smaller prey in the reserve.", "no": ["badge"]}, {"id": "bear", "sp": "ursus arctos", "xh": 0.78, "desc": "The largest predator of the reserve, though most of a brown bear diet is plants such as fruit and acorns."}], "raw": [["sun", "grass", "r"], ["soil", "grass", "r"], ["sun", "juniper", "r"], ["soil", "juniper", "r"], ["sun", "oak", "r"], ["soil", "oak", "r"], ["sun", "pear", "r"], ["soil", "pear", "r"], ["snow", "grass", "r"], ["snow", "oak", "r"], ["snow", "juniper", "r"], ["decomp", "soil", "r"], ["grass", "ibex"], ["grass", "hare"], ["grass", "vole"], ["grass", "chukar"], ["grass", "boar"], ["grass", "bear"], ["oak", "boar"], ["oak", "bear"], ["pear", "boar"], ["pear", "fox"], ["pear", "bear"], ["vole", "fox"], ["vole", "bear"], ["hare", "fox"], ["hare", "lynx"], ["hare", "eagle"], ["hare", "wolf"], ["hare", "leopard"], ["chukar", "fox"], ["chukar", "lynx"], ["chukar", "eagle"], ["chukar", "bear"], ["ibex", "leopard"], ["ibex", "wolf"], ["boar", "leopard"], ["boar", "wolf"], ["boar", "bear"], ["hare", "bearded"], ["ibex", "cinereous", "s"], ["ibex", "bearded", "s"], ["boar", "cinereous", "s"], ["boar", "bearded", "s"], ["grass", "decomp", "d"], ["juniper", "decomp", "d"], ["oak", "decomp", "d"], ["pear", "decomp", "d"], ["ibex", "decomp", "d"], ["hare", "decomp", "d"], ["vole", "decomp", "d"], ["boar", "decomp", "d"], ["chukar", "decomp", "d"], ["fox", "decomp", "d"], ["lynx", "decomp", "d"], ["eagle", "decomp", "d"], ["cinereous", "decomp", "d"], ["bearded", "decomp", "d"], ["leopard", "decomp", "d"], ["wolf", "decomp", "d"], ["bear", "decomp", "d"], ["ibex", "fox"], ["boar", "fox"], ["ibex", "lynx"], ["vole", "lynx"], ["boar", "lynx"], ["vole", "eagle"], ["boar", "eagle"], ["fox", "leopard"], ["vole", "wolf"], ["chukar", "wolf"], ["fox", "wolf"], ["lynx", "wolf"], ["fox", "bear"], ["eagle", "bear"]], "ev": {"grass>ibex": ["a"], "grass>hare": ["a"], "grass>vole": ["a"], "grass>chukar": ["a"], "grass>boar": ["a"], "grass>bear": ["a"], "oak>boar": ["gg", "Sus scrofa", "Quercus macranthera"], "oak>bear": ["gg", "Ursus arctos", "Quercus macranthera"], "pear>boar": ["gg", "Sus scrofa", "Pyrus"], "pear>fox": ["gg", "Vulpes vulpes", "Pyrus"], "pear>bear": ["a"], "vole>fox": ["g", "Vulpes vulpes", "Microtus arvalis"], "vole>bear": ["g", "Ursus arctos", "Microtus arvalis"], "hare>fox": ["g", "Vulpes vulpes", "Lepus europaeus"], "hare>lynx": ["g", "Lyn