{"id": "xzambia", "name": "South Luangwa National Park", "short": "S. Luangwa", "place": "Zambia", "lat": -13.0, "lon": 31.6, "side": "r", "cont": "Africa", "country": "Zambia", "kind": "Grassland", "park": true, "blurb": "Hippos, lagoons and mopane woodland along a wandering river.", "tip": {"id": "hippo", "title": "Remove the hippos", "text": "Hippos graze on land at night and fertilize the river with dung. Lower their numbers and watch the fish, crocodiles and fish eagles respond."}, "sources": [{"title": "Wikipedia: South Luangwa National Park", "url": "https://en.wikipedia.org/wiki/South_Luangwa_National_Park"}, {"title": "Wikipedia: Luangwa River", "url": "https://en.wikipedia.org/wiki/Luangwa_River"}, {"title": "Wikipedia: Colophospermum mopane", "url": "https://en.wikipedia.org/wiki/Colophospermum_mopane"}, {"title": "Wikipedia: Hippopotamus", "url": "https://en.wikipedia.org/wiki/Hippopotamus"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "South Luangwa National Park", "icon": "lion", "tier": "overview", "nodes": [{"id": "mopane", "sp": "colophospermum mopane", "xh": 0.15, "desc": "The dominant tree of the hot valley floor, often forming near-uniform woodland. Its leaves feed elephants, giraffes, antelopes and caterpillars.", "badge": "Foundation species"}, {"id": "grass", "sp": "cynodon", "xh": 0.4}, {"id": "ebony", "sp": "diospyros mespiliformis", "xh": 0.65, "name": "Ebony tree", "desc": "Riverine forest tree whose fruit and leaves are eaten by elephants, impala and many other animals."}, {"id": "lettuce", "sp": "pistia stratiotes", "xh": 0.88, "desc": "A floating plant of lagoons and slow water that is eaten by some antelopes."}, {"id": "zebra", "sp": "equus quagga", "xh": 0.05, "desc": "A grazer of valley grasslands, found alongside giraffes that browse leaves in the same areas."}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.17, "wiki": "African elephant", "desc": "Eats grass, fruit and the leaves of mopane and ebony trees, and shapes woodland as it feeds."}, {"id": "impala", "sp": "aepyceros melampus", "xh": 0.28, "desc": "A mixed grazer and browser that is among the most common prey of lions, leopards and wild dogs."}, {"id": "puku", "sp": "kobus vardonii", "xh": 0.39}, {"id": "buffalo", "sp": "syncerus caffer", "xh": 0.5, "desc": "Herds graze coarse grass and are taken by lions, hyenas and wild dogs."}, {"id": "hippo", "sp": "hippopotamus amphibius", "xh": 0.62, "desc": "Rests in the river by day and grazes grass on land at night, moving nutrients into the water as dung.", "ic": "bison"}, {"id": "giraffe", "sp": "giraffa thornicrofti", "xh": 0.76}, {"id": "fish", "sp": "oreochromis", "xh": 0.92, "name": "River fish", "desc": "Fish in the river and lagoons are fertilized by hippo dung and are eaten by crocodiles and fish eagles."}, {"id": "wilddog", "sp": "lycaon pictus", "xh": 0.15, "desc": "A pack hunter of impala, puku, zebra and other medium-sized herbivores."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.4, "desc": "Hunts and scavenges across the valley, feeding on many of the same animals as lions."}, {"id": "croc", "sp": "crocodylus niloticus", "xh": 0.65, "tl": 3, "desc": "Lives in the river and lagoons, eating fish and ambushing animals that come to drink."}, {"id": "eagle", "sp": "haliaeetus vocifer", "xh": 0.88, "desc": "A bird of the river and lagoons that takes fish from the surface."}, {"id": "lion", "sp": "panthera leo", "xh": 0.35, "desc": "Top predator of the valley, hunting zebra, buffalo, impala, puku and giraffe.", "no": ["badge"]}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.65, "desc": "A solitary hunter of impala, puku and other prey; the Nsefu sector has some of the highest recorded densities in southern Africa."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Heat and light drive growth in the woodland and grassland, so water decides when plants flourish."}, {"id": "rain", "sp": "rainy season", "xh": 0.3, "wiki": "Rain", "desc": "Rains from about December to March swell the Luangwa River and green the valley; in the dry season animals crowd near water."}, {"id": "river", "sp": "luangwa river floods", "xh": 0.5}, {"id": "soil", "sp": "valley soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Decomposers", "desc": "Beetles, termites, fungi and microbes break down dung, carcasses and dead plants and return nutrients to the soil."}], "raw": [["sun", "mopane", "r"], ["sun", "grass", "r"], ["sun", "ebony", "r"], ["sun", "lettuce", "r"], ["rain", "mopane", "r"], ["soil", "mopane", "r"], ["rain", "grass", "r"], ["soil", "grass", "r"], ["rain", "ebony", "r"], ["soil", "ebony", "r"], ["river", "grass", "r"], ["river", "lettuce", "r"], ["decomp", "soil", "r"], ["grass", "zebra"], ["grass", "elephant"], ["grass", "impala"], ["grass", "puku"], ["grass", "buffalo"], ["grass", "hippo"], ["mopane", "elephant"], ["mopane", "giraffe"], ["mopane", "impala"], ["ebony", "elephant"], ["ebony", "impala"], ["lettuce", "impala"], ["hippo", "fish"], ["impala", "lion"], ["impala", "leopard"], ["impala", "wilddog"], ["impala", "hyena"], ["puku", "lion"], ["puku", "leopard"], ["puku", "wilddog"], ["puku", "hyena"], ["zebra", "lion"], ["zebra", "leopard"], ["zebra", "wilddog"], ["zebra", "hyena"], ["buffalo", "lion"], ["buffalo", "leopard"], ["buffalo", "wilddog"], ["buffalo", "hyena"], ["giraffe", "lion"], ["giraffe", "hyena"], ["elephant", "hyena", "s"], ["lion", "hyena", "s"], ["fish", "croc"], ["fish", "eagle"], ["impala", "croc"], ["zebra", "croc"], ["mopane", "decomp", "d"], ["grass", "decomp", "d"], ["ebony", "decomp", "d"], ["lettuce", "decomp", "d"], ["elephant", "decomp", "d"], ["buffalo", "decomp", "d"], ["zebra", "decomp", "d"], ["hippo", "decomp", "d"], ["hippo", "hyena"], ["