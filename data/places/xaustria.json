{"id": "xaustria", "name": "Hohe Tauern National Park", "short": "Hohe Tauern", "place": "Austria", "lat": 47.1, "lon": 12.6, "side": "r", "cont": "Europe", "country": "Austria", "kind": "Polar & mountain", "park": true, "blurb": "Alpine meadows, ibex and marmots, and the vultures that clean up the high peaks.", "tip": {"id": "marmot", "title": "Thin out the marmots", "text": "Marmots are a key prey for golden eagles and foxes. Set Alpine marmot to -100% and watch the eagle, the fox and the hares they then lean on."}, "sources": [{"title": "Wikipedia: Hohe Tauern National Park", "url": "https://en.wikipedia.org/wiki/Hohe_Tauern_National_Park"}, {"title": "Wikipedia: Bearded vulture", "url": "https://en.wikipedia.org/wiki/Bearded_vulture"}, {"title": "Wikipedia: Alpine marmot", "url": "https://en.wikipedia.org/wiki/Alpine_marmot"}, {"title": "Wikipedia: Alpine ibex", "url": "https://en.wikipedia.org/wiki/Alpine_ibex"}, {"title": "Wikipedia: Golden eagle", "url": "https://en.wikipedia.org/wiki/Golden_eagle"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Hohe Tauern National Park", "icon": "ice", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Short alpine summers with strong light drive plant growth above the tree line."}, {"id": "snow", "sp": "snow & glacier melt", "xh": 0.27}, {"id": "rain", "sp": "rain & meltwater", "xh": 0.46}, {"id": "soil", "sp": "alpine soil", "xh": 0.65}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, soil animals & bacteria", "desc": "Break down dead plants, dung and carcasses and return nutrients to the soil."}, {"id": "alpenrose", "sp": "rhododendron ferrugineum", "xh": 0.15, "name": "Rusty-leaved alpenrose", "desc": "A dwarf evergreen shrub that, according to Wikipedia, dominates the zone above the tree line in the park.", "badge": "Foundation species"}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.38, "desc": "A low berry shrub of mountain heath and woodland edges. Red deer and hares are recorded eating it."}, {"id": "nardus", "sp": "nardus stricta", "xh": 0.62, "name": "Mat-grass", "wiki": "Nardus stricta", "desc": "A tough tussock grass of acidic alpine pastures and meadows.", "no": ["badge"]}, {"id": "poa", "sp": "poa alpina", "xh": 0.85}, {"id": "marmot", "sp": "marmota marmota", "xh": 0.05, "desc": "Colonial burrowing rodent that eats grasses, herbs and some insects, and hibernates for up to nine months. Wikipedia notes it was reintroduced to the park area."}, {"id": "ibex", "sp": "capra ibex", "xh": 0.19, "desc": "Grazer of steep rocky slopes and high meadows, eating mostly grass and adding dwarf shrubs in autumn and winter. Golden eagles may take young.", "ic": "elk"}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.33, "desc": "Mountain goat-antelope and one of the main large mammals of the park, grazing alpine meadows and shrubs.", "ic": "elk"}, {"id": "reddeer", "sp": "cervus elaphus", "xh": 0.47, "name": "Red deer", "wiki": "Red deer", "desc": "One of the main large herbivores of the park, eating shrubs such as bilberry as well as grasses.", "ic": "elk"}, {"id": "hare", "sp": "lepus timidus", "xh": 0.61, "desc": "Small herbivore of high ground, recorded eating bilberry; prey of foxes, stoats and golden eagles."}, {"id": "snowvole", "sp": "chionomys nivalis", "xh": 0.75}, {"id": "hopper", "sp": "omocestus viridulus", "xh": 0.9}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.15, "desc": "Generalist predator that hunts marmots, hares, voles and insects at all elevations."}, {"id": "stoat", "sp": "mustela erminea", "xh": 0.32, "desc": "Small weasel that hunts voles and other small mammals."}, {"id": "raven", "sp": "corvus corax", "xh": 0.5, "desc": "Omnivorous crow that eats insects and also feeds on carcasses."}, {"id": "griffon", "sp": "gyps fulvus", "xh": 0.68, "desc": "Soaring scavenger that Wikipedia lists among the park raptors; feeds on carcasses of large mammals."}, {"id": "bearded", "sp": "gypaetus barbatus", "xh": 0.86, "desc": "Specialist scavenger living mostly on bone and marrow from carcasses. Reintroduced to the Alps from 1987 and now breeding again."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.5, "desc": "Top aerial predator of the Alps, nesting near the tree line and hunting alpine pastures for marmots and hares."}], "raw": [["sun", "alpenrose", "r"], ["sun", "bilberry", "r"], ["sun", "nardus", "r"], ["sun", "poa", "r"], ["snow", "alpenrose", "r"], ["snow", "bilberry", "r"], ["snow", "nardus", "r"], ["snow", "poa", "r"], ["rain", "alpenrose", "r"], ["rain", "bilberry", "r"], ["rain", "nardus", "r"], ["rain", "poa", "r"], ["soil", "alpenrose", "r"], ["soil", "bilberry", "r"], ["soil", "nardus", "r"], ["soil", "poa", "r"], ["alpenrose", "decomp", "d"], ["bilberry", "decomp", "d"], ["nardus", "decomp", "d"], ["poa", "decomp", "d"], ["decomp", "soil", "r"], ["poa", "marmot"], ["nardus", "marmot"], ["nardus", "ibex"], ["poa", "ibex"], ["bilberry", "ibex"], ["poa", "chamois"], ["bilberry", "chamois"], ["nardus", "chamois"], ["bilberry", "reddeer"], ["nardus", "reddeer"], ["poa", "reddeer"], ["bilberry", "hare"], ["poa", "hare"], ["nardus", "snowvole"], ["poa", "snowvole"], ["nardus", "hopper"], ["poa", "hopper"], ["marmot", "fox"], ["hare", "fox"], ["snowvole", "fox"], ["hopper", "fox"], ["snowvole", "stoat"], ["hare", "stoat"], ["hopper", "raven"], ["marmot", "eagle"], ["hare", "eagle"], ["ibex", "eagle"], ["chamois", "eagle"], ["ibex", "raven", "s"], ["ibex", "griffon", "s"], ["ibex", "bearded", "s"], ["chamois", "raven", "s"], ["chamois", "griffon", "s"], ["chamois", "bearded", "s"], ["reddeer", "raven", "s"], ["reddeer", "griffon", "s"], ["reddeer", "bearded", "s"], ["hare", "raven", "s"], ["bilberry", "fox"], ["ibex", "fox"],