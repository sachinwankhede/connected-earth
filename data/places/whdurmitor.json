{"id": "whdurmitor", "name": "Durmitor National Park", "short": "Durmitor", "place": "Montenegro", "lat": 43.1, "lon": 19.0, "side": "r", "cont": "Europe", "country": "Montenegro", "kind": "Polar & mountain", "park": true, "blurb": "Dinaric limestone peaks, black pine forest and bears, wolves and chamois.", "tip": {"id": "wolf", "title": "Remove the wolf", "text": "Wolves hunt chamois and roe deer. Set Grey wolf to -100% and watch the grazers rise, the herbs and bilberry they eat fall, and the carrion left for bears, ravens and vultures change."}, "sources": [{"title": "UNESCO World Heritage Centre: Durmitor National Park", "url": "https://whc.unesco.org/en/list/100/"}, {"title": "Wikipedia: Durmitor National Park", "url": "https://en.wikipedia.org/wiki/Durmitor_National_Park"}, {"title": "Wikipedia: Chamois", "url": "https://en.wikipedia.org/wiki/Chamois"}, {"title": "Wikipedia: Alpine chough", "url": "https://en.wikipedia.org/wiki/Alpine_chough"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}, {"title": "Wikipedia: Eurasian otter", "url": "https://en.wikipedia.org/wiki/Eurasian_otter"}, {"title": "Wikipedia: Durmitor", "url": "https://en.wikipedia.org/wiki/Durmitor"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Durmitor, Durmitor, Chamois). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Durmitor", "icon": "ice", "tier": "overview", "link_ideas": [{"kind": "species", "with": "Drina and Danube river system", "what": "Danube salmon (huchen) live in the Tara, Lim and Cehotina and depend on free-flowing tributaries of the Drina.", "evidence_url": "https://en.wikipedia.org/wiki/Danube_salmon"}], "nodes": [{"id": "sun", "sp": "sun and altitude", "xh": 0.08}, {"id": "rain", "sp": "rain and snowmelt", "xh": 0.24}, {"id": "snow", "sp": "winter snow and ice", "xh": 0.42}, {"id": "soil", "sp": "limestone soil and nutrients", "xh": 0.6}, {"id": "decomp", "sp": "decomposer community", "xh": 0.84, "name": "Decomposers", "desc": "Fungi, bacteria and soil invertebrates break down needles, leaves and carcasses and return nutrients to the thin karst soil."}, {"id": "blackpine", "sp": "pinus nigra", "xh": 0.12}, {"id": "beech", "sp": "fagus sylvatica", "xh": 0.36, "wiki": "Fagus sylvatica", "desc": "Broadleaf forest tree of the lower slopes. Its leaves, nuts and litter feed deer, bears and the wider forest floor.", "no": ["badge"]}, {"id": "bilberry", "sp": "vaccinium myrtillus", "xh": 0.6, "wiki": "Bilberry", "desc": "A low forest and subalpine shrub whose berries and shoots are eaten by roe deer, birds, foxes and bears."}, {"id": "herbs", "sp": "gentiana", "xh": 0.84}, {"id": "snowvole", "sp": "dinaromys bogdanovi", "xh": 0.08}, {"id": "grasshopper", "sp": "chorthippus biguttulus", "xh": 0.24}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.42, "badge": "Keystone grazer"}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.6, "name": "Roe deer", "wiki": "Roe deer", "desc": "A forest and edge browser that eats beech and bilberry. Prey for wolves and bears."}, {"id": "chough", "sp": "pyrrhocorax graculus", "xh": 0.78}, {"id": "mayfly", "sp": "ephemeroptera", "xh": 0.93, "name": "Stream insect larvae"}, {"id": "trout", "sp": "salmo trutta", "xh": 0.1}, {"id": "otter", "sp": "lutra lutra", "xh": 0.28, "desc": "Lives along unpolluted rivers and lakes. Fish are its main food, with amphibians and invertebrates added. Its presence signals a healthy river."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.48, "desc": "A flexible hunter and scavenger that takes small mammals, birds, insects and berries, and feeds on carrion."}, {"id": "raven", "sp": "corvus corax", "xh": 0.68, "desc": "A scavenger at carcasses that also robs chough nests of nestlings."}, {"id": "griffon", "sp": "gyps fulvus", "xh": 0.88}, {"id": "bear", "sp": "ursus arctos", "xh": 0.2, "desc": "Mostly a plant eater, taking berries, nuts, roots and insects, but also hunting young or weak ungulates and using carrion. Wolves and bears contest kills."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "name": "Grey wolf", "wiki": "Wolf", "desc": "A top predator that hunts chamois and deer. The presence of large predators such as wolf and bear is read as a sign of ecological integrity here."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.8, "desc": "A cliff-nesting raptor of the high massif that hunts birds and small mammals, including choughs."}], "raw": [["sun", "blackpine", "r"], ["rain", "blackpine", "r"], ["blackpine", "decomp", "d"], ["sun", "beech", "r"], ["rain", "beech", "r"], ["beech", "decomp", "d"], ["sun", "bilberry", "r"], ["rain", "bilberry", "r"], ["bilberry", "decomp", "d"], ["sun", "herbs", "r"], ["rain", "herbs", "r"], ["herbs", "decomp", "d"], ["soil", "blackpine", "r"], ["soil", "beech", "r"], ["soil", "herbs", "r"], ["soil", "bilberry", "r"], ["snow", "herbs", "r"], ["snow", "bilberry", "r"], ["decomp", "soil", "r"], ["herbs", "chamois"], ["blackpine", "chamois"], ["herbs", "snowvole"], ["herbs", "grasshopper"], ["bilberry", "roe"], ["beech", "roe"], ["beech", "bear"], ["bilberry", "bear"], ["herbs", "bear"], ["grasshopper", "bear"], ["snowvole", "bear"], ["roe", "bear"], ["chamois", "bear"], ["chamois", "wolf"], ["roe", "wolf"], ["snowvole", "fox"], ["chough", "fox"], ["grasshopper", "fox"], ["bilberry", "fox"], ["grasshopper", "chough"], ["bilberry", "chough"], ["chough", "raven"], ["chough", "eagle"], ["snowvole", "eagle"], ["beech", "mayfly"], ["mayfly", "trout"], ["trout", "otter"], ["chamois", "fox", "s"], ["chamois", "raven", "s"], ["roe", "raven", "s"], ["roe", "griffon", "s"], ["chamois", "decomp", "d"], ["roe", "decomp", "d"], ["bear", "decomp", "d"], ["wolf", "decomp", "d"], ["fox", "decomp", "d"], ["snowvole", "decomp", "d"], ["