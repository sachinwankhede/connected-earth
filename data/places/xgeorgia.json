{"id": "xgeorgia", "name": "Kolkheti National Park", "short": "Kolkheti", "place": "Georgia", "lat": 42.1, "lon": 41.7, "side": "r", "cont": "Asia", "country": "Georgia", "kind": "Lakes & wetlands", "park": true, "blurb": "Black Sea peat bogs, reedbeds and wet alder forest at the mouth of the Rioni.", "tip": {"id": "reed", "title": "Thin the reedbeds", "text": "Reeds feed coypu, water voles and leafhoppers, and shelter frogs. Set Common reed to -100% and watch the grazers, then the herons, harriers and otters that hunt them."}, "sources": [{"title": "Wikipedia: Kolkheti National Park", "url": "https://en.wikipedia.org/wiki/Kolkheti_National_Park"}, {"title": "Wikipedia: Colchis", "url": "https://en.wikipedia.org/wiki/Colchis"}, {"title": "Wikipedia: Grey heron", "url": "https://en.wikipedia.org/wiki/Grey_heron"}, {"title": "Wikipedia: Western marsh harrier", "url": "https://en.wikipedia.org/wiki/Western_marsh_harrier"}, {"title": "Wikipedia: Marsh frog", "url": "https://en.wikipedia.org/wiki/Marsh_frog"}, {"title": "Wikipedia: Coypu", "url": "https://en.wikipedia.org/wiki/Coypu"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Kolkheti National Park", "icon": "water", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Warm, humid summers on the Black Sea coast power plant growth across the reedbeds, bogs and wet forest."}, {"id": "rain", "sp": "heavy rainfall", "xh": 0.27, "desc": "The Colchis plain is among the wettest parts of the region, with mild humid weather and abundant rain that keeps the lowlands waterlogged."}, {"id": "peat", "sp": "waterlogged peat", "xh": 0.46}, {"id": "water", "sp": "rivers and lake water", "xh": 0.65}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Bacteria and fungi", "desc": "Break down dead reeds, alder leaves and animals, returning nutrients to the peat and water."}, {"id": "alder", "sp": "alnus glutinosa", "xh": 0.1}, {"id": "reed", "sp": "phragmites australis", "xh": 0.32, "wiki": "Common reed", "desc": "Tall grass that forms dense reedbeds along lake shores and channels, giving food and cover to many wetland animals."}, {"id": "sedge", "sp": "carex", "xh": 0.54, "desc": "Sedges grow in the wet meadows and peat bogs; one of them, Carex lasiocarpa, is listed for the park's bogs.", "ic": "sage"}, {"id": "sphagnum", "sp": "sphagnum", "xh": 0.76, "name": "Sphagnum moss", "desc": "Bog moss that carpets the peat bogs; its slowly decaying remains help build the thick peat layers.", "no": ["badge"]}, {"id": "coypu", "sp": "myocastor coypus", "xh": 0.08, "wiki": "Coypu", "desc": "Large semi-aquatic rodent, introduced to the area, that eats reed and other wetland plants."}, {"id": "watervole", "sp": "arvicola amphibius", "xh": 0.26}, {"id": "fieldmouse", "sp": "apodemus uralensis", "xh": 0.44}, {"id": "leafhopper", "sp": "cicadella viridis", "xh": 0.62}, {"id": "roedeer", "sp": "capreolus capreolus", "xh": 0.82, "name": "Roe deer", "wiki": "Roe deer", "desc": "Small deer listed among the park's mammals; browses leaves and shoots in the wet forest and meadows."}, {"id": "dragonfly", "sp": "anax parthenope", "xh": 0.1}, {"id": "marshfrog", "sp": "pelophylax ridibundus", "xh": 0.28, "desc": "The most recorded amphibian near the park; it eats mostly insects and other invertebrates and is itself food for snakes, herons and otters."}, {"id": "dicesnake", "sp": "natrix tessellata", "xh": 0.46, "desc": "Water snake of rivers and lakes that hunts fish and amphibians."}, {"id": "heron", "sp": "ardea cinerea", "xh": 0.64, "desc": "Wading bird that stalks shallow water for fish, frogs and small mammals; heavily recorded around the park."}, {"id": "hedgehog", "sp": "erinaceus concolor", "xh": 0.84}, {"id": "harrier", "sp": "circus aeruginosus", "xh": 0.2, "desc": "Raptor tied to reedbeds that glides low over marsh hunting small mammals, birds, frogs and reptiles."}, {"id": "otter", "sp": "lutra lutra", "xh": 0.5, "tl": 4, "desc": "Semi-aquatic hunter listed among the park's mammals; eats mainly fish plus amphibians and small mammals."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.8, "desc": "Elusive forest cat with only a single record near the park; it takes deer, hares and rodents.", "no": ["badge"]}], "raw": [["sun", "alder", "r"], ["rain", "alder", "r"], ["peat", "alder", "r"], ["water", "alder", "r"], ["sun", "reed", "r"], ["rain", "reed", "r"], ["peat", "reed", "r"], ["water", "reed", "r"], ["sun", "sedge", "r"], ["rain", "sedge", "r"], ["peat", "sedge", "r"], ["water", "sedge", "r"], ["sun", "sphagnum", "r"], ["rain", "sphagnum", "r"], ["peat", "sphagnum", "r"], ["water", "sphagnum", "r"], ["decomp", "peat", "r"], ["alder", "decomp", "d"], ["reed", "decomp", "d"], ["sedge", "decomp", "d"], ["sphagnum", "decomp", "d"], ["coypu", "decomp", "d"], ["watervole", "decomp", "d"], ["fieldmouse", "decomp", "d"], ["leafhopper", "decomp", "d"], ["roedeer", "decomp", "d"], ["dragonfly", "decomp", "d"], ["marshfrog", "decomp", "d"], ["dicesnake", "decomp", "d"], ["heron", "decomp", "d"], ["hedgehog", "decomp", "d"], ["harrier", "decomp", "d"], ["otter", "decomp", "d"], ["lynx", "decomp", "d"], ["reed", "coypu"], ["reed", "watervole"], ["sedge", "watervole"], ["alder", "fieldmouse"], ["alder", "roedeer"], ["sedge", "leafhopper"], ["reed", "leafhopper"], ["leafhopper", "dragonfly"], ["leafhopper", "marshfrog"], ["dragonfly", "marshfrog"], ["marshfrog", "dicesnake"], ["marshfrog", "heron"], ["dicesnake", "heron"], ["watervole", "heron"], ["fieldmouse", "heron"], ["coypu", "heron"], ["marshfrog", "hedgehog"], ["dicesnake", "hedgehog"], ["fieldmouse", "hedgehog"], ["watervole", "hedgehog"], ["marshfrog", "harrier"], ["watervole", "harrier"], ["fieldmouse", "harrier"], ["dicesnake", "harrier"], ["marshfrog", "otter"], ["watervole", "otter"], ["roedeer", "lynx"], ["watervole", "lynx"], ["fieldmouse", "lynx"], ["alder", "leafhopper"], ["sphagnum", "leafhopper"], ["sedge", "roedeer"], ["dicesnake", "otter"]], "ev": {"reed>coypu": ["g", "Myocastor coypus", "Phragmites australis"], "reed>watervole": ["a"], "sedge>watervole": ["a"], "alder>fieldmouse": ["a"], "alder>roedeer": ["g", "Capreolus capreolus", "Alnus glutinosa"], "sedge>leafhopper": ["g", "Cicadella viridis", "Carex"], "reed>leafhopper": ["g", "Cicadella viridis", "Phragmites australis"], "leafhopper>dragonfly": ["a"], "leafhopper>marshfrog": ["a"], "dragonfly>marshfrog": ["a"], "marshfrog>dicesnake": ["g", "Natrix tessellata", "Pelophylax ridibundus"], "marshfrog>heron": ["g", "Ardea cinerea", "Pelophylax ridibundus"], "dicesnake>heron": ["g", "Ardea cinerea", "Natrix tessellata"], "watervole>heron": ["g", "Ardea cinerea", "Arvicola amphibius"], "fieldmouse>heron": ["g", "Ardea cinerea", "Apodemus uralensis"], "coypu>heron": ["g", "Ardea cinerea", "Myocastor coypus"], "marshfrog>hedgehog": ["g", "Erinaceus concolor", "Pelophylax ridibundus"], "dicesnake>hedgehog": ["g", "Erinaceus concolor", "Natrix tessellata"], "fieldmouse>hedgehog": ["g", "Erinaceus concolor", "Apodemus uralensis"], "watervole>hedgehog": ["g", "Erinaceus concolor", "Arvicola amphibius"], "marshfrog>harrier": ["g", "Circus aeruginosus", "Pelophylax ridibundus"], "watervole>harrier": ["g", "Circus aeruginosus", "Arvicola amphibius"], "fieldmouse>harrier": ["a"], "dicesnake>harrier": ["g", "Circus aeruginosus", "Natrix tessellata"], "marshfrog>otter": ["g", "Lutra lutra", "Pelophylax ridibundus"], "watervole>otter": ["g", "Lutra lutra", "Arvicola amphibius"], "roedeer>lynx": ["g", "Lynx lynx", "Capreolus capreolus"], "watervole>lynx": ["g", "Lynx lynx", "Arvicola amphibius"], "fieldmouse>lynx": ["gg", "Lynx lynx", "Apodemus uralensis"], "alder>leafhopper": ["ga", "Cicadella viridis", "Alnus glutinosa"], "sphagnum>leafhopper": ["ga", "Cicadella viridis