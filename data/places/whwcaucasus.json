{"id": "whwcaucasus", "name": "Western Caucasus", "short": "W. Caucasus", "place": "Krasnodar and Adygea, Russia", "lat": 43.8, "lon": 40.2, "side": "r", "cont": "Asia", "country": "Russia", "kind": "Polar & mountain", "park": true, "blurb": "Beech and fir forest, alpine meadows, and the return of the bison and leopard.", "tip": {"id": "wolf", "title": "Remove the gray wolf", "text": "Wolves hunt deer, chamois and tur. Set Gray wolf to -100% and watch those grazers, then the meadows and forest shoots they feed on."}, "sources": [{"title": "Wikipedia: Western Caucasus", "url": "https://en.wikipedia.org/wiki/Western_Caucasus"}, {"title": "Wikipedia: European bison", "url": "https://en.wikipedia.org/wiki/European_bison"}, {"title": "Wikipedia: Chamois", "url": "https://en.wikipedia.org/wiki/Chamois"}, {"title": "Wikipedia: Brown bear", "url": "https://en.wikipedia.org/wiki/Brown_bear"}, {"title": "Wikipedia: Persian leopard", "url": "https://en.wikipedia.org/wiki/Persian_leopard"}, {"title": "Wikipedia: Nordmann fir", "url": "https://en.wikipedia.org/wiki/Nordmann_fir"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Western Caucasus", "icon": "elk", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Summer light and warmth drive growth from the lowland forests up to the alpine meadows."}, {"id": "snow", "sp": "winter snow", "xh": 0.3}, {"id": "rain", "sp": "heavy rainfall", "xh": 0.5, "desc": "Moist air from the Black Sea brings the high precipitation that mountain firs need, over 1,000 mm a year."}, {"id": "soil", "sp": "mountain soil and leaf litter", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi and soil microbes", "desc": "Break down fallen leaves, wood, dung and carcasses, returning nutrients to the soil."}, {"id": "beech", "sp": "fagus orientalis", "xh": 0.1}, {"id": "fir", "sp": "abies nordmanniana", "xh": 0.3}, {"id": "oak", "sp": "quercus robur", "xh": 0.5, "desc": "A lowland and foothill oak whose acorns are a rich autumn food for bears, boar and rodents.", "no": ["badge"]}, {"id": "hazel", "sp": "corylus avellana", "xh": 0.7}, {"id": "meadow", "sp": "poaceae", "xh": 0.9, "name": "Alpine meadow grasses and herbs", "wiki": "Alpine grassland", "desc": "Summer grassland above the treeline where chamois, tur, deer and bison graze."}, {"id": "bison", "sp": "bison bonasus", "xh": 0.05, "desc": "The Caucasian wisent was shot out by 1927; free-ranging herds now live again in the forests of the Western Caucasus. They graze grasses and herbs and browse shoots and bark.", "cat": "Keystone grazer", "no": ["badge"]}, {"id": "reddeer", "sp": "cervus elaphus", "xh": 0.19, "name": "Red deer", "wiki": "Red deer", "desc": "A large forest and meadow herbivore of the Caucasus mountains, taken by wolves and bears.", "ic": "elk"}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.33, "desc": "Grazes highland grasses and herbs in summer and eats conifer bark and needles in winter, moving down to forest as snow deepens."}, {"id": "tur", "sp": "capra caucasica", "xh": 0.47}, {"id": "boar", "sp": "sus scrofa", "xh": 0.61, "desc": "An omnivore of the forests that roots for acorns, nuts and other foods, and is itself prey for large carnivores."}, {"id": "squirrel", "sp": "sciurus vulgaris", "xh": 0.75, "name": "Eurasian red squirrel", "wiki": "Eurasian red squirrel", "desc": "The most recorded mammal near the site; eats hazelnuts and seeds in the forest canopy."}, {"id": "mouse", "sp": "apodemus flavicollis", "xh": 0.9, "desc": "A forest rodent that eats nuts, acorns and seeds, and is food for foxes, buzzards and bears."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.2, "desc": "A flexible hunter and scavenger that takes rodents and squirrels and feeds on carcasses."}, {"id": "buzzard", "sp": "buteo buteo", "xh": 0.5}, {"id": "crow", "sp": "corvus cornix", "xh": 0.8}, {"id": "bear", "sp": "ursus arctos", "xh": 0.2, "desc": "Mostly vegetarian, eating roots, nuts and acorns, but also takes rodents, boar and hoofed animals, and scavenges carrion in spring."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "desc": "A pack-hunting predator of mountain ungulates such as deer and wild goats.", "cat": "Keystone predator", "no": ["badge"]}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.8, "name": "Persian leopard", "wiki": "Persian leopard", "desc": "Reintroduced in 2016 and 2018 into the Caucasus Biosphere Reserve from a breeding centre in Sochi; chamois and boar are known prey of the subspecies."}], "raw": [["sun", "beech", "r"], ["sun", "oak", "r"], ["sun", "hazel", "r"], ["sun", "meadow", "r"], ["sun", "fir", "r"], ["rain", "fir", "r"], ["rain", "beech", "r"], ["rain", "meadow", "r"], ["snow", "meadow", "r"], ["soil", "beech", "r"], ["soil", "fir", "r"], ["soil", "oak", "r"], ["soil", "hazel", "r"], ["soil", "meadow", "r"], ["decomp", "soil", "r"], ["beech", "decomp", "d"], ["fir", "decomp", "d"], ["oak", "decomp", "d"], ["hazel", "decomp", "d"], ["meadow", "decomp", "d"], ["bison", "decomp", "d"], ["reddeer", "decomp", "d"], ["chamois", "decomp", "d"], ["tur", "decomp", "d"], ["boar", "decomp", "d"], ["squirrel", "decomp", "d"], ["mouse", "decomp", "d"], ["fox", "decomp", "d"], ["buzzard", "decomp", "d"], ["crow", "decomp", "d"], ["bear", "decomp", "d"], ["wolf", "decomp", "d"], ["leopard", "decomp", "d"], ["meadow", "bison"], ["meadow", "reddeer"], ["meadow", "chamois"], ["meadow", "tur"], ["meadow", "bear"], ["fir", "bison"], ["fir", "chamois"], ["fir", "squirrel"], ["beech", "reddeer"], ["beech", "boar"], ["oak", "boar"], ["oak", "bear"], ["oak", "mouse"], ["hazel", "boar"], ["hazel", "mouse"], ["hazel", "squirrel"], ["mouse", "fox"], ["squirrel", "fox"], ["squirrel", "buzzard"], ["mouse", "buzzard"], ["mo