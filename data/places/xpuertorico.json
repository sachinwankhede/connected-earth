anaquit", "sp": "coereba flaveola", "xh": 0.2, "desc": "Small, very commonly recorded bird that takes nectar and fruit. GloBI records it eating fruit of several forest plants."}, {"id": "pigeon", "sp": "patagioenas squamosa", "xh": 0.34}, {"id": "fruitbat", "sp": "artibeus jamaicensis", "xh": 0.5, "desc": "A fruit-eating bat recorded feeding on pumpwood. Fruit-eating bats help spread forest seeds."}, {"id": "parrot", "sp": "amazona vittata", "xh": 0.66}, {"id": "rat", "sp": "rattus rattus", "xh": 0.84, "desc": "An introduced omnivore that eats parrot eggs and chicks. It is in turn prey for the Puerto Rican boa."}, {"id": "coqui", "sp": "eleutherodactylus coqui", "xh": 0.08}, {"id": "anole", "sp": "anolis gundlachi", "xh": 0.24}, {"id": "tody", "sp": "todus mexicanus", "xh": 0.4}, {"id": "thrasher", "sp": "margarops fuscatus", "xh": 0.56}, {"id": "woodpecker", "sp": "melanerpes portoricensis", "xh": 0.72}, {"id": "mongoose", "sp": "herpestes javanicus", "xh": 0.88, "desc": "An introduced predator that eats parrot eggs and chicks, and opportunistically takes coquís, according to the species accounts."}, {"id": "boa", "sp": "epicrates inornatus", "xh": 0.3}, {"id": "hawk", "sp": "buteo platypterus brunnescens", "xh": 0.7}, {"id": "rain", "sp": "rainfall and cloud", "xh": 0.1}, {"id": "sun", "sp": "sunlight", "xh": 0.3, "desc": "Warm, steady temperatures and light year-round drive growth, though cloud cover is frequent."}, {"id": "hurricane", "sp": "hurricane winds", "xh": 0.5}, {"id": "soil", "sp": "soil nutrients", "xh": 0.7, "desc": "Shallow, acidic soils in the higher forest zones; nutrients come mainly from recycled leaf litter."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Decomposers", "desc": "Fungi, bacteria and litter invertebrates break down fallen leaves and wood and return nutrients to the soil."}], "raw": [["sun", "tabonuco", "r"], ["rain", "tabonuco", "r"], ["sun", "cecropia", "r"], ["rain", "cecropia", "r"], ["sun", "palm", "r"], 