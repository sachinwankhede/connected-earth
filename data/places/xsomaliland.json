{"id": "xsomaliland", "name": "Daallo Forest", "short": "Daallo Forest", "place": "Somaliland", "lat": 10.75, "lon": 47.3, "side": "r", "cont": "Africa", "country": "Somaliland", "kind": "Forest", "park": true, "blurb": "Juniper mist forest on a Gulf of Aden escarpment, home of the Warsangli linnet.", "tip": {"id": "juniper", "title": "Thin the juniper", "text": "Juniper berries feed pigeons and bulbuls, and the trees hold moisture on the scarp. Set African juniper to -100% and watch the fruit-eaters and then the predators that rely on them."}, "sources": [{"title": "Wikipedia: Daallo Mountain", "url": "https://en.wikipedia.org/wiki/Daallo_Mountain"}, {"title": "Wikipedia: Erigavo", "url": "https://en.wikipedia.org/wiki/Erigavo"}, {"title": "Wikipedia: Wildlife of Somaliland", "url": "https://en.wikipedia.org/wiki/Wildlife_of_Somaliland"}, {"title": "Wikipedia: Warsangli linnet", "url": "https://en.wikipedia.org/wiki/Warsangli_linnet"}, {"title": "Wikipedia: Rock hyrax", "url": "https://en.wikipedia.org/wiki/Rock_hyrax"}, {"title": "Wikipedia: Salt's dik-dik", "url": "https://en.wikipedia.org/wiki/Salt%27s_dik-dik"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Daallo Mountain", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "juniper", "sp": "juniperus procera", "xh": 0.12}, {"id": "olea", "sp": "olea", "xh": 0.34}, {"id": "aloe", "sp": "aloidendron eminens", "xh": 0.56}, {"id": "grass", "sp": "themeda triandra", "xh": 0.78, "desc": "A tufted grass of highland clearings and open slopes, recorded in the Daallo area, providing seeds and leaves for small herbivores."}, {"id": "hyrax", "sp": "heterohyrax brucei", "xh": 0.06}, {"id": "dikdik", "sp": "madoqua saltiana", "xh": 0.2}, {"id": "klip", "sp": "oreotragus oreotragus", "xh": 0.34, "desc": "A small antelope that lives on rocky cliffs and outcrops, browsing on leaves, shoots and fruit."}, {"id": "pigeon", "sp": "columba arquatrix", "xh": 0.48}, {"id": "bulbul", "sp": "pycnonotus barbatus", "xh": 0.62, "desc": "A very commonly recorded songbird around Daallo. GloBI records it eating African juniper."}, {"id": "katydid", "sp": "phaneroptera nana", "xh": 0.76}, {"id": "linnet", "sp": "linaria johannis", "xh": 0.92}, {"id": "wildcat", "sp": "felis silvestris", "xh": 0.14, "name": "Wildcat", "wiki": "Wildcat", "desc": "A small cat that hunts hyraxes and small birds. GloBI holds records of it eating rock hyrax and wheatears."}, {"id": "wheatear", "sp": "oenanthe isabellina", "xh": 0.38}, {"id": "agama", "sp": "acanthocercus annectans", "xh": 0.62}, {"id": "cobra", "sp": "naja arabica", "xh": 0.86}, {"id": "wolf", "sp": "canis lupaster", "xh": 0.3, "tl": 4, "desc": "An opportunistic canid recorded in the Daallo area that eats small mammals and other prey."}, {"id": "buzzard", "sp": "buteo augur", "xh": 0.68, "tl": 4, "desc": "A cliff-nesting bird of prey of African highlands, recorded in the Daallo area, that takes hyraxes, lizards and snakes."}, {"id": "sun", "sp": "sunlight", "xh": 0.12, "desc": "Bright highland sun drives growth in the open forest and grassland."}, {"id": "mist", "sp": "mist & seasonal rain", "xh": 0.36}, {"id": "soil", "sp": "limestone soil", "xh": 0.62, "desc": "Thin soils on a limestone and gypsum escarpment hold the roots of juniper and olive."}, {"id": "decomp", "sp": "fungi, termites & bacteria", "xh": 0.86}], "raw": [["sun", "juniper", "r"], ["sun", "olea", "r"], ["sun", "aloe", "r"], ["sun", "grass", "r"], ["mist", "juniper", "r"], ["mist", "olea", "r"], ["mist", "aloe", "r"], ["mist", "grass", "r"], ["soil", "juniper", "r"], ["soil", "olea", "r"], ["soil", "aloe", "r"], ["soil", "grass", "r"], ["decomp", "soil", "r"], ["juniper", "pigeon"], ["juniper", "bulbul"], ["olea", "bulbul"], ["olea", "pigeon"], ["grass", "hyrax