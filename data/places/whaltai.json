{"id": "whaltai", "name": "Golden Mountains of Altai", "short": "Altai Mountains", "place": "Altai Republic, Russia", "lat": 49.8, "lon": 86.9, "side": "l", "cont": "Asia", "country": "Russia", "kind": "Polar & mountain", "park": true, "blurb": "Steppe to alpine slopes where snow leopards hunt ibex and argali.", "tip": {"id": "ibex", "title": "Remove the Siberian ibex", "text": "Set Siberian ibex to -100% and watch the snow leopard and wolf lose a main prey, and cinereous vultures lose carrion."}, "sources": [{"title": "Wikipedia: Golden Mountains of Altai", "url": "https://en.wikipedia.org/wiki/Golden_Mountains_of_Altai"}, {"title": "Wikipedia: Snow leopard", "url": "https://en.wikipedia.org/wiki/Snow_leopard"}, {"title": "Wikipedia: Argali", "url": "https://en.wikipedia.org/wiki/Argali"}, {"title": "Wikipedia: Siberian ibex", "url": "https://en.wikipedia.org/wiki/Siberian_ibex"}, {"title": "Wikipedia: Gray marmot", "url": "https://en.wikipedia.org/wiki/Gray_marmot"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Golden Mountains of Altai, Snow leopard, Argali). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Golden Mountains of Altai", "icon": "ice", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Summer light drives growth on the alpine meadows and steppe slopes; the growing season is short at altitude."}, {"id": "melt", "sp": "snowmelt and glacier water", "xh": 0.37}, {"id": "snow", "sp": "cold, snowy winters", "xh": 0.64}, {"id": "soil", "sp": "mountain soils", "xh": 0.9, "desc": "Thin mountain and steppe soils hold the nutrients that plants draw on and that decomposers return."}, {"id": "decomp", "sp": "decomposers", "xh": 0.5, "desc": "Fungi, bacteria and soil invertebrates break down dead plants, dung and carcasses and return nutrients to the soil."}, {"id": "larch", "sp": "larix sibirica", "xh": 0.1}, {"id": "pine", "sp": "pinus sibirica", "xh": 0.36}, {"id": "grass", "sp": "festuca", "xh": 0.64, "name": "Steppe and alpine grasses", "desc": "Grasses and sedges of the steppe and alpine meadows, the main food of the wild sheep, goats and small grazers."}, {"id": "cinq", "sp": "dasiphora fruticosa", "xh": 0.9, "name": "Shrubby cinquefoil", "desc": "A low shrub of mountain meadows and rocky ground; GloBI records bears and other animals feeding on it.", "ic": "sage"}, {"id": "ibex", "sp": "capra sibirica", "xh": 0.08}, {"id": "argali", "sp": "ovis ammon", "xh": 0.22}, {"id": "marmot", "sp": "marmota baibacina", "xh": 0.36}, {"id": "squirrel", "sp": "urocitellus undulatus", "xh": 0.5}, {"id": "pika", "sp": "ochotona alpina", "xh": 0.64}, {"id": "vole", "sp": "microtus gregalis", "xh": 0.78}, {"id": "nutcracker", "sp": "nucifraga caryocatactes", "xh": 0.92}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.12, "desc": "A flexible predator recorded in GloBI eating many species here, from voles and marmots to birds, lizards and berries."}, {"id": "stoat", "sp": "mustela erminea", "xh": 0.3, "desc": "A small weasel that hunts voles and other small prey, including birds and lizards, in meadows and scree."}, {"id": "steppeeagle", "sp": "aquila nipalensis", "xh": 0.48}, {"id": "vulture", "sp": "aegypius monachus", "xh": 0.68}, {"id": "bear", "sp": "ursus arctos", "xh": 0.88, "tl": 3, "desc": "An omnivore of the forests and meadows that eats plants and berries as well as marmots, voles and other animals."}, {"id": "snowleopard", "sp": "panthera uncia", "xh": 0.3, "desc": "The high-mountain cat of the Altai, living on rocky broken ground. Its main prey here includes Siberian ibex and argali, plus marmots and pikas.", "no": ["badge"]}, {"id": "wolf", "sp": "canis lupus", "xh": 0.7, "wiki": "Wolf", "desc": "A pack hunter that preys on wild sheep and goats such as argali and ibex, and also takes marmots.", "no": ["badge"]}], "raw": [["sun", "larch", "r"], ["soil", "larch", "r"], ["sun", "pine", "r"], ["soil", "pine", "r"], ["sun", "grass", "r"], ["soil", "grass", "r"], ["sun", "cinq", "r"], ["soil", "cinq", "r"], ["melt", "grass", "r"], ["melt", "cinq", "r"], ["snow", "larch", "r"], ["snow", "pine", "r"], ["pine", "nutcracker"], ["grass", "ibex"], ["grass", "argali"], ["grass", "marmot"], ["grass", "squirrel"], ["grass", "pika"], ["grass", "vole"], ["cinq", "bear"], ["cinq", "marmot"], ["marmot", "fox"], ["squirrel", "fox"], ["vole", "fox"], ["nutcracker", "fox"], ["vole", "stoat"], ["squirrel", "steppeeagle"], ["marmot", "steppeeagle"], ["vole", "steppeeagle"], ["marmot", "vulture"], ["marmot", "bear"], ["vole", "bear"], ["ibex", "vulture", "s"], ["argali", "vulture", "s"], ["ibex", "snowleopard"], ["argali", "snowleopard"], ["marmot", "snowleopard"], ["pika", "snowleopard"], ["ibex", "wolf"], ["argali", "wolf"], ["marmot", "wolf"], ["larch", "decomp", "d"], ["pine", "decomp", "d"], ["grass", "decomp", "d"], ["cinq", "decomp", "d"], ["ibex", "decomp", "d"], ["marmot", "decomp", "d"], ["decomp", "soil", "r"], ["ibex", "fox"], ["argali", "fox"], ["argali", "bear"], ["fox", "snowleopard"], ["vole", "wolf"], ["nutcracker", "wolf"], ["fox", "wolf"], ["stoat", "wolf"], ["bear", "wolf"]], "ev": {"pine>nutcracker": ["gg", "Nucifraga caryocatactes", "Pinus sibirica"], "grass>ibex": ["a"], "grass>argali": ["a"], "grass>marmot": ["a"], "grass>squirrel": ["a"], "grass>pika": ["a"], "grass>vole": ["a"], "cinq>bear": ["g", "Ursus arctos", "Dasiphora fruticosa"], "cinq>marmot": ["a"], "marmot>fox": ["g", "Vulpes vulpes", "Marmota baibacina"], "squirrel>fox": ["gg", "Vulpes vulpes", "Urocitellus undulatus"], "vole>fox": ["g", "Vulpes vulpes", "Microtus gregalis"], "nutcracker>fox": ["g", "Vulpes vulpes", "Nucifraga caryocatactes"], "vole>stoat": ["g", "Mustela erminea", "Microtus gregalis"], "squirrel>steppeeagle": ["g", "Aquila nipalensis", "Urocitellus undulatus"], "marmot>steppeeagle": ["g", "Aquila nipalensis", "Marmota baibacina"], "vole>steppeeagle": ["g", "Aquila nipalensis", "Microtus gregalis"], "marmot>vulture": ["g", "Aegypius monachus", "Marmota baibacina"], "marmot>bear": ["g", "Ursus arctos", "Marmota baibacina"], "vole>bear": ["g", "Ursus arctos", "Microtus gregalis"], "ibex>vulture": ["a"], "argali>vulture": ["a"], "ibex>snowleopard": ["g", "Panthera uncia", "Capra sibirica"], "argali>snowleopard": ["g", "Panthera uncia", "Ovis ammon"], "marmot>snowleopard": ["g", "Panthera uncia", "Marmota baibacina"], "pika>snowleopard": ["gg", "Panthera uncia", "Ochotona alpina"], "ibex>wolf": ["g", "Canis lupus", "Capra sibirica"], "argali>wolf": ["g", "Canis lupus", "Ovis ammon"], "marmot>wolf": ["g", "Canis lupus", "Marmota baibacina"], "ibex>fox": ["ga", "Vulpes vulpes", "Capra sibirica"], "argali>fox": ["ga", "Vulpes vulpes", "Ovis ammon"], "argali>bear": ["ga", "Ursus arctos", "Ovis ammon"], "fox>snowleopard": ["ga", "Panthera uncia", "Vulpes vulpes"], "vole>wolf": ["ga", "Canis lupus", "Microtus gregalis"], "nutcracker>wolf": ["ga", "Canis lupus", "Nucifraga caryocatactes"], "fox>wolf": ["ga", "Canis lupus", "Vulpes vulpes"], "stoat>wolf": ["ga", "Canis lupus", "Mustela erminea"], "bear>wolf": ["ga", "Canis lupus", "Ursus arctos"]}, "story": "The Golden Mountains of Altai cover 16,178 km² of Russia, including the Altai and Katun Reserves, Lake Teletskoye, Mount Belukha and the Ukok Plateau. UNESCO notes the most complete sequence of altitude zones in central Siberia, from steppe to alpine vegetation.", "matters": "The region protects globally endangered mammals such as the snow leopard, Altai argali and Siberian ibex. Its permafrost has also preserved frozen Scythian burial mounds."}