{"id": "xghana", "name": "Mole National Park", "short": "Mole", "place": "Ghana", "lat": 9.7, "lon": -1.83, "side": "l", "cont": "Africa", "country": "Ghana", "kind": "Grassland", "park": true, "blurb": "Guinea savanna where elephants, kob and fire shape trees, grass and prey.", "tip": {"id": "elephant", "title": "Thin out the elephants", "text": "Elephants browse and break trees. Lower them and watch the shea and burkea trees, then lion and hyena food from calves, respond."}, "sources": [{"title": "Wikipedia: Mole National Park", "url": "https://en.wikipedia.org/wiki/Mole_National_Park"}, {"title": "Wikipedia: African bush elephant", "url": "https://en.wikipedia.org/wiki/African_bush_elephant"}, {"title": "Wikipedia: Lion", "url": "https://en.wikipedia.org/wiki/Lion"}, {"title": "Wikipedia: Ugandan kob", "url": "https://en.wikipedia.org/wiki/Uganda_kob"}, {"title": "Wikipedia: Vitellaria", "url": "https://en.wikipedia.org/wiki/Vitellaria"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Mole National Park", "icon": "elephant", "tier": "overview", "nodes": [{"id": "andro", "sp": "andropogon", "xh": 0.12}, {"id": "hyparr", "sp": "hyparrhenia", "xh": 0.34}, {"id": "shea", "sp": "vitellaria paradoxa", "xh": 0.56, "wiki": "Vitellaria", "desc": "A widespread tree of the dry savanna belt. Its fruit pulp is edible and elephants in the park damage it more often than some other trees.", "ic": "aspen"}, {"id": "burkea", "sp": "burkea africana", "xh": 0.76}, {"id": "cowpea", "sp": "vigna unguiculata", "xh": 0.92}, {"id": "elephant", "sp": "loxodonta africana", "xh": 0.08, "desc": "A resident population of roughly 800 elephants is studied here. They eat grass and browse trees, and can thin woodland."}, {"id": "kob", "sp": "kobus kob", "xh": 0.19, "desc": "Reed and grass-eating antelope, the most recorded large mammal near the park and a preferred prey of big cats."}, {"id": "warthog", "sp": "phacochoerus africanus", "xh": 0.3, "desc": "A grazing pig that kneels to dig for roots; lions regularly take it despite its small size."}, {"id": "bushbuck", "sp": "tragelaphus scriptus", "xh": 0.41, "desc": "A shy antelope of thickets and river edges that browses leaves and shoots."}, {"id": "baboon", "sp": "papio anubis", "xh": 0.53, "desc": "Omnivorous troops eat fruit such as shea, plus grasses and other foods, and are a regular leopard prey."}, {"id": "guineafowl", "sp": "numida meleagris", "xh": 0.65}, {"id": "butterfly", "sp": "hamanumida daedalus", "xh": 0.8}, {"id": "beeeater", "sp": "merops bulocki", "xh": 0.12}, {"id": "monitor", "sp": "varanus niloticus", "xh": 0.32, "desc": "A large lizard of watersides that eats eggs, small animals and carrion."}, {"id": "bateleur", "sp": "terathopius ecaudatus", "xh": 0.52, "desc": "A short-tailed eagle that hunts small animals and also feeds on carrion."}, {"id": "hyena", "sp": "crocuta crocuta", "xh": 0.74, "desc": "A powerful hunter and scavenger. The park says hyenas are now rarely seen."}, {"id": "lion", "sp": "panthera leo", "xh": 0.35, "desc": "Takes hooved mammals including warthog and sometimes elephant calves. Now rare in this park."}, {"id": "leopard", "sp": "panthera pardus", "xh": 0.68, "desc": "A secretive cat that remains in the park and hunts antelope and monkeys."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Bright tropical sun drives plant growth; water is the main limit."}, {"id": "rain", "sp": "seasonal rain", "xh": 0.32, "desc": "A long dry season leaves the Mole and Lovi rivers as pools, so the wet season sets the pace of growth."}, {"id": "fire", "sp": "dry-season fire", "xh": 0.54, "desc": "Savanna grass burns in the dry season, clearing old growth so new shoots come up for grazers."}, {"id": "soil", "sp": "savanna soil", "xh": 0.74, "desc": "The nutrient store that grasses and trees draw on, refreshed by dung and decay."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Termites, dung beetles & fungi", "desc": "Break down dead grass, dung and carcasses, returning nutrients to the soil."}], "raw": [["sun", "andro", "r"], ["sun", "hyparr", "r"], ["sun", "shea", "r"], ["sun", "burkea", "r"], ["sun", "cowpea", "r"], ["rain", "andro", "r"], ["rain", "hyparr", "r"], ["rain", "shea", "r"], ["rain", "burkea", "r"], ["rain", "cowpea", "r"], ["fire", "andro", "r"], ["fire", "hyparr", "r"], ["soil", "shea", "r"], ["soil", "burkea", "r"], ["decomp", "soil", "r"], ["andro", "elephant"], ["hyparr", "elephant"], ["shea", "elephant"], ["burkea", "elephant"], ["andro", "kob"], ["hyparr", "kob"], ["andro", "warthog"], ["hyparr", "warthog"], ["burkea", "bushbuck"], ["shea", "baboon"], ["hyparr", "baboon"], ["andro", "guineafowl"], ["cowpea", "butterfly"], ["butterfly", "beeeater"], ["guineafowl", "monitor"], ["guineafowl", "bateleur"], ["kob", "lion"], ["warthog", "lion"], ["elephant", "lion"], ["kob", "leopard"], ["bushbuck", "leopard"], ["baboon", "leopard"], ["warthog", "leopard"], ["kob", "hyena"], ["warthog", "hyena"], ["elephant", "hyena"], ["bushbuck", "hyena"], ["kob", "bateleur", "s"], ["warthog", "bateleur", "s"], ["kob", "monitor", "s"], ["kob", "hyena", "s"], ["warthog", "hyena", "s"], ["lion", "hyena", "s"], ["lion", "bateleur", "s"], ["andro", "decomp", "d"], ["hyparr", "decomp", "d"], ["shea", "decomp", "d"], ["burkea", "decomp", "d"], ["cowpea", "decomp", "d"], ["elephant", "decomp", "d"], ["kob", "decomp", "d"], ["warthog", "decomp", "d"], ["bushbuck", "decomp", "d"], ["baboon", "decomp", "d"], ["guineafowl", "decomp", "d"], ["butterfly", "decomp", "d"], ["beeeater", "decomp", "d"], ["monitor", "decomp", "d"], ["bateleur", "decomp", "d"], ["hyena", "decomp", "d"], ["lion", "decomp", "d"], ["leopard", "decomp", "d"], ["baboon", "hyena"], ["bushbuck", "lion"], ["baboon", "lion"], ["guineafo