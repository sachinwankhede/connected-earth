{"id": "nplassen", "name": "Lassen Volcanic National Park", "short": "Lassen Volcanic", "place": "California, USA", "lat": 40.49, "lon": -121.51, "side": "l", "cont": "North America", "country": "United States of America", "states": ["California"], "kind": "Polar & mountain", "park": true, "blurb": "Snowy volcanic peaks, whitebark pines, deer and the rare Sierra Nevada red fox.", "tip": {"id": "snow", "title": "Shrink the snowpack", "text": "Meltwater feeds meadow wildflowers and conifers. Set Winter snowpack to -100% and watch the plants, then deer, pikas and the predators above them."}, "sources": [{"title": "Wikipedia: Lassen Volcanic National Park", "url": "https://en.wikipedia.org/wiki/Lassen_Volcanic_National_Park"}, {"title": "NPS: Animals of Lassen Volcanic National Park", "url": "https://www.nps.gov/lavo/learn/nature/animals.htm"}, {"title": "Wikipedia: Sierra Nevada red fox", "url": "https://en.wikipedia.org/wiki/Sierra_Nevada_red_fox"}, {"title": "Wikipedia: Mule deer", "url": "https://en.wikipedia.org/wiki/Mule_deer"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}, {"title": "Wikipedia: Clark's nutcracker", "url": "https://en.wikipedia.org/wiki/Clark%27s_nutcracker"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Lassen Volcanic National Park", "icon": "ice", "tier": "overview", "nodes": [{"id": "redfir", "sp": "abies magnifica", "xh": 0.08, "desc": "Dominant conifer of the red fir forest between about 6,500 and 8,000 feet, and a seed source for squirrels.", "ic": "aspen"}, {"id": "whitebark", "sp": "pinus albicaulis", "xh": 0.24, "wiki": "Pinus albicaulis", "desc": "A hardy high-elevation pine of the subalpine zone. Its large seeds feed Clark's nutcrackers and bears, and nutcrackers spread it by caching seeds.", "no": ["badge"]}, {"id": "ceanothus", "sp": "ceanothus", "xh": 0.42}, {"id": "manzanita", "sp": "arctostaphylos nevadensis", "xh": 0.6, "ic": "sage"}, {"id": "lupine", "sp": "lupinus", "xh": 0.8}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.07, "wiki": "Mule deer", "desc": "Browses shrubs and eats forbs. Cougars, coyotes and bobcats prey on it, and its carcasses feed scavengers."}, {"id": "nutcracker", "sp": "nucifraga columbiana", "xh": 0.2, "desc": "Relies mainly on pine seeds, especially whitebark pine, and buries surplus seeds that can sprout into new trees."}, {"id": "dougsq", "sp": "tamiasciurus douglasii", "xh": 0.34, "desc": "Eats mainly conifer seeds and stores cones in a midden. Preyed on by martens, bobcats and owls."}, {"id": "gmgs", "sp": "callospermophilus lateralis", "xh": 0.5, "wiki": "Golden-mantled ground squirrel", "desc": "The most recorded mammal near the park. An omnivore of pine nuts, plants, fungi and insects that hibernates in winter."}, {"id": "pika", "sp": "ochotona princeps", "xh": 0.66, "desc": "A heat-sensitive herbivore of talus slopes that stores cut vegetation in haypiles for winter."}, {"id": "deermouse", "sp": "peromyscus maniculatus", "xh": 0.82, "wiki": "Deer mouse", "desc": "A very common small rodent and a meal for foxes, coyotes, snakes and other predators.", "ic": "vole"}, {"id": "raven", "sp": "corvus corax", "xh": 0.12, "desc": "A clever omnivore and scavenger that feeds on carrion, small animals and other birds."}, {"id": "redfox", "sp": "vulpes vulpes necator", "xh": 0.3}, {"id": "coyote", "sp": "canis latrans", "xh": 0.5, "tl": 3, "wiki": "Coyote", "desc": "A flexible predator and scavenger that takes rodents, pikas and deer fawns and feeds on carrion."}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.68, "tl": 3, "wiki": "Bobcat", "desc": "A small cat that hunts squirrels, pikas and rodents and sometimes deer fawns.", "ic": "lion"}, {"id": "bear", "sp": "ursus americanus", "xh": 0.88, "name": "American black bear", "tl": 3, "wiki": "American black bear", "desc": "Mostly a plant eater (berries, nuts) that also eats insects, fawns and carrion, and raids squirrel nut caches."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.45, "name": "Cougar", "desc": "The park's top cat. Deer are its main prey, and black bears often take over its kills."}, {"id": "sun", "sp": "sunlight", "xh": 0.15, "latin": "Sunlight", "desc": "Short, bright summers drive plant growth once the snow has gone."}, {"id": "snow", "sp": "snow", "xh": 0.4}, {"id": "fire", "sp": "wildfire", "xh": 0.62, "latin": "Wildfire", "desc": "The 2021 Dixie Fire burned about 69% of the park and opened ground for fire-adapted shrubs."}, {"id": "soil", "sp": "soil", "xh": 0.78}, {"id": "decomp", "sp": "decomposers", "xh": 0.95, "latin": "Decomposers", "name": "Fungi & bacteria", "desc": "Break down dead trees, plants and carcasses and return nutrients to the soil."}], "raw": [["sun", "redfir", "r"], ["sun", "whitebark", "r"], ["sun", "ceanothus", "r"], ["sun", "manzanita", "r"], ["sun", "lupine", "r"], ["snow", "redfir", "r"], ["snow", "whitebark", "r"], ["snow", "lupine", "r"], ["fire", "ceanothus", "r"], ["soil", "redfir", "r"], ["soil", "lupine", "r"], ["redfir", "dougsq"], ["whitebark", "dougsq"], ["whitebark", "nutcracker"], ["whitebark", "bear"], ["whitebark", "gmgs"], ["ceanothus", "muledeer"], ["lupine", "muledeer"], ["lupine", "pika"], ["lupine", "gmgs"], ["lupine", "deermouse"], ["manzanita", "redfox"], ["manzanita", "bear"], ["nutcracker", "redfox"], ["muledeer", "cougar"], ["muledeer", "bobcat"], ["muledeer", "redfox"], ["gmgs", "bear"], ["gmgs", "coyote"], ["gmgs", "bobcat"], ["gmgs", "redfox"], ["dougsq", "bobcat"], ["pika", "coyote"], ["pika", "bobcat"], ["pika", "cougar"], ["deermouse", "coyote"], ["deermouse", "bobcat"], ["deermouse", "redfox"], ["muledeer", "raven", "s"], ["muledeer", "coyote", "s"], ["muledeer", "bear", "s"], ["muledeer", "coyote"], ["muledeer", "bear"], ["redfir", "deco