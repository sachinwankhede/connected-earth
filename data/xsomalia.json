{"id": "xsomalia", "name": "Lag Badana National Park (Bush-Bush)", "short": "Lag Badana", "place": "Somalia", "lat": -1.0, "lon": 41.7, "side": "r", "cont": "Africa", "country": "Somalia", "kind": "Coast & ocean", "park": true, "blurb": "Coastal forest, mangroves and seagrass on Somalia's far southern coast.", "tip": {"id": "seagrass", "title": "Lose the seagrass", "text": "Dugongs and green turtles graze seagrass. Set Seagrass to -100% and watch both grazers, then the tiger sharks that hunt them."}, "sources": [{"title": "Wikipedia: Lag Badana National Park", "url": "https://en.wikipedia.org/wiki/Lag_Badana_National_Park"}, {"title": "Wikipedia: Mangrove", "url": "https://en.wikipedia.org/wiki/Mangrove"}, {"title": "Wikipedia: Dugong", "url": "https://en.wikipedia.org/wiki/Dugong"}, {"title": "Wikipedia: Lesser kudu", "url": "https://en.wikipedia.org/wiki/Lesser_kudu"}, {"title": "Wikipedia: Green sea turtle", "url": "https://en.wikipedia.org/wiki/Green_sea_turtle"}, {"title": "Wikipedia: Scylla serrata", "url": "https://en.wikipedia.org/wiki/Scylla_serrata"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Lag Badana National Park", "icon": "shell", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.12, "desc": "Tropical sun on the equator drives growth of mangroves, seagrass and forest trees along this coast."}, {"id": "tide", "sp": "tides and salt water", "xh": 0.38}, {"id": "rains", "sp": "monsoon rains", "xh": 0.64, "desc": "Seasonal monsoon rains bring the freshwater that coastal forest plants and river-fed mangroves depend on."}, {"id": "mud", "sp": "nutrient-rich mud", "xh": 0.84}, {"id": "decomp", "sp": "decomposer community", "xh": 0.95, "desc": "Break down mangrove leaves, wood and dead animals in the mud, returning nutrients to the system."}, {"id": "avicennia", "sp": "avicennia marina", "xh": 0.1, "desc": "A salt-tolerant mangrove tree of Indian Ocean shores that holds muddy shorelines together and shelters young fish and crabs."}, {"id": "rhizophora", "sp": "rhizophora mucronata", "xh": 0.3}, {"id": "seagrass", "sp": "thalassodendron ciliatum", "xh": 0.5}, {"id": "grewia", "sp": "grewia", "xh": 0.72}, {"id": "forest", "sp": "manilkara", "xh": 0.9}, {"id": "kudu", "sp": "ammelaphus imberbis", "xh": 0.1}, {"id": "dugong", "sp": "dugong dugon", "xh": 0.3, "desc": "A large marine grazer that feeds mainly on seagrass. East African populations are now very small.", "no": ["badge"]}, {"id": "turtle", "sp": "chelonia mydas", "xh": 0.5, "desc": "Adults graze seagrass beds in shallow lagoons. Tiger sharks are the main predator of turtles of all sizes."}, {"id": "sesarmid", "sp": "sesarmidae", "xh": 0.7}, {"id": "termite", "sp": "isoptera", "xh": 0.9, "desc": "Termites eat leaf litter, roots and wood, including in mangrove forests, and are a major food for insect-eating birds."}, {"id": "mudcrab", "sp": "scylla serrata", "xh": 0.1}, {"id": "lemon", "sp": "negaprion acutidens", "xh": 0.28}, {"id": "drongo", "sp": "dicrurus adsimilis", "xh": 0.46}, {"id": "beeeater", "sp": "merops pusillus", "xh": 0.64}, {"id": "hornbill", "sp": "tockus deckeni", "xh": 0.84}, {"id": "lion", "sp": "panthera leo", "xh": 0.25, "desc": "Top predator of the Lag Badana forests, which have been a Lion Conservation Unit since 2005. It hunts medium and large browsers."}, {"id": "tiger", "sp": "galeocerdo cuvier", "xh": 0.7, "desc": "A large shark and the main predator of green turtles. Sharks also threaten young dugongs."}], "raw": [["sun", "avicennia", "r"], ["sun", "rhizophora", "r"], ["sun", "seagrass", "r"], ["sun", "grewia", "r"], ["sun", "forest", "r"], ["tide", "avicennia", "r"], ["tide", "rhizophora", "r"], ["rains", "grewia", "r"], ["rains", "forest", "r"], ["mud", "avicennia", "r"], ["mud", "rhizophora", "r"], ["decomp", "mud", "r"], ["avicennia", "sesarmid"], ["rhizophora", "sesarmid"], ["avicennia", "termite"], ["rhizophora", "termite"], ["grewia", "kudu"], ["forest", "kudu"], ["seagrass", "dugong"], ["seagrass", "turtle"], ["sesarmid", "mudcrab"], ["sesarmid", "drongo"], ["termite", "drongo"], ["termite", "beeeater"], ["termite", "hornbill"], ["mudcrab", "lemon"], ["kudu", "lion"], ["dugong", "tiger"], ["turtle", "tiger"], ["avicennia", "decomp", "d"], ["rhizophora", "decomp", "d"], ["grewia", "decomp", "d"], ["forest", "decomp", "d"], ["sesarmid", "decomp", "d"], ["kudu", "decomp", "d"], ["mudcrab", "decomp", "d"], ["lion", "decomp", "d"], ["avicennia", "dugong"], ["lemon", "tiger"]], "ev": {"avicennia>sesarmid": ["a"], "rhizophora>sesarmid": ["a"], "avicennia>termite": ["a"], "rhizophora>termite": ["a"], "grewia>kudu": ["a"], "forest>kudu": ["a"], "seagrass>dugong": ["a"], "seagrass>turtle": ["a"], "sesarmid>mudcrab": ["a"], "sesarmid>drongo": ["a"], "termite>drongo": ["a"], "termite>beeeater": ["a"], "termite>hornbill": ["a"], "mudcrab>lemon": ["a"], "kudu>lion": ["a"], "dugong>tiger": ["g", "Galeocerdo cuvier", "Dugong dugon"], "turtle>tiger": ["g", "Galeocerdo cuvier", "Chelonia mydas"], "avicennia>dugong": ["ga", "Dugong dugon", "Avicennia marina"], "lemon>tiger": ["ga", "Galeocerdo cuvier", "Negaprion acutidens"]}}