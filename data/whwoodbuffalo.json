{"id": "whwoodbuffalo", "name": "Wood Buffalo National Park", "short": "Wood Buffalo", "place": "Alberta and Northwest Territories, Canada", "lat": 59.3, "lon": -112.9, "side": "l", "cont": "North America", "country": "Canada", "blurb": "Wood bison, wolves and whooping cranes on a vast northern delta.", "tip": {"id": "bison", "title": "Remove the wood bison", "text": "Wolves here rely on wood bison. Set Wood bison to -100% and watch the wolf, then the moose, beavers and cranes it must turn to."}, "sources": [{"title": "Wikipedia: Wood Buffalo National Park", "url": "https://en.wikipedia.org/wiki/Wood_Buffalo_National_Park"}, {"title": "UNESCO World Heritage: Wood Buffalo National Park", "url": "https://whc.unesco.org/en/list/256/"}, {"title": "Wikipedia: Wood bison", "url": "https://en.wikipedia.org/wiki/Wood_bison"}, {"title": "Wikipedia: Whooping crane", "url": "https://en.wikipedia.org/wiki/Whooping_crane"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Wood Buffalo National Park", "icon": "bison", "kind": "Forest", "park": true, "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Long summer days power the sedge meadows, willows and forest of the far north."}, {"id": "delta", "sp": "peace-athabasca delta floods", "xh": 0.5}, {"id": "fire", "sp": "wildfire", "xh": 0.85, "desc": "Fire renews boreal forest and open meadow, resetting plant growth across the landscape."}, {"id": "sedge", "sp": "carex", "xh": 0.06, "desc": "Sedges form some of the large grass and sedge meadows UNESCO highlights in the park; they feed wood bison.", "badge": "Foundation species"}, {"id": "bluejoint", "sp": "calamagrostis canadensis", "xh": 0.25}, {"id": "willow", "sp": "salix bebbiana", "xh": 0.44}, {"id": "spruce", "sp": "picea glauca", "xh": 0.63, "desc": "A main conifer of the boreal forest, whose seeds feed red squirrels."}, {"id": "rubus", "sp": "rubus pubescens", "xh": 0.82}, {"id": "bison", "sp": "bison bison", "xh": 0.06, "name": "Wood bison", "wiki": "Wood bison", "desc": "The park holds the world's largest wood bison herd. They graze grasses, sedges and forbs, and dig through snow for food."}, {"id": "moose", "sp": "alces alces", "xh": 0.2, "desc": "A large browser of willows and other woody plants, and a main prey of wolves and bears."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.34, "name": "North American beaver", "wiki": "North American beaver", "desc": "Eats willow and sedges and builds dams; satellite images in 2007 revealed a dam about 850 m long in the park.", "badge": "Ecosystem engineer"}, {"id": "vole", "sp": "microtus pennsylvanicus", "xh": 0.48, "wiki": "Meadow vole", "desc": "A small grass-eating rodent of meadows, eaten by foxes, bears and many other predators.", "ic": "vole"}, {"id": "squirrel", "sp": "tamiasciurus hudsonicus", "xh": 0.62, "wiki": "American red squirrel", "desc": "A forest squirrel that eats conifer seeds; lynx, foxes and wolves are recorded eating it.", "ic": "rsquirrel"}, {"id": "mallard", "sp": "anas platyrhynchos", "xh": 0.78, "wiki": "Mallard", "desc": "A dabbling duck of the delta wetlands that eats plant matter and small aquatic animals."}, {"id": "crane", "sp": "grus americana", "xh": 0.1}, {"id": "raven", "sp": "corvus corax", "xh": 0.3, "wiki": "Common raven", "desc": "A scavenger and egg thief, recorded more than any other bird in the park area."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.5, "wiki": "Red fox", "desc": "Hunts voles, squirrels, ducks and eats berries; it is also a predator of crane nests."}, {"id": "lynx", "sp": "lynx canadensis", "xh": 0.7, "desc": "A forest cat that preys on red squirrels and beavers according to GloBI records."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.9, "name": "American black bear", "tl": 3, "wiki": "American black bear", "desc": "An omnivore eating berries, grasses, voles and moose, and a recorded predator of crane nests."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.5, "desc": "UNESCO says the park is the only place where the wolf and wood bison predator-prey link has continued unbroken."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.97, "name": "Decomposers", "desc": "Fungi and bacteria that break down dead plants and animals, returning nutrients to the wet soils."}], "raw": [["delta", "sedge", "r"], ["delta", "bluejoint", "r"], ["delta", "willow", "r"], ["sun", "sedge", "r"], ["sun", "bluejoint", "r"], ["sun", "spruce", "r"], ["sun", "rubus", "r"], ["fire", "bluejoint", "r"], ["fire", "rubus", "r"], ["sedge", "bison"], ["bluejoint", "bison"], ["willow", "bison"], ["willow", "moose"], ["willow", "beaver"], ["sedge", "beaver"], ["sedge", "vole"], ["bluejoint", "vole"], ["sedge", "mallard"], ["spruce", "squirrel"], ["sedge", "crane"], ["vole", "crane"], ["vole", "fox"], ["vole", "bear"], ["squirrel", "fox"], ["squirrel", "lynx"], ["squirrel", "wolf"], ["mallard", "fox"], ["mallard", "wolf"], ["rubus", "bear"], ["rubus", "fox"], ["bluejoint", "bear"], ["bison", "wolf"], ["moose", "wolf"], ["moose", "bear"], ["beaver", "wolf"], ["beaver", "lynx"], ["beaver", "bear"], ["crane", "wolf"], ["crane", "fox"], ["crane", "bear"], ["crane", "raven"], ["fox", "wolf"], ["fox", "lynx"], ["lynx", "wolf"], ["bear", "wolf"], ["bison", "raven", "s"], ["moose", "raven", "s"], ["bison", "bear", "s"], ["sedge", "decomp", "d"], ["bluejoint", "decomp", "d"], ["willow", "decomp", "d"], ["spruce", "decomp", "d"], ["rubus", "decomp", "d"], ["bison", "decomp", "d"], ["moose", "decomp", "d"], ["beaver", "decomp", "d"], ["vole", "decomp", "d"], ["squirrel", "decomp", "d"], ["mallard", "decomp", "d"], ["crane", "decomp", "d"], ["raven", "decomp", "d"], ["fox", "decomp", "d"], ["lynx", "decomp", "d"], ["bear", "decomp", "d"], ["wolf", "decomp", "d"], ["decomp