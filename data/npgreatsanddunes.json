{"id": "npgreatsanddunes", "name": "Great Sand Dunes National Park and Preserve", "short": "Great Sand Dunes", "place": "Colorado, USA", "lat": 37.73, "lon": -105.51, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Colorado"], "kind": "Desert", "park": true, "blurb": "Tallest dunes in North America, kangaroo rats and a beetle found nowhere else.", "tip": {"id": "snow", "title": "Dry up the snowmelt", "text": "Snowmelt feeds Medano Creek and the moist sand. Set Snowmelt and Medano Creek to -100% and watch the plants, then the seed and leaf eaters and their predators."}, "sources": [{"title": "Wikipedia: Great Sand Dunes National Park and Preserve", "url": "https://en.wikipedia.org/wiki/Great_Sand_Dunes_National_Park_and_Preserve"}, {"title": "NPS: Nature and science at Great Sand Dunes", "url": "https://www.nps.gov/grsa/learn/nature/index.htm"}, {"title": "Wikipedia: Ord's kangaroo rat", "url": "https://en.wikipedia.org/wiki/Ord%27s_kangaroo_rat"}, {"title": "Wikipedia: Indian ricegrass", "url": "https://en.wikipedia.org/wiki/Indian_ricegrass"}, {"title": "Wikipedia: Eleodes", "url": "https://en.wikipedia.org/wiki/Eleodes"}, {"title": "Wikipedia: Great Sand Dunes tiger beetle", "url": "https://en.wikipedia.org/wiki/Cicindela_theatina"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Great Sand Dunes National Park and Preserve", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "High-altitude sun powers the sparse plants of the dune field and the grasslands around it."}, {"id": "snow", "sp": "snowmelt and medano creek", "xh": 0.3}, {"id": "sand", "sp": "moist dune sand", "xh": 0.5}, {"id": "rain", "sp": "summer rain", "xh": 0.7}, {"id": "decomp", "sp": "decomposers", "xh": 0.9, "desc": "Fungi, bacteria and detritus feeders break down dead plants and animals and return nutrients to the sand."}, {"id": "pinyon", "sp": "pinus edulis", "xh": 0.12, "desc": "A small pine of the drier slopes, listed by Wikipedia among the park's trees. Its large seeds are a food for birds and rodents."}, {"id": "rabbitbrush", "sp": "ericameria nauseosa", "xh": 0.32, "ic": "sage"}, {"id": "ricegrass", "sp": "eriocoma hymenoides", "xh": 0.52, "wiki": "Indian ricegrass", "desc": "A bunchgrass of sandy ground that Wikipedia says is eaten by elk, mule deer and others, and whose seeds feed many rodents and birds.", "badge": "Foundation species"}, {"id": "sunflower", "sp": "helianthus petiolaris", "xh": 0.72}, {"id": "darkling", "sp": "eleodes hirtipennis", "xh": 0.06}, {"id": "hopper", "sp": "melanoplus borealis", "xh": 0.2}, {"id": "mouse", "sp": "peromyscus maniculatus", "xh": 0.34, "wiki": "Deer mouse", "desc": "A common, widely recorded rodent that eats seeds and insects and is prey for snakes, hawks and coyotes.", "ic": "vole"}, {"id": "kroo", "sp": "dipodomys ordii", "xh": 0.5, "desc": "Mostly eats seeds and caches them in burrows in loose sand. Coyotes, owls, hawks and snakes prey on it.", "ic": "gsquirrel"}, {"id": "deer", "sp": "odocoileus hemionus", "xh": 0.68, "wiki": "Mule deer", "desc": "Browses shrubs and grazes grasses. Wikipedia says cougars hunt it at night in the montane woodlands."}, {"id": "elk", "sp": "cervus canadensis", "xh": 0.84, "desc": "Visits the dunes from surrounding habitats and grazes grasses such as ricegrass. Cougars take it, and coyotes and ravens use carcasses."}, {"id": "tiger", "sp": "cicindela theatina", "xh": 0.12}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.34, "wiki": "Bullsnake", "desc": "A large constrictor of the drier woodlands and sand country that eats rodents such as kangaroo rats and deer mice.", "ic": "snake"}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.56, "tl": 3, "desc": "Wikipedia says raptors hunt mice and kangaroo rats over the sand sheet. Red-tailed hawks also take snakes."}, {"id": "raven", "sp": "corvus corax", "xh": 0.8, "desc": "The most recorded bird near the park. Eats insects and small animals and scavenges carcasses."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.3, "name": "Cougar", "desc": "Wikipedia says cougars hunt mule deer at night in the park's montane woodlands. Elk are also a large prey."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.68, "wiki": "Coyote", "desc": "Eats rodents, snakes, beetles and carcasses, and takes deer and elk. It hunts the sand sheet and woodlands."}], "raw": [["sun", "pinyon", "r"], ["sun", "rabbitbrush", "r"], ["sun", "ricegrass", "r"], ["sun", "sunflower", "r"], ["rain", "pinyon", "r"], ["rain", "rabbitbrush", "r"], ["rain", "ricegrass", "r"], ["rain", "sunflower", "r"], ["snow", "ricegrass", "r"], ["snow", "sunflower", "r"], ["snow", "rabbitbrush", "r"], ["snow", "pinyon", "r"], ["sand", "ricegrass", "r"], ["sand", "sunflower", "r"], ["sand", "rabbitbrush", "r"], ["decomp", "sand", "r"], ["ricegrass", "kroo"], ["sunflower", "kroo"], ["pinyon", "mouse"], ["sunflower", "mouse"], ["ricegrass", "mouse"], ["hopper", "mouse"], ["ricegrass", "hopper"], ["sunflower", "hopper"], ["ricegrass", "darkling"], ["ricegrass", "deer"], ["rabbitbrush", "deer"], ["ricegrass", "elk"], ["hopper", "tiger"], ["kroo", "bullsnake"], ["mouse", "bullsnake"], ["kroo", "hawk"], ["mouse", "hawk"], ["bullsnake", "hawk"], ["hopper", "raven"], ["darkling", "raven"], ["bullsnake", "raven"], ["deer", "cougar"], ["elk", "cougar"], ["mouse", "coyote"], ["kroo", "coyote"], ["bullsnake", "coyote"], ["darkling", "coyote"], ["deer", "coyote"], ["elk", "coyote", "s"], ["elk", "raven", "s"], ["deer", "raven", "s"], ["pinyon", "decomp", "d"], ["rabbitbrush", "decomp", "d"], ["ricegrass", "decomp", "d"], ["sunflower", "decomp", "d"], ["darkling", "decomp", "d"], ["hopper", "decomp", "d"], ["mouse", "decomp", "d"], ["kroo", "