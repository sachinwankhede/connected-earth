iger"], ["monitor", "tiger"], ["fiddler", "croc"], ["chital", "croc"], ["boar", "croc"], ["hilsa", "croc"], ["monitor", "croc"], ["sundri", "decomp", "d"], ["gewa", "decomp", "d"], ["fiddler", "decomp", "d"], ["chital", "decomp", "d"], ["hilsa", "decomp", "d"]], "cont": "Asia", "country": "Bangladesh", "link_ideas": [{"kind": "species", "with": "Bay of Bengal / Ganges river system", "what": "Hilsa migrate from the sea up the rivers to spawn", "evidence_url": "https://en.wikipedia.org/wiki/Hilsa"}], "kind": "Coast & ocean", "countries": ["Bangladesh", "India"], "ev": {"sundri>fiddler": ["a"], "gewa>fiddler": ["a"], "sundri>shrimp": ["a"], "phyto>shrimp": ["a"], "sundri>chital": ["a"], "sundri>boar": ["a"], "phyto>zoop": ["a"], "phyto>hilsa": ["a"], "zoop>hilsa": ["a"], "fiddler>mudskipper": ["a"], "fiddler>fishcat": ["a"], "hilsa>fishcat": ["a"], "mudskipper>fishcat": ["a"], "fiddler>monitor": ["a"], "mudskipper>monitor": ["a"], "hilsa>eagle": ["a"], "monitor>eagle": ["a"], "hilsa>irra": ["a"], "shrimp>irra": ["a"], "hilsa>ganges": ["a"], "shrimp>ganges": ["a"], "chital>tiger": ["g", "Panthera tigris", "Axis axis"], "boar>tiger": ["g", "Panthera tigris", "Sus scrofa"], "hilsa>tiger": ["a"], "fiddler>tiger": ["a"], "monitor>tiger": ["a"], "fiddler>croc": ["a"], "chital>croc": ["a"], "boar>croc": ["g", "Crocodylus porosus", "Sus scrofa"], "hilsa>croc": ["a"], "monitor>croc": ["a"]}, "story": "The Sundarbans, where the Ganges, Brahmaputra and Meghna meet the Bay of Bengal, is the world's largest mangrove forest at 10,277 km². Tigers hunt chital deer and wild boar here, and saltwater crocodiles also eat boar.", "matters": "Sundarbans tigers are smaller than tigers elsewhere, probably an adaptation to small prey. These mangroves are important habitat for the endangered Bengal tiger."}