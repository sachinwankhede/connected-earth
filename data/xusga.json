{"id": "xusga", "name": "Okefenokee National Wildlife Refuge", "short": "Okefenokee", "place": "Georgia and Florida, USA", "lat": 30.8, "lon": -82.3, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Georgia", "Florida"], "kind": "Lakes & wetlands", "park": true, "blurb": "Alligators, peat and blackwater in the Land of the Trembling Earth.", "tip": {"id": "alligator", "title": "Remove the alligators", "text": "Alligators eat fish, snakes and raccoons. Set American alligator to -100% and watch what happens to bowfin, cottonmouths and raccoons."}, "sources": [{"title": "Wikipedia: Okefenokee Swamp", "url": "https://en.wikipedia.org/wiki/Okefenokee_Swamp"}, {"title": "Wikipedia: Okefenokee National Wildlife Refuge", "url": "https://en.wikipedia.org/wiki/Okefenokee_National_Wildlife_Refuge"}, {"title": "US Fish & Wildlife Service: Okefenokee NWR", "url": "https://www.fws.gov/refuge/okefenokee"}, {"title": "US Fish & Wildlife Service: Fishing at Okefenokee", "url": "https://fws.gov/refuge/okefenokee/visit-us/activities/fishing"}, {"title": "Wikipedia: American alligator", "url": "https://en.wikipedia.org/wiki/American_alligator"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Okefenokee Swamp", "icon": "croc", "tier": "overview", "nodes": [{"id": "cypress", "sp": "taxodium distichum", "xh": 0.12, "desc": "A swamp conifer that, with swamp tupelo, dominates the forested parts of the Okefenokee. Squirrels and other seed eaters use its cones.", "ic": "willow", "badge": "Foundation species"}, {"id": "lily", "sp": "nymphaea odorata", "xh": 0.35, "name": "American white water lily", "ic": "water"}, {"id": "blueberry", "sp": "vaccinium corymbosum", "xh": 0.6, "name": "Highbush blueberry", "ic": "sage"}, {"id": "bay", "sp": "persea palustris", "xh": 0.85}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.1, "wiki": "White-tailed deer", "desc": "A common browser of shrubs and plants on the swamp islands and edges. The refuge lists it among its main mammals."}, {"id": "squirrel", "sp": "sciurus carolinensis", "xh": 0.34, "wiki": "Eastern gray squirrel", "desc": "Eats tree seeds and nuts, including cypress, and is itself prey for hawks, owls and bobcats."}, {"id": "swallowtail", "sp": "papilio palamedes", "xh": 0.58}, {"id": "cardinal", "sp": "cardinalis cardinalis", "xh": 0.84, "wiki": "Northern cardinal", "desc": "A seed- and fruit-eating songbird that also takes insects. It is one of the many songbirds of the refuge."}, {"id": "pondhawk", "sp": "erythemis simplicicollis", "xh": 0.06, "name": "Eastern pondhawk", "wiki": "Eastern pondhawk", "desc": "A dragonfly that hunts other insects and is one of the commonly recorded dragonflies near the swamp.", "ic": "hopper"}, {"id": "pigfrog", "sp": "lithobates grylio", "xh": 0.2}, {"id": "bowfin", "sp": "amia calva", "xh": 0.34}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.5, "wiki": "Raccoon", "desc": "An omnivore that eats fruit, small animals and eggs. It is also prey for alligators and bobcats."}, {"id": "egret", "sp": "ardea alba", "xh": 0.65, "wiki": "Great egret", "desc": "A wading bird that spears fish and frogs in shallow water. Wading bird numbers shift with water levels.", "ic": "hawk"}, {"id": "cottonmouth", "sp": "agkistrodon conanti", "xh": 0.79}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.93, "wiki": "Turkey vulture", "desc": "Scavenges carrion such as dead deer and mammals."}, {"id": "alligator", "sp": "alligator mississippiensis", "xh": 0.2, "desc": "The refuge estimates about 15,000 alligators. It eats fish, snakes, birds and mammals, and its holes hold water in dry spells.", "badge": "Keystone predator"}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.5, "wiki": "Bobcat", "desc": "A stealthy cat that hunts deer, squirrels, birds and rabbits across the swamp islands and edges.", "ic": "lion"}, {"id": "bear", "sp": "ursus americanus", "xh": 0.8, "name": "Florida black bear", "wiki": "American black bear", "desc": "An omnivore of berries and animal foods. The swamp is critical habitat for the Florida black bear."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light drives plant growth, and the open tea-coloured water lets lilies and shrubs thrive."}, {"id": "water", "sp": "blackwater and rain", "xh": 0.35}, {"id": "fire", "sp": "drought and fire", "xh": 0.6}, {"id": "peat", "sp": "peat", "xh": 0.82, "desc": "Peat up to about 15 feet thick covers much of the swamp floor, giving it the name Land of the Trembling Earth."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.95, "name": "Fungi, bacteria & detritivores", "desc": "Break down fallen leaves, wood and dead animals and recycle nutrients into the peat."}], "raw": [["sun", "cypress", "r"], ["sun", "lily", "r"], ["sun", "blueberry", "r"], ["sun", "bay", "r"], ["water", "cypress", "r"], ["water", "lily", "r"], ["water", "bay", "r"], ["fire", "blueberry", "r"], ["peat", "cypress", "r"], ["peat", "blueberry", "r"], ["peat", "bay", "r"], ["decomp", "peat", "r"], ["cypress", "squirrel"], ["cypress", "cardinal"], ["blueberry", "cardinal"], ["blueberry", "deer"], ["blueberry", "raccoon"], ["blueberry", "bear"], ["lily", "deer"], ["bay", "swallowtail"], ["swallowtail", "pondhawk"], ["pondhawk", "pigfrog"], ["pondhawk", "bowfin"], ["pigfrog", "egret"], ["pigfrog", "bowfin"], ["pigfrog", "cottonmouth"], ["bowfin", "egret"], ["bowfin", "alligator"], ["cottonmouth", "alligator"], ["raccoon", "alligator"], ["egret", "alligator"], ["raccoon", "bobcat"], ["squirrel", "bobcat"], ["deer", "bobcat"], ["cardinal", "bobcat"], ["deer", "bear"], ["squirrel", "raccoon"], ["cardinal", "raccoon"], ["deer", "vulture", "s"], ["raccoon", "vulture", "s"], ["squirrel", "vulture", "s"], ["bobcat", "vulture", "s"], ["cypress", "decomp