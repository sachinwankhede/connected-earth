{"id": "xusct", "name": "Connecticut River Estuary", "short": "CT River Estuary", "place": "Connecticut, USA", "lat": 41.3, "lon": -72.4, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Connecticut"], "park": true, "kind": "Coast & ocean", "blurb": "Tidal marsh, shad runs and ospreys where the river meets Long Island Sound.", "tip": {"id": "shad", "title": "Cut the shad run", "text": "Shad feed striped bass and harbor seals. Set American shad to -80% and watch the bass and seals. Shad numbers in the river fell by about 80% from 1992 to 2005."}, "sources": [{"title": "Wikipedia: Connecticut River", "url": "https://en.wikipedia.org/wiki/Connecticut_River"}, {"title": "Wikipedia: Spartina alterniflora", "url": "https://en.wikipedia.org/wiki/Spartina_alterniflora"}, {"title": "Wikipedia: American shad", "url": "https://en.wikipedia.org/wiki/American_shad"}, {"title": "Wikipedia: Osprey", "url": "https://en.wikipedia.org/wiki/Osprey"}, {"title": "Wikipedia: Geukensia demissa", "url": "https://en.wikipedia.org/wiki/Geukensia_demissa"}, {"title": "Wikipedia: Atlantic menhaden", "url": "https://en.wikipedia.org/wiki/Atlantic_menhaden"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Connecticut River", "icon": "water", "tier": "overview", "nodes": [{"id": "sun", "sp": "solar energy", "xh": 0.15}, {"id": "tide", "sp": "tidal mixing", "xh": 0.4}, {"id": "flow", "sp": "connecticut river discharge", "xh": 0.65}, {"id": "sediment", "sp": "tidal sediment", "xh": 0.88}, {"id": "spartina", "sp": "spartina alterniflora", "xh": 0.15, "desc": "The low-marsh grass of the tidal flats. It traps sediment at the marsh edge and builds up the land."}, {"id": "phyto", "sp": "diatoms and dinoflagellates", "xh": 0.5, "desc": "Drifting algae that feed filter feeders and small plankton grazers throughout the estuary."}, {"id": "eelgrass", "sp": "zostera marina", "xh": 0.85, "desc": "A seagrass of shallow sheltered water in Long Island Sound. When it dies it feeds the decomposers."}, {"id": "goose", "sp": "branta canadensis", "xh": 0.08, "wiki": "Canada goose", "desc": "A common grazer of grasses and marsh plants along the river and shore.", "ic": "hawk"}, {"id": "mussel", "sp": "geukensia demissa", "xh": 0.26}, {"id": "zoop", "sp": "copepods and larvae", "xh": 0.44, "desc": "Tiny grazers of phytoplankton. Young menhaden and shad feed on them.", "ic": "hopper"}, {"id": "menhaden", "sp": "brevoortia tyrannus", "xh": 0.62, "desc": "A filter-feeding schooling fish. Striped bass, ospreys and eagles all prey on it."}, {"id": "shad", "sp": "alosa sapidissima", "xh": 0.82}, {"id": "crab", "sp": "callinectes sapidus", "xh": 0.1, "desc": "An omnivorous marsh and estuary crab that preys on ribbed mussels."}, {"id": "raccoon", "sp": "procyon lotor", "xh": 0.28, "wiki": "Raccoon", "desc": "Forages along the marsh edge, where it takes ribbed mussels among many other foods."}, {"id": "gull", "sp": "larus smithsonianus", "xh": 0.46, "desc": "A shoreline generalist that eats shellfish and scavenges dead fish."}, {"id": "bass", "sp": "morone saxatilis", "xh": 0.7, "desc": "Spends its adult life mostly in salt water and enters rivers to spawn. Feeds on shad, river herring and menhaden."}, {"id": "osprey", "sp": "pandion haliaetus", "xh": 0.2, "tl": 4, "wiki": "Osprey", "desc": "Fish are about 99 percent of its diet. Nests on platforms and poles along the river and marsh.", "ic": "osprey"}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.5, "name": "Bald eagle", "desc": "Takes fish such as menhaden along the river and shore, and also eats carrion."}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.8, "tl": 4, "desc": "Hunts fish in Long Island Sound and has been recorded as far up the river as Holyoke, Massachusetts."}, {"id": "decomp", "sp": "decomposers", "xh": 0.5, "latin": "Decomposers", "name": "Bacteria and fungi", "desc": "Break down dead cordgrass, eelgrass and algae, returning nutrients to the mud."}], "raw": [["sun", "spartina", "r"], ["sun", "phyto", "r"], ["sun", "eelgrass", "r"], ["tide", "spartina", "r"], ["flow", "phyto", "r"], ["sediment", "spartina", "r"], ["spartina", "goose"], ["phyto", "zoop"], ["phyto", "mussel"], ["phyto", "menhaden"], ["zoop", "menhaden"], ["zoop", "shad"], ["mussel", "crab"], ["mussel", "raccoon"], ["mussel", "gull"], ["menhaden", "bass"], ["shad", "bass"], ["menhaden", "osprey"], ["menhaden", "eagle"], ["shad", "seal"], ["menhaden", "gull", "s"], ["menhaden", "eagle", "s"], ["spartina", "decomp", "d"], ["eelgrass", "decomp", "d"], ["phyto", "decomp", "d"], ["decomp", "sediment", "r"], ["shad", "osprey"], ["bass", "osprey"], ["goose", "eagle"], ["shad", "eagle"], ["raccoon", "eagle"], ["gull", "eagle"], ["bass", "eagle"], ["menhaden", "seal"]], "ev": {"spartina>goose": ["a"], "phyto>zoop": ["a"], "phyto>mussel": ["a"], "phyto>menhaden": ["a"], "zoop>menhaden": ["a"], "zoop>shad": ["a"], "mussel>crab": ["g", "Callinectes sapidus", "Geukensia demissa"], "mussel>raccoon": ["a"], "mussel>gull": ["a"], "menhaden>bass": ["g", "Morone saxatilis", "Brevoortia tyrannus"], "shad>bass": ["g", "Morone saxatilis", "Alosa sapidissima"], "menhaden>osprey": ["g", "Pandion haliaetus", "Brevoortia tyrannus"], "menhaden>eagle": ["g", "Haliaeetus leucocephalus", "Brevoortia tyrannus"], "shad>seal": ["g", "Phoca vitulina", "Alosa sapidissima"], "menhaden>gull": ["g", "Larus smithsonianus", "Brevoortia tyrannus"], "shad>osprey": ["ga", "Pandion haliaetus", "Alosa sapidissima"], "bass>osprey": ["ga", "Pandion haliaetus", "Morone saxatilis"], "goose>eagle": ["ga", "Haliaeetus leucocephalus", "Branta canadensis"], "shad>eagle": ["ga", "Haliaeetus leucocephalus", "Alosa sapidissima"], "raccoon>eagle": ["ga", "Haliaeetus leucocephalus", "Procyon lotor"], "gull>eagle": ["ga", "Haliaeetus leucocephalus", "Larus smithsonianus"], "bass>eagle": ["ga", "Haliaeetus leucocephalus", "Morone saxatilis"], "menhaden>seal": ["ga", "Phoca vitulina", "Brevoortia tyrannus"]}}