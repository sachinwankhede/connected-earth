{"id": "yellowstone", "name": "Greater Yellowstone", "short": "Yellowstone", "place": "Wyoming, Montana and Idaho, USA", "lat": 44.6, "lon": -110.5, "side": "l", "blurb": "Wolves, elk, willow and beaver on North America's northern range.", "story": "Yellowstone sits at the heart of one of the last large, nearly intact ecosystems in the northern temperate zone: about 22 million acres of the central Rockies across Wyoming, Montana and Idaho. Wolves, grizzlies and mountain lions hunt the elk and other plant-eaters, and those grazers shape the willow, aspen and grass that beavers, birds and insects depend on.", "matters": "It is a flagship site for conservation groups and one of the world's foremost natural laboratories in landscape ecology. Because so much of the system is still whole, it shows how predators, grazers and plants affect one another.", "tip": {"id": "wolf", "title": "Try the gray wolf", "text": "Wolves were reintroduced in 1995. Many ecologists link their return to less elk browsing on willow and aspen, and to more beaver habitat. Open the wolf, then use the what-if slider."}, "nodes": [{"id": "algae", "sp": "bacillariophyta (diatoms)", "xh": 0.05}, {"id": "willow", "sp": "salix spp.", "xh": 0.22}, {"id": "aspen", "sp": "populus tremuloides", "xh": 0.34, "wiki": "Quaking aspen", "desc": "Clonal groves that shelter birds and insects. Elk and beaver browse young shoots, which can stop a grove from regrowing.", "badge": "Foundation species"}, {"id": "grass", "sp": "pseudoroegneria spicata", "xh": 0.56}, {"id": "sage", "sp": "artemisia tridentata", "xh": 0.74, "wiki": "Big sagebrush", "desc": "Evergreen winter forage. Pronghorn lean on it when snow buries the grass."}, {"id": "whitebark", "sp": "pinus albicaulis", "xh": 0.93, "desc": "A high-elevation pine whose fatty seeds feed grizzly bears and red squirrels."}, {"id": "mayfly", "sp": "ephemeroptera", "xh": 0.04, "desc": "Nymphs graze algae on stream stones and are a main food for cutthroat trout."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.15, "wiki": "North American beaver", "desc": "Cuts willow and aspen and dams streams. The ponds it makes are used by fish, birds and moose.", "badge": "Ecosystem engineer"}, {"id": "moose", "sp": "alces alces", "xh": 0.26, "desc": "Wades into streamside willow thickets, its main winter food."}, {"id": "elk", "sp": "cervus canadensis", "xh": 0.37, "desc": "The northern range's main large grazer and browser. Wolves, cougars, coyotes and bears all take elk."}, {"id": "bison", "sp": "bison bison", "xh": 0.47, "name": "Bison", "desc": "Grazes grass and sedge in large herds. Winter-killed animals feed scavengers.", "no": ["badge"]}, {"id": "muledeer", "sp": "odocoileus hemionus", "xh": 0.57, "wiki": "Mule deer", "desc": "Browses sagebrush, willow and grass at lower elevations."}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.66, "wiki": "Pronghorn", "desc": "Open-country grazer and sagebrush browser. Coyotes and eagles take fawns.", "ic": "pronghorn"}, {"id": "hopper", "sp": "acrididae", "xh": 0.74, "desc": "Chew grasses all summer, then feed songbirds, and trout when they fall into streams."}, {"id": "vole", "sp": "microtus montanus", "xh": 0.82, "wiki": "Montane vole", "ic": "vole"}, {"id": "gsquirrel", "sp": "urocitellus armatus", "xh": 0.9, "name": "Ground squirrel", "desc": "A hibernating meadow rodent eaten by nearly every mid-sized predator. Grizzlies dig them out of burrows."}, {"id": "rsquirrel", "sp": "tamiasciurus hudsonicus", "xh": 0.98, "name": "Red squirrel", "wiki": "American red squirrel", "desc": "Stores whitebark pine cones in middens, which grizzly bears raid.", "ic": "rsquirrel"}, {"id": "otter", "sp": "lontra canadensis", "xh": 0.03, "name": "River otter", "wiki": "North American river otter", "desc": "Hunts trout and other fish along streams and lake shores."}, {"id": "trout", "sp": "oncorhynchus clarkii bouvieri", "xh": 0.1}, {"id": "osprey", "sp": "pandion haliaetus", "xh": 0.18, "desc": "Dives for trout from perches over rivers and lakes."}, {"id": "baldeagle", "sp": "haliaeetus leucocephalus", "xh": 0.26, "tl": 3, "desc": "Takes fish and scavenges carcasses, including wolf kills."}, {"id": "raven", "sp": "corvus corax", "xh": 0.34, "desc": "Ravens often follow wolves and feed on what they leave behind."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.44, "tl": 3, "wiki": "Coyote", "desc": "Hunts voles and ground squirrels, takes fawns and calves, and scavenges wolf kills. Wolves also kill coyotes."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.54, "desc": "Pounces on voles beneath the snow and takes ground squirrels."}, {"id": "meadowlark", "sp": "sturnella neglecta", "xh": 0.64, "tl": 3, "wiki": "Western meadowlark", "desc": "A grassland songbird that eats grasshoppers and seeds in summer."}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.74, "tl": 3, "desc": "Hunts voles, ground squirrels and meadow birds from open perches."}, {"id": "goldeneagle", "sp": "aquila chrysaetos", "xh": 0.86, "tl": 3, "desc": "Hunts ground squirrels and voles, takes pronghorn fawns, and scavenges kills."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.36, "desc": "Reintroduced in 1995. Hunts elk, bison, deer and moose, and its kills feed scavengers. Many ecologists link its return to recovering willow and aspen."}, {"id": "grizzly", "sp": "ursus arctos horribilis", "xh": 0.64, "desc": "An omnivore that eats pine seeds, roots, trout, elk calves and carrion."}, {"id": "lion", "sp": "puma concolor", "xh": 0.9, "name": "Mountain lion", "desc": "An ambush hunter of elk and mule deer in broken, wooded terrain."}, {"id": "water", "sp": "snowmelt & streams", "xh": 0.12}, {"id": "sun", "sp": "sunlight", "xh": 0.38, "desc": "Powers photosynthesis. Nearly all the energy in this web starts here."}, {"id": "soil", "sp": "soil & nutrients", "xh": 0.62, "desc": "Holds the nitrogen and minerals that plants draw up. Decomposers return nutrients from litter and carcasses."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.86, "name": "Fungi & bacteria", "desc": "Break down plant litter and carcasses and return nutrients to the soil."}], "raw": [["grass", "elk"], ["grass", "bison"], ["grass", "pronghorn"], ["grass", "muledeer"], ["grass", "vole"], ["grass", "gsquirrel"], ["grass", "hopper"], ["grass", "grizzly"], ["aspen", "elk"], ["aspen", "beaver"], ["aspen", "moose"], ["willow", "elk"], ["willow", "moose"], ["willow", "beaver"], ["willow", "muledeer"], ["sage", "pronghorn"], ["sage", "muledeer"], ["whitebark", "rsquirrel"], ["whitebark", "grizzly"], ["algae", "mayfly"], ["mayfly", "trout"], ["hopper", "trout"], ["hopper", "meadowlark"], ["vole", "fox"], ["vole", "coyote"], ["vole", "hawk"], ["vole", "goldeneagle"], ["gsquirrel", "fox"], ["gsquirrel", "coyote"], ["gsquirrel", "hawk"], ["gsquirrel", "goldeneagle"], ["gsquirrel", "grizzly"], ["rsquirrel", "hawk"], ["elk", "wolf"], ["elk", "grizzly"], ["elk", "lion"], ["elk", "coyote"], ["bison", "wolf"], ["bison", "grizzly"], ["pronghorn", "coyote"], ["pronghorn", "goldeneagle"], ["muledeer", "lion"], ["muledeer", "wolf"], ["muledeer", "coyote"], ["moose", "wolf"], ["moose", "grizzly"], ["beaver", "wolf"], ["trout", "otter"], ["trout", "osprey"], ["trout", "baldeagle"], ["trout", "grizzly"], ["meadowlark", "hawk"], ["wolf", "raven", "s"], ["wolf", "coyote", "s"], ["wolf", "grizzly", "s"], ["wolf", "baldeagle", "s"], ["wolf", "goldeneagle", "s"], ["sun", "algae", "r"], ["sun", "willow", "r"], ["sun", "aspen", "r"], ["sun", "grass", "r"], ["sun", "sage", "r"], ["sun", "whitebark", "r"], ["water", "algae", "r"], ["water", "willow", "r"], ["water", "aspen", "r"], ["water", "grass", "r"], ["water", "sage", "r"], ["water", "whitebark", "r"], ["soil", "willow", "r"], ["soil", "aspen", "r"], ["soil", "grass", "r"], ["soil", "sage", "r"], ["soil", "whitebark", "r"], ["decomp", "soil", "r"], ["grass", "decomp", "d"], ["aspen", "decomp", "d"], ["willow", "decomp", "d"], ["whitebark", "decomp", "d"],