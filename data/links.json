   ],
   "text": "Chilean flamingos move between high-altitude lakes on the Andean plateau, from the salt lakes of southern Bolivia to Lake Titicaca. Shallow lakes dry up and fill with the seasons.",
   "imgwiki": "Chilean flamingo"
  },
  {
   "id": "caribouwest",
   "type": "species",
   "title": "Western Arctic caribou",
   "ends": [
    {
     "eco": "npkobukvalley",
     "node": "caribou"
    },
    {
     "eco": "npgatesarctic",
     "node": "caribou"
    }
   ],
   "text": "The Western Arctic caribou herd migrates across northern Alaska and passes through both Kobuk Valley and Gates of the Arctic. Its river crossings in autumn are a major event at Kobuk.",
   "imgwiki": "Caribou"
  },
  {
   "id": "sockeye",
