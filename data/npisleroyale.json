{"id": "npisleroyale", "name": "Isle Royale National Park", "short": "Isle Royale", "place": "Michigan, USA", "lat": 48.1, "lon": -88.55, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Michigan"], "kind": "Lakes & wetlands", "park": true, "blurb": "A Lake Superior island where wolves, moose and beavers share a boreal forest.", "tip": {"id": "wolf", "title": "Remove the wolves", "text": "Wolves are the main predator of moose here. Set Gray wolf to -100% and watch moose, then the balsam fir, aspen and maple they browse."}, "sources": [{"title": "Wikipedia: Isle Royale National Park", "url": "https://en.wikipedia.org/wiki/Isle_Royale_National_Park"}, {"title": "Wikipedia: Moose", "url": "https://en.wikipedia.org/wiki/Moose"}, {"title": "Wikipedia: Gray wolf", "url": "https://en.wikipedia.org/wiki/Gray_wolf"}, {"title": "Wikipedia: American beaver", "url": "https://en.wikipedia.org/wiki/American_beaver"}, {"title": "Wikipedia: Balsam fir", "url": "https://en.wikipedia.org/wiki/Balsam_fir"}, {"title": "Wikipedia: Snowshoe hare", "url": "https://en.wikipedia.org/wiki/Snowshoe_hare"}, {"title": "Wikipedia: Wolf", "url": "https://en.wikipedia.org/wiki/Wolf"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Isle Royale National Park, Moose, Wolf). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Isle Royale National Park", "icon": "moose", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Short northern summers give the forest and the lake plants their growing season."}, {"id": "lake", "sp": "lake superior", "xh": 0.35}, {"id": "soil", "sp": "thin boreal soil", "xh": 0.6}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & bacteria", "desc": "Break down fallen leaves, wood and carcasses, returning nutrients to the thin soil."}, {"id": "fir", "sp": "abies balsamea", "xh": 0.1, "wiki": "Balsam fir", "desc": "A cold-hardy evergreen of the boreal forest. Moose browse its foliage and red squirrels eat its seeds.", "ic": "whitebark", "badge": "Foundation species"}, {"id": "aspen", "sp": "populus tremuloides", "xh": 0.3, "name": "Quaking aspen", "desc": "A fast-growing leafy tree. Moose and beavers strongly favor its shoots, bark and twigs."}, {"id": "maple", "sp": "acer spicatum", "xh": 0.5, "name": "Mountain maple", "desc": "A shrubby understory maple, also called moose maple. Moose, hares and beavers browse it.", "ic": "willow"}, {"id": "raspberry", "sp": "rubus idaeus", "xh": 0.7, "name": "Red raspberry", "ic": "sage"}, {"id": "pondweed", "sp": "potamogeton", "xh": 0.9}, {"id": "moose", "sp": "alces alces", "xh": 0.1, "wiki": "Moose", "desc": "The island's main large herbivore, thought to have arrived in the early 1900s. It browses trees and shrubs and wades for aquatic plants.", "ic": "moose"}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.25, "wiki": "American beaver", "desc": "Cuts aspen and other woody plants and dams streams into ponds and marshes, creating habitat for many species.", "badge": "Ecosystem engineer"}, {"id": "hare", "sp": "lepus americanus", "xh": 0.4, "wiki": "Snowshoe hare", "desc": "Eats green plants in summer and buds, twigs and needles in winter. Prey for many predators."}, {"id": "squirrel", "sp": "tamiasciurus hudsonicus", "xh": 0.55, "wiki": "American red squirrel", "desc": "A small conifer-seed eater of the boreal forest, taken by foxes and hawks.", "ic": "rsquirrel"}, {"id": "swallowtail", "sp": "papilio canadensis", "xh": 0.7}, {"id": "bumblebee", "sp": "bombus terricola", "xh": 0.85}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.15, "desc": "A small canid that hunts hares and rodents, takes beavers and scavenges carcasses."}, {"id": "raven", "sp": "corvus corax", "xh": 0.4, "desc": "A clever scavenger. Wolf kills attract ravens, which feed on the carcasses."}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.65, "tl": 3, "wiki": "Bald eagle", "desc": "Nests around the shoreline; takes prey such as hares and scavenges carrion."}, {"id": "hawk", "sp": "accipiter striatus", "xh": 0.88, "wiki": "Sharp-shinned hawk", "ic": "hawk"}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "desc": "The island's top predator and long-studied partner of the moose. Inbreeding left only a few wolves by 2016; 19 were brought in from 2018 to 2019.", "no": ["badge"]}], "raw": [["sun", "fir", "r"], ["soil", "fir", "r"], ["sun", "aspen", "r"], ["soil", "aspen", "r"], ["sun", "maple", "r"], ["soil", "maple", "r"], ["sun", "raspberry", "r"], ["soil", "raspberry", "r"], ["sun", "pondweed", "r"], ["lake", "pondweed", "r"], ["decomp", "soil", "r"], ["fir", "moose"], ["fir", "squirrel"], ["fir", "hare"], ["aspen", "moose"], ["aspen", "beaver"], ["aspen", "hare"], ["aspen", "swallowtail"], ["maple", "moose"], ["maple", "beaver"], ["maple", "hare"], ["raspberry", "moose"], ["raspberry", "bumblebee"], ["raspberry", "fox"], ["raspberry", "raven"], ["pondweed", "moose"], ["moose", "wolf"], ["beaver", "wolf"], ["hare", "wolf"], ["squirrel", "wolf"], ["beaver", "fox"], ["hare", "fox"], ["squirrel", "fox"], ["hare", "eagle"], ["beaver", "eagle"], ["hare", "hawk"], ["squirrel", "hawk"], ["moose", "fox", "s"], ["moose", "raven", "s"], ["moose", "eagle", "s"], ["moose", "decomp", "d"], ["wolf", "decomp", "d"], ["fir", "decomp", "d"], ["aspen", "decomp", "d"], ["hare", "decomp", "d"], ["fir", "beaver"], ["fir", "swallowtail"], ["raspberry", "swallowtail"], ["beaver", "raven"], ["hare", "raven"], ["squirrel", "raven"], ["squirrel", "eagle"], ["fox", "wolf"], ["raven", "wolf"]], "ev": {"fir>moose": ["a"], "fir>squirrel": ["g", "Tamiasciurus hudsonicus", "Abies balsamea"], "fir>hare": ["g", "Lepus americanus", "Abies balsamea"], "aspen>moose": ["gg", "Alces alces", "Po