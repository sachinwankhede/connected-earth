{"id": "whkamchatka", "name": "Volcanoes of Kamchatka", "short": "Kamchatka", "place": "Kamchatka, Russia", "lat": 56.0, "lon": 160.0, "side": "l", "cont": "Asia", "country": "Russia", "kind": "Polar & mountain", "park": true, "blurb": "Salmon, brown bears and sea eagles beneath a chain of active volcanoes.", "tip": {"id": "sockeye", "title": "Cut the salmon run", "text": "Sockeye feed bears, sea eagles, ravens and foxes. Set Sockeye salmon to -100% and watch the bear and eagle, then the scavengers."}, "sources": [{"title": "Wikipedia: Volcanoes of Kamchatka", "url": "https://en.wikipedia.org/wiki/Volcanoes_of_Kamchatka"}, {"title": "Wikipedia: Kamchatka brown bear", "url": "https://en.wikipedia.org/wiki/Kamchatka_brown_bear"}, {"title": "Wikipedia: Steller's sea eagle", "url": "https://en.wikipedia.org/wiki/Steller%27s_sea_eagle"}, {"title": "Wikipedia: Sockeye salmon", "url": "https://en.wikipedia.org/wiki/Sockeye_salmon"}, {"title": "Wikipedia: Pinus pumila", "url": "https://en.wikipedia.org/wiki/Pinus_pumila"}, {"title": "Wikipedia: Sable", "url": "https://en.wikipedia.org/wiki/Sable"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Volcanoes of Kamchatka", "icon": "fire", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Short, bright summers power a brief growing season for berries, herbs and the plankton of nearby seas."}, {"id": "ash", "sp": "volcanic ash soil", "xh": 0.5, "desc": "Frequent eruptions leave fresh ash and rock that new plants colonise, which keeps parts of the peninsula in constant renewal."}, {"id": "snow", "sp": "snowpack and meltwater", "xh": 0.8, "wiki": "Snowmelt", "desc": "Deep winter snow melts into the rivers and lakes where salmon spawn and feeds the soil moisture of alpine meadows.", "ic": "rain"}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "desc": "Break down dead plants, salmon carcasses and animal remains, returning nutrients to the volcanic soil."}, {"id": "stonepine", "sp": "pinus pumila", "xh": 0.1}, {"id": "larch", "sp": "larix gmelinii", "xh": 0.3, "name": "Gmelin larch"}, {"id": "bilberry", "sp": "vaccinium uliginosum", "xh": 0.5, "desc": "A low berry shrub of tundra and open forest. Its fruit is eaten by bears, hares, voles and birds."}, {"id": "fireweed", "sp": "chamaenerion angustifolium", "xh": 0.7, "desc": "A tall pink wildflower that quickly colonises burned and disturbed ground, such as slopes after eruptions or fires."}, {"id": "phyto", "sp": "microscopic algae", "xh": 0.9, "desc": "Drifting microscopic algae in the cold Pacific and Okhotsk seas that feed zooplankton. General ecological knowledge."}, {"id": "marmot", "sp": "marmota camtschatica", "xh": 0.06}, {"id": "sheep", "sp": "ovis nivicola", "xh": 0.2}, {"id": "hare", "sp": "lepus timidus", "xh": 0.34, "desc": "Feeds on shrubs, berries and herbs and is taken by foxes, sables and stoats."}, {"id": "vole", "sp": "myodes rufocanus", "xh": 0.5}, {"id": "nutcracker", "sp": "nucifraga caryocatactes", "xh": 0.66, "name": "Spotted nutcracker", "wiki": "Spotted nutcracker", "desc": "Harvests and caches pine seeds, helping to spread Siberian dwarf pine. Also takes small animals."}, {"id": "zoop", "sp": "copepoda", "xh": 0.86, "wiki": "Zooplankton", "desc": "Small drifting animals that graze phytoplankton and are the main food of sockeye salmon at sea."}, {"id": "sockeye", "sp": "oncorhynchus nerka", "xh": 0.1, "desc": "Kamchatka holds the largest Asian spawning grounds, notably the Ozernaya River. Adults die after spawning and feed the land."}, {"id": "sable", "sp": "martes zibellina", "xh": 0.3, "desc": "A small omnivorous marten that eats rodents, hares, birds and berries."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.5, "desc": "Hunts voles, hares and birds, eats berries, and scavenges carcasses."}, {"id": "raven", "sp": "corvus corax", "xh": 0.72, "desc": "An opportunist that scavenges carrion, such as salmon left on riverbanks."}, {"id": "bear", "sp": "ursus arctos beringianus", "xh": 0.28}, {"id": "eagle", "sp": "haliaeetus pelagicus", "xh": 0.65}], "raw": [["sun", "stonepine", "r"], ["ash", "stonepine", "r"], ["sun", "larch", "r"], ["ash", "larch", "r"], ["sun", "bilberry", "r"], ["ash", "bilberry", "r"], ["sun", "fireweed", "r"], ["ash", "fireweed", "r"], ["sun", "phyto", "r"], ["snow", "bilberry", "r"], ["snow", "fireweed", "r"], ["decomp", "ash", "r"], ["bilberry", "vole"], ["bilberry", "hare"], ["bilberry", "bear"], ["bilberry", "sable"], ["bilberry", "fox"], ["bilberry", "raven"], ["stonepine", "nutcracker"], ["stonepine", "bear"], ["larch", "hare"], ["fireweed", "marmot"], ["fireweed", "sheep"], ["phyto", "zoop"], ["zoop", "sockeye"], ["sockeye", "bear"], ["sockeye", "eagle"], ["sockeye", "raven", "s"], ["sockeye", "fox", "s"], ["vole", "sable"], ["vole", "fox"], ["vole", "bear"], ["hare", "sable"], ["hare", "fox"], ["marmot", "bear"], ["marmot", "fox"], ["nutcracker", "sable"], ["sheep", "bear", "s"], ["sheep", "raven", "s"], ["stonepine", "decomp", "d"], ["larch", "decomp", "d"], ["bilberry", "decomp", "d"], ["fireweed", "decomp", "d"], ["phyto", "decomp", "d"], ["marmot", "decomp", "d"], ["sheep", "decomp", "d"], ["hare", "decomp", "d"], ["vole", "decomp", "d"], ["nutcracker", "decomp", "d"], ["zoop", "decomp", "d"], ["sockeye", "decomp", "d"], ["sable", "decomp", "d"], ["fox", "decomp", "d"], ["raven", "decomp", "d"], ["bear", "decomp", "d"], ["eagle", "decomp", "d"], ["nutcracker", "fox"], ["hare", "raven"], ["vole", "raven"], ["nutcracker", "raven"], ["fox", "bear"]], "link_ideas": [{"kind": "flow", "with": "North Pacific Ocean", "what": "Sockeye grow at sea and return to Kamchatka rivers to spawn.", "evidence_url": "https://en.wikipedia.org/wiki/Sockeye_salmon"}], "ev": {"bilberry>vole": ["g", "Myod