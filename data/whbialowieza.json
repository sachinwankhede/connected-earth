 "icon": "bison",
 "tier": "overview",
 "nodes": [
  {
   "id": "sun",
   "name": "Sunlight",
   "latin": "",
   "tl": 0,
   "xh": 0.08,
   "cat": "abiotic",
   "wiki": "Sun",
   "desc": "Light reaching the forest floor is limited by the canopy, so gaps left by fallen trees let shrubs and young trees grow.",
   "ic": "sun"
  },
  {
   "id": "water",
   "name": "Wet river valleys and meadows",
   "latin": "",
   "tl": 0,
   "xh": 0.32,
   "cat": "abiotic",
   "wiki": "Wetland",
   "desc": "The forest sits on the Baltic-Black Sea watershed and holds river valleys and wetlands. UNESCO notes that wet meadows need continued water flow and management.",
   "ic": "water"
  },
  {
   "id": "dwsoil",
   "name": "Deadwood and forest soil",
   "latin": "",
   "tl": 0,
   "xh": 0.58,
   "cat": "abiotic",
   "wiki": "Dead wood",
   "desc": "Almost half the forest wood is dead, far more than in managed forests, and it slowly returns nutrients to the soil.",
   "ic": "soil"
  },
  {
   "id": "oak",
   "name": "Pedunculate oak",
   "latin": "Quercus robur",
   "tl": 1,
   "xh": 0.12,
   "wiki": "Quercus robur",
   "desc": "Giant old oaks, some individually named, grow in the forest. Their acorns and shoots feed boar, deer and voles.",
   "ic": "willow",
   "badge": "Foundation species"
  },
  {
   "id": "hornbeam",
   "name": "Hornbeam",
   "latin": "Carpinus betulus",
   "tl": 1,
   "xh": 0.3,
   "wiki": "Carpinus betulus",
   "desc": "A common broadleaf tree of the mixed forest, recorded often in the area. Its shoots and bark are browsed by deer and bison.",
   "ic": "willow"
  },
  {
   "id": "spruce",
   "name": "Norway spruce",
   "latin": "Picea abies",
   "tl": 1,
   "xh": 0.48,
   "wiki": "Picea abies",
   "desc": "A widespread conifer of the forest. Its seeds feed squirrels and its bark is where spruce bark beetles breed.",
   "ic": "whitebark"
  },
  {
   "id": "bilberry",
   "name": "Bilberry",
   "latin": "Vaccinium myrtillus",
   "tl": 1,
   "xh": 0.68,
   "wiki": "Bilberry",
   "desc": "A low forest-floor shrub whose leaves and berries are eaten by deer and voles.",
   "ic": "sage"
  },
  {
   "id": "marsh",
   "name": "Marsh bedstraw and meadow plants",
   "latin": "Galium palustre",
   "tl": 1,
   "xh": 0.87,
   "wiki": "Galium palustre",
   "desc": "Plants of damp meadows and forest edges, grazed by bison, red deer and wild boar in GloBI records.",
   "ic": "grass"
  },
  {
   "id": "bison",
   "name": "European bison",
   "latin": "Bison bonasus",
   "tl": 2,
   "xh": 0.06,
   "wiki": "European bison",
   "desc": "Europe's heaviest land animal eats grasses, herbs and tree bark and leaves. The forest holds the largest free-living herd, restored after reintroduction in 1929.",
   "ic": "bison",
   "badge": "Keystone grazer"
  },
  {
   "id": "reddeer",
   "name": "Red deer",
   "latin": "Cervus elaphus",
   "tl": 2,
   "xh": 0.2,
   "wiki": "Red deer",
   "desc": "Reintroduced to the forest in the 1890s after local extinction. It eats bilberry, young trees and meadow plants and is a main prey of wolves.",
   "ic": "elk"
  },
  {
   "id": "roe",
   "name": "Roe deer",
   "latin": "Capreolus capreolus",
   "tl": 2,
   "xh": 0.34,
   "wiki": "Roe deer",
   "desc": "A small browsing deer that eats shoots and leaves of oak, spruce and bilberry. It is a favoured prey of lynx where common.",
   "ic": "muledeer"
  },
  {
   "id": "boar",
   "name": "Wild boar",
   "latin": "Sus scrofa",
   "tl": 2,
   "xh": 0.48,
   "wiki": "Wild boar",
   "desc": "An omnivore that eats acorns, roots, small animals and carrion, rooting up the forest floor. Prey of wolves.",
   "ic": "quad"
  },
  {
   "id": "vole",
   "name": "Bank vole",
   "latin": "Myodes glareolus",
   "tl": 2,
   "xh": 0.62,
   "wiki": "Bank vole",
   "desc": "The most recorded mammal near the forest. It eats seeds, berries and herbs, and feeds foxes and owls.",
   "ic": "vole"
  },
  {
   "id": "squirrel",
   "name": "Red squirrel",
   "latin": "Sciurus vulgaris",
   "tl": 2,
   "xh": 0.76,
   "wiki": "Red squirrel",
   "desc": "Eats conifer seeds, nuts and buds in the canopy, and is taken by foxes and lynx.",
   "ic": "rsquirrel"
  },
  {
   "id": "beetle",
   "name": "European spruce bark beetle",
   "latin": "Ips typographus",
   "tl": 2,
   "xh": 0.91,
   "wiki": "European spruce bark beetle",
   "desc": "A bark beetle that breeds under spruce bark and mainly attacks Norway spruce. Woodpeckers strip bark to reach its larvae.",
   "ic": "hopper"
  },
  {
   "id": "fox",
   "name": "Red fox",
   "latin": "Vulpes vulpes",
   "tl": 3,
   "xh": 0.14,
   "wiki": "Red fox",
   "desc": "A flexible hunter of voles, birds and young deer, widely recorded in the area. Wolves and lynx can kill it.",
   "ic": "fox"
  },
  {
   "id": "woodpecker",
   "name": "White-backed woodpecker",
   "latin": "Dendrocopos leucotos",
   "tl": 3,
   "xh": 0.4,
   "wiki": "White-backed woodpecker",
   "desc": "Feeds mainly on wood-boring beetles and larvae and needs plenty of standing and fallen dead wood in mature broadleaf forest.",
   "ic": "meadowlark"
  },
  {
   "id": "raven",
   "name": "Common raven",
   "latin": "Corvus corax",
   "tl": 3,
   "xh": 0.62,
   "wiki": "Common raven",
   "desc": "A scavenger drawn to carcasses and wolf-kill sites, feeding on what large predators leave behind.",
   "ic": "raven"
  },
  {
   "id": "owl",
   "name": "Tawny owl",
   "latin": "Strix aluco",
   "tl": 3,
   "xh": 0.85,
   "wiki": "Tawny owl",
   "desc": "A woodland owl hunting small mammals such as voles at night.",
   "ic": "hawk"
  },
  {
   "id": "wolf",
   "name": "Grey wolf",
   "latin": "Canis lupus",
   "tl": 4,
   "xh": 0.3,
   "wiki": "Gray wolf",
   "desc": "Hunts red deer, roe deer and wild boar, and occasionally bison. The forest is large enough to hold viable wolf populations, UNESCO notes.",
   "ic": "wolf",
   "badge": "Keystone predator"
  },
  {
   "id": "lynx",
   "name": "Eurasian lynx",
   "latin": "Lynx lynx",
   "tl": 4,
   "xh": 0.7,
   "wiki": "Eurasian lynx",
   "desc": "Prefers roe deer where common, and also takes hares, squirrels and foxes. Wolves compete with it and can suppress its numbers.",
   "ic": "lion"
  },
  {
   "id": "decomp",
   "name": "Fungi and decomposers",
   "latin": "Decomposer community",
   "tl": 0,
   "xh": 0.9,
   "cat": "decomp",
   "wiki": "Decomposer",
   "desc": "Fungi, bacteria and wood-eating insects break down fallen trunks and carcasses. The forest is notable for its fungi.",
   "ic": "decomp"
  }
 ],
