us"], "ficus>bluem": ["gg", "Cercopithecus mitis", "Ficus"], "ficus>turaco": ["gg", "Corythaeola cristata", "Ficus"], "ficus>elephant": ["gg", "Loxodonta", "Ficus"], "ficus>duiker": ["gg", "Cephalophus nigrifrons", "Ficus"], "galium>gorilla": ["a"], "galium>duiker": ["a"], "galium>elephant": ["a"], "lantana>bluem": ["g", "Cercopithecus mitis", "Lantana camara"], "lantana>guereza": ["g", "Colobus guereza", "Lantana camara"], "lantana>papilio": ["g", "Papilio", "Lantana camara"], "papilio>frog": ["a"], "papilio>cham": ["a"], "bluem>chimp": ["a"], "guereza>chimp": ["a"], "duiker>leopard": ["g", "Panthera pardus", "Cephalophus nigrifrons"], "bluem>leopard": ["g", "Panthera pardus", "Cercopithecus mitis"], "guereza>leopard": ["gg", "Panthera pardus", "Colobus guereza"], "chimp>leopard": ["g", "Panthera pardus", "Pan troglodytes"], "gorilla>leopard": ["gg", "Panthera pardus", "Gorilla beringei"], "bluem>eagle": ["a"], "guereza>eagle": ["gg", "Stephanoaetus coronatus", "Colobus guereza"], "duiker>eagle": ["a"], "lantana>elephant": ["ga", "Loxodonta", "Lantana camara"]}, "story": "Bwindi Impenetrable National Park in southwestern Uganda covers 321 square kilometres of lowland and montane forest, reached only on foot. It holds 120 mammal species, 350 birds and more than 1,000 flowering plants. About 400 mountain gorillas live here, half the world's population.", "matters": "It is one of the most diverse forests in East Africa. Fourteen gorilla groups live in four sectors of the park."}