{"id": "npwhitesands", "name": "White Sands National Park", "short": "White Sands", "place": "New Mexico, USA", "lat": 32.78, "lon": -106.17, "side": "r", "cont": "North America", "country": "United States of America", "states": ["New Mexico"], "kind": "Desert", "park": true, "blurb": "Gypsum dunes where seeds feed kangaroo rats and the rats feed the hunters.", "tip": {"id": "rain", "title": "Skip the monsoon", "text": "Summer rain grows the seed-bearing grasses. Cut Monsoon rain by 70% and watch sacaton, the kangaroo rats and the snakes, foxes and coyotes that eat them."}, "sources": [{"title": "Wikipedia: White Sands National Park", "url": "https://en.wikipedia.org/wiki/White_Sands_National_Park"}, {"title": "National Park Service: White Sands animals", "url": "https://www.nps.gov/whsa/learn/nature/animals.htm"}, {"title": "Wikipedia: Merriam's kangaroo rat", "url": "https://en.wikipedia.org/wiki/Merriam%27s_kangaroo_rat"}, {"title": "Wikipedia: Kit fox", "url": "https://en.wikipedia.org/wiki/Kit_fox"}, {"title": "Wikipedia: Western diamondback rattlesnake", "url": "https://en.wikipedia.org/wiki/Western_diamondback_rattlesnake"}, {"title": "Wikipedia: Common lesser earless lizard", "url": "https://en.wikipedia.org/wiki/Holbrookia_maculata"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "White Sands National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Intense desert sun drives plant growth and heats the pale dunes through the long summer."}, {"id": "rain", "sp": "monsoon rain", "xh": 0.35, "wiki": "North American monsoon", "desc": "Rain is scarce, and summer storms give the grasses and shrubs their main pulse of growth. Plants and animals here store or conserve water."}, {"id": "groundwater", "sp": "shallow salty groundwater", "xh": 0.6}, {"id": "gypsum", "sp": "gypsum sand", "xh": 0.85}, {"id": "sacaton", "sp": "sporobolus airoides", "xh": 0.1}, {"id": "yucca", "sp": "yucca elata", "xh": 0.35}, {"id": "saltbush", "sp": "atriplex canescens", "xh": 0.6, "desc": "A salt-tolerant shrub of dry, alkaline ground that gives browse and cover.", "ic": "sage"}, {"id": "mesquite", "sp": "prosopis glandulosa", "xh": 0.85}, {"id": "merriam", "sp": "dipodomys merriami", "xh": 0.06, "desc": "A nocturnal seed eater that stores seeds in burrow chambers and rarely drinks. A key prey species for many desert predators."}, {"id": "ord", "sp": "dipodomys ordii", "xh": 0.2, "desc": "A nocturnal seed eater of sandy ground, like its relatives. Snake and owl prey.", "ic": "vole"}, {"id": "harvest", "sp": "reithrodontomys megalotis", "xh": 0.34, "wiki": "Western harvest mouse", "ic": "vole"}, {"id": "gopher", "sp": "geomys arenarius", "xh": 0.48}, {"id": "hopper", "sp": "acrididae", "xh": 0.62}, {"id": "gemsbok", "sp": "oryx gazella", "xh": 0.78, "desc": "A large antelope from southern Africa that was introduced to southern New Mexico and now roams the basin. It grazes grasses and shrubs.", "ic": "pronghorn"}, {"id": "earless", "sp": "holbrookia maculata", "xh": 0.06}, {"id": "mouse", "sp": "onychomys arenicola", "xh": 0.2, "name": "Chihuahuan grasshopper mouse", "desc": "A small carnivorous mouse that hunts insects and other small animals at night."}, {"id": "shrike", "sp": "lanius ludovicianus", "xh": 0.34}, {"id": "rattler", "sp": "crotalus atrox", "xh": 0.48, "desc": "An ambush hunter that feeds mostly on small mammals such as kangaroo rats, plus some lizards and birds. It occasionally scavenges."}, {"id": "kitfox", "sp": "vulpes macrotis", "xh": 0.64}, {"id": "raven", "sp": "corvus cryptoleucus", "xh": 0.82}, {"id": "coyote", "sp": "canis latrans", "xh": 0.3, "wiki": "Coyote", "desc": "The park lists coyotes among the carnivores that hunt rodents and rabbits. Also scavenges carrion.", "badge": "Keystone predator"}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.7, "wiki": "Red-tailed hawk", "desc": "A soaring raptor that hunts rodents, snakes, lizards and birds over open ground.", "ic": "hawk"}, {"id": "decomp", "sp": "decomposer community", "xh": 0.97, "name": "Fungi, insects & bacteria", "desc": "Break down dead plants and animals and return nutrients to the thin desert soil."}], "raw": [["rain", "sacaton", "r"], ["rain", "yucca", "r"], ["rain", "saltbush", "r"], ["sun", "sacaton", "r"], ["sun", "yucca", "r"], ["groundwater", "sacaton", "r"], ["groundwater", "saltbush", "r"], ["groundwater", "mesquite", "r"], ["gypsum", "sacaton", "r"], ["gypsum", "saltbush", "r"], ["decomp", "gypsum", "r"], ["sacaton", "merriam"], ["sacaton", "ord"], ["sacaton", "harvest"], ["sacaton", "gopher"], ["sacaton", "hopper"], ["sacaton", "gemsbok"], ["saltbush", "gemsbok"], ["merriam", "rattler"], ["ord", "rattler"], ["harvest", "rattler"], ["gopher", "rattler"], ["merriam", "coyote"], ["harvest", "coyote"], ["gopher", "coyote"], ["mouse", "coyote"], ["merriam", "hawk"], ["harvest", "hawk"], ["rattler", "hawk"], ["shrike", "hawk"], ["merriam", "kitfox"], ["hopper", "earless"], ["hopper", "mouse"], ["hopper", "shrike"], ["hopper", "raven"], ["earless", "shrike"], ["earless", "kitfox"], ["rattler", "coyote"], ["gemsbok", "coyote", "s"], ["gemsbok", "raven", "s"], ["sacaton", "decomp", "d"], ["yucca", "decomp", "d"], ["mesquite", "decomp", "d"], ["saltbush", "decomp", "d"], ["coyote", "decomp", "d"], ["gemsbok", "decomp", "d"], ["merriam", "decomp", "d"], ["hawk", "decomp", "d"], ["harvest", "kitfox"], ["hopper", "coyote"], ["hopper", "hawk"]], "ev": {"sacaton>merriam": ["a"], "sacaton>ord": ["a"], "sacaton>harvest": ["a"], "sacaton>gopher": ["a"], "sacaton>hopper": ["a"], "sacaton>gemsbok": ["a"], "saltbush>gemsbok": ["a"], "merriam>rattler": ["g", "Crotalus atrox", "Dipodomys merriami"], "ord>rattler": ["g", "Crotalus atrox", "Dipodomys ordii