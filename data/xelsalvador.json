{"id": "xelsalvador", "name": "El Imposible National Park", "short": "El Imposible", "place": "El Salvador", "lat": 13.84, "lon": -89.96, "side": "r", "cont": "North America", "country": "El Salvador", "kind": "Forest", "park": true, "blurb": "Wet mountain forest where fruit trees feed bats and birds, and pumas hunt.", "tip": {"id": "rain", "title": "Take away the rains", "text": "Rain keeps the forest plants growing. Set Seasonal rain to -100% and watch the fruit plants fail, then the bats, birds and the cats above them."}, "sources": [{"title": "Wikipedia: El Imposible National Park", "url": "https://en.wikipedia.org/wiki/El_Imposible_National_Park"}, {"title": "Wikipedia: Oncilla", "url": "https://en.wikipedia.org/wiki/Oncilla"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}, {"title": "Wikipedia: Jamaican fruit bat", "url": "https://en.wikipedia.org/wiki/Jamaican_fruit_bat"}, {"title": "Wikipedia: Turkey vulture", "url": "https://en.wikipedia.org/wiki/Turkey_vulture"}, {"title": "Wikipedia: Boa constrictor", "url": "https://en.wikipedia.org/wiki/Boa_constrictor"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "El Imposible National Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light reaching the forest canopy powers the growth of the trees and shrubs that feed the whole web."}, {"id": "rain", "sp": "seasonal rain", "xh": 0.3, "desc": "Rain feeds the rivers of the watershed and keeps this tropical mountain forest wet enough for lush plant growth."}, {"id": "soil", "sp": "forest soil nutrients", "xh": 0.55, "desc": "Nutrients in the soil of the volcanic mountain slopes are taken up by the roots of forest plants."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "desc": "Break down fallen leaves, fruit and dead animals, returning nutrients to the soil."}, {"id": "milkberry", "sp": "chiococca alba", "xh": 0.2}, {"id": "guarea", "sp": "guarea glabra", "xh": 0.5}, {"id": "waxmallow", "sp": "malvaviscus arboreus", "xh": 0.8, "desc": "A shrub with red tubular flowers and fleshy fruit. Manakins and thrushes are recorded eating the fruit."}, {"id": "fruitbat", "sp": "artibeus jamaicensis", "xh": 0.06, "desc": "A fruit-eating bat that carries fruit to a roost and so spreads seeds. Boa constrictors are among its listed predators."}, {"id": "manakin", "sp": "chiroxiphia linearis", "xh": 0.19}, {"id": "thrush", "sp": "turdus grayi", "xh": 0.32}, {"id": "dove", "sp": "leptotila verreauxi", "xh": 0.46}, {"id": "squirrel", "sp": "sciurus deppei", "xh": 0.6}, {"id": "mouse", "sp": "peromyscus mexicanus", "xh": 0.74}, {"id": "hopper", "sp": "tropidacris cristata", "xh": 0.88}, {"id": "boa", "sp": "boa imperator", "xh": 0.07, "name": "Central American boa", "wiki": "Boa imperator", "desc": "A constrictor that eats mammals, lizards and birds. GloBI records Jamaican fruit bats as prey."}, {"id": "cuckoo", "sp": "piaya cayana", "xh": 0.23}, {"id": "ameiva", "sp": "holcosus undulatus", "xh": 0.39}, {"id": "motmot", "sp": "momotus lessonii", "xh": 0.55}, {"id": "tvulture", "sp": "cathartes aura", "xh": 0.72, "name": "Turkey vulture", "wiki": "Turkey vulture", "desc": "Feeds almost entirely on carrion, finding it largely by smell, and so helps clear dead animals from the forest."}, {"id": "bvulture", "sp": "coragyps atratus", "xh": 0.88, "wiki": "Black vulture", "desc": "A scavenger that feeds on carcasses and often crowds out turkey vultures at a carcass."}, {"id": "puma", "sp": "puma concolor", "xh": 0.3, "desc": "Named among the large predators of El Imposible. In El Salvador it has been recorded in montane forest, and it hunts small to medium mammals."}, {"id": "oncilla", "sp": "leopardus tigrinus", "xh": 0.7}], "raw":