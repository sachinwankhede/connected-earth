{"id": "whvatnajokull", "name": "Vatnajökull National Park", "short": "Vatnajökull", "place": "Iceland", "lat": 64.4, "lon": -16.8, "side": "l", "cont": "Europe", "country": "Iceland", "kind": "Polar & mountain", "park": true, "blurb": "Ice cap, outwash plains and a glacial lagoon where seals, terns and skuas hunt.", "tip": {"id": "herring", "title": "Remove the herring", "text": "Tides bring herring into the glacial lagoon. Set Atlantic herring to -100% and watch seals, terns and skuas, and the Arctic fox that preys on tern."}, "sources": [{"title": "Wikipedia: Vatnajökull National Park", "url": "https://en.wikipedia.org/wiki/Vatnaj%C3%B6kull_National_Park"}, {"title": "Wikipedia: Jökulsárlón", "url": "https://en.wikipedia.org/wiki/J%C3%B6kuls%C3%A1rl%C3%B3n"}, {"title": "Wikipedia: Arctic fox", "url": "https://en.wikipedia.org/wiki/Arctic_fox"}, {"title": "Wikipedia: Great skua", "url": "https://en.wikipedia.org/wiki/Great_skua"}, {"title": "Wikipedia: Pink-footed goose", "url": "https://en.wikipedia.org/wiki/Pink-footed_goose"}, {"title": "Wikipedia: Reindeer", "url": "https://en.wikipedia.org/wiki/Reindeer"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Vatnajökull National Park", "icon": "ice", "tier": "overview", "nodes": [{"id": "sun", "sp": "midsummer daylight", "xh": 0.1}, {"id": "ice", "sp": "vatnajökull ice cap", "xh": 0.3}, {"id": "melt", "sp": "glacial meltwater", "xh": 0.5, "desc": "Silty rivers and lakes fed by melting ice shape the lowlands, lay down outwash sands and feed the lagoon at the glacier edge."}, {"id": "soil", "sp": "outwash sands and volcanic soil", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Soil microbes and fungi", "desc": "Break down dead plants, droppings and carcasses, returning nutrients to the thin soil."}, {"id": "crowberry", "sp": "empetrum nigrum", "xh": 0.12, "desc": "A low evergreen heath shrub with black berries, widespread on Icelandic moors and eaten by reindeer, ptarmigan and snow buntings."}, {"id": "bilberry", "sp": "vaccinium uliginosum", "xh": 0.28, "desc": "A dwarf heath shrub whose leaves and berries are food for reindeer, ptarmigan and small birds."}, {"id": "willow", "sp": "salix lanata", "xh": 0.44}, {"id": "bistort", "sp": "bistorta vivipara", "xh": 0.6, "desc": "A small tundra flower with edible leaves and bulbils, eaten by geese and ptarmigan."}, {"id": "phyto", "sp": "microscopic algae", "xh": 0.82, "desc": "Drifting microscopic algae in the sea and glacial lagoon that feed small crustaceans and fish. General ecological knowledge."}, {"id": "reindeer", "sp": "rangifer tarandus", "xh": 0.08, "name": "Reindeer", "desc": "Introduced to Iceland in the 18th century, the East Iceland herd grazes heath and highland plants, with lichen a winter staple."}, {"id": "goose", "sp": "anser brachyrhynchus", "xh": 0.22}, {"id": "ptarmigan", "sp": "lagopus muta", "xh": 0.36, "desc": "A hardy grouse that stays all year and eats shoots, buds, leaves and berries of heath plants."}, {"id": "bunting", "sp": "plectrophenax nivalis", "xh": 0.5}, {"id": "midge", "sp": "chironomidae", "xh": 0.64, "name": "Non-biting midges", "desc": "Their larvae live in lake and river mud on algae and detritus, and are food for fish. General ecological knowledge."}, {"id": "herring", "sp": "clupea harengus", "xh": 0.82, "tl": 2, "desc": "Tides carry herring from the sea into Jökulsárlón, where seals, terns and skuas feed on them."}, {"id": "char", "sp": "salvelinus alpinus", "xh": 0.1, "desc": "A cold-water fish of Icelandic lakes and rivers that feeds largely on insect larvae and other small invertebrates."}, {"id": "raven", "sp": "corvus corax", "xh": 0.3, "desc": "A clever omnivore and scavenger that takes carrion as well as berries and other plant food."}, {"id": "tern", "sp": "sterna paradisaea", "xh": 0.5}, {"id": "skua", "sp": "stercorarius skua", "xh": 0.68}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.88, "name": "Harbour seal", "wiki": "Harbour seal", "desc": "Gathers at the mouth of Jökulsárlón, especially in winter, to hunt fish brought in by the tide."}, {"id": "fox", "sp": "vulpes lagopus", "xh": 0.45, "tl": 4, "desc": "Iceland's only native land mammal, a mostly bird-eating predator that also scavenges carcasses.", "badge": "Keystone predator"}], "raw": [["crowberry", "reindeer"], ["bilberry", "reindeer"], ["willow", "reindeer"], ["crowberry", "ptarmigan"], ["bilberry", "ptarmigan"], ["willow", "ptarmigan"], ["bistort", "ptarmigan"], ["bistort", "goose"], ["crowberry", "goose"], ["crowberry", "bunting"], ["bilberry", "bunting"], ["crowberry", "raven"], ["bilberry", "raven"], ["phyto", "herring"], ["phyto", "midge"], ["midge", "char"], ["herring", "tern"], ["herring", "skua"], ["herring", "seal"], ["goose", "fox"], ["ptarmigan", "fox"], ["bunting", "fox"], ["tern", "fox"], ["tern", "skua"], ["bunting", "skua"], ["ptarmigan", "skua"], ["sun", "crowberry", "r"], ["sun", "bilberry", "r"], ["sun", "willow", "r"], ["sun", "bistort", "r"], ["sun", "phyto", "r"], ["melt", "willow", "r"], ["melt", "bistort", "r"], ["melt", "phyto", "r"], ["ice", "melt", "r"], ["soil", "crowberry", "r"], ["soil", "bilberry", "r"], ["soil", "willow", "r"], ["soil", "bistort", "r"], ["decomp", "soil", "r"], ["reindeer", "fox", "s"], ["reindeer", "raven", "s"], ["fox", "raven", "s"], ["crowberry", "decomp", "d"], ["bilberry", "decomp", "d"], ["willow", "decomp", "d"], ["bistort", "decomp", "d"], ["phyto", "decomp", "d"], ["reindeer", "decomp", "d"], ["goose", "decomp", "d"], ["ptarmigan", "decomp", "d"], ["bunting", "decomp", "d"], ["midge", "decomp", "d"], ["herring", "decomp", "d"], ["char", "decomp", "d"], ["raven", "decomp", "d"], ["tern", "decomp", "d"], ["skua", "decomp", "d"], ["seal", "decomp", "d"], ["fox", "decom