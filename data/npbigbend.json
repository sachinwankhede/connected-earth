{"id": "npbigbend", "name": "Big Bend National Park", "short": "Big Bend", "place": "Texas, USA", "lat": 29.25, "lon": -103.25, "side": "l", "cont": "North America", "country": "United States of America", "states": ["Texas"], "kind": "Desert", "park": true, "blurb": "Cactus, javelina and cougars where the Rio Grande bends through the Chihuahuan Desert.", "tip": {"id": "rain", "title": "Cut the rain", "text": "Rain is scarce here. Set Scarce rain to -60% and watch desert grasses and prickly pear fall, then the seed eaters, deer and the predators that hunt them."}, "sources": [{"title": "Wikipedia: Big Bend National Park", "url": "https://en.wikipedia.org/wiki/Big_Bend_National_Park"}, {"title": "National Park Service: Big Bend mammals", "url": "https://www.nps.gov/bibe/learn/nature/mammals.htm"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}, {"title": "Wikipedia: Collared peccary", "url": "https://en.wikipedia.org/wiki/Collared_peccary"}, {"title": "Wikipedia: Merriam's kangaroo rat", "url": "https://en.wikipedia.org/wiki/Merriam%27s_kangaroo_rat"}, {"title": "Wikipedia: Turkey vulture", "url": "https://en.wikipedia.org/wiki/Turkey_vulture"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Big Bend National Park, Cougar, Collared peccary). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Big Bend National Park", "icon": "sage", "tier": "overview", "nodes": [{"id": "creosote", "sp": "larrea tridentata", "xh": 0.1, "desc": "A common evergreen desert shrub of the Chihuahuan Desert flats. Its flowers feed bees, and GloBI records show honey bees and other insects using it.", "ic": "sage"}, {"id": "lechuguilla", "sp": "agave lechuguilla", "xh": 0.3}, {"id": "pricklypear", "sp": "opuntia phaeacantha", "xh": 0.5}, {"id": "grama", "sp": "bouteloua", "xh": 0.7, "wiki": "Bouteloua"}, {"id": "bee", "sp": "apis mellifera", "xh": 0.06, "wiki": "Western honey bee", "desc": "Collects nectar and pollen from desert flowers such as creosote and prickly pear. Roadrunners and bears also eat honey bees in GloBI records.", "ic": "hopper"}, {"id": "kangrat", "sp": "dipodomys merriami", "xh": 0.22, "desc": "Eats mostly seeds and stores them in its burrow. It rarely drinks, getting water from its food and its humid burrow."}, {"id": "cottontail", "sp": "sylvilagus audubonii", "xh": 0.38, "wiki": "Desert cottontail", "desc": "A rabbit of open desert scrub that grazes on grasses and other plants. Coyotes, foxes and rattlesnakes hunt it."}, {"id": "dove", "sp": "zenaida asiatica", "xh": 0.54, "wiki": "White-winged dove", "desc": "One of the most commonly recorded birds in the park area. It eats seeds and fruit and is taken by coyotes."}, {"id": "peccary", "sp": "pecari tajacu", "xh": 0.7, "desc": "Also called javelina. Its main foods are agaves and prickly pears, and its predators include cougars and coyotes."}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.86, "wiki": "White-tailed deer", "desc": "The park's main hoofed prey. Cougar hunting centres on deer, and coyotes eat them too. A small Chisos Mountains population is well known."}, {"id": "raven", "sp": "corvus corax", "xh": 0.08, "wiki": "Common raven", "desc": "A clever omnivore that scavenges carcasses. It is one of the most frequently recorded birds in the park area."}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.24, "wiki": "Turkey vulture", "desc": "Eats almost only carrion and finds it by smell. Recorded far more than any other species near the park, it cleans up dead animals."}, {"id": "roadrunner", "sp": "geococcyx californianus", "xh": 0.4}, {"id": "rattler", "sp": "crotalus atrox", "xh": 0.56, "wiki": "Western diamondback rattlesnake", "desc": "Ambush predator of rodents, rabbits and birds. Young snakes are eaten by roadrunners, and coyotes also take it.", "ic": "snake"}, {"id": "fox", "sp": "urocyon cinereoargenteus", "xh": 0.72, "wiki": "Gray fox", "desc": "A small omnivorous canid seen near campsites at night. Eats rodents, rabbits and fruit."}, {"id": "bear", "sp": "ursus americanus", "xh": 0.9, "name": "American black bear", "tl": 3, "wiki": "American black bear", "desc": "Lives in the Chisos Mountains. An omnivore that eats deer, small rodents and bee nests, and often steals cougar kills."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.35, "name": "Cougar", "desc": "Roughly two dozen live in the park. Deer are its chief prey, with peccaries also taken. When big prey is scarce it eats smaller animals.", "badge": "Keystone predator"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.65, "wiki": "Coyote", "desc": "The most widespread predator, with GloBI records of it eating deer, peccary, rabbits, rodents, birds and rattlesnakes."}, {"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Strong desert sun drives plant growth, but it also dries the land and heats it, so most animals are active at dawn, dusk or night."}, {"id": "rain", "sp": "scarce rain", "xh": 0.3}, {"id": "rio", "sp": "rio grande & springs", "xh": 0.52}, {"id": "soil", "sp": "desert soil", "xh": 0.74}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Soil microbes & fungi"}], "raw": [["creosote", "bee"], ["pricklypear", "bee"], ["pricklypear", "peccary"], ["lechuguilla", "peccary"], ["pricklypear", "deer"], ["grama", "deer"], ["grama", "cottontail"], ["grama", "kangrat"], ["grama", "dove"], ["bee", "roadrunner"], ["bee", "bear"], ["kangrat", "coyote"], ["kangrat", "fox"], ["kangrat", "rattler"], ["kangrat", "roadrunner"], ["kangrat", "bear"], ["cottontail", "coyote"], ["cottontail", "fox"], ["cottontail", "rattler"], ["cottontail", "cougar"], ["dove", "coyote"], ["peccary", "cougar"], ["peccary", "coyote"], ["deer", "cougar"], ["deer", "coyote"], ["deer", "bear"], ["rattler", "roadrunner"], ["rattler", "coyote"], ["cottontail", "vulture"], ["cottontail", "raven"], ["deer", "vulture", "s"], ["peccary", "vulture", "s"], ["deer", "raven", "s"], ["peccary", "raven", "s"], ["cougar", "bear", "s"], ["sun", "creosote", "r"], ["rain", "creosote", "r"], ["soil", "creosote", "r"], ["sun", "lechuguilla", "r"], ["rain", "lechuguilla", "r"], ["soil", "lechuguilla", "r"], ["sun", "pricklypear", "r"], ["rain", "pricklypear", "r"], ["soil", "pricklypear", "r"], ["sun", "grama", "r"], ["rain", "grama", "r"], ["soil", "grama", "r"], ["rio", "grama", "r"], ["decomp", "soil", "r"], ["creosote", "decomp", "d"], ["lechuguilla", "decomp", "d"], ["pricklypear", "decomp", "d"], ["grama", "decomp", "d"], ["deer", "decomp", "d"], ["peccary", "decomp", "d"], ["kangrat", "decomp", "d"], ["cottontail", "decomp", "d"], ["cougar", "decomp", "d"], ["coyote", "decomp", "d"], ["vulture", "decomp", "d"], ["raven", "decomp", "d"], ["rattler", "decomp", "d"], ["fox", "decomp", "d"], ["bear", "decomp", "d"], ["roadrunner", "decomp", "d"], ["dove", "decomp", "d"], ["bee", "decomp", "d"], ["creosote", "dove"], ["dove", "vulture"], ["cottontail", "roadrunner"], ["deer", "roadrunner"], ["dove", "rattler"], ["peccary", "fox"], ["deer", "fox"], ["fox", "cougar"], ["bear", "cougar"], ["raven", "coyote"], ["fox", "coyote"], ["bear", "coyote"]], "ev": {"creosote>bee": ["g", "Apis mellifera", "Larrea tridentata"], "pricklypear>bee": ["g", "Apis mellifera", "Opuntia phaeacantha"], "pricklypear>peccary": ["a"], "lechuguilla>peccary": ["a"], "pricklypear>deer": ["gg", "Odocoileus virginianus", "Opuntia phaeacantha"], "grama>deer": ["a"], "grama>cottontail": ["a"], "grama>kangrat": ["a"], "grama>dove": ["a"], "bee>roadrunner": ["g", "Geococcyx californianus", "Apis mellifera"], "bee>bear": ["g", "Ursus americanus", "Apis mellifera"], "kangrat>coyote": ["g", "Canis latrans", "Dipodomys merriami"], "kangrat>fox": ["g", "Urocyon cinereoargenteus", "Dipodomys merriami"], "kangrat>rattler": ["g", "