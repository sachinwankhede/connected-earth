{"id": "xslovenia", "name": "Triglav National Park", "short": "Triglav", "place": "Slovenia", "lat": 46.4, "lon": 13.8, "side": "r", "cont": "Europe", "country": "Slovenia", "kind": "Polar & mountain", "park": true, "blurb": "Limestone Julian Alps: chamois, marmots and the wolf and eagle above them.", "tip": {"id": "wolf", "title": "Remove the wolf", "text": "Take the wolf out and watch deer and chamois numbers and the carcasses that ravens, foxes and eagles live on."}, "sources": [{"title": "Wikipedia: Triglav National Park", "url": "https://en.wikipedia.org/wiki/Triglav_National_Park"}, {"title": "Wikipedia: Alpine chamois", "url": "https://en.wikipedia.org/wiki/Alpine_chamois"}, {"title": "Wikipedia: Alpine ibex", "url": "https://en.wikipedia.org/wiki/Alpine_ibex"}, {"title": "Wikipedia: Alpine marmot", "url": "https://en.wikipedia.org/wiki/Alpine_marmot"}, {"title": "Wikipedia: Golden eagle", "url": "https://en.wikipedia.org/wiki/Golden_eagle"}, {"title": "Wikipedia: Dryas octopetala", "url": "https://en.wikipedia.org/wiki/Dryas_octopetala"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Triglav National Park", "icon": "ice", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.15, "desc": "Light is short in deep valleys and in winter, so sun-warmed slopes and early snow-free ground matter for plant growth."}, {"id": "snow", "sp": "snow and snowmelt", "xh": 0.4, "desc": "Winter snow shapes where animals can feed, and meltwater in spring feeds alpine meadows and the park streams."}, {"id": "rain", "sp": "rain and rivers", "xh": 0.62}, {"id": "soil", "sp": "limestone soil", "xh": 0.85, "wiki": "Limestone", "desc": "Thin, lime-rich mountain soils carry the meadows and forests; nutrients return to them through decomposers."}, {"id": "beech", "sp": "fagus sylvatica", "xh": 0.15, "wiki": "Fagus sylvatica", "desc": "A widespread forest tree in the park; its nuts are eaten by squirrels and dormice, and roe deer browse it."}, {"id": "grass", "sp": "festuca", "xh": 0.5, "name": "Alpine grasses", "desc": "Fescue and other grasses of the alpine pastures; ibex eat mostly grass, and chamois and marmots graze meadow grasses in summer."}, {"id": "dryas", "sp": "dryas octopetala", "xh": 0.85, "desc": "A mat-forming alpine plant of limestone outcrops and gravel where snow melts early."}, {"id": "chamois", "sp": "rupicapra rupicapra", "xh": 0.1, "name": "Alpine chamois", "wiki": "Alpine chamois", "desc": "Grazes alpine meadows in summer and moves down into forest in winter, eating conifers and bark."}, {"id": "ibex", "sp": "capra ibex", "xh": 0.24, "desc": "Eats mostly grass, adding herbs in summer and dwarf shrubs in winter. Reintroduced to Slovenia in the 1890s."}, {"id": "roe", "sp": "capreolus capreolus", "xh": 0.38, "desc": "A small forest deer, often recorded in the park, that browses trees such as beech."}, {"id": "reddeer", "sp": "cervus elaphus", "xh": 0.52, "name": "Red deer", "wiki": "Red deer", "desc": "A large deer of the valleys and forests, and a main prey of the wolf.", "ic": "elk"}, {"id": "marmot", "sp": "marmota marmota", "xh": 0.66, "desc": "Colonial burrower of alpine meadows that eats grasses, herbs and insects and hibernates for much of the year."}, {"id": "squirrel", "sp": "sciurus vulgaris", "xh": 0.8, "name": "Eurasian red squirrel", "desc": "A tree-dwelling seed eater that feeds on beech nuts and other forest seeds."}, {"id": "dormouse", "sp": "glis glis", "xh": 0.93, "desc": "A nocturnal forest rodent that eats beech nuts and other seeds, then hibernates.", "ic": "vole"}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.18, "desc": "A generalist hunter and scavenger, recorded eating marmots, squirrels, dormice and deer."}, {"id": "marten", "sp": "martes foina", "xh": 0.4, "desc": "A forest and village-edge predator that hunts dormice and squirrels."}, {"id": "raven", "sp": "corvus corax", "xh": 0.65, "wiki": "Common raven", "desc": "A scavenging crow that feeds on the carcasses of deer and chamois."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "name": "Grey wolf", "wiki": "Wolf", "desc": "Pack hunter of deer and chamois, returning to the Alps; its kills feed scavengers."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.7, "desc": "Hunts alpine pastures above the tree line, taking marmots and young ibex, and scavenges carcasses."}, {"id": "decomp", "sp": "decomposers", "xh": 0.5, "desc": "Fungi, bacteria and soil animals return dead plants and animals to the soil."}], "raw": [["sun", "beech", "r"], ["sun", "grass", "r"], ["sun", "dryas", "r"], ["snow", "grass", "r"], ["snow", "dryas", "r"], ["rain", "beech", "r"], ["rain", "grass", "r"], ["soil", "beech", "r"], ["soil", "grass", "r"], ["soil", "dryas", "r"], ["decomp", "soil", "r"], ["beech", "decomp", "d"], ["grass", "decomp", "d"], ["dryas", "decomp", "d"], ["wolf", "decomp", "d"], ["marmot", "decomp", "d"], ["beech", "roe"], ["beech", "squirrel"], ["beech", "dormouse"], ["grass", "chamois"], ["grass", "ibex"], ["grass", "marmot"], ["grass", "reddeer"], ["dryas", "chamois"], ["dryas", "ibex"], ["dryas", "marmot"], ["chamois", "wolf"], ["roe", "wolf"], ["reddeer", "wolf"], ["marmot", "wolf"], ["marmot", "eagle"], ["ibex", "eagle"], ["marmot", "fox"], ["squirrel", "fox"], ["dormouse", "fox"], ["squirrel", "marten"], ["dormouse", "marten"], ["chamois", "raven", "s"], ["roe", "raven", "s"], ["reddeer", "raven", "s"], ["reddeer", "fox", "s"], ["chamois", "eagle", "s"], ["chamois", "fox"], ["ibex", "fox"], ["roe", "fox"], ["reddeer", "marten"], ["beech", "raven"], ["dryas", "raven"], ["squirrel", "raven"], ["dormouse", "raven"], ["ibex", "wolf"], ["squirrel", "wolf"], ["dormouse", "wolf"], ["fox", "wolf"], ["marten", "wolf"], ["raven", "wolf"], ["roe", "eagle"], ["reddeer", "eagle"], 