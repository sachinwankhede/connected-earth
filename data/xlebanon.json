{"id": "xlebanon", "name": "Al Shouf Cedar Nature Reserve", "short": "Shouf Cedar", "place": "Lebanon", "lat": 33.7, "lon": 35.7, "side": "r", "cont": "Asia", "country": "Lebanon", "kind": "Forest", "park": true, "blurb": "Ancient cedars, oak slopes and a rewilding ibex herd in Mount Lebanon.", "tip": {"id": "snow", "title": "Thin the snowpack", "text": "Cedar and juniper stands rely on winter snow. Cut Winter snow by 80% and watch the trees, then the browsers and predators that depend on them."}, "sources": [{"title": "Wikipedia: Al Shouf Cedar Nature Reserve", "url": "https://en.wikipedia.org/wiki/Al_Shouf_Cedar_Nature_Reserve"}, {"title": "Wikipedia: Cedrus libani", "url": "https://en.wikipedia.org/wiki/Cedrus_libani"}, {"title": "Wikipedia: Nubian ibex", "url": "https://en.wikipedia.org/wiki/Nubian_ibex"}, {"title": "Wikipedia: Golden jackal", "url": "https://en.wikipedia.org/wiki/Golden_jackal"}, {"title": "Wikipedia: Wild boar", "url": "https://en.wikipedia.org/wiki/Wild_boar"}, {"title": "Wikipedia: Short-toed snake eagle", "url": "https://en.wikipedia.org/wiki/Short-toed_snake_eagle"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Al Shouf Cedar Nature Reserve", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "cedar", "sp": "cedrus libani", "xh": 0.15}, {"id": "oak", "sp": "quercus infectoria, quercus coccifera", "xh": 0.38}, {"id": "juniper", "sp": "juniperus drupacea", "xh": 0.62}, {"id": "grass", "sp": "aegilops", "xh": 0.85, "name": "Wild grasses", "desc": "Wild goatgrasses and other annual herbs of open slopes and clearings, grazed by wild and domestic hoofed animals."}, {"id": "boar", "sp": "sus scrofa", "xh": 0.06, "desc": "Omnivore that digs for roots and bulbs and eats acorns. Wolves are its main predator across much of its range.", "badge": "Ecosystem engineer"}, {"id": "gazelle", "sp": "gazella gazella", "xh": 0.22, "desc": "A small gazelle listed among the reserve's mammals and a recorded prey of red fox."}, {"id": "ibex", "sp": "capra nubiana", "xh": 0.38, "desc": "Extinct in Lebanon since the mid-19th century; a herd from Jordan was brought to the reserve in 2017. It eats grasses and leaves and stays near cliffs for safety."}, {"id": "hyrax", "sp": "procavia capensis", "xh": 0.54, "name": "Cape hyrax", "desc": "A rock-dwelling herbivore recorded near the reserve.", "ic": "vole"}, {"id": "goat", "sp": "capra hircus", "xh": 0.7, "desc": "Browsing by goats on young cedars hinders regeneration of the forest. Jackals and wolves take livestock."}, {"id": "mouse", "sp": "mus musculus", "xh": 0.9, "wiki": "House mouse", "desc": "Small omnivorous rodent eaten by jackals, foxes, hedgehogs and snakes in recorded GloBI interactions.", "ic": "vole"}, {"id": "jackal", "sp": "canis aureus", "xh": 0.1, "desc": "Opportunistic omnivore that eats rodents, birds, reptiles and fruit, and scavenges carcasses. Wolves dominate it."}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.26, "wiki": "Red fox", "desc": "Generalist hunter and scavenger; GloBI records it eating gazelle, mice, hedgehogs and snakes among these species."}, {"id": "hedgehog", "sp": "erinaceus concolor", "xh": 0.42, "desc": "Small ground forager; GloBI records it eating mice and snakes."}, {"id": "whip", "sp": "dolichophis jugularis", "xh": 0.58}, {"id": "snakeeagle", "sp": "circaetus gallicus", "xh": 0.74, "desc": "Eats mostly snakes, plus some lizards. Populations in the Middle East are resident."}, {"id": "vulture", "sp": "gyps fulvus", "xh": 0.9, "wiki": "Eurasian griffon vulture", "desc": "Raptor listed among the reserve's birds. It feeds on carcasses of large animals."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "desc": "Listed among the reserve's mammals. Wolves are the main predator of wild boar and dominate jackals."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.7, "desc": "A large eagle listed among the reserve's raptors; it is a recorded predator of Nubian ibex."}, {"id": "snow", "sp": "winter snow", "xh": 0.25, "latin": "Winter snow", "desc": "Heavy snow cover blankets the high cedar slopes and melts into water for spring growth."}, {"id": "rain", "sp": "winter rain", "xh": 0.5, "latin": "Winter rain", "desc": "Mediterranean winter rains water the oaks and grasses."}, {"id": "soil", "sp": "limestone soil nutrients", "xh": 0.75}, {"id": "decomp", "sp": "decomposers", "xh": 0.92, "latin": "Decomposers", "desc": "Fungi, bacteria and invertebrates recycling dead wood, leaves and carcasses."}], "raw": [["snow", "cedar", "r"], ["snow", "juniper", "r"], ["rain", "oak", "r"], ["rain", "grass", "r"], ["soil", "cedar", "r"], ["soil", "oak", "r"], ["soil", "grass", "r"], ["decomp", "soil", "r"], ["oak", "boar"], ["grass", "boar"], ["grass", "gazelle"], ["grass", "ibex"], ["oak", "ibex"], ["grass", "hyrax"], ["cedar", "goat"], ["oak", "goat"], ["grass", "goat"], ["grass", "mouse"], ["boar", "jackal"], ["boar", "jackal", "s"], ["goat", "jackal"], ["mouse", "jackal"], ["hedgehog", "jackal"], ["whip", "jackal"], ["gazelle", "fox"], ["mouse", "fox"], ["hedgehog", "fox"], ["whip", "fox"], ["mouse", "hedgehog"], ["whip", "hedgehog"], ["mouse", "whip"], ["whip", "snakeeagle"], ["boar", "vulture", "s"], ["gazelle", "vulture", "s"], ["ibex", "vulture", "s"], ["goat", "vulture", "s"], ["boar", "wolf"], ["gazelle", "wolf"], ["ibex", "wolf"], ["goat", "wolf"], ["jackal", "wolf"], ["ibex", "eagle"], ["hyrax", "eagle"], ["whip", "eagle"], ["cedar", "decomp", "d"], ["oak", "decomp", "d"], ["juniper", "decomp", "d"], ["grass", "decomp", "d"], ["wolf", "decomp", "d"], ["vulture", "decomp", "d"], ["boar", "decomp", "d"], ["jackal", "decomp", "d"], ["boar", "fox"], ["hyrax", "fox"], ["goat", "fox"], ["mouse", "wolf"], ["fox", "wolf"], ["hedgehog", "wolf"], ["whip", "wolf"], ["boar", "eagle"], ["m