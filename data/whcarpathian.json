eer and wild boar, found across the Carpathian forests."}, {"id": "lynx", "sp": "lynx lynx", "xh": 0.8, "desc": "A solitary forest cat that hunts mainly deer, preferring roe deer where they are common.", "no": ["badge"]}, {"id": "fungi", "sp": "fomes fomentarius", "xh": 0.72}], "raw": [["sun", "beech", "r"], ["sun", "fir", "r"], ["sun", "bilberry", "r"], ["sun", "herbs", "r"], ["climate", "beech", "r"], ["climate", "fir", "r"], ["climate", "bilberry", "r"], ["soil", "beech", "r"], ["soil", "fir", "r"], ["soil", "herbs", "r"], ["fungi", "soil", "r"], ["deadwood", "fungi", "d"], ["beech", "deadwood"], ["deadwood", "rosalia"], ["beech", "mouse"], ["beech", "vole"], ["beech", "boar"], ["bilberry", "vole"], ["bilberry", "bear"], ["bilberry", "roe"], ["herbs", "reddeer"], ["herbs", "roe"], ["herbs", "bison"], ["herbs", "vole"], ["beech", "roe"], ["fir", "roe"], ["beech", "bison"], ["beech", "bear"], ["rosalia", "woodpecker"], ["mouse", "wildcat"], ["vole", "wildcat"], ["mouse", "adder"], ["vole", "adder"], ["reddeer", "wolf"], ["roe", "wolf"], ["boar", "wolf"], ["roe", "lynx"], ["reddeer", "lynx"], ["reddeer", "bear"], ["roe", "bear"], ["boar", "bear"], ["beech", "rosalia"], ["fir", "reddeer"], ["bilberry", "reddeer"], ["boar", "wildcat"], ["roe", "wildcat"], ["mouse", "bear"], ["bison", "bear"], ["mouse", "wolf"], ["bison", "wolf"], ["wildcat", "wolf"], ["adder", "wolf"], ["mouse", "lynx"], ["boar", "lynx"], ["wildcat", "lynx"]], "ev": {"beech>mouse": ["g", "Apodemus flavicollis", "Fagus sylvatica"], "beech>vole": ["a"], "beech>boar": ["g", "Sus scrofa", "Fagus sylvatica"], "bilberry>vole": ["a"], "bilberry>bear": ["gg", "Ursus arctos", "Vaccinium myrtillus"], "bilberry>roe": ["g", "Capreolus capreolus", "Vaccinium myrtillus"], "herbs>reddeer": ["a"], "herbs>roe": ["a"], "herbs>bison": ["a"], "herbs>vole": ["a"], "beech>roe": ["g", "Capreolus capreolus", "Fagus sylvatica"], "fir>roe": ["g", "Capreolus capreolus", "Abies alba"], "beech>bison": ["a"], "beech>bear": ["g", "