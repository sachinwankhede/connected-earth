{"id": "npacadia", "name": "Acadia National Park", "short": "Acadia", "place": "Maine, USA", "lat": 44.35, "lon": -68.21, "side": "r", "cont": "North America", "country": "United States of America", "states": ["Maine"], "kind": "Coast & ocean", "park": true, "blurb": "Granite shore and spruce-fir forest: mussels, eiders, hares and eagles.", "tip": {"id": "mussel", "title": "Thin out the mussels", "text": "Blue mussels feed eiders and gulls on the rocky shore. Set Blue mussel to -80% and watch the sea duck and gull, then the eagle that eats them."}, "sources": [{"title": "Wikipedia: Acadia National Park", "url": "https://en.wikipedia.org/wiki/Acadia_National_Park"}, {"title": "NPS: Acadia nature and science", "url": "https://www.nps.gov/acad/learn/nature/index.htm"}, {"title": "Wikipedia: Bald eagle", "url": "https://en.wikipedia.org/wiki/Bald_eagle"}, {"title": "Wikipedia: Blue mussel", "url": "https://en.wikipedia.org/wiki/Blue_mussel"}, {"title": "Wikipedia: Snowshoe hare", "url": "https://en.wikipedia.org/wiki/Snowshoe_hare"}, {"title": "Wikipedia: Common eider", "url": "https://en.wikipedia.org/wiki/Common_eider"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Acadia National Park, Bald eagle, Blue mussel). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Acadia National Park", "icon": "algae", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light drives growth of both the forest and the coastal algae. Summer fog often cuts it along the shore."}, {"id": "tide", "sp": "tides", "xh": 0.3}, {"id": "gom", "sp": "cold gulf of maine water", "xh": 0.5}, {"id": "soil", "sp": "thin glacial soils", "xh": 0.7}, {"id": "decomp", "sp": "fungi, bacteria & detritivores", "xh": 0.9}, {"id": "phyto", "sp": "diatoms and dinoflagellates", "xh": 0.12, "desc": "Drifting algae that grow in sunlit coastal water. They feed mussels and the tiny animals that fish eat."}, {"id": "rockweed", "sp": "ascophyllum nodosum", "xh": 0.35}, {"id": "fir", "sp": "abies balsamea", "xh": 0.62, "ic": "aspen"}, {"id": "maple", "sp": "acer rubrum", "xh": 0.86, "desc": "A common hardwood of the park's mixed forest and wetlands. Its twigs and leaves are browsed by deer and hares."}, {"id": "copepod", "sp": "calanus finmarchicus", "xh": 0.06}, {"id": "mussel", "sp": "mytilus edulis", "xh": 0.2, "wiki": "Blue mussel"}, {"id": "periwinkle", "sp": "littorina littorea", "xh": 0.34}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.52, "wiki": "White-tailed deer", "desc": "The park's main large browser of twigs, buds and leaves. Its carcasses feed scavengers."}, {"id": "hare", "sp": "lepus americanus", "xh": 0.68, "desc": "Eats twigs and bark of woody plants in winter. Many predators, from foxes to eagles, depend on it.", "ic": "vole"}, {"id": "squirrel", "sp": "tamiasciurus hudsonicus", "xh": 0.86, "wiki": "American red squirrel", "desc": "A conifer-seed eater of the spruce-fir forest. Foxes and other predators take it.", "ic": "rsquirrel"}, {"id": "herring", "sp": "clupea harengus", "xh": 0.1}, {"id": "eider", "sp": "somateria mollissima", "xh": 0.27}, {"id": "gull", "sp": "larus smithsonianus", "xh": 0.44, "wiki": "American herring gull", "ic": "meadowlark"}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.62, "desc": "A small predator of hares, squirrels and voles. GloBI records it eating many park species."}, {"id": "raven", "sp": "corvus corax", "xh": 0.82, "desc": "An omnivore and scavenger that feeds on carcasses and other food."}, {"id": "seal", "sp": "phoca vitulina", "xh": 0.14, "tl": 4, "desc": "Eats mostly schooling fish such as herring. Harbor seals breed along the Maine coast."}, {"id": "eagle", "sp": "haliaeetus leucocephalus", "xh": 0.4, "desc": "Takes fish, ducks and gulls, and scavenges carrion. Wikipedia lists eiders and cormorants as frequent prey on the Maine coast."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.72, "wiki": "Coyote", "desc": "The park's top land predator. Hares and deer are among its recorded prey, and it also scavenges.", "badge": "Keystone predator"}], "raw": [["phyto", "copepod"], ["phyto", "mussel"], ["rockweed", "periwinkle"], ["fir", "deer"], ["maple", "deer"], ["fir", "hare"], ["maple", "hare"], ["fir", "squirrel"], ["copepod", "herring"], ["mussel", "eider"], ["mussel", "gull"], ["herring", "seal"], ["herring", "eagle"], ["eider", "eagle"], ["gull", "eagle"], ["hare", "fox"], ["squirrel", "fox"], ["hare", "eagle"], ["hare", "coyote"], ["deer", "coyote"], ["squirrel", "coyote"], ["sun", "phyto", "r"], ["sun", "rockweed", "r"], ["sun", "fir", "r"], ["sun", "maple", "r"], ["tide", "rockweed", "r"], ["gom", "phyto", "r"], ["gom", "rockweed", "r"], ["soil", "fir", "r"], ["soil", "maple", "r"], ["decomp", "soil", "r"], ["phyto", "decomp", "d"], ["rockweed", "decomp", "d"], ["fir", "decomp", "d"], ["maple", "decomp", "d"], ["deer", "decomp", "d"], ["hare", "decomp", "d"], ["squirrel", "decomp", "d"], ["fox", "decomp", "d"], ["coyote", "decomp", "d"], ["eagle", "decomp", "d"], ["seal", "decomp", "d"], ["eider", "decomp", "d"], ["gull", "decomp", "d"], ["herring", "decomp", "d"], ["mussel", "decomp", "d"], ["periwinkle", "decomp", "d"], ["copepod", "decomp", "d"], ["raven", "decomp", "d"], ["deer", "raven", "s"], ["deer", "eagle", "s"], ["deer", "coyote", "s"], ["mussel", "herring"], ["periwinkle", "eider"], ["deer", "fox"], ["hare", "raven"], ["squirrel", "raven"], ["mussel", "eagle"], ["squirrel", "eagle"], ["fox", "eagle"], ["raven", "eagle"], ["fir", "coyote"], ["fox", "coyote"], ["raven", "coyote"]], "ev": {"phyto>copepod": ["a"], "phyto>mussel": ["a"], "rockweed>periwinkle": ["g", "Littorina littorea", "Ascophyllum nodosum"], "fir>deer": ["g", "Odocoileus virginianus", "Abies balsamea"], "maple>deer": ["g", "Odocoileus virginianus", "Acer rubrum"], "fir>hare": ["g", "Lepus americanus", "Abies balsamea"], "maple>hare": ["g", "Lepus americanus", "Acer rubrum"], "fir>squirrel": ["g", "Tamiasciurus hudsonicus", "Abies balsamea"], "copepod>herring": ["g", "Clupea harengus", "Calanus finmarchicus"], "mussel>eider": ["g", "Somateria mollissima", "Mytilus edulis"], "mussel>gull": ["g", "Larus smithsonianus", "Mytilus edulis"], "herring>seal": ["g", "Phoca vitulina", "Clupea harengus"], "herring>eagle": ["gg", "Haliaeetus leucocephalus", "Clupea harengus"], "eider>eagle": ["g", "Haliaeetus leucocephalus", "Somateria mollissima"], "gull>eagle": ["g", "Haliaeetus leucocephalus", "Larus smithsonianus"], "hare>fox": ["g", "Vulpes vulpes", "Lepus americanus"], "squirrel>fox": ["g", "Vulpes vulpes", "Tamiasciurus hudsonicus"], "hare>eagle": ["g", "Haliaeetus leucocephalus", "Lepus americanus"], "hare>coyote": ["g", "Canis latrans", "Lepus americanus"], "deer>coyote": ["g", "Canis latrans", "Odocoileus virginianus"], "squirrel>coyote": ["g", "Canis latrans", "Tamiasciurus hudsonicus"], "deer>raven": ["g", "Corvus corax", "Odocoileus virginianus"], "deer>eagle": ["g", "Haliaeetus leucocephalus", "Odocoileus virginianus"], "mussel>herring": ["ga", "Clupea harengus", "Mytilus edulis"], "periwinkle>eider": ["ga", "Somateria mollissima", "Littorina littorea"], "deer>fox": ["ga", "Vulpes vulpes", "Odocoileus virginianus"], "hare>raven": ["ga", "Corvus corax", "Lepus americanus"], "squirrel>raven": ["ga", "Corvus corax", "Tamiasciurus hudsonicus"], "mussel>eagle": ["ga", "Haliaeetus leucocephalus", "Mytilus edulis"], "squirrel>eagle": ["ga", "Haliaeetus leucocephalus", "Tamiasciurus hudsonicus"], "fox>eagle": ["ga", "Haliaeetus leucocephalus", "Vulpes vulpes"], "raven>eagle": ["ga", "Haliaeetus leucocephalus", "Corvus corax"], "fir>coyote": ["ga", "Canis latrans", "Abies balsamea"], "fox>coyote": ["ga", "Canis latrans", "Vulpes vulpes"], "raven>coyote": ["ga", "Canis latrans", "Corvus corax"]}, "story": "Acadia National Park covers 49,075 acres of the Maine coast, including half of Mount Desert Island. Cadillac Mountain is the tallest on the US Atlantic coast. Mountains, lakes, streams, wetlands, forests, meadows and shoreline all lie close together, which supports a variety of plants and animals.", "matters": "It is the first US national park east of the Mississippi River and the only one in the Northeast. Wabanaki people have lived here for more than 10,000 years."}