{"id": "npbadlands", "name": "Badlands National Park", "short": "Badlands", "place": "South Dakota, USA", "lat": 43.75, "lon": -102.5, "side": "r", "cont": "North America", "country": "United States of America", "states": ["South Dakota"], "kind": "Grassland", "park": true, "blurb": "Mixed-grass prairie where prairie dogs hold up ferrets, owls and coyotes.", "tip": {"id": "pdog", "title": "Remove the prairie dogs", "text": "Prairie dogs feed ferrets, badgers, hawks and coyotes. Set Black-tailed prairie dog to -100% and watch the black-footed ferret first, then the predators behind it."}, "sources": [{"title": "Wikipedia: Badlands National Park", "url": "https://en.wikipedia.org/wiki/Badlands_National_Park"}, {"title": "Wikipedia: Black-tailed prairie dog", "url": "https://en.wikipedia.org/wiki/Black-tailed_prairie_dog"}, {"title": "Wikipedia: Black-footed ferret", "url": "https://en.wikipedia.org/wiki/Black-footed_ferret"}, {"title": "Wikipedia: Western wheatgrass", "url": "https://en.wikipedia.org/wiki/Western_wheatgrass"}], "notes": "The story and why it matters come from the Wikipedia articles listed below (Badlands National Park, Black-tailed prairie dog, Black-footed ferret). Individual species and links have not been checked one by one. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "imgwiki": "Badlands National Park", "icon": "bison", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Drives grass growth across the open prairie through the warm season."}, {"id": "rain", "sp": "rain & snowmelt", "xh": 0.3, "desc": "Limited rainfall is what makes this a mixed-grass prairie, with grasses from ankle to waist height."}, {"id": "fire", "sp": "fire", "xh": 0.5, "desc": "Prairie fire clears dead growth and keeps trees and shrubs from spreading across the grassland."}, {"id": "soil", "sp": "prairie soil & badland clays", "xh": 0.7}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi, insects & bacteria", "desc": "Break down dead grass, dung and carcasses and return nutrients to the soil."}, {"id": "wheatgrass", "sp": "pascopyrum smithii", "xh": 0.1, "wiki": "Western wheatgrass"}, {"id": "grama", "sp": "bouteloua gracilis", "xh": 0.3}, {"id": "pricklypear", "sp": "opuntia polyacantha", "xh": 0.5, "name": "Plains prickly pear", "desc": "A spiny cactus of dry ground. Prairie dogs eat it in winter and draw water from it.", "ic": "sage"}, {"id": "globemallow", "sp": "sphaeralcea coccinea", "xh": 0.7, "desc": "A low orange-flowered wildflower of dry prairie that prairie dogs favour in late summer and fall.", "ic": "sage"}, {"id": "bison", "sp": "bison bison", "xh": 0.05}, {"id": "pdog", "sp": "cynomys ludovicianus", "xh": 0.2, "wiki": "Black-tailed prairie dog", "badge": "Ecosystem engineer"}, {"id": "pronghorn", "sp": "antilocapra americana", "xh": 0.35, "wiki": "Pronghorn", "desc": "A fast grazing and browsing animal of open plains, listed among the park's mammals.", "ic": "pronghorn"}, {"id": "bighorn", "sp": "ovis canadensis", "xh": 0.5, "desc": "Lives on the steep badland slopes, where the park's population has reached 233."}, {"id": "cottontail", "sp": "sylvilagus audubonii", "xh": 0.65, "wiki": "Desert cottontail", "desc": "A small rabbit that eats grasses and herbs and is prey for many predators.", "ic": "vole"}, {"id": "deermouse", "sp": "peromyscus maniculatus", "xh": 0.8, "wiki": "Deer mouse", "desc": "A small seed and insect eater that many mammals, birds and snakes hunt.", "ic": "vole"}, {"id": "owl", "sp": "athene cunicularia", "xh": 0.08, "name": "Burrowing owl", "wiki": "Burrowing owl", "desc": "Nests underground and is associated with prairie dog colonies. Hunts small mammals, birds, frogs and insects."}, {"id": "ferret", "sp": "mustela nigripes", "xh": 0.22}, {"id": "badger", "sp": "taxidea taxus", "xh": 0.38, "wiki": "American badger", "desc": "Digs out prairie dogs and small rodents and is recorded eating burrowing owls.", "ic": "fox"}, {"id": "hawk", "sp": "buteo jamaicensis", "xh": 0.54, "tl": 3, "wiki": "Red-tailed hawk", "desc": "Hunts prairie dogs, rabbits, rodents and snakes from the air.", "ic": "hawk"}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.7, "wiki": "Gopher snake", "desc": "A large constrictor that eats rodents, rabbits and ground birds.", "ic": "snake"}, {"id": "vulture", "sp": "cathartes aura", "xh": 0.88, "wiki": "Turkey vulture", "desc": "Finds carcasses by smell and soaring. Recorded feeding on many of the park's mammals."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.5, "wiki": "Coyote", "desc": "A top predator here. It hunts prairie dogs, pronghorn, rabbits and rodents, and eats badgers and ferrets."}], "raw": [["sun", "wheatgrass", "r"], ["rain", "wheatgrass", "r"], ["soil", "wheatgrass", "r"], ["sun", "grama", "r"], ["rain", "grama", "r"], ["soil", "grama", "r"], ["sun", "pricklypear", "r"], ["rain", "pricklypear", "r"], ["soil", "pricklypear", "r"], ["sun", "globemallow", "r"], ["rain", "globemallow", "r"], ["soil", "globemallow", "r"], ["fire", "wheatgrass", "r"], ["fire", "grama", "r"], ["decomp", "soil", "r"], ["wheatgrass", "bison"], ["grama", "bison"], ["wheatgrass", "pdog"], ["grama", "pdog"], ["pricklypear", "pdog"], ["globemallow", "pdog"], ["wheatgrass", "pronghorn"], ["globemallow", "pronghorn"], ["wheatgrass", "bighorn"], ["grama", "bighorn"], ["wheatgrass", "cottontail"], ["grama", "cottontail"], ["grama", "deermouse"], ["globemallow", "deermouse"], ["pdog", "ferret"], ["deermouse", "ferret"], ["cottontail", "ferret"], ["pdog", "badger"], ["deermouse", "badger"], ["ferret", "badger"], ["pdog", "hawk"], ["deermouse", "hawk"], ["cottontail", "hawk"], ["bullsnake", "hawk"], ["deermouse", "owl"], ["deermouse", "bullsnake"], ["cottontail", "bullsnake"], ["owl", "bullsnake"], ["owl", "badger"], ["pdog", "coyote"], ["pdog", "vulture"], ["pronghorn", "coyote"], ["cottontail", "coyote"], ["deermouse", "coyote"], ["badger", "coyote"], ["ferret", "coyote"], ["bullsnake", "coyote"], ["bighorn", "coyote"], ["bison", "vulture", "s"], ["pronghorn", "vulture", "s"], ["bighorn", "vulture", "s"], ["pdog", "vulture", "s"], ["cottontail", "vulture", "s"], ["coyote", "vulture", "s"], ["badger", "vulture", "s"], ["wheatgrass", "decomp", "d"], ["grama", "decomp", "d"], ["pricklypear", "decomp", "d"], ["globemallow", "decomp", "d"], ["bison", "decomp", "d"], ["pdog", "decomp", "d"], ["pronghorn", "decomp", "d"], ["deermouse", "decomp", "d"], ["cottontail", "owl"], ["pdog", "bullsnake"], ["deermouse", "vulture"]], "ev": {"wheatgrass>bison": ["a"], "grama>bison": ["a"], "wheatgrass>pdog": ["a"], "grama>pdog": ["a"], "pricklypear>pdog": ["gg", "Cynomys ludovicianus", "Opuntia polyacantha"], "globemallow>pdog": ["a"], "wheatgrass>pronghorn": ["a"], "globemallow>pronghorn": ["a"], "wheatgrass>bighorn": ["a"], "grama>bighorn": ["a"], "wheatgrass>cottontail": ["a"], "grama>cottontail": ["a"], "grama>deermouse": ["a"], "globemallow>deermouse": ["a"], "pdog>ferret": ["gg", "Mustela nigripes", "Cynomys ludovicianus"], "deermouse>ferret": ["a"], "cottontail>ferret": ["a"], "pdog>badger": ["g", "Taxidea taxus", "Cynomys ludovicianus"], "deermouse>badger": ["g", "Taxidea taxus", "Peromyscus maniculatus"], "ferret>badger": ["gg", "Taxidea taxus", "Mustela nigripes"], "pdog>hawk": ["g", "Buteo jamaicensis", "Cynomys ludovicianus"], "deermouse>hawk": ["g", "Buteo jamaicensis", "Peromyscus maniculatus"], "cottontail>hawk": ["g", "Buteo jamaicensis", "Sylvilagus audubonii"], "bullsnake>hawk": ["g", "Buteo jamaicensis", "Pituophis catenifer"], "deermouse>owl": ["g", "Athene cunicularia", "Peromyscus maniculatus"], "deermouse>bullsnake": ["g", "Pituophis catenifer", "Peromyscus maniculatus"], "cottontail>bullsnake": ["g", "Pituophis catenifer", "Sylvilagus audubonii"], "owl>bullsnake": ["g", "Pituophis catenifer", "Athene cunicularia"], "owl>badger": ["g", "Taxidea taxus", "Athene cunicularia"], "pdog>coyote": ["g", "Canis latrans", "Cynomys ludovicianus"], "pdog>vulture": ["g", "Cathartes aura", "Cynomys ludovicianus"], "pronghorn>coyote": ["g", "Canis latrans", "Antilocapra americana"], "cottontail>coyote": ["g", "Canis latrans", "Sylvilagus audubonii"], "deermouse>coyote": ["g", "Canis latrans", "Peromyscus maniculatus"], "badger>coyote": ["g", "Canis latrans", "Taxidea taxus"], "ferret>coyote": ["gg", "Canis latrans", "Mustela nigripes"], "bullsnake>coyote": ["g", "Canis latrans", "Pituophis catenifer"], "bighorn>coyote": ["g", "Canis latrans", "Ovis canadensis"], "bison>vulture": ["a"], "pronghorn>vulture": ["a"], "bighorn>vulture": ["gg", "Cathartes aura", "Ovis canadensis"], "cottontail>vulture": ["g", "Cathartes aura", "Sylvilagus audubonii"], "coyote>vulture": ["g", "Cathartes aura", "Canis latrans"], "badger>vulture": ["g", "Cathartes aura", "Taxidea taxus"], "cottontail>owl": ["ga", "Athene cunicularia", "Sylvilagus audubonii"], "pdog>bullsnake": ["ga", "Pituophis catenifer", "Cynomys ludovicianus"], "deermouse>vulture": ["ga", "Cathartes aura", "Peromyscus maniculatus"]}, "story": "Badlands National Park in southwestern South Dakota protects 242,756 acres of sharply eroded buttes and pinnacles, along with the largest undisturbed mixed grass prairie in the United States. The black-footed ferret, one of the most endangered mammals in the world, was reintroduced to the wild here.", "matters": "The Oglala Lakota co-manage the South Unit with the National Park Service. It was authorized as a national monument in 1929 and became a national park in 1978."}