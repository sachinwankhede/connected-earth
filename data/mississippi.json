{"id": "mississippi", "name": "Mississippi River Floodplain", "short": "Mississippi River", "place": "St. Louis region, Missouri and Illinois", "lat": 38.8, "lon": -90.2, "side": "r", "blurb": "Eagles, pelicans and paddlefish on the river beside St. Louis.", "tip": {"id": "silvercarp", "title": "Try the invasive silver carp", "text": "Silver carp filter the same plankton that shad, paddlefish and mussels need. Raise them by 100% and see who loses out."}, "sources": [{"title": "National Park Service: animals of the Mississippi River corridor", "url": "https://home.nps.gov/miss/learn/nature/animals.htm"}, {"title": "US Fish & Wildlife Service: Upper Mississippi floodplains", "url": "https://www.fws.gov/story/2009-06/us-designates-upper-mississippi-river-floodplains-wetland-international-importance-0"}, {"title": "Wikipedia: Upper Mississippi River", "url": "https://en.wikipedia.org/wiki/Upper_Mississippi_River"}, {"title": "Wikipedia: Mississippi Flyway", "url": "https://en.wikipedia.org/wiki/Mississippi_Flyway"}], "notes": "Feeding links were checked against the sources listed where they state them. Where the sources are silent, links come from general ecological knowledge and are illustrative. Feeding links that match a GloBI (Global Biotic Interactions) record are marked in the node details, with a link to the records. A few links were added from GloBI records.", "nodes": [{"id": "algae", "sp": "diverse microalgae", "xh": 0.08, "name": "River phytoplankton", "desc": "Drifting algae that start the river's food chain. They feed zooplankton, mussels and filter-feeding fish."}, {"id": "celery", "sp": "vallisneria and potamogeton spp.", "xh": 0.3}, {"id": "moist", "sp": "smartweeds and millets", "xh": 0.5}, {"id": "cottonwood", "sp": "populus deltoides, acer saccharinum", "xh": 0.72}, {"id": "willow", "sp": "salix nigra", "xh": 0.9}, {"id": "zoop", "sp": "cladocera and copepods", "xh": 0.04}, {"id": "mussels", "sp": "unionidae", "xh": 0.13}, {"id": "insects", "sp": "mayflies, caddisflies and midges", "xh": 0.23}, {"id": "shad", "sp": "dorosoma cepedianum", "xh": 0.32}, {"id": "silvercarp", "sp": "hypophthalmichthys molitrix", "xh": 0.42}, {"id": "paddlefish", "sp": "polyodon spathula", "xh": 0.51}, {"id": "canvasback", "sp": "aythya valisineria", "xh": 0.6}, {"id": "mallard", "sp": "anas platyrhynchos", "xh": 0.69, "wiki": "Mallard", "desc": "Eats seeds from moist-soil plants and other plant foods in flooded fields and backwaters."}, {"id": "muskrat", "sp": "ondatra zibethicus", "xh": 0.78, "wiki": "Muskrat", "desc": "Lives along banks and marshes, eating aquatic plants.", "ic": "beaver"}, {"id": "deer", "sp": "odocoileus virginianus", "xh": 0.88, "wiki": "White-tailed deer", "desc": "Browses young trees and shrubs on the floodplain. Coyotes take fawns, and eagles scavenge carcasses."}, {"id": "beaver", "sp": "castor canadensis", "xh": 0.97, "wiki": "North American beaver", "desc": "Cuts cottonwood and willow for food and dams.", "badge": "Ecosystem engineer"}, {"id": "drum", "sp": "aplodinotus grunniens", "xh": 0.1}, {"id": "otter", "sp": "lontra canadensis", "xh": 0.28, "name": "River otter", "wiki": "North American river otter", "desc": "Hunts fish along the banks. The NPS notes its return since the 1980s as a sign of better water quality."}, {"id": "heron", "sp": "ardea herodias", "xh": 0.4}, {"id": "cormorant", "sp": "nannopterum auritum", "xh": 0.5, "desc": "Dives for fish. The NPS notes cormorants depend on fish.", "ic": "raven"}, {"id": "pelican", "sp": "pelecanus erythrorhynchos", "xh": 0.6, "desc": "Scoops up fish from shallows. Breeds on lakes across interior North America and winters on the Gulf coast, and also follows the Mississippi River in winter."}, {"id": "osprey", "sp": "pandion haliaetus", "xh": 0.72, "desc": "Dives for fish. The NPS notes ospreys depend on fish."}, {"id": "flathead", "sp": "pylodictis olivaris", "xh": 0.1}, {"id": "baldeagle", "sp": "haliaeetus leucocephalus", "xh": 0.45, "desc": "The FWS counts more than 200 nesting pairs in the refuge and nearby public lands. Eats fish and waterfowl and scavenges carcasses."}, {"id": "coyote", "sp": "canis latrans", "xh": 0.85, "wiki": "Coyote", "desc": "Lives along the banks, taking fawns, ducks and muskrats. The NPS lists it as a bank dweller."}, {"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Powers phytoplankton and the plants of the floodplain."}, {"id": "flood", "sp": "flood pulse & river flow", "xh": 0.35}, {"id": "sed", "sp": "sediment & nutrients", "xh": 0.62}, {"id": "decomp", "sp": "decomposer community", "xh": 0.88, "name": "Bacteria & fungi", "desc": "Break down leaf litter, dead fish and plants and return nutrients to the water and soil."}], "raw": [["sun", "algae", "r"], ["sun", "celery", "r"], ["sun", "moist", "r"], ["sun", "cottonwood", "r"], ["sun", "willow", "r"], ["flood", "algae", "r"], ["flood", "celery", "r"], ["flood", "moist", "r"], ["flood", "cottonwood", "r"], ["flood", "willow", "r"], ["sed", "algae", "r"], ["sed", "celery", "r"], ["sed", "moist", "r"], ["sed", "cottonwood", "r"], ["sed", "willow", "r"], ["decomp", "sed", "r"], ["algae", "zoop"], ["algae", "mussels"], ["algae", "insects"], ["algae", "shad"], ["algae", "silvercarp"], ["zoop", "shad"], ["zoop", "silvercarp"], ["zoop", "paddlefish"], ["celery", "canvasback"], ["celery", "muskrat"], ["moist", "mallard"], ["moist", "muskrat"], ["cottonwood", "beaver"], ["cottonwood", "deer"], ["willow", "beaver"], ["willow", "deer"], ["willow", "muskrat"], ["mussels", "drum"], ["insects", "drum"], ["shad", "flathead"], ["shad", "otter"], ["shad", "heron"], ["shad", "cormorant"], ["shad", "pelican"], ["shad", "osprey"], ["shad", "baldeagle"], ["shad", "drum"], ["silvercarp", "flathead"], ["silvercarp", "baldeagle"], ["drum", "flathead"], ["drum", "otter"], ["canvasback", "baldeagle"], ["mallard", "baldeagle"], ["mallard", "coyote"], ["muskrat", "coyote"], ["deer", "coyote"], ["deer", "baldeagle", "s"], ["celery", "decomp", "d"], ["cottonwood",