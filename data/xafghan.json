{"id": "xafghan", "name": "Band-e Amir National Park", "short": "Band-e Amir", "place": "Bamyan, Afghanistan", "lat": 34.8, "lon": 67.2, "side": "r", "cont": "Asia", "country": "Afghanistan", "blurb": "Six travertine-dammed lakes high in the Hindu Kush, with ibex, wolves and snowcocks.", "tip": {"id": "ibex", "title": "Remove the ibex", "text": "Wild ibex are a main prey of wolves and golden eagles. Remove them and watch the pressure shift to snowcocks, rodents and the foxes that feed on carcasses."}, "sources": [{"title": "Wikipedia: Band-e Amir National Park", "url": "https://en.wikipedia.org/wiki/Band-e_Amir_National_Park"}, {"title": "Wikipedia: Band-e Amir", "url": "https://en.wikipedia.org/wiki/Band-e_Amir"}, {"title": "Wikipedia: Siberian ibex", "url": "https://en.wikipedia.org/wiki/Siberian_ibex"}, {"title": "Wikipedia: Himalayan snowcock", "url": "https://en.wikipedia.org/wiki/Himalayan_snowcock"}, {"title": "Wikipedia: Gray wolf", "url": "https://en.wikipedia.org/wiki/Gray_wolf"}, {"title": "Wikipedia: Golden eagle", "url": "https://en.wikipedia.org/wiki/Golden_eagle"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Band-e Amir National Park", "icon": "water", "tier": "overview", "kind": "Lakes & wetlands", "park": true, "nodes": [{"id": "willow", "sp": "salix pycnostachya", "xh": 0.12}, {"id": "fescue", "sp": "festuca rubra", "xh": 0.34, "name": "Mountain grasses", "desc": "Red fescue and other grasses form the pasture that wild mountain herbivores and livestock graze.", "badge": "Foundation species"}, {"id": "artem", "sp": "artemisia", "xh": 0.56}, {"id": "ephedra", "sp": "ephedra intermedia", "xh": 0.78}, {"id": "ibex", "sp": "capra sibirica", "xh": 0.08, "desc": "Lives on steep slopes and scree. It eats alpine grasses and herbs, and in winter more twigs and needles of trees such as willow.", "badge": "Keystone grazer"}, {"id": "urial", "sp": "ovis vignei", "xh": 0.24}, {"id": "vole", "sp": "alticola argentatus", "xh": 0.4}, {"id": "hamster", "sp": "cricetulus migratorius", "xh": 0.56}, {"id": "snowcock", "sp": "tetraogallus himalayensis", "xh": 0.72, "desc": "Listed as an Important Bird Area species at Band-e Amir. Eats grass shoots, seeds, Ephedra berries and Artemisia leaves, and golden eagles sometimes take adults."}, {"id": "swallow", "sp": "papilio machaon", "xh": 0.89, "name": "Old World swallowtail", "desc": "A butterfly whose caterpillars eat plants such as Artemisia. GloBI records many songbirds eating it.", "ic": "mayfly"}, {"id": "whitethroat", "sp": "sylvia curruca", "xh": 0.1}, {"id": "redstart", "sp": "phoenicurus ochruros", "xh": 0.25}, {"id": "shrike", "sp": "lanius schach", "xh": 0.4}, {"id": "agama", "sp": "paralaudakia himalayana", "xh": 0.55}, {"id": "boa", "sp": "eryx elegans", "xh": 0.7}, {"id": "fox", "sp": "vulpes vulpes", "xh": 0.88, "desc": "GloBI records it eating many songbirds and small rodents recorded here. It also scavenges carcasses."}, {"id": "wolf", "sp": "canis lupus", "xh": 0.3, "desc": "The northern regions of Afghanistan are described as strongholds for wolves. Wolves chiefly hunt hoofed mammals and eat carrion, and the ibex has wolves as a main predator."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.7, "desc": "Occurs in Hindu Kush mountain habitat and hunts rodents, gamebirds and sometimes larger prey. It sometimes preys on adult Himalayan snowcocks."}, {"id": "ice", "sp": "winter snow and ice", "xh": 0.08, "wiki": "Band-e Amir National Park", "desc": "Winters are severe, with temperatures down to about minus 20 C, and the lakes freeze over. Meltwater feeds streams and pasture."}, {"id": "sun", "sp": "sunlight", "xh": 0.3, "desc": "High-altitude sunshine drives plant growth in the short summer."}, {"id": "water", "sp": "travertine lake water", "xh": 0.52}, {"id": "soil", "sp": "mountain soil", "xh": 0.74, "desc": "Thin mountain soils hold nutrients for shrubs and grasses and are replenished by decomposition."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.92, "name": "Soil microbes and fungi", "desc": "Break down dead plants, droppings and carcasses, returning nutrients to the soil."}], "raw": [["sun", "fescue", "r"], ["sun", "artem", "r"], ["ice", "fescue", "r"], ["ice", "willow", "r"], ["water", "willow", "r"], ["water", "fescue", "r"], ["soil", "ephedra", "r"], ["soil", "artem", "r"], ["decomp", "soil", "r"], ["willow", "ibex"], ["fescue", "ibex"], ["fescue", "urial"], ["fescue", "vole"], ["fescue", "hamster"], ["fescue", "snowcock"], ["ephedra", "snowcock"], ["artem", "snowcock"], ["artem", "swallow"], ["swallow", "whitethroat"], ["swallow", "redstart"], ["swallow", "shrike"], ["swallow", "agama"], ["agama", "shrike"], ["hamster", "fox"], ["vole", "fox"], ["vole", "boa"], ["hamster", "boa"], ["agama", "boa"], ["whitethroat", "fox"], ["redstart", "fox"], ["hamster", "eagle"], ["vole", "eagle"], ["ibex", "wolf"], ["urial", "wolf"], ["snowcock", "eagle"], ["ibex", "eagle"], ["ibex", "wolf", "s"], ["ibex", "fox", "s"], ["ibex", "eagle", "s"], ["urial", "fox", "s"], ["willow", "decomp", "d"], ["fescue", "decomp", "d"], ["artem", "decomp", "d"], ["ephedra", "decomp", "d"], ["ibex", "decomp", "d"], ["urial", "decomp", "d"], ["vole", "decomp", "d"], ["hamster", "decomp", "d"], ["snowcock", "decomp", "d"], ["swallow", "decomp", "d"], ["whitethroat", "decomp", "d"], ["redstart", "decomp", "d"], ["shrike", "decomp", "d"], ["agama", "decomp", "d"], ["boa", "decomp", "d"], ["fox", "decomp", "d"], ["wolf", "decomp", "d"], ["eagle", "decomp", "d"], ["hamster", "wolf"], ["whitethroat", "wolf"], ["redstart", "wolf"], ["fox", "wolf"], ["fox", "eagle"]], "ev": {"willow>ibex": ["a"], "fescue>ibex": ["a"], "fescue>urial": ["a"], "fescue>vole": ["a"], "fescue>hamster": ["a"], "fescue>snowcock": ["a"], "ephedra