{"id": "whyasuni", "name": "Yasuní National Park", "short": "Yasuní", "place": "Ecuador", "lat": -1.0, "lon": -76.0, "side": "r", "cont": "South America", "country": "Ecuador", "kind": "Forest", "park": true, "blurb": "Fruit trees, peccaries and monkeys, and the jaguars and harpy eagles above them.", "tip": {"id": "jaguar", "title": "Remove the jaguars", "text": "Jaguars hunt peccaries, tapirs and agoutis. Set Jaguar to -100% and watch those plant-eaters, then the fruit trees they feed on."}, "sources": [{"title": "Wikipedia: Yasuní National Park", "url": "https://en.wikipedia.org/wiki/Yasun%C3%AD_National_Park"}, {"title": "Wikipedia: Jaguar", "url": "https://en.wikipedia.org/wiki/Jaguar"}, {"title": "Wikipedia: Harpy eagle", "url": "https://en.wikipedia.org/wiki/Harpy_eagle"}, {"title": "Wikipedia: White-lipped peccary", "url": "https://en.wikipedia.org/wiki/White-lipped_peccary"}, {"title": "Wikipedia: Lowland tapir", "url": "https://en.wikipedia.org/wiki/Lowland_tapir"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Yasuní National Park", "icon": "willow", "tier": "overview", "nodes": [{"id": "sun", "sp": "sunlight", "xh": 0.1, "desc": "Light that filters down through the tall canopy to the plants that drive the forest's food web."}, {"id": "rain", "sp": "rainfall", "xh": 0.3, "desc": "Constant moisture in this wet Amazon forest keeps its trees growing and fruiting."}, {"id": "soil", "sp": "forest soil", "xh": 0.5, "desc": "Soil and leaf litter hold the nutrients that trees take up again after decomposers release them."}, {"id": "decomp", "sp": "decomposer community", "xh": 0.9, "name": "Fungi & bacteria", "desc": "Break down fallen leaves, fruit and dead animals, returning nutrients to the forest floor."}, {"id": "theobroma", "sp": "theobroma subincanum", "xh": 0.12}, {"id": "guarea", "sp": "guarea macrophylla", "xh": 0.34}, {"id": "dendropanax", "sp": "dendropanax caucanus", "xh": 0.56}, {"id": "leonia", "sp": "leonia glycycarpa", "xh": 0.78}, {"id": "tapir", "sp": "tapirus terrestris", "xh": 0.05, "desc": "Browses leaves, shoots and fruit and is described as an important seed disperser. Jaguars, caimans and anacondas prey on it.", "badge": "Ecosystem engineer"}, {"id": "wlp", "sp": "tayassu pecari", "xh": 0.17, "desc": "Herd animal that eats mostly fruit and other plant parts. Wikipedia calls it important prey for large cats."}, {"id": "cp", "sp": "pecari tajacu", "xh": 0.29, "wiki": "Collared peccary", "desc": "Eats fruit and other plant material and is a common jaguar prey animal in Amazonian forests."}, {"id": "brocket", "sp": "mazama americana", "xh": 0.41, "desc": "A forest deer that eats fruit and leaves. Recorded in GloBI eating Theobroma fruit and as jaguar prey."}, {"id": "agouti", "sp": "dasyprocta fuliginosa", "xh": 0.53}, {"id": "woolly", "sp": "lagothrix lagothricha", "xh": 0.65, "desc": "A canopy primate that eats fruit. Monkeys of this kind are among harpy eagle prey."}, {"id": "toucan", "sp": "ramphastos tucanus", "xh": 0.77}, {"id": "hopper", "sp": "omura congrua", "xh": 0.89}, {"id": "anole", "sp": "anolis fuscoauratus", "xh": 0.2}, {"id": "snake", "sp": "imantodes cenchoa", "xh": 0.5}, {"id": "ocelot", "sp": "leopardus pardalis", "xh": 0.8, "desc": "A medium-sized forest cat that hunts small mammals such as agoutis, and lizards."}, {"id": "jaguar", "sp": "panthera onca", "xh": 0.3, "desc": "The top predator. GloBI records it eating peccaries, brocket deer, tapirs, agoutis and pacas, and it also takes caiman in floodplains."}, {"id": "harpy", "sp": "harpia harpyja", "xh": 0.7, "desc": "Canopy raptor that eats mostly sloths and monkeys, plus agoutis, snakes and birds."}], "raw": [["sun", "theobroma", "r"], ["rain", "theobroma", "r"], ["soil", "theobroma", "r"], ["theobroma", "de