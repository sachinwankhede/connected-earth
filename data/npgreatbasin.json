{"id": "npgreatbasin", "name": "Great Basin National Park", "short": "Great Basin", "place": "Nevada, USA", "lat": 38.98, "lon": -114.3, "side": "l", "cont": "North America", "country": "United States of America", "states": ["Nevada"], "kind": "Desert", "park": true, "blurb": "Bristlecone pines, sagebrush and the snowmelt that sustains a mountain island in the desert.", "tip": {"id": "snow", "title": "Shrink the snowpack", "text": "Mountain snowmelt is the water that sustains the high meadows and aspen. Set Snowpack & meltwater to -100% and watch the plants, then the deer, elk and the predators that follow them."}, "sources": [{"title": "Wikipedia: Great Basin National Park", "url": "https://en.wikipedia.org/wiki/Great_Basin_National_Park"}, {"title": "National Park Service: Great Basin nature and science", "url": "https://www.nps.gov/grba/learn/nature/index.htm"}, {"title": "Wikipedia: Great Basin bristlecone pine", "url": "https://en.wikipedia.org/wiki/Great_Basin_bristlecone_pine"}, {"title": "Wikipedia: Clark's nutcracker", "url": "https://en.wikipedia.org/wiki/Clark%27s_nutcracker"}, {"title": "Wikipedia: Mule deer", "url": "https://en.wikipedia.org/wiki/Mule_deer"}, {"title": "Wikipedia: Cougar", "url": "https://en.wikipedia.org/wiki/Cougar"}], "notes": "The species list comes from GBIF occurrence records inside a circle around the park, so it can include nearby areas. Feeding links come from GloBI records and the sources listed where they state them; others are general ecology and are illustrative.", "imgwiki": "Great Basin National Park", "icon": "whitebark", "tier": "overview", "nodes": [{"id": "bristle", "sp": "pinus longaeva", "xh": 0.08}, {"id": "limber", "sp": "pinus flexilis", "xh": 0.24, "desc": "A high-elevation pine whose large seeds are among the favourite foods of Clark's nutcracker.", "ic": "whitebark"}, {"id": "aspen", "sp": "populus tremuloides", "xh": 0.4, "name": "Quaking aspen", "desc": "Forms groves on the wetter mountain slopes. Elk and mule deer browse it."}, {"id": "mahogany", "sp": "cercocarpus ledifolius", "xh": 0.56}, {"id": "sage", "sp": "artemisia tridentata", "xh": 0.72, "desc": "Dominates the valley floors and lower slopes near the park and is key winter browse for mule deer."}, {"id": "meadow", "sp": "poaceae and wildflowers", "xh": 0.88}, {"id": "mdeer", "sp": "odocoileus hemionus", "xh": 0.08, "wiki": "Mule deer", "desc": "Mostly a browser, taking shrubs such as sagebrush, mountain-mahogany and aspen, with more flowering plants in summer. A main prey of cougars and coyotes."}, {"id": "elk", "sp": "cervus elaphus", "xh": 0.24, "wiki": "Elk", "desc": "A large grazer and browser of the high slopes and meadows, and big prey for cougars.", "ic": "elk"}, {"id": "dmouse", "sp": "peromyscus maniculatus", "xh": 0.4, "wiki": "Deer mouse", "desc": "The most recorded small mammal near the park. Eats seeds and insects and is food for snakes, bobcats and coyotes.", "ic": "vole"}, {"id": "gsq", "sp": "callospermophilus lateralis", "xh": 0.56, "wiki": "Golden-mantled ground squirrel", "desc": "Eats seeds, plants and fungi in mountain forests and meadows, and is prey for eagles and carnivores."}, {"id": "chip", "sp": "tamias umbrinus", "xh": 0.72, "desc": "A conifer-forest chipmunk that eats seeds and other plant foods and is taken by bobcats and coyotes."}, {"id": "nutcracker", "sp": "nucifraga columbiana", "xh": 0.88, "desc": "Eats pine seeds and buries thousands for later; forgotten caches can sprout into new trees. Limber pine is among its important foods."}, {"id": "raven", "sp": "corvus corax", "xh": 0.15, "desc": "A very well recorded park bird and an opportunist that scavenges carcasses and takes snakes."}, {"id": "bullsnake", "sp": "pituophis catenifer", "xh": 0.4, "name": "Gopher snake (bullsnake)", "wiki": "Gopher snake", "desc": "A constrictor that hunts rodents such as mice and voles on valley and slope habitats.", "ic": "snake"}, {"id": "bobcat", "sp": "lynx rufus", "xh": 0.62, "tl": 3, "wiki": "Bobcat", "desc": "A park predator of rabbits, rodents, birds and young deer on the rugged slopes.", "ic": "lion"}, {"id": "coyote", "sp": "canis latrans", "xh": 0.85, "tl": 3, "wiki": "Coyote", "desc": "Hunts rodents and takes fawns, and feeds on carcasses, across the park's valleys and slopes."}, {"id": "cougar", "sp": "puma concolor", "xh": 0.3, "name": "Cougar", "desc": "The top predator of the mountains. Across North America deer and elk are its main prey."}, {"id": "eagle", "sp": "aquila chrysaetos", "xh": 0.7, "desc": "Hunts rabbits, hares and ground squirrels in open western country. Listed among the park's raptors."}, {"id": "sun", "sp": "sunlight", "xh": 0.08, "desc": "Bright high-desert sun powers growth from the sagebrush valleys to the alpine slopes."}, {"id": "snow", "sp": "snowpack & meltwater", "xh": 0.26}, {"id": "soil", "sp": "rocky mountain soils", "xh": 0.44}, {"id": "decomp", "sp": "decomposer community", "xh": 0.8, "name": "Fungi, bacteria & soil invertebrates", "desc": "Break down dead needles, plants and carcasses and return nutrients to the thin mountain soil."}], "raw": [["sun", "bristle", "r"], ["sun", "limber", "r"], ["sun", "aspen", "r"], ["sun", "mahogany", "r"], ["sun", "sage", "r"], ["sun", "meadow", "r"], ["snow", "bristle", "r"], ["snow", "limber", "r"], ["snow", "aspen", "r"], ["snow", "mahogany", "r"], ["snow", "sage", "r"], ["snow", "meadow", "r"], ["soil", "bristle", "r"], ["soil", "limber", "r"], ["soil", "aspen", "r"], ["soil", "mahogany", "r"], ["soil", "sage", "r"], ["soil", "meadow", "r"], ["decomp", "soil", "r"], ["limber", "nutcracker"], ["bristle", "nutcracker"], ["limber", "chip"], ["limber", "dmouse"], ["limber", "gsq"], ["meadow", "elk"], ["aspen", "elk"], ["aspen", "mdeer"], ["sage", "mdeer"], ["mahogany", "mdeer"], ["meadow", "mdeer"], ["sage", "dmouse"], ["meadow", "dmouse"], ["meadow", "gsq"], ["meadow", "chip"], ["dmouse", "bullsnake"], ["dmouse", "bobcat"], ["dmouse", "coyote"], ["gsq", "bobcat"], ["gsq", "coyote"], ["gsq", "eagle"], ["chip", "bobcat"], ["chip", "coyote"], ["mdeer", "bobcat"], ["mdeer", "coyote"], ["mdeer", "cougar"], ["elk", "cougar"], ["bullsnake", "raven"], ["mdeer", "raven", "s"], ["elk", "raven", "s"], ["mdeer", "coyote", "s"], ["bristle", "decomp", "d"], ["limber", "decomp", "d"], ["aspen", "decomp", "d"], ["mahogany", "decomp", "d"], ["sage", "decomp", "d"], ["meadow", "decomp", "d"], ["mdeer", "decomp", "d"], ["elk", "decomp", "d"], ["cougar", "decomp", "d"], ["raven", "decomp", "d"], ["meadow", "raven"], ["elk", "bobcat"], ["elk", "coyote"], ["meadow", "cougar"], ["bobcat", "cougar"], ["coyote", "cougar"], ["mdeer", "eagle"], ["elk", "eagle"], ["dmouse", "eagle"], ["nutcracker", "eagle"], ["raven", "eagle"], ["bullsnake", "eagle"], ["bobcat", "eagle"], ["coyote", "eagle"]], "ev": {"limber>nutcracker": ["g", "Nucifraga columbiana", "Pinus flexilis"], "bristle>nutcracker": ["gg", "Nucifraga columbiana", "Pinus longaeva"], "limber>chip": ["a"], "limber>dmouse": ["a"], "limber>gsq": ["a"], "meadow>elk": ["g", "Cervus elaphus", "Poaceae"], "aspen>elk": ["g", "Cervus elaphus", "Populus tremuloides"], "aspen>mdeer": ["a"], "sage>mdeer": ["gg", "Odocoileus hemionus", "Artemisia tridentata"], "mahogany>mdeer": ["a"], "meadow>mdeer": ["g", "Odocoileus hemionus", "Poaceae"], "sage>dmouse": ["a"], "meadow>dmouse": ["a"], "meadow>gsq": ["g", "Callospermophilus lateralis", "Poaceae"], "meadow>chip": ["a"], "dmouse>bullsnake": ["g", "Pituophis catenifer", "Peromyscus maniculatus"], "dmouse>bobcat": ["g", "Lynx rufus", "Peromyscus maniculatus"], "dmouse>coyote": ["g", "Canis latrans", "Peromyscus maniculatus"], "gsq>bobcat": ["g", "Lynx rufus", "Callospermophilus lateralis"], "gsq>coyote": ["g", "Canis latrans", "Callospermophilus lateralis"], "gsq>eagle": ["a"], "chip>bobcat": ["gg", "Lynx rufus", "Tamias umbrinus"], "chip>coyote": ["gg", "Canis latrans", "Tamias umbrinus"], "mdeer>bobcat": ["g", "Lynx rufus", "Odocoileus hemionus"], "mdeer>coyote": ["g", "C