{"nodes":[{"id":"algae","name":"Stream algae","latin":"Bacillariophyta (diatoms)","tl":1,"xh":0.05,"wiki":"Diatom","desc":"Films of diatoms on stream stones. They feed the mayflies and other grazers that trout depend on.","ic":"algae"},{"id":"willow","name":"Willow","latin":"Salix spp.","tl":1,"xh":0.22,"wiki":"Willow","desc":"Streamside shrubs that feed moose and beaver and hold the banks that trout streams run between.","ic":"willow"},{"id":"aspen","name":"Quaking aspen","latin":"Populus tremuloides","tl":1,"xh":0.34,"wiki":"Quaking aspen","desc":"Clonal groves that shelter birds and insects. Elk and beaver browse young shoots, which can stop a grove from regrowing.","ic":"aspen","badge":"Foundation species"},{"id":"grass","name":"Bluebunch wheatgrass","latin":"Pseudoroegneria spicata","tl":1,"xh":0.56,"wiki":"Bluebunch wheatgrass","desc":"A bunchgrass of the northern range and the base of the grazing chain for elk, bison and pronghorn.","ic":"grass"},{"id":"sage","name":"Big sagebrush","latin":"Artemisia tridentata","tl":1,"xh":0.74,"wiki":"Big sagebrush","desc":"Evergreen winter forage. Pronghorn lean on it when snow buries the grass.","ic":"sage"},{"id":"whitebark","name":"Whitebark pine","latin":"Pinus albicaulis","tl":1,"xh":0.93,"wiki":"Whitebark pine","desc":"A high-elevation pine whose fatty seeds feed grizzly bears and red squirrels.","ic":"whitebark","badge":"Foundation species"},{"id":"mayfly","name":"Mayflies","latin":"Ephemeroptera","tl":2,"xh":0.04,"wiki":"Mayfly","desc":"Nymphs graze algae on stream stones and are a main food for cutthroat trout.","ic":"mayfly"},{"id":"beaver","name":"American beaver","latin":"Castor canadensis","tl":2,"xh":0.15,"wiki":"North American beaver","desc":"Cuts willow and aspen and dams streams. The ponds it makes are used by fish, birds and moose.","ic":"beaver","badge":"Ecosystem engineer"},{"id":"moose","name":"Moose","latin":"Alces alces","tl":2,"xh":0.26,"wiki":"Moose","desc":"Wades into streamside willow thickets, its main winter food.","ic":"moose"},{"id":"elk","name":"Elk","latin":"Cervus canadensis","tl":2,"xh":0.37,"wiki":"Elk","desc":"The northern range's main large grazer and browser. Wolves, cougars, coyotes and bears all take elk.","ic":"elk"},{"id":"bison","name":"Bison","latin":"Bison bison","tl":2,"xh":0.47,"wiki":"American bison","desc":"Grazes grass and sedge in large herds. Winter-killed animals feed scavengers.","ic":"bison"},{"id":"muledeer","name":"Mule deer","latin":"Odocoileus hemionus","tl":2,"xh":0.57,"wiki":"Mule deer","desc":"Browses sagebrush, willow and grass at lower elevations.","ic":"muledeer"},{"id":"pronghorn","name":"Pronghorn","latin":"Antilocapra americana","tl":2,"xh":0.66,"wiki":"Pronghorn","desc":"Open-country grazer and sagebrush browser. Coyotes and eagles take fawns.","ic":"pronghorn"},{"id":"hopper","name":"Grasshoppers","latin":"Acrididae","tl":2,"xh":0.74,"wiki":"Grasshopper","desc":"Chew grasses all summer, then feed songbirds, and trout when they fall into streams.","ic":"hopper"},{"id":"vole","name":"Montane vole","latin":"Microtus montanus","tl":2,"xh":0.82,"wiki":"Montane vole","desc":"A small grass-eating rodent and a staple for foxes, coyotes, hawks and eagles.","ic":"vole"},{"id":"gsquirrel","name":"Ground squirrel","latin":"Urocitellus armatus","tl":2,"xh":0.9,"wiki":"Uinta ground squirrel","desc":"A hibernating meadow rodent eaten by nearly every mid-sized predator. Grizzlies dig them out of burrows.","ic":"gsquirrel"},{"id":"rsquirrel","name":"Red squirrel","latin":"Tamiasciurus hudsonicus","tl":2,"xh":0.98,"wiki":"American red squirrel","desc":"Stores whitebark pine cones in middens, which grizzly bears raid.","ic":"rsquirrel"},{"id":"otter","name":"River otter","latin":"Lontra canadensis","tl":3,"xh":0.03,"wiki":"North American river otter","desc":"Hunts trout and other fish along streams and lake shores.","ic":"otter"},{"id":"trout","name":"Cutthroat trout","latin":"Oncorhynchus clarkii bouvieri","tl":3,"xh":0.1,"wiki":"Yellowstone cutthroat trout","desc":"Yellowstone's native trout. Eats mayflies and fallen grasshoppers, and feeds otters, ospreys, eagles and bears.","ic":"trout"},{"id":"osprey","name":"Osprey","latin":"Pandion haliaetus","tl":3,"xh":0.18,"wiki":"Osprey","desc":"Dives for trout from perches over rivers and lakes.","ic":"osprey"},{"id":"baldeagle","name":"Bald eagle","latin":"Haliaeetus leucocephalus","tl":3,"xh":0.26,"wiki":"Bald eagle","desc":"Takes fish and scavenges carcasses, including wolf kills.","ic":"baldeagle"},{"id":"raven","name":"Common raven","latin":"Corvus corax","tl":3,"xh":0.34,"wiki":"Common raven","desc":"Ravens often follow wolves and feed on what they leave behind.","ic":"raven"},{"id":"coyote","name":"Coyote","latin":"Canis latrans","tl":3,"xh":0.44,"wiki":"Coyote","desc":"Hunts voles and ground squirrels, takes fawns and calves, and scavenges wolf kills. Wolves also kill coyotes.","ic":"coyote"},{"id":"fox","name":"Red fox","latin":"Vulpes vulpes","tl":3,"xh":0.54,"wiki":"Red fox","desc":"Pounces on voles beneath the snow and takes ground squirrels.","ic":"fox"},{"id":"meadowlark","name":"Western Meadowlark","latin":"Sturnella neglecta","tl":3,"xh":0.64,"wiki":"Western meadowlark","desc":"A grassland songbird that eats grasshoppers and seeds in summer.","ic":"meadowlark"},{"id":"hawk","name":"Red-tailed hawk","latin":"Buteo jamaicensis","tl":3,"xh":0.74,"wiki":"Red-tailed hawk","desc":"Hunts voles, ground squirrels and meadow birds from open perches.","ic":"hawk"},{"id":"goldeneagle","name":"Golden eagle","latin":"Aquila chrysaetos","tl":3,"xh":0.86,"wiki":"Golden eagle","desc":"Hunts ground squirrels and voles, takes pronghorn fawns, and scavenges kills.","ic":"goldeneagle"},{"id":"wolf","name":"Gray wolf","latin":"Canis lupus","tl":4,"xh":0.36,"wiki":"Gray wolf","desc":"Reintroduced in 1995. Hunts elk, bison, deer and moose, and its kills feed scavengers. Many ecologists link its return to recovering willow and aspen.","ic":"wolf","badge":"Keystone predator"},{"id":"grizzly","name":"Grizzly bear","latin":"Ursus arctos horribilis","tl":4,"xh":0.64,"wiki":"Grizzly bear","desc":"An omnivore that eats pine seeds, roots, trout, elk calves and carrion.","ic":"grizzly"},{"id":"lion","name":"Mountain lion","latin":"Puma concolor","tl":4,"xh":0.9,"wiki":"Cougar","desc":"An ambush hunter of elk and mule deer in broken, wooded terrain.","ic":"lion"},{"id":"water","name":"Snowmelt & streams","latin":"","tl":0,"xh":0.12,"wiki":"Stream","desc":"Winter snowpack melts into the rivers and soils that carry algae, willows and meadow grasses through the dry summer.","ic":"water","cat":"abiotic"},{"id":"sun","name":"Sunlight","latin":"","tl":0,"xh":0.38,"wiki":"Sun","desc":"Powers photosynthesis. Nearly all the energy in this web starts here.","ic":"sun","cat":"abiotic"},{"id":"soil","name":"Soil & nutrients","latin":"","tl":0,"xh":0.62,"wiki":"Soil","desc":"Holds the nitrogen and minerals that plants draw up. Decomposers return nutrients from litter and carcasses.","ic":"soil","cat":"abiotic"},{"id":"decomp","name":"Fungi & bacteria","latin":"Decomposer community","tl":0,"xh":0.86,"wiki":"Decomposer","desc":"Break down plant litter and carcasses and return nutrients to the soil.","ic":"decomp","cat":"decomp"}],"raw":[["grass","elk"],["grass","bison"],["grass","pronghorn"],["grass","muledeer"],["grass","vole"],["grass","gsquirrel"],["grass","hopper"],["grass","grizzly"],["aspen","elk"],["aspen","beaver"],["aspen","moose"],["willow","elk"],["willow","moose"],["willow","beaver"],["willow","muledeer"],["sage","pronghorn"],["sage","muledeer"],["whitebark","rsquirrel"],["whitebark","grizzly"],["algae","mayfly"],["mayfly","trout"],["hopper","trout"],["hopper","meadowlark"],["vole","fox"],["vole","coyote"],["vole","hawk"],["vole","goldeneagle"],["gsquirrel","fox"],["gsquirrel","coyote"],["gsquirrel","hawk"],["gsquirrel","goldeneagle"],["gsquirrel","grizzly"],["rsquirrel","hawk"],["elk","wolf"],["elk","grizzly"],["elk","lion"],["e