{"nodes":[{"id":"redoat","name":"Red oat grass","latin":"Themeda triandra","tl":1,"xh":0.2,"wiki":"Themeda triandra","desc":"The tall grass of the plains. Fire and grazing keep it growing back each year.","ic":"grass"},{"id":"star","name":"Short grasses","latin":"Cynodon and Digitaria spp.","tl":1,"xh":0.45,"wiki":"Cynodon dactylon","desc":"Short, nutritious grasses on the southern plains that wildebeest and gazelles head for each rainy season.","ic":"grass"},{"id":"acacia","name":"Umbrella thorn acacia","latin":"Vachellia tortilis","tl":1,"xh":0.72,"wiki":"Vachellia tortilis","desc":"Flat-topped trees that feed giraffes and elephants and shade the ground beneath.","ic":"aspen"},{"id":"rivalg","name":"River algae","latin":"Periphyton","tl":1,"xh":0.93,"wiki":"Periphyton","desc":"Green films on rocks in the Mara and Grumeti rivers that feed fish.","ic":"algae"},{"id":"wildebeest","name":"Blue wildebeest","latin":"Connochaetes taurinus","tl":2,"xh":0.08,"wiki":"Blue wildebeest","desc":"More than a million migrate in a loop around the ecosystem, following the rains and the new grass.","ic":"bison"},{"id":"zebra","name":"Plains zebra","latin":"Equus quagga","tl":2,"xh":0.2,"wiki":"Plains zebra","desc":"Grazes the taller grass first, clearing the way for wildebeest and gazelles.","ic":"quad"},{"id":"gazelle","name":"Thomson's gazelle","latin":"Eudorcas thomsonii","tl":2,"xh":0.31,"wiki":"Thomson's gazelle","desc":"A small, fast grazer of the short-grass plains and the main food of cheetahs.","ic":"pronghorn"},{"id":"buffalo","name":"African buffalo","latin":"Syncerus caffer","tl":2,"xh":0.43,"wiki":"African buffalo","desc":"Herds graze tall, coarse grass and are hard for most predators to take down.","ic":"bison"},{"id":"giraffe","name":"Giraffe","latin":"Giraffa camelopardalis","tl":2,"xh":0.54,"wiki":"Giraffe","desc":"Browses the tops of acacias that no other herbivore can reach.","ic":"giraffe"},{"id":"elephant","name":"African elephant","latin":"Loxodonta africana","tl":2,"xh":0.65,"wiki":"African elephant","desc":"Pushes over trees and digs for water, opening woodland into grassland.","ic":"elephant","badge":"Ecosystem engineer"},{"id":"hippo","name":"Hippopotamus","latin":"Hippopotamus amphibius","tl":2,"xh":0.76,"wiki":"Hippopotamus","desc":"Grazes grass on land at night and fertilizes rivers with its dung by day.","ic":"bison"},{"id":"termites","name":"Termites","latin":"Macrotermes spp.","tl":2,"xh":0.87,"wiki":"Termite","desc":"Chew dead grass and wood, and their mounds enrich the soil around them.","ic":"hopper"},{"id":"tilapia","name":"Tilapia","latin":"Oreochromis spp.","tl":2,"xh":0.96,"wiki":"Tilapia","desc":"River fish that graze algae and feed crocodiles.","ic":"trout"},{"id":"cheetah","name":"Cheetah","latin":"Acinonyx jubatus","tl":3,"xh":0.18,"wiki":"Cheetah","desc":"Sprints after gazelles on open plains, often losing kills to larger predators.","ic":"lion"},{"id":"wilddog","name":"African wild dog","latin":"Lycaon pictus","tl":3,"xh":0.3,"wiki":"African wild dog","desc":"Hunts in packs and wears down gazelles, zebra and wildebeest calves.","ic":"coyote"},{"id":"jackal","name":"Black-backed jackal","latin":"Lupulella mesomelas","tl":3,"xh":0.42,"wiki":"Black-backed jackal","desc":"Takes gazelle fawns and rodents and cleans up scraps at kills.","ic":"fox"},{"id":"aardwolf","name":"Aardwolf","latin":"Proteles cristata","tl":3,"xh":0.6,"wiki":"Aardwolf","desc":"A small hyena relative that laps up thousands of termites a night.","ic":"fox"},{"id":"vulture","name":"Rüppell's vulture","latin":"Gyps rueppelli","tl":3,"xh":0.78,"wiki":"Rüppell's vulture","desc":"Circles on thermals and arrives fast at carcasses, stripping them within hours.","ic":"hawk"},{"id":"lion","name":"Lion","latin":"Panthera leo","tl":4,"xh":0.25,"wiki":"Lion","desc":"Hunts wildebeest, zebra and buffalo in prides, and its kills feed hyenas, jackals and vultures.","ic":"lion","badge":"Keystone predator"},{"id":"leopard","name":"Leopard","latin":"Panthera pardus","tl":4,"xh":0.5,"wiki":"Leopard","desc":"A solitary ambush hunter that hauls kills into trees, out of reach of lions and hyenas.","ic":"lion"},{"id":"hyena","name":"Spotted hyena","latin":"Crocuta crocuta","tl":4,"xh":0.72,"wiki":"Spotted hyena","desc":"A powerful hunter in its own right, as well as a scavenger of lion kills.","ic":"coyote"},{"id":"croc","name":"Nile crocodile","latin":"Crocodylus niloticus","tl":4,"xh":0.93,"wiki":"Nile crocodile","desc":"Ambushes wildebeest and zebra at river crossings and eats fish between migrations.","ic":"croc"},{"id":"sun","name":"Sunlight","latin":"","tl":0,"xh":0.12,"wiki":"Sunbeam","desc":"Drives grass growth. Heat and light are plentiful, so water, not sun, limits the plains.","ic":"sun","cat":"abiotic"},{"id":"rain","name":"Seasonal rains","latin":"","tl":0,"xh":0.38,"wiki":"Rain","desc":"Rain arrives in two seasons and sets the timing of the whole migration.","ic":"rain","cat":"abiotic"},{"id":"soil","name":"Volcanic soil","latin":"","tl":0,"xh":0.64,"wiki":"Soil","desc":"Ash from old volcanoes makes the southern plains rich in minerals but shallow.","ic":"soil","cat":"abiotic"},{"id":"decomp","name":"Dung beetles & fungi","latin":"Decomposer community","tl":0,"xh":0.88,"wiki":"Dung beetle","desc":"Break down dung, carcasses and dead grass and return nutrients to the soil.","ic":"decomp","cat":"decomp"}],"raw":[["sun","redoat","r"],["sun","star","r"],["sun","acacia","r"],["sun","rivalg","r"],["rain","redoat","r"],["rain","star","r"],["rain","acacia","r"],["rain","rivalg","r"],["soil","redoat","r"],["soil","star","r"],["soil","acacia","r"],["decomp","soil","r"],["redoat","wildebeest"],["redoat","zebra"],["redoat","buffalo"],["redoat","elephant"],["redoat","termites"],["star","wildebeest"],["star","gazelle"],["star","zebra"],["star","hippo"],["acacia","giraffe"],["acacia","elephant"],["rivalg","tilapia"],["wildebeest","lion"],["wildebeest","hyena"],["wildebeest","croc"],["wildebeest","wilddog"],["wildebees