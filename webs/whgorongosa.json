us strepsiceros"],"waterbuck>croc":["g","Crocodylus niloticus","Kobus ellipsiprymnus"],"wildebeest>croc":["g","Crocodylus niloticus","Connochaetes taurinus"],"hippo>croc":["g","Crocodylus niloticus","Hippopotamus amphibius"],"wildebeest>vulture":["g","Gyps africanus","Connochaetes taurinus"],"wildebeest>marabou":["g","Leptoptilos crumenifer","Connochaetes taurinus"],"impala>vulture":["g","Gyps africanus","Aepyceros melampus"],"impala>marabou":["g","Leptoptilos crumenifer","Aepyceros melampus"],"waterbuck>vulture":["g","Gyps africanus","Kobus ellipsiprymnus"],"waterbuck>marabou":["g","Leptoptilos crumenifer","Kobus ellipsiprymnus"],"hippo>vulture":["g","Gyps africanus","Hippopotamus amphibius"],"hippo>marabou":["g","Leptoptilos crumenifer","Hippopotamus amphibius"],"elephant>vulture":["g","Gyps africanus","Loxodonta africana"],"elephant>marabou":["g","Leptoptilos crumenifer","Loxodonta africana"],"kudu>vulture":["g","Gyps africanus","Tragelaphus strepsiceros"],"kudu>marabou":["g","Leptoptilos crumenifer","Tragelaphus strepsiceros"],"buffalo>wilddog":["ga","Lycaon pictus","Syncerus caffer"],"buffalo>vulture":["ga","Gyps africanus","Syncerus caffer"],"elephant>lion":["ga","Panthera leo","Loxodonta africana"],"impala>croc":["ga","Crocodylus niloticus","Aepyceros melampus"],"elephant>croc":["ga","Crocodylus niloticus","Loxodonta africana"],"buffalo>croc":["ga","Crocodylus niloticus","Syncerus caffer"],"baboon>croc":["ga","Crocodylus niloticus","Papio ursinus"]}}