{"nodes":[{"id":"fir","name":"Balsam fir","latin":"Abies balsamea","tl":1,"xh":0.08,"wiki":"Abies balsamea","desc":"A cold-climate conifer of the northern forest and a browse plant for hare, deer and beaver in GloBI feeding records.","ic":"willow","badge":"Foundation species"},{"id":"beech","name":"American beech","latin":"Fagus grandifolia","tl":1,"xh":0.27,"wiki":"Fagus grandifolia","desc":"A hardwood of the lower forest. Its leaves, twigs and nuts are eaten by hare, deer, beaver, mice and bears.","ic":"willow"},{"id":"maple","name":"Striped maple","latin":"Acer pensylvanicum","tl":1,"xh":0.46,"wiki":"Acer pensylvanicum","desc":"A small understory tree. Moose browse its new growth, and a GloBI record links the two.","ic":"willow"},{"id":"berries","name":"Cowberry and bilberry","latin":"Vaccinium","tl":1,"xh":0.65,"wiki":"Vaccinium vitis-idaea","desc":"Low heath shrubs of the subalpine and bog zones. Their berries are eaten by black bears.","ic":"sage"},{"id":"bunch","name":"Bunchberry","latin":"Cornus canadensis","tl":1,"xh":0.85,"wiki":"Cornus canadensis","desc":"A common forest-floor plant of the cool woods, eaten by hare, voles and bears in GloBI records.","ic":"sage"},{"id":"moose","name":"Moose","latin":"Alces alces","tl":2,"xh":0.05,"wiki":"Moose","desc":"A large browser of young shoots and twigs. Winter ticks, helped by milder winters, have driven moose declines in New Hampshire.","ic":"moose","badge":"Keystone grazer"},{"id":"deer","name":"White-tailed deer","latin":"Odocoileus virginianus","tl":2,"xh":0.19,"wiki":"White-tailed deer","desc":"Browses twigs, buds and plants in the forest and is hunted by bobcats and coyotes.","ic":"muledeer"},{"id":"hare","name":"Snowshoe hare","latin":"Lepus americanus","tl":2,"xh":0.33,"wiki":"Snowshoe hare","desc":"Browses conifer and shrub shoots. It is the main prey of the fisher.","ic":"quad"},{"id":"beaver","name":"American beaver","latin":"Castor canadensis","tl":2,"xh":0.47,"wiki":"American beaver","desc":"Fells trees and eats bark and twigs of fir and beech, building ponds that make wetland habitat.","ic":"beaver","badge":"Ecosystem engineer"},{"id":"vole","name":"Meadow vole","latin":"Microtus pennsylvanicus","tl":2,"xh":0.62,"wiki":"Meadow vole","desc":"A small plant-eater of wet meadows and forest edges, and prey for many carnivores.","ic":"vole"},{"id":"mouse","name":"White-footed mouse","latin":"Peromyscus leucopus","tl":2,"xh":0.78,"wiki":"White-footed mouse","desc":"Eats seeds, nuts and plant matter, and is common prey for snakes, bobcats and coyotes.","ic":"vole"},{"id":"shrew","name":"Northern short-tailed shrew","latin":"Blarina brevicauda","tl":3,"xh":0.1,"wiki":"Northern short-tailed shrew","desc":"A tiny predator of small animals. GloBI records show it eating voles and snakes.","ic":"vole"},{"id":"snake","name":"Common garter snake","latin":"Thamnophis sirtalis","tl":3,"xh":0.3,"wiki":"Common garter snake","desc":"Eats frogs, small mammals and amphibians, based on GloBI records.","ic":"snake"},{"id":"marten","name":"American marten","latin":"Martes americana","tl":3,"xh":0.55,"wiki":"American marten","desc":"A forest weasel that hunts small mammals and hares, and is itself killed by fishers and bobcats.","ic":"quad"},{"id":"fisher","name":"Fisher","latin":"Pekania pennanti","tl":3,"xh":0.78,"wiki":"Fisher (animal)","desc":"A generalist hunter whose main prey are snowshoe hares and porcupines. It also eats small mammals and carrion.","ic":"quad"},{"id":"bobcat","name":"Bobcat","latin":"Lynx rufus","tl":4,"xh":0.18,"wiki":"Bobcat","desc":"A cat that preys on hares, rodents and deer, and also takes marten and fisher.","ic":"lion","badge":"Keystone predator"},{"id":"coyote","name":"Coyote","latin":"Canis latrans","tl":4,"xh":0.5,"wiki":"Coyote","desc":"An adaptable predator and scavenger of hares, rodents and the carcasses of deer and moose.","ic":"coyote"},{"id":"bear","name":"American black bear","latin":"Ursus americanus","tl":4,"xh":0.82,"wiki":"American black bear","desc":"An omnivore that eats berries, beech nuts and plants, and takes beaver, hare and young moose.","ic":"grizzly"},{"id":"sun","name":"Sunlight","latin":"","tl":0,"xh":0.12,"wiki":"Sunbeam","desc":"Short, cool growing seasons limit plant growth in the mountains.","ic":"sun","cat":"abiotic"},{"id":"precip","name":"Rain and snow","latin":"","tl":0,"xh":0.34,"wiki":"Precipitation","desc":"Mount Washington receives very high precipitation, about 91 inches a year, feeding moist forests and alpine plants.","ic":"rain","cat":"abiotic"},{"id":"soil","name":"Forest soil nutrients","latin":"","tl":0,"xh":0.6,"wiki":"Soil","desc":"Nutrients in thin mountain soils are recycled from dead leaves, wood and animals.","ic":"soil","cat":"abiotic"},{"id":"decomp","name":"Fungi and bacteria","latin":"Decomposer community","tl":0,"xh":0.88,"wiki":"Decomposer","desc":"Break down fallen leaves, wood and carcasses, returning nutrients to the soil.","ic":"decomp","cat":"decomp"}],"raw":[["fir","hare"],["fir","deer"],["fir","beaver"],["fir","vole"],["fir","mouse"],["fir","moose"],["beech","hare"],["beech","deer"],["beech","beaver"],["beech","mouse"],["beech","bear"],["maple","moose"],["berries","bear"],["bunch","hare"],["bunch","vole"],["bunch","bear"],["vole","shrew"],["vole","snake"],["vole","marten"],["vole","bobcat"],["vole","coyote"],["mouse","snake"],["mouse","bobcat"],["mouse","coyote"],["hare","marten"],["hare","fisher"],["hare","bobcat"],["hare","coyote"],["hare","bear"],["beaver","bobcat"],["beaver","coyote"],["beaver","bear"],["deer","bobcat"],["deer","coyote"],["deer","bear"],["deer","fisher","s"],["moose","bear"],["moose","coyote","s"],["shrew","fisher"],["shrew","coyote"],["marten","fisher"],["marten","bobcat"],["marten","coyote"],["fisher","bobcat"],["sun","fir","r"],["precip","fir","r"],["soil","fir","r"],["fir","decomp","d"],["sun","beech","r"],["precip","beech","r"],["soil","beech","r"],["beech","decomp","d"],["sun","maple","r"],["precip","maple","r"],["soil","maple