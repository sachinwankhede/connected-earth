{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/species/taxonomy_manual.json: classifications entered by hand for names GBIF cannot decide (read by jobs/taxonomy.py)",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "kingdom",
      "rank",
      "note"
    ],
    "properties": {
      "kingdom": {
        "type": "string"
      },
      "phylum": {
        "type": "string"
      },
      "class": {
        "type": "string"
      },
      "order": {
        "type": "string"
      },
      "family": {
        "type": "string"
      },
      "rank": {
        "type": "string"
      },
      "note": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
