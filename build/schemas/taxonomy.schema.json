{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/species/taxonomy.json: GBIF classification per species id (written only by jobs/taxonomy.py)",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "kingdom",
      "rank",
      "match",
      "src",
      "at"
    ],
    "properties": {
      "kingdom": {
        "type": "string"
      },
      "phylum": {
        "type": "string"
      },
      "class": {
        "type": "string"
      },
      "order": {
        "type": "string"
      },
      "family": {
        "type": "string"
      },
      "rank": {
        "type": "string"
      },
      "key": {
        "type": "integer"
      },
      "match": {
        "enum": [
          "exact",
          "higher-rank",
          "fuzzy",
          "name-search",
          "manual"
        ]
      },
      "conf": {
        "type": "integer",
        "minimum": 90,
        "maximum": 100
      },
      "gname": {
        "type": "string"
      },
      "src": {
        "enum": [
          "gbif",
          "manual"
        ]
      },
      "at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "note": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
