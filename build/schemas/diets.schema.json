{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/diets/<xx>/<sid>.json: what one consumer species eats, with the evidence for each link (written by build/diets.py)",
  "type": "object",
  "required": ["sid", "prey"],
  "additionalProperties": false,
  "properties": {
    "sid": {"type": "string", "minLength": 1},
    "prey": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["ev", "k"],
        "additionalProperties": false,
        "properties": {
          "ev": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "k": {"enum": ["e", "s"]},
          "src": {"type": "string"},
          "at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
